<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue du wizard d'import d'emails -->
    <record id="view_import_email_wizard_form" model="ir.ui.view">
        <field name="name">blg.import.email.wizard.form</field>
        <field name="model">blg.import.email.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Importer depuis les emails</h1>
                        <h3 class="text-muted">
                            Créer des projets à partir des emails reçus
                        </h3>
                    </div>
                    
                    <group>
                        <field name="email_content" widget="html" placeholder="Collez le contenu de l'email ici..."/>
                    </group>
                    
                    <group string="Informations extraites">
                        <field name="client_name"/>
                        <field name="project_name"/>
                        <field name="address"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Créer le projet" name="action_create_project" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action pour le wizard -->
    <record id="action_import_email_wizard" model="ir.actions.act_window">
        <field name="name">Importer depuis email</field>
        <field name="res_model">blg.import.email.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
