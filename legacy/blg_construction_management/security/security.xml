<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_blg_construction" model="ir.module.category">
            <field name="name">Gestion Chantiers</field>
            <field name="description">BLG Gestion de Chantiers</field>
            <field name="sequence">50</field>
        </record>
        
        <!-- User Group -->
        <record id="group_blg_construction_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_blg_construction"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- Conductor Group -->
        <record id="group_blg_construction_conductor" model="res.groups">
            <field name="name">Conducteur Travaux</field>
            <field name="category_id" ref="module_category_blg_construction"/>
            <field name="implied_ids" eval="[(4, ref('group_blg_construction_user'))]"/>
        </record>
        
        <!-- Manager Group -->
        <record id="group_blg_construction_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="category_id" ref="module_category_blg_construction"/>
            <field name="implied_ids" eval="[(4, ref('group_blg_construction_conductor'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
        
        <!-- Construction Management Groups -->
        <record id="group_construction_user" model="res.groups">
            <field name="name">Construction User</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_construction_manager" model="res.groups">
            <field name="name">Construction Manager</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
        </record>
    </data>

    <!-- Record Rules -->
    <data noupdate="1">
        <!-- Rule: Users can see only their assigned projects -->
        <record id="rule_blg_chantier_user" model="ir.rule">
            <field name="name">Users see only their assigned projects</field>
            <field name="model_id" ref="model_blg_chantier"/>
            <field name="domain_force">['|', ('user_ids', 'in', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_blg_construction_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Rule: Conductors can see all projects but follow workflow -->
        <record id="rule_blg_chantier_conductor" model="ir.rule">
            <field name="name">Conductors can see all projects</field>
            <field name="model_id" ref="model_blg_chantier"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_blg_construction_conductor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Rule: Managers have full access -->
        <record id="rule_blg_chantier_manager" model="ir.rule">
            <field name="name">Managers have full access</field>
            <field name="model_id" ref="model_blg_chantier"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_blg_construction_manager'))]"/>
        </record>
    </data>
</odoo>
