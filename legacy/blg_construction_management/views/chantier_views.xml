<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Formulaire Chantier - Design Professionnel BTP -->
    <record id="view_blg_chantier_form" model="ir.ui.view">
        <field name="name">blg.chantier.form</field>
        <field name="model">blg.chantier</field>
        <field name="arch" type="xml">
            <form string="Chantier" class="o_chantier_form">
                <header>
                    <button name="action_progress_workflow" string="Étape suivante" type="object"
                            class="oe_highlight"
                            invisible="not show_progress_workflow"
                            help="Faire progresser le projet vers l'étape suivante"/>
                    <button name="action_schedule_visit" string="Planifier visite" type="object"
                            class="btn-primary"
                            invisible="not show_schedule_visit"
                            help="Programmer une visite technique"/>
                    <button name="action_create_quote" string="Créer devis" type="object"
                            class="btn-info"
                            invisible="not show_create_quote"
                            help="Générer un devis pour ce projet"/>
                    <button name="action_assign_subcontractors" string="Assigner sous-traitants" type="object"
                            class="btn-success"
                            invisible="not show_assign_subcontractors"
                            help="Gérer les sous-traitants du projet"/>
                    <button name="%(blg_sales_extension.action_create_quote_wizard)d" 
                            string="📄 Créer devis" 
                            type="action"
                            class="btn-info"
                            context="{'default_chantier_id': id}"
                            invisible="not show_create_quote"
                            help="Générer un devis pour ce projet"/>
                    <button name="action_create_quote_with_lots" string="📄 Créer devis avec lots" 
                            type="object" class="btn-primary"
                            help="Créer un devis avec tous les lots définis pour ce chantier"/>
                    <button name="action_mark_not_pursued" string="Marquer sans suite" type="object"
                            class="btn-secondary"
                            invisible="not show_mark_not_pursued"
                            confirm="Confirmer l'abandon de ce projet ?"
                            help="Archiver le projet"/>
                    <field name="stage_id" widget="statusbar" clickable="True"
                           options="{'fold_field': 'fold'}"/>
                </header>

                <sheet>
                    <!-- Boutons Intelligents -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visits" type="object" class="oe_stat_button" 
                                icon="fa-calendar">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="visite_count"/>
                                </span>
                                <span class="o_stat_text">Visites</span>
                            </div>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" 
                                icon="fa-folder">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="document_count"/>
                                </span>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                        <button name="action_view_subcontractors" type="object" class="oe_stat_button" 
                                icon="fa-users">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="subcontractor_count"/>
                                </span>
                                <span class="o_stat_text">Sous-traitants</span>
                            </div>
                        </button>
                    </div>

                    <!-- Ruban de statut -->
                    <widget name="web_ribbon" title="Archivé" bg_color="bg-secondary"
                            invisible="stage_id and stage_id.code not in ['6_1', '6_2']"/>
                    
                    <!-- Titre du projet -->
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only">Nom du chantier</label>
                        <h1>
                            <field name="name" placeholder="Nom du projet" required="1"/>
                        </h1>
                    </div>

                    <!-- Informations principales -->
                    <group>
                        <group name="client_info" string="Client">
                            <field name="client_id" required="1"/>
                            <field name="address" required="1" string="Adresse du chantier"/>
                            <field name="phone" string="Téléphone"/>
                        </group>
                        <group name="project_info" string="Projet">
                            <field name="chapter_id" string="Phase"/>
                            <field name="total_cost" widget="monetary" string="Budget"/>
                            <field name="progress" widget="progressbar" string="Avancement"/>
                            <field name="days_remaining" readonly="1" string="Jours restants"
                                   decoration-danger="days_remaining &lt; 0"
                                   decoration-warning="days_remaining &lt; 30"/>
                        </group>
                    </group>

                    <!-- Planning -->
                    <group string="Planning">
                        <group name="contract_dates" string="Dates contractuelles">
                            <field name="date_start_contract" string="Début"/>
                            <field name="date_end_contract" string="Fin"/>
                        </group>
                        <group name="internal_dates" string="Dates internes">
                            <field name="date_start_internal" string="Début effectif"/>
                            <field name="date_end_internal" string="Fin effective"/>
                        </group>
                    </group>

                    <!-- Gestion -->
                    <group string="Gestion">
                        <field name="user_ids" widget="many2many_avatar_user" string="Responsables"/>
                        <field name="tag_ids" widget="many2many_tags" 
                               options="{'color_field': 'color', 'no_create_edit': True}"
                               string="Étiquettes"/>
                    </group>

                    <!-- Onglets -->
                    <notebook>
                        <!-- Lots de travaux -->
                        <page string="Lots de travaux" name="lots">
                            <p class="text-muted mb-3">
                                Définition des différents corps de métier et leur répartition sur le chantier.
                            </p>
                            <field name="lot_ids" context="{'default_chantier_id': id}">
                                <list editable="bottom" 
                                      decoration-success="progress == 100" 
                                      decoration-warning="progress &gt; 0 and progress &lt; 100">
                                    <field name="lot_id" required="1" string="Corps de métier" options="{'no_create': True}"/>
                                    <field name="subcontractor_id"
                                           options="{'no_create': True}"
                                           domain="[('contact_type','=','sous_traitant'), ('lots', 'in', lot_id)]"
                                           string="Sous-traitant"/>
                                    <field name="cost" string="Coût estimé" sum="Total"/>
                                    <field name="progress" widget="progressbar" string="Avancement"/>
                                    <field name="quote_state" string="Devis"/>
                                </list>
                            </field>
                        </page>

                        <!-- Sous-traitants -->
                        <page string="Sous-traitants" name="subcontractors">
                            <p class="text-muted mb-3">
                                Liste des entreprises sous-traitantes intervenant sur ce chantier.
                            </p>
                            <field name="subcontractor_ids">
                                <list>
                                    <field name="name" string="Entreprise"/>
                                    <field name="email"/>
                                    <field name="phone" string="Téléphone"/>
                                    <field name="lots" widget="many2many_tags" string="Spécialités"/>
                                </list>
                            </field>
                        </page>

                        <!-- Visites techniques -->
                        <page string="Visites techniques" name="visits">
                            <p class="text-muted mb-3">
                                Suivi des visites et interventions techniques sur le site.
                            </p>
                            <field name="visite_ids">
                                <list decoration-success="state == 'completed'" 
                                      decoration-warning="state == 'in_progress'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="date" string="Date"/>
                                    <field name="user_ids" widget="many2many_avatar_user" 
                                           string="Intervenants"/>
                                    <field name="state" string="Statut" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Documents -->
                        <page string="Documents" name="documents">
                            <p class="text-muted mb-3">
                                Gestion documentaire du projet : contrats, plans, attestations, factures.
                            </p>
                            <field name="document_ids">
                                <list decoration-danger="state == 'expired'" 
                                      decoration-success="state == 'valid'">
                                    <field name="name" string="Document"/>
                                    <field name="document_type" string="Type"/>
                                    <field name="expiry_date" string="Échéance"/>
                                    <field name="state" string="Statut" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Description -->
                        <page string="Description" name="description">
                            <field name="description" widget="html" 
                                   placeholder="Description détaillée des travaux à réaliser, spécifications techniques, contraintes particulières..."/>
                        </page>

                        <!-- Notes -->
                        <page string="Notes internes" name="notes">
                            <field name="notes" placeholder="Notes internes, remarques pour l'équipe, points d'attention..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue Liste -->
    <record id="view_blg_chantier_tree" model="ir.ui.view">
        <field name="name">blg.chantier.tree</field>
        <field name="model">blg.chantier</field>
        <field name="arch" type="xml">
            <list string="Chantiers" sample="1" 
                  decoration-danger="days_remaining &lt; 0 and date_end_contract"
                  decoration-warning="days_remaining &lt; 30 and days_remaining &gt;= 0"
                  decoration-success="progress == 100">
                <field name="name" string="Projet"/>
                <field name="client_id" string="Client"/>
                <field name="address" string="Adresse"/>
                <field name="chapter_name" string="Phase"/>
                <field name="stage_id" string="Étape" widget="badge"/>
                <field name="progress" widget="progressbar" string="Avancement"/>
                <field name="total_cost" widget="monetary" string="Budget" sum="Total"/>
                <field name="date_end_contract" string="Échéance"/>
                <field name="days_remaining" string="J. restants"/>
                <field name="user_ids" widget="many2many_avatar_user" string="Équipe"/>
            </list>
        </field>
    </record>

    <!-- Vue Kanban -->
    <record id="view_blg_chantier_kanban" model="ir.ui.view">
        <field name="name">blg.chantier.kanban</field>
        <field name="model">blg.chantier</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="stage_id"/>
                <field name="chapter_id"/>
                <field name="progress"/>
                <field name="total_cost"/>
                <field name="user_ids"/>
                <field name="days_remaining"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <progressbar field="activity_state" colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Options">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="edit" class="dropdown-item">Modifier</a>
                                    <a role="menuitem" type="delete" class="dropdown-item">Supprimer</a>
                                </div>
                            </div>
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="client_id"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <div class="mt-2">
                                        <div class="row mb-1">
                                            <div class="col-5">
                                                <small class="text-muted">Avancement</small>
                                            </div>
                                            <div class="col-7">
                                                <field name="progress" widget="progressbar"/>
                                            </div>
                                        </div>
                                        <div class="row mb-1" t-if="record.total_cost.raw_value">
                                            <div class="col-5">
                                                <small class="text-muted">Budget</small>
                                            </div>
                                            <div class="col-7">
                                                <field name="total_cost" widget="monetary"/>
                                            </div>
                                        </div>
                                        <div class="row" t-if="record.days_remaining.raw_value">
                                            <div class="col-12">
                                                <small t-attf-class="#{record.days_remaining.raw_value &lt; 0 ? 'text-danger' : record.days_remaining.raw_value &lt; 30 ? 'text-warning' : 'text-muted'}">
                                                    <field name="days_remaining"/> 
                                                    <span t-if="record.days_remaining.raw_value &lt; 0">j. de retard</span>
                                                    <span t-if="record.days_remaining.raw_value &gt;= 0">j. restants</span>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_ids" widget="many2many_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue de Recherche -->
    <record id="view_blg_chantier_search" model="ir.ui.view">
        <field name="name">blg.chantier.search</field>
        <field name="model">blg.chantier</field>
        <field name="arch" type="xml">
            <search string="Rechercher un chantier">
                <field name="name" string="Nom du chantier"
                       filter_domain="[('name', 'ilike', self)]"/>
                <field name="client_id" string="Client"/>
                <field name="address" string="Adresse"/>
                <field name="stage_id" string="Étape"/>
                <field name="chapter_id" string="Phase"/>
                <field name="user_ids" string="Responsable"/>
                
                <separator/>
                <filter string="Mes chantiers" name="my_chantiers"
                        domain="[('user_ids', 'in', uid)]"/>
                <filter string="En retard" name="overdue"
                        domain="[('days_remaining', '&lt;', 0), ('date_end_contract', '!=', False)]"/>
                <filter string="Échéance proche" name="deadline_soon"
                        domain="[('days_remaining', '&lt;=', 30), ('days_remaining', '&gt;=', 0)]"/>
                        
                <separator/>
                <filter string="Projets actifs" name="active_projects"
                        domain="[('stage_id.code', 'not in', ['6_1', '6_2'])]"/>
                <filter string="Terminés" name="completed"
                        domain="[('stage_id.code', '=', '6_1')]"/>
                <filter string="Abandonnés" name="not_pursued"
                        domain="[('stage_id.code', '=', '6_2')]"/>
                        
                <separator/>
                <group expand="0" string="Regrouper par">
                    <filter string="Client" name="group_by_client" 
                            context="{'group_by': 'client_id'}"/>
                    <filter string="Étape" name="group_by_stage" 
                            context="{'group_by': 'stage_id'}"/>
                    <filter string="Phase" name="group_by_chapter" 
                            context="{'group_by': 'chapter_id'}"/>
                    <filter string="Responsable" name="group_by_user" 
                            context="{'group_by': 'user_ids'}"/>
                    <filter string="Date d'échéance" name="group_by_date_end" 
                            context="{'group_by': 'date_end_contract'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Principale -->
    <record id="action_blg_chantier" model="ir.actions.act_window">
        <field name="name">Chantiers</field>
        <field name="res_model">blg.chantier</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_blg_chantier_search"/>
        <field name="context">{
            'search_default_active_projects': 1,
            'search_default_my_chantiers': 1
        }</field>
        <field name="help" type="html">
            <div class="text-center o_view_nocontent">
                <div class="o_view_nocontent_smiling_face">
                    <i class="fa fa-building-o fa-4x text-muted mb-4"></i>
                </div>
                <h3 class="o_view_nocontent_title">Aucun chantier</h3>
                <p class="o_view_nocontent_subtitle text-muted">
                    Créez votre premier projet de construction
                </p>
                <div class="mt-4 text-left" style="max-width: 600px; margin: 0 auto;">
                    <h5>Fonctionnalités disponibles :</h5>
                    <ul class="list-unstyled mt-3">
                        <li class="mb-2">
                            <i class="fa fa-check text-success mr-2"></i>
                            <strong>Suivi de projet :</strong> Workflow automatisé par étapes
                        </li>
                        <li class="mb-2">
                            <i class="fa fa-check text-success mr-2"></i>
                            <strong>Gestion d'équipe :</strong> Attribution des responsabilités
                        </li>
                        <li class="mb-2">
                            <i class="fa fa-check text-success mr-2"></i>
                            <strong>Planning :</strong> Suivi des visites techniques
                        </li>
                        <li class="mb-2">
                            <i class="fa fa-check text-success mr-2"></i>
                            <strong>Documentation :</strong> Centralisation des documents
                        </li>
                    </ul>
                </div>
            </div>
        </field>
    </record>

    <!-- Action Management Vue (replace problematic view reference) -->
    <record id="action_blg_chantier_management" model="ir.actions.act_window">
        <field name="name">Gestion des Chantiers</field>
        <field name="res_model">blg.chantier</field>
        <field name="view_mode">kanban,list,form</field>
        <!-- Remove the problematic view_id reference -->
        <!-- <field name="view_id" ref="view_blg_chantier_management_kanban"/> -->
        <field name="context">{
            'search_default_active_projects': 1,
            'search_default_my_chantiers': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau chantier
            </p>
            <p>
                Gérez vos projets de construction de A à Z avec un suivi détaillé des étapes.
            </p>
        </field>
    </record>
</odoo>
