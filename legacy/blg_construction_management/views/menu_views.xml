        <menuitem id="menu_blg_configuration"
            name="Configuration"
            parent="menu_blg_construction_root"
            sequence="100"/>
        
        <!-- Configuration Sous-menus -->
        <menuitem id="menu_blg_chapters"
            name="Phases"
            parent="menu_blg_configuration"
            action="action_blg_chapter"
            sequence="10"/>
        
        <menuitem id="menu_blg_stages"
            name="Étapes"
            parent="menu_blg_configuration"
            action="action_blg_stage"
