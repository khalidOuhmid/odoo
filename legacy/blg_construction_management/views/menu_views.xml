            web_icon="blg_construction_management,static/description/icon.png"
            sequence="10"/>
        
        <!-- Gestion des Chantiers -->
        <menuitem id="menu_blg_chantier"
            name="Chantiers"
            parent="menu_blg_construction_root"
            action="action_blg_chantier_management"
            sequence="10"/>
        
        <!-- Sous-menu Chantiers -->
        <menuitem id="menu_blg_chantier_all"
            name="Tous les Chantiers"
            parent="menu_blg_chantier"
            action="action_blg_chantier"
            sequence="10"/>
            
