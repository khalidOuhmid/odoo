        <!-- Add the missing visite and document actions -->
        <menuitem id="menu_blg_visite"
            name="Visites"
            parent="menu_blg_construction_root"
            action="action_blg_visite"
            sequence="30"/>
        
        <menuitem id="menu_blg_document"
