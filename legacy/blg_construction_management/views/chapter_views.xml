<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Formulaire pour les Chapitres -->
    <record id="view_blg_chapter_form" model="ir.ui.view">
        <field name="name">blg.chapter.form</field>
        <field name="model">blg.chapter</field>
        <field name="arch" type="xml">
            <form string="Chapitre">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Nom du chapitre"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Étapes" name="stages">
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="sequence"/>
                                    <field name="progress"/>
                                    <field name="fold" widget="boolean_toggle"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Liste pour les Chapitres -->
    <record id="view_blg_chapter_tree" model="ir.ui.view">
        <field name="name">blg.chapter.tree</field>
        <field name="model">blg.chapter</field>
        <field name="arch" type="xml">
            <list string="Chapitres" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action pour les Chapitres -->
    <record id="action_blg_chapter" model="ir.actions.act_window">
        <field name="name">Chapitres</field>
        <field name="res_model">blg.chapter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer le premier chapitre
            </p>
            <p>
                Les chapitres organisent le workflow des chantiers par grandes phases.
            </p>
        </field>
    </record>

    <!-- Vue Formulaire pour les Étapes -->
    <record id="view_blg_stage_form" model="ir.ui.view">
        <field name="name">blg.stage.form</field>
        <field name="model">blg.stage</field>
        <field name="arch" type="xml">
            <form string="Étape">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Nom de l'étape"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chapter_id" required="1"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="progress"/>
                            <field name="fold" widget="boolean_toggle"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Liste pour les Étapes -->
    <record id="view_blg_stage_tree" model="ir.ui.view">
        <field name="name">blg.stage.tree</field>
        <field name="model">blg.stage</field>
        <field name="arch" type="xml">
            <list string="Étapes" editable="bottom">
                <field name="chapter_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="progress"/>
                <field name="fold" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action pour les Étapes -->
    <record id="action_blg_stage" model="ir.actions.act_window">
        <field name="name">Étapes</field>
        <field name="res_model">blg.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer la première étape
            </p>
            <p>
                Les étapes définissent les sous-phases détaillées de chaque chapitre.
            </p>
        </field>
    </record>
</odoo>
