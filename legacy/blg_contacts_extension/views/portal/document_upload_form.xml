<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main upload form with modern, professional design -->
    <template id="document_upload_form" name="Upload Documents">
        <t t-call="web.frontend_layout">
            <!-- Modern font and fallback for icons -->
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
            <t t-set="title">Documents administratifs - BLG Groupe</t>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <style>
                body, .o_document_portal {
                    font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif !important;
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    min-height: 100vh;
                    color: #334155;
                    margin: 0;
                    padding: 0;
                }
                
                .main-container {
                    max-width: 1000px;
                    margin: 40px auto;
                    padding: 0 20px;
                }
                
                .header-card {
                    background: rgba(255,255,255,0.95);
                    backdrop-filter: blur(20px);
                    -webkit-backdrop-filter: blur(20px);
                    border-radius: 20px;
                    padding: 40px;
                    text-align: center;
                    margin-bottom: 32px;
                    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
                    border: 1px solid rgba(255,255,255,0.2);
                }
                
                .company-logo {
                    width: 80px;
                    height: 80px;
                    background: linear-gradient(135deg, #4f46e5, #7c3aed);
                    border-radius: 20px;
                    margin: 0 auto 24px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: white;
                    font-size: 32px;
                }
                
                .header-title {
                    font-size: 28px;
                    font-weight: 700;
                    color: #1f2937;
                    margin-bottom: 8px;
                    letter-spacing: -0.01em;
                }
                
                .header-subtitle {
                    font-size: 16px;
                    color: #6b7280;
                    font-weight: 400;
                }
                
                .o_document_portal .section-title {
                    font-size: 1.75rem;
                    font-weight: 700;
                    color: #1e40af;
                    margin-bottom: 1.25rem;
                    letter-spacing: -0.01em;
                }
                
                .o_document_portal .upload-card {
                    background: rgba(255,255,255,0.95);
                    backdrop-filter: blur(20px);
                    -webkit-backdrop-filter: blur(20px);
                    border-radius: 16px;
                    margin-bottom: 24px;
                    overflow: hidden;
                    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
                    border: 1px solid rgba(255,255,255,0.2);
                    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
                }
                
                .o_document_portal .upload-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
                }
                
                .o_document_portal .card-header {
                    padding: 24px 32px;
                    border-bottom: 1px solid rgba(243, 244, 246, 0.8);
                    background: rgba(250, 250, 250, 0.7);
                    backdrop-filter: blur(10px);
                }
                
                .o_document_portal .card-body {
                    padding: 32px;
                }
                
                /* Badge styling with glass morphism */
                .o_document_portal .badge {
                    padding: 6px 12px;
                    font-weight: 500;
                    font-size: 0.75em;
                    border-radius: 12px;
                    backdrop-filter: blur(10px);
                    -webkit-backdrop-filter: blur(10px);
                    border: 1px solid rgba(255,255,255,0.2);
                }
                
                .o_document_portal .badge.bg-primary {
                    background: linear-gradient(135deg, rgba(79, 70, 229, 0.9), rgba(124, 58, 237, 0.9)) !important;
                    color: white;
                }
                
                .o_document_portal .badge.bg-danger {
                    background: linear-gradient(135deg, rgba(239, 68, 68, 0.9), rgba(220, 38, 38, 0.9)) !important;
                    color: white;
                }
                
                .o_document_portal .badge.bg-warning {
                    background: linear-gradient(135deg, rgba(245, 158, 11, 0.9), rgba(217, 119, 6, 0.9)) !important;
                    color: white;
                }
                
                .o_document_portal .badge.bg-success {
                    background: linear-gradient(135deg, rgba(34, 197, 94, 0.9), rgba(22, 163, 74, 0.9)) !important;
                    color: white;
                }
                
                /* Modern file upload styling */
                .o_document_portal .file-upload-wrapper {
                    position: relative;
                    border: 2px dashed #d1d5db;
                    border-radius: 16px;
                    padding: 48px 24px;
                    text-align: center;
                    background: rgba(248, 250, 252, 0.7);
                    backdrop-filter: blur(10px);
                    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
                    cursor: pointer;
                    overflow: hidden;
                }
                
                .o_document_portal .file-upload-wrapper:hover,
                .o_document_portal .file-upload-wrapper.dragover {
                    border-color: #4f46e5;
                    background: rgba(238, 242, 255, 0.8);
                    transform: scale(1.02);
                }
                
                .o_document_portal .file-upload-wrapper.has-file {
                    border-color: #10b981;
                    background: rgba(240, 253, 244, 0.8);
                }
                
                .o_document_portal .file-upload-input {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    opacity: 0;
                    cursor: pointer;
                    z-index: 10;
                }
                
                .o_document_portal .upload-content {
                    pointer-events: none;
                }
                
                .o_document_portal .upload-content .fa-file-pdf {
                    color: #4f46e5;
                    font-size: 3rem;
                    margin-bottom: 16px;
                    transition: all 0.3s ease;
                }
                
                .o_document_portal .file-upload-wrapper:hover .fa-file-pdf {
                    color: #7c3aed;
                    transform: scale(1.1);
                }
                
                .o_document_portal .upload-text {
                    font-size: 16px;
                    font-weight: 500;
                    color: #374151;
                    margin-bottom: 8px;
                    line-height: 1.5;
                }
                
                .o_document_portal .uploaded-file {
                    display: none;
                    background: linear-gradient(135deg, rgba(240, 253, 244, 0.9), rgba(220, 252, 231, 0.9));
                    border: 1px solid rgba(34, 197, 94, 0.3);
                    border-radius: 12px;
                    padding: 16px;
                    margin-top: 16px;
                    font-weight: 500;
                    color: #166534;
                    animation: fadeSlideIn 0.5s cubic-bezier(0.25, 1, 0.5, 1);
                    align-items: center;
                    backdrop-filter: blur(10px);
                }
                
                .o_document_portal .uploaded-file .fa-check-circle {
                    color: #16a34a;
                    margin-right: 12px;
                    font-size: 1.2em;
                }
                
                /* Status indicators with modern styling */
                .status-indicator {
                    display: inline-flex;
                    align-items: center;
                    padding: 12px 16px;
                    border-radius: 12px;
                    font-size: 0.9rem;
                    font-weight: 500;
                    margin-bottom: 16px;
                    backdrop-filter: blur(10px);
                    -webkit-backdrop-filter: blur(10px);
                    border: 1px solid rgba(255,255,255,0.2);
                }
                
                .status-indicator i {
                    margin-right: 8px;
                }
                
                .status-rejected {
                    background: linear-gradient(135deg, rgba(254, 226, 226, 0.9), rgba(252, 165, 165, 0.9));
                    color: #b91c1c;
                }
                
                .status-missing {
                    background: linear-gradient(135deg, rgba(219, 234, 254, 0.9), rgba(191, 219, 254, 0.9));
                    color: #1e40af;
                }
                
                .status-expired {
                    background: linear-gradient(135deg, rgba(254, 226, 226, 0.9), rgba(252, 165, 165, 0.9));
                    color: #b91c1c;
                }
                
                .status-expiring {
                    background: linear-gradient(135deg, rgba(254, 243, 199, 0.9), rgba(253, 230, 138, 0.9));
                    color: #92400e;
                }
                
                .uploaded-indicator {
                    background: linear-gradient(135deg, rgba(220, 252, 231, 0.9), rgba(187, 247, 208, 0.9));
                    color: #166534;
                    animation: fadeInScale 0.5s ease-out;
                }
                
                /* Alert styling with glass morphism */
                .o_document_portal .alert {
                    background: rgba(255,255,255,0.95);
                    backdrop-filter: blur(20px);
                    -webkit-backdrop-filter: blur(20px);
                    border-radius: 16px;
                    font-size: 0.975rem;
                    border: 1px solid rgba(255,255,255,0.2);
                    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
                    padding: 24px;
                }
                
                .o_document_portal .alert-info {
                    border-left: 4px solid #3b82f6;
                }
                
                .o_document_portal .alert-success {
                    border-left: 4px solid #22c55e;
                }
                
                /* Button styling */
                .o_document_portal .btn {
                    border-radius: 12px;
                    font-weight: 600;
                    padding: 12px 24px;
                    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
                    border: none;
                }
                
                .o_document_portal .btn-primary {
                    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
                    color: white;
                    box-shadow: 0 4px 16px rgba(79, 70, 229, 0.3);
                }
                
                .o_document_portal .btn-primary:hover,
                .o_document_portal .btn-primary:focus {
                    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
                    box-shadow: 0 8px 24px rgba(79, 70, 229, 0.4);
                    transform: translateY(-2px);
                }
                
                .o_document_portal .btn-outline-secondary {
                    border: 1.5px solid rgba(79, 70, 229, 0.3);
                    color: #4f46e5;
                    background: rgba(255,255,255,0.1);
                    backdrop-filter: blur(10px);
                }
                
                .o_document_portal .btn-outline-secondary:hover {
                    background: rgba(79, 70, 229, 0.1);
                    border-color: #4f46e5;
                    transform: translateY(-1px);
                }
                
                /* Form styling */
                .o_document_portal .form-label {
                    font-weight: 500;
                    color: #475569;
                    margin-bottom: 8px;
                }
                
                .o_document_portal .form-control {
                    border: 1px solid rgba(203, 213, 225, 0.8);
                    border-radius: 10px;
                    padding: 12px 16px;
                    font-size: 0.95rem;
                    background: rgba(255,255,255,0.9);
                    backdrop-filter: blur(10px);
                    transition: all 0.2s ease;
                }
                
                .o_document_portal .form-control:focus {
                    border-color: #4f46e5;
                    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
                    background: rgba(255,255,255,1);
                }
                
                .o_document_portal .input-group-text {
                    border-radius: 10px 0 0 10px;
                    background: rgba(248, 250, 252, 0.9);
                    backdrop-filter: blur(10px);
                    border-color: rgba(203, 213, 225, 0.8);
                    color: #64748b;
                }
                
                /* Animation keyframes */
                @keyframes fadeInScale {
                    0% { transform: scale(0.9); opacity: 0; }
                    100% { transform: scale(1); opacity: 1; }
                }
                
                @keyframes fadeSlideIn {
                    0% { opacity: 0; transform: translateY(-12px); }
                    100% { opacity: 1; transform: translateY(0); }
                }
                
                /* Document uploaded state */
                .upload-card.document-uploaded {
                    border-left: 4px solid #16a34a !important;
                    box-shadow: 0 8px 32px rgba(22, 163, 74, 0.15) !important;
                }
                
                /* Success/Error animations */
                .success-animation i {
                    font-size: 4rem;
                    animation: pulseSuccess 1.5s infinite alternate;
                }
                
                @keyframes pulseSuccess {
                    0% { transform: scale(1); }
                    100% { transform: scale(1.05); }
                }
                
                /* Mobile responsiveness */
                @media (max-width: 991px) {
                    .main-container {
                        padding: 0 16px;
                        margin: 20px auto;
                    }
                    
                    .header-card {
                        padding: 24px;
                        margin-bottom: 24px;
                    }
                    
                    .o_document_portal .card-body {
                        padding: 24px;
                    }
                    
                    .o_document_portal .file-upload-wrapper {
                        padding: 32px 16px;
                    }
                    
                    .company-logo {
                        width: 60px;
                        height: 60px;
                        font-size: 24px;
                    }
                    
                    .header-title {
                        font-size: 24px;
                    }
                }
                
                /* Fix for Odoo framework interference */
                .o_main_navbar, .o_main, .o_web_client {
                    display: none !important;
                }
                
                .o_frontend_layout_container {
                    padding: 0 !important;
                }
            </style>
            
            <div class="o_document_portal d-flex flex-column min-vh-100">
                <div class="main-container">
                    <!-- Modern header -->
                    <div class="header-card">
                        <div class="company-logo">
                            <i class="fa fa-building"></i>
                        </div>
                        <h1 class="header-title">Documents administratifs</h1>
                        <p class="header-subtitle">Téléversez vos documents obligatoires pour <strong><t t-esc="partner.name"/></strong></p>
                    </div>

                    <!-- Success message with enhanced design -->
                    <div t-if="uploaded_docs" class="alert alert-success mb-4">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <i class="fa fa-check-circle fa-2x text-success"></i>
                            </div>
                            <div>
                                <h5 class="mb-1 fw-bold">Documents envoyés avec succès</h5>
                                <p class="mb-1">Les documents suivants ont été téléchargés avec succès:</p>
                                <ul class="mb-0 ps-3">
                                    <t t-foreach="uploaded_docs" t-as="doc">
                                        <li><t t-esc="document_types.get(doc, doc)"/></li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Required Documents Guide -->
                    <div class="alert alert-info mb-4">
                        <div class="d-flex align-items-start">
                            <div class="me-3 pt-1">
                                <i class="fa fa-info-circle fa-lg"></i>
                            </div>
                            <div>
                                <h5 class="mb-2 fw-bold">Guide des documents</h5>
                                <p class="mb-1">Documents <span class="badge bg-primary">Requis</span> : Ces documents doivent être fournis en priorité</p>
                                <p class="mb-0">Documents expirés ou rejetés doivent être renouvelés rapidement</p>
                            </div>
                        </div>
                    </div>

                    <!-- Main form -->
                    <form method="post" enctype="multipart/form-data" id="documentUploadForm" autocomplete="off"
                          class="document-upload-form mb-5" t-att-data-partner-name="partner.name">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <!-- Document categories -->
                        <div class="row g-4">
                            <t t-foreach="document_types.items()" t-as="doc">
                                <div class="col-lg-6">
                                    <div t-att-class="'card upload-card h-100' + 
                                        (doc_expired.get(doc[0]) and ' border-danger' or 
                                        (doc_expiring.get(doc[0]) and ' border-warning' or '')) +
                                        (uploaded_docs and doc[0] in uploaded_docs and ' document-uploaded' or '')">

                                        <!-- Card header -->
                                        <div class="card-header">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h5 class="mb-0 fw-bold">
                                                    <i class="fa fa-file-alt me-2 text-primary"></i>
                                                    <t t-esc="doc[1]"/>
                                                    <t t-if="critical_documents.get(doc[0], False)">
                                                        <span class="badge bg-primary ms-2">Requis</span>
                                                    </t>
                                                </h5>
                                                <div>
                                                    <t t-if="doc_expired.get(doc[0])">
                                                        <span class="badge bg-danger">
                                                            <i class="fa fa-exclamation-triangle me-1"></i>Expiré
                                                        </span>
                                                    </t>
                                                    <t t-elif="doc_expiring.get(doc[0])">
                                                        <span class="badge bg-warning">
                                                            <i class="fa fa-clock me-1"></i>Expire bientôt
                                                        </span>
                                                    </t>
                                                    <t t-if="uploaded_docs and doc[0] in uploaded_docs">
                                                        <span class="badge bg-success ms-2">
                                                            <i class="fa fa-check me-1"></i>Envoyé
                                                        </span>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Card body -->
                                        <div class="card-body">
                                            <!-- Document status indicators -->
                                            <div t-if="doc_expired.get(doc[0])" class="status-indicator status-expired">
                                                <i class="fa fa-exclamation-triangle"></i>
                                                <t t-if="doc_expiry_dates.get(doc[0])">
                                                    Document expiré le <t t-esc="doc_expiry_dates.get(doc[0])"/>
                                                </t>
                                                <t t-else="">Document expiré</t>
                                            </div>

                                            <div t-elif="doc_expiring.get(doc[0])" class="status-indicator status-expiring">
                                                <i class="fa fa-clock"></i>
                                                <span>Expire dans <t t-esc="doc_days_to_expiry.get(doc[0], 0)"/> jours</span>
                                            </div>

                                            <div t-if="uploaded_docs and doc[0] in uploaded_docs" class="status-indicator uploaded-indicator">
                                                <i class="fa fa-check-circle"></i>
                                                <span>Document envoyé avec succès</span>
                                            </div>

                                            <!-- File upload area -->
                                            <div class="mb-3">
                                                <div class="file-upload-wrapper" t-att-id="'dropzone-%s' % doc[0]" t-att-data-doctype="doc[0]">
                                                    <input type="file" t-att-name="'document_%s' % doc[0]"
                                                           t-att-id="'document_%s' % doc[0]"
                                                           class="file-upload-input"
                                                           t-att-required="critical_documents.get(doc[0], False)"
                                                           accept="application/pdf"/>
                                                    <div class="upload-content">
                                                        <i class="fa fa-file-pdf"></i>
                                                        <div class="upload-text">
                                                            Glissez votre fichier PDF ici<br/>ou cliquez pour parcourir
                                                        </div>
                                                    </div>
                                                </div>
                                                <div t-att-id="'uploaded-file-%s' % doc[0]" class="uploaded-file">
                                                    <i class="fa fa-check-circle"></i>
                                                    <span class="filename"></span>
                                                </div>
                                                <div t-if="error.get(doc[0])" class="text-danger mt-2 small">
                                                    <i class="fa fa-exclamation-triangle me-1"></i>
                                                    <t t-esc="error.get(doc[0])"/>
                                                </div>
                                            </div>

                                            <!-- Expiry date fields -->
                                            <t t-if="doc[0] not in ['urssaf', 'kbis', 'rib']">
                                                <div class="mb-3">
                                                    <label t-att-for="'expiry_%s' % doc[0]" class="form-label">
                                                        <i class="fa fa-calendar-alt me-2"></i>Date d'expiration
                                                        <t t-if="critical_documents.get(doc[0], False)">
                                                            <span class="text-danger">*</span>
                                                        </t>
                                                    </label>
                                                    <div class="input-group">
                                                        <span class="input-group-text">
                                                            <i class="fa fa-calendar"></i>
                                                        </span>
                                                        <input type="date" t-att-name="'expiry_%s' % doc[0]"
                                                               class="form-control"
                                                               t-att-id="'expiry_%s' % doc[0]"
                                                               t-att-required="critical_documents.get(doc[0], False)"
                                                               t-att-min="today.strftime('%Y-%m-%d')"/>
                                                    </div>
                                                </div>
                                            </t>

                                            <!-- Auto-calculated expiry for URSSAF and KBIS -->
                                            <t t-if="doc[0] in ['urssaf', 'kbis']">
                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        <i class="fa fa-calendar-alt me-2"></i>Date d'expiration
                                                    </label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-primary text-white">
                                                            <i class="fa fa-robot"></i>
                                                        </span>
                                                        <input type="text" class="form-control" disabled="disabled"
                                                               value="Calculée automatiquement (3 mois)"/>
                                                    </div>
                                                    <div class="form-text mt-1 small">
                                                        <i class="fa fa-info-circle me-1"></i>
                                                        Expiration fixée automatiquement à 3 mois après l'envoi
                                                    </div>
                                                </div>
                                            </t>

                                            <!-- No expiry for RIB -->
                                            <t t-if="doc[0] == 'rib'">
                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        <i class="fa fa-calendar-alt me-2"></i>Date d'expiration
                                                    </label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-success text-white">
                                                            <i class="fa fa-infinity"></i>
                                                        </span>
                                                        <input type="text" class="form-control" disabled="disabled"
                                                               value="Document permanent - Pas d'expiration"/>
                                                    </div>
                                                    <div class="form-text mt-1 small">
                                                        <i class="fa fa-check-circle me-1"></i>
                                                        Ce document n'expire pas
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Submit section -->
                        <div class="text-center mt-5">
                            <div class="upload-card" style="background: rgba(255,255,255,0.95); backdrop-filter: blur(20px); border-radius: 16px; padding: 40px; text-align: center;">
                                <button type="submit" id="submitBtn" class="btn btn-primary btn-lg px-5 py-3">
                                    <i class="fa fa-cloud-upload-alt me-2"></i>Envoyer les documents
                                </button>
                                <div class="mt-3 small text-muted">
                                    <i class="fa fa-shield-alt me-1"></i>
                                    Transmission sécurisée - Vos documents seront vérifiés sous 24-48h
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Enhanced JavaScript -->
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                    const form = document.getElementById('documentUploadForm');
                    if (form) {
                        form.classList.add('js-applied');

                        // Enhanced form submission
                        form.addEventListener('submit', function(e) {
                            const submitBtn = document.getElementById('submitBtn');
                            if (submitBtn) {
                                const spinnerIcon = document.createElement('i');
                                spinnerIcon.className = 'fa fa-spinner fa-spin me-2';
                                
                                submitBtn.textContent = '';
                                submitBtn.appendChild(spinnerIcon);
                                submitBtn.appendChild(document.createTextNode('Traitement en cours...'));
                                submitBtn.disabled = true;
                            }
                            return true;
                        });

                        // Enhanced file upload interaction
                        document.querySelectorAll('.file-upload-wrapper').forEach(dropzone => {
                            const input = dropzone.querySelector('.file-upload-input');
                            const docType = dropzone.getAttribute('data-doctype');
                            const uploadedFileEl = document.getElementById('uploaded-file-' + docType);
                            const filenameEl = uploadedFileEl ? uploadedFileEl.querySelector('.filename') : null;

                            // Drag & drop events with smooth animations
                            ['dragover', 'dragenter'].forEach(eventName => {
                                dropzone.addEventListener(eventName, e => {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    dropzone.classList.add('dragover');
                                });
                            });

                            ['dragleave', 'dragend', 'drop'].forEach(eventName => {
                                dropzone.addEventListener(eventName, e => {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    dropzone.classList.remove('dragover');
                                });
                            });

                            // File selection with enhanced feedback
                            input.addEventListener('change', e => {
                                if (input.files && input.files[0]) {
                                    const file = input.files[0];
                                    if (filenameEl) {
                                        filenameEl.textContent = file.name;
                                        uploadedFileEl.style.display = 'flex';
                                    }

                                    // Enhanced card animation
                                    const card = dropzone.closest('.upload-card');
                                    if (card) {
                                        card.classList.add('document-uploaded');
                                        setTimeout(() => {
                                            card.classList.remove('document-uploaded');
                                        }, 3000);
                                    }
                                }
                            });
                        });
                    }
                });
            </script>
        </t>
    </template>
</odoo>