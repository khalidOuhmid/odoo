<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main upload form with modern, professional design -->
    <template id="document_upload_form" name="Upload Documents">
        <t t-call="web.frontend_layout">
            <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:400,500,600,700&amp;display=swap"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
            <t t-set="title">Documents administratifs - BLG Groupe</t>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <style>
                body, .o_document_portal {
                    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
                    background: linear-gradient(135deg, #f8fafc 0%, #e9f0fa 100%);
                    min-height: 100vh;
                    color: #334155;
                }
                .o_document_portal .section-title {
                    font-size: 1.75rem;
                    font-weight: 700;
                    color: #1e40af;
                    margin-bottom: 1.25rem;
                    letter-spacing: -0.01em;
                }
                .o_document_portal .upload-card {
                    border-radius: 16px;
                    box-shadow: 0 4px 20px rgba(15,23,42,0.08);
                    border: 1px solid rgba(226,232,240,0.8);
                    background: #fff;
                    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
                }
                .o_document_portal .upload-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 12px 28px rgba(15,23,42,0.12);
                }
                .o_document_portal .card-header {
                    background: rgba(248,250,252,0.7);
                    border-bottom: 1px solid rgba(226,232,240,0.7);
                    border-radius: 16px 16px 0 0;
                    padding: 1rem 1.25rem;
                }
                .o_document_portal .badge {
                    padding: 0.35em 0.65em;
                    font-weight: 500;
                    font-size: 0.75em;
                    border-radius: 6px;
                }
                .o_document_portal .file-upload-wrapper {
                    position: relative;
                    border: 2px dashed #cbd5e1;
                    border-radius: 12px;
                    padding: 2rem 1.5rem;
                    text-align: center;
                    background: #f8fafc;
                    transition: all 0.2s ease;
                    cursor: pointer;
                }
                .o_document_portal .file-upload-wrapper:hover {
                    background: #f1f5f9;
                    border-color: #94a3b8;
                }
                .o_document_portal .btn-primary {
                    background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
                    border: none;
                    box-shadow: 0 2px 8px rgba(30, 64, 175, 0.25);
                    border-radius: 10px;
                    font-weight: 500;
                    padding: 0.65rem 1.25rem;
                }
                .o_document_portal .alert {
                    border-radius: 12px;
                    font-size: 0.975rem;
                    border: none;
                    box-shadow: 0 2px 10px rgba(15,23,42,0.08);
                }
                .o_document_portal .custom-header {
                    padding: 1.25rem 0;
                    background: rgba(255, 255, 255, 0.7);
                    backdrop-filter: blur(10px);
                    border-bottom: 1px solid rgba(226,232,240,0.8);
                }
                .o_document_portal .brand-logo {
                    height: 42px;
                }
                .o_document_portal .brand-text {
                    font-size: 1.5rem;
                    font-weight: 700;
                    color: #1e40af;
                    margin-left: 0.75rem;
                    letter-spacing: -0.01em;
                }
            </style>
            
            <div class="o_document_portal d-flex flex-column min-vh-100">
                <!-- Custom header -->
                <div class="custom-header py-3">
                    <div class="container d-flex align-items-center">
                        <img t-att-src="'/blg_contacts_extension/static/src/img/icon.png'"
                             alt="Logo"
                             class="brand-logo"
                             onerror="this.onerror=null; this.src='/web/static/img/logo.png'"/>
                        <span class="brand-text">BLG Groupe</span>
                    </div>
                </div>

                <!-- Main content area -->
                <div class="container flex-grow-1 py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            <div class="text-center mb-4">
                                <div class="section-title">Documents administratifs à fournir</div>
                                <p class="text-muted mb-0">Téléversez vos documents obligatoires ci-dessous</p>
                            </div>

                            <!-- Success message -->
                            <div t-if="uploaded_docs" class="alert alert-success mb-4">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        <i class="fa fa-check-circle fa-2x"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 fw-bold">Documents envoyés avec succès</h5>
                                        <p class="mb-1">Les documents suivants ont été téléchargés avec succès:</p>
                                        <ul class="mb-0 ps-3">
                                            <t t-foreach="uploaded_docs" t-as="doc">
                                                <li><t t-esc="document_types.get(doc, doc)"/></li>
                                            </t>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Error messages -->
                            <div t-if="error" class="alert alert-danger mb-4">
                                <strong>Des erreurs ont été détectées:</strong>
                                <ul class="mb-0 mt-2">
                                    <t t-foreach="error" t-as="error_code">
                                        <li><t t-esc="error[error_code]"/></li>
                                    </t>
                                </ul>
                            </div>

                            <!-- Instructions -->
                            <div class="alert alert-info mb-4">
                                <div class="d-flex align-items-start">
                                    <div class="me-3 pt-1">
                                        <i class="fa fa-info-circle fa-lg"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-2 fw-bold">Guide des documents</h5>
                                        <p class="mb-1">Documents <span class="badge bg-primary">Requis</span> : Ces documents doivent être fournis en priorité</p>
                                        <p class="mb-0">Formats acceptés: <t t-foreach="allowed_extensions" t-as="ext"><t t-esc="ext"/> </t> (max <t t-esc="max_file_size_mb"/> MB)</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Main form -->
                            <form method="post" enctype="multipart/form-data" id="documentUploadForm" autocomplete="off">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <!-- Document cards -->
                                <div class="row g-4">
                                    <t t-foreach="document_types.items()" t-as="doc">
                                        <div class="col-lg-6">
                                            <div t-att-class="'card upload-card h-100' + 
                                                (doc_expired.get(doc[0]) and ' border-danger' or 
                                                (doc_expiring.get(doc[0]) and ' border-warning' or ''))">

                                                <!-- Card header -->
                                                <div class="card-header">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <h5 class="mb-0 fw-bold">
                                                            <t t-esc="doc[1]"/>
                                                            <t t-if="critical_documents.get(doc[0], False)">
                                                                <span class="badge bg-primary ms-2">Requis</span>
                                                            </t>
                                                        </h5>
                                                        <div>
                                                            <t t-if="doc_expired.get(doc[0])">
                                                                <span class="badge bg-danger">
                                                                    <i class="fa fa-exclamation-triangle me-1"></i>Expiré
                                                                </span>
                                                            </t>
                                                            <t t-elif="doc_expiring.get(doc[0])">
                                                                <span class="badge bg-warning">
                                                                    <i class="fa fa-clock me-1"></i>Expire bientôt
                                                                </span>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Card body -->
                                                <div class="card-body p-4">
                                                    <!-- File upload area -->
                                                    <div class="mb-3">
                                                        <div class="file-upload-wrapper">
                                                            <input type="file" t-attf-name="document_#{doc[0]}" 
                                                                   t-attf-id="document_#{doc[0]}"
                                                                   class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                                                                   t-att-required="critical_documents.get(doc[0], False)"
                                                                   accept="application/pdf,.pdf,.jpg,.png" />
                                                            <div>
                                                                <i class="fa fa-file-pdf text-primary fa-2x mb-2"></i>
                                                                <div class="text-muted">
                                                                    Glissez votre fichier PDF ici<br/>ou cliquez pour parcourir
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div t-if="error.get(doc[0])" class="text-danger mt-2 small">
                                                            <i class="fa fa-exclamation-triangle me-1"></i>
                                                            <t t-esc="error.get(doc[0])"/>
                                                        </div>
                                                    </div>

                                                    <!-- Expiry date field -->
                                                    <t t-if="doc_has_expiry.get(doc[0], True) and doc[0] not in ['urssaf', 'kbis', 'rib']">
                                                        <div class="mb-3">
                                                            <label t-attf-for="expiry_#{doc[0]}" class="form-label">
                                                                Date d'expiration
                                                                <t t-if="doc_expired.get(doc[0])">
                                                                    <span class="text-danger">*</span>
                                                                </t>
                                                            </label>
                                                            <div class="input-group">
                                                                <span class="input-group-text">
                                                                    <i class="fa fa-calendar"></i>
                                                                </span>
                                                                <input type="date" t-attf-name="expiry_#{doc[0]}"
                                                                       class="form-control"
                                                                       t-attf-id="expiry_#{doc[0]}"
                                                                       t-att-required="doc_expired.get(doc[0], False) or critical_documents.get(doc[0], False) and doc_has_expiry.get(doc[0], True)"
                                                                       t-att-min="today.strftime('%Y-%m-%d')"/>
                                                            </div>
                                                        </div>
                                                    </t>

                                                    <!-- Auto-calculated expiry info -->
                                                    <t t-if="doc[0] in ['urssaf', 'kbis']">
                                                        <div class="mb-3">
                                                            <label class="form-label">Date d'expiration</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text bg-primary text-white">
                                                                    <i class="fa fa-info-circle"></i>
                                                                </span>
                                                                <input type="text" class="form-control" disabled="disabled"
                                                                       value="Automatiquement calculée (3 mois)"/>
                                                            </div>
                                                        </div>
                                                    </t>

                                                    <!-- No expiry info -->
                                                    <t t-if="doc[0] == 'rib' or (not doc_has_expiry.get(doc[0], True))">
                                                        <div class="mb-3">
                                                            <label class="form-label">Date d'expiration</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text bg-info text-white">
                                                                    <i class="fa fa-infinity"></i>
                                                                </span>
                                                                <input type="text" class="form-control" disabled="disabled"
                                                                       value="Document sans date d'expiration"/>
                                                            </div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>

                                <!-- Submit button -->
                                <div class="text-center mt-5">
                                    <button type="submit" class="btn btn-primary btn-lg px-4 py-2">
                                        <i class="fa fa-upload me-2"></i>Envoyer les documents
                                    </button>
                                    <div class="mt-2 small text-muted">
                                        <i class="fa fa-shield-alt me-1"></i>Transmission sécurisée
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Success page -->
    <template id="document_upload_success" name="Upload Success">
        <t t-call="web.frontend_layout">
            <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:400,600,700&amp;display=swap"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
            <t t-set="title">Documents envoyés - BLG Groupe</t>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="o_document_portal d-flex flex-column min-vh-100">
                <div class="container flex-grow-1 py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6 text-center">
                            <div class="card border-0 shadow p-5">
                                <div class="mb-4">
                                    <i class="fa fa-check-circle text-success" style="font-size: 4rem;"></i>
                                </div>
                                <h2 class="mb-3">Documents envoyés avec succès</h2>
                                <p class="text-muted mb-4">
                                    Vos documents ont bien été reçus et seront vérifiés prochainement par notre équipe administrative.
                                </p>
                                
                                <div class="mt-4">
                                    <h5>Documents téléversés (<t t-esc="total_uploaded"/>):</h5>
                                    <ul class="list-group">
                                        <t t-foreach="uploaded_docs" t-as="doc_code">
                                            <li class="list-group-item">
                                                <i class="fa fa-file me-2"></i>
                                                <t t-esc="uploaded_docs[doc_code]"/>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                                
                                <div class="text-center mt-4">
                                    <button onclick="window.close();" class="btn btn-outline-secondary px-4">
                                        <i class="fa fa-times me-2"></i>Fermer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Error page -->
    <template id="document_upload_error" name="Upload Error">
        <t t-call="web.frontend_layout">
            <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:400,600,700&amp;display=swap"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
            <t t-set="title">Erreur - BLG Groupe</t>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="o_document_portal d-flex flex-column min-vh-100">
                <div class="container flex-grow-1 py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6 text-center">
                            <div class="card border-danger">
                                <div class="card-header bg-danger text-white">
                                    <h3 class="mb-0"><i class="fa fa-exclamation-triangle me-2"></i>Erreur</h3>
                                </div>
                                <div class="card-body">
                                    <div class="text-center mb-4">
                                        <i class="fa fa-times-circle text-danger" style="font-size: 4rem;"></i>
                                    </div>
                                    <h4 class="text-center text-danger">Une erreur est survenue</h4>
                                    <p class="text-center mb-4"><t t-esc="error"/></p>
                                    <div class="text-center">
                                        <a href="/" class="btn btn-primary">Retour à l'accueil</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- No documents needed template -->
    <template id="document_upload_no_documents" name="No Documents Required">
        <t t-call="web.frontend_layout">
            <t t-set="title">Aucun document requis - BLG Groupe</t>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6 text-center">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h3 class="mb-0"><i class="fa fa-check-circle me-2"></i>Tout est en ordre</h3>
                            </div>
                            <div class="card-body">
                                <div class="text-center mb-4">
                                    <i class="fa fa-check-circle text-success" style="font-size: 4rem;"></i>
                                </div>
                                <h4 class="text-center text-success">Bonjour <t t-esc="partner.name"/></h4>
                                <p class="text-center">Aucun document n'est requis pour le moment. Votre dossier est à jour.</p>
                                <div class="text-center mt-4">
                                    <button onclick="window.close();" class="btn btn-success">Fermer</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
