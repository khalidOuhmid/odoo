<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue principale du wizard de sélection de produits - Interface moderne -->
    <record id="view_product_selection_wizard_form" model="ir.ui.view">
        <field name="name">blg.product.selection.wizard.form</field>
        <field name="model">blg.product.selection.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Navigation multi-lots -->
                    <div class="lot-navigation" invisible="not chantier_lot_ids">
                        <button name="action_previous_lot" string="‹ Lot précédent" 
                                type="object" class="btn-secondary"
                                invisible="not has_previous_lot"/>
                        <span class="lot-progress badge bg-info">
                            <field name="lot_progress" readonly="1"/>
                        </span>
                        <button name="action_next_lot" string="Lot suivant ›" 
                                type="object" class="btn-secondary"
                                invisible="not has_next_lot"/>
                    </div>
                    
                    <!-- Champs cachés pour la navigation -->
                    <field name="chantier_lot_ids" invisible="1"/>
                    <field name="current_lot_index" invisible="1"/>
                    <field name="has_next_lot" invisible="1"/>
                    <field name="has_previous_lot" invisible="1"/>
                    
                    <button name="action_confirm_selection" string="✓ Confirmer la sélection" 
                            type="object" class="btn-primary" 
                            invisible="selection_count == 0"/>
                    <button name="action_clear_selection" string="🗑 Vider la sélection" 
                            type="object" class="btn-secondary"
                            confirm="Êtes-vous sûr de vouloir vider toute la sélection ?"
                            invisible="selection_count == 0"/>
                    <button name="action_import_products_from_template" string="📋 Importer du modèle" 
                            type="object" class="btn-secondary"
                            help="Importer les produits prédéfinis pour ce type de lot"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </header>

                <sheet>
                    <!-- En-tête avec informations du lot -->
                    <div class="oe_title mb-3">
                        <h1>
                            <field name="lot_id" readonly="1" class="oe_inline"/>
                            <field name="lot_type_id" invisible="1"/>
                        </h1>
                        <h3 class="text-muted">
                            Sélection de produits pour le devis 
                            <field name="order_id" readonly="1" class="oe_inline"/>
                        </h3>
                    </div>

                    <!-- Panneau de recherche et filtres -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="card-title mb-0">🔍 Recherche et filtres</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <field name="search_term" placeholder="Rechercher par nom, référence..."
                                           class="form-control"/>
                                </div>
                                <div class="col-md-3">
                                    <field name="category_filter" placeholder="Filtrer par catégorie"
                                           domain="[('parent_id', '!=', False)]"/>
                                </div>
                                <div class="col-md-2">
                                    <field name="price_min" placeholder="Prix min"/>
                                </div>
                                <div class="col-md-2">
                                    <field name="price_max" placeholder="Prix max"/>
                                </div>
                                <div class="col-md-1">
                                    <button name="action_search_products" string="🔍" type="object" 
                                            class="btn btn-primary" title="Rechercher"/>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-3">
                                    <field name="sort_by"/>
                                </div>
                                <div class="col-md-3">
                                    <field name="view_mode" widget="radio" options="{'horizontal': true}"/>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <field name="show_lot_specific_products" string="Produits recommandés"/>
                                            <field name="show_all_products" string="Tous les produits"/>
                                            <field name="show_stock" string="Afficher stock"/>
                                        </div>
                                        <div>
                                            <button name="action_clear_filters" string="🗑 Effacer filtres" 
                                                    type="object" class="btn btn-secondary btn-sm"/>
                                            <button name="action_create_quick_product" string="➕ Nouveau produit" 
                                                    type="object" class="btn btn-success btn-sm"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Résumé de la sélection -->
                    <div class="alert alert-info mb-3" invisible="selection_count == 0">
                        <div class="row">
                            <div class="col-md-3">
                                <strong>Articles sélectionnés :</strong> <field name="selection_count" readonly="1"/>
                            </div>
                            <div class="col-md-3">
                                <strong>Quantité totale :</strong> <field name="total_quantity" readonly="1"/>
                            </div>
                            <div class="col-md-3">
                                <strong>Total sélection :</strong> <field name="total_selection" readonly="1" widget="monetary"/>
                            </div>
                            <div class="col-md-3">
                                <field name="currency_id" invisible="1"/>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <!-- Onglet Catalogue de produits -->
                        <page string="📦 Catalogue" name="catalog">
                            <!-- Pagination et statistiques -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="badge bg-info">
                                        <field name="total_products" readonly="1"/> produits trouvés
                                    </span>
                                    <span class="text-muted ms-2">
                                        Page <field name="current_page" readonly="1"/> / <field name="total_pages" readonly="1"/>
                                    </span>
                                </div>
                                <div>
                                    <field name="page_size" class="form-control d-inline" style="width: 80px;"/>
                                    <span class="ms-1">par page</span>
                                </div>
                            </div>

                            <!-- Navigation pagination -->
                            <div class="d-flex justify-content-center mb-3" invisible="total_pages &lt;= 1">
                                <div class="btn-group">
                                    <button name="action_prev_page" string="‹ Précédent" type="object" 
                                            class="btn btn-outline-secondary" 
                                            invisible="current_page &lt;= 1"/>
                                    <span class="btn btn-outline-info">
                                        <field name="current_page" readonly="1"/> / <field name="total_pages" readonly="1"/>
                                    </span>
                                    <button name="action_next_page" string="Suivant ›" type="object" 
                                            class="btn btn-outline-secondary"
                                            invisible="current_page >= total_pages"/>
                                </div>
                            </div>

                            <!-- FIXED: Remove problematic kanban view with buttons -->
                            <!-- Affichage des produits avec widget list simple -->
                            <field name="filtered_product_ids" nolabel="1" readonly="1">
                                <list create="false" edit="false" delete="false" decoration-info="True">
                                    <field name="display_name" string="Produit"/>
                                    <field name="default_code" string="Référence"/>
                                    <field name="categ_id" string="Catégorie"/>
                                    <field name="list_price" string="Prix" widget="monetary"/>
                                    <field name="qty_available" string="Stock" column_invisible="not context.get('show_stock', False)"/>
                                    <field name="id" invisible="1"/>
                                </list>
                            </field>

                            <!-- Add selection buttons outside the list -->
                            <div class="mt-3" invisible="total_products == 0">
                                <div class="alert alert-info">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <p class="mb-0">
                                                <i class="fa fa-info-circle me-2"/>
                                                Pour ajouter des produits à votre sélection, utilisez les boutons ci-dessous :
                                            </p>
                                        </div>
                                        <div class="col-md-4 text-end">
                                            <div class="btn-group">
                                                <button name="action_add_all_visible" string="➕ Ajouter tous les produits visibles" 
                                                        type="object" class="btn btn-primary btn-sm"
                                                        title="Ajouter tous les produits de cette page"/>
                                                <button name="action_create_quick_product" string="🆕 Nouveau produit" 
                                                        type="object" class="btn btn-success btn-sm"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Message si aucun produit -->
                            <div class="alert alert-warning" invisible="total_products > 0">
                                <h5>🔍 Aucun produit trouvé</h5>
                                <p class="mb-3">Essayez de modifier vos critères de recherche ou créez un nouveau produit.</p>
                                <button name="action_create_quick_product" string="🆕 Créer un nouveau produit" 
                                        type="object" class="btn btn-success"/>
                            </div>
                        </page>

                        <!-- Onglet Sélection actuelle -->
                        <page string="🛒 Ma sélection" name="selection">
                            <!-- Description personnalisée pour la sélection -->
                            <div class="mb-3">
                                <field name="custom_description" placeholder="Ajoutez des notes spécifiques pour cette sélection de produits..."/>
                            </div>

                            <!-- Liste des produits sélectionnés -->
                            <field name="selection_line_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="product_code" readonly="1"/>
                                    <field name="product_category" readonly="1"/>
                                    <field name="quantity" sum="Total Quantité"/>
                                    <field name="room_type"/>
                                    <field name="room_number"/>
                                    <field name="floor_level"/>
                                    <field name="unit_price" readonly="1" widget="monetary"/>
                                    <field name="subtotal" readonly="1" widget="monetary" sum="Total"/>
                                    <field name="description"/>
                                    <button name="action_edit_line" string="✏" type="object" 
                                            title="Éditer en détail" class="btn btn-link"/>
                                    <button name="action_duplicate_line" string="📋" type="object" 
                                            title="Dupliquer" class="btn btn-link"/>
                                    <button name="action_remove_line" string="🗑" type="object" 
                                            title="Supprimer" class="btn btn-link text-danger"
                                            confirm="Supprimer cette ligne ?"/>
                                </list>
                            </field>

                            <!-- Récapitulatif de la sélection -->
                            <div class="row mt-3" invisible="selection_count == 0">
                                <div class="col-md-12">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-3">
                                                    <h6>📦 Articles</h6>
                                                    <span class="h4 text-primary"><field name="selection_count" readonly="1"/></span>
                                                </div>
                                                <div class="col-md-3">
                                                    <h6>📊 Quantité</h6>
                                                    <span class="h4 text-info"><field name="total_quantity" readonly="1"/></span>
                                                </div>
                                                <div class="col-md-3">
                                                    <h6>💰 Total HT</h6>
                                                    <span class="h4 text-success">
                                                        <field name="total_selection" readonly="1" widget="monetary"/>
                                                    </span>
                                                </div>
                                                <div class="col-md-3">
                                                    <h6>🏷 Lot</h6>
                                                    <span class="h6"><field name="lot_id" readonly="1"/></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Message si sélection vide -->
                            <div class="alert alert-info" invisible="selection_count > 0">
                                <h5>🛒 Sélection vide</h5>
                                <p>Parcourez le catalogue pour ajouter des produits à votre sélection.</p>
                                <p class="mb-0">
                                    <strong>Conseil :</strong> Utilisez le bouton "➕ Ajouter tous les produits visibles" 
                                    dans l'onglet Catalogue pour sélectionner rapidement plusieurs produits.
                                </p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue formulaire détaillée pour les lignes de sélection -->
    <record id="view_product_selection_line_form" model="ir.ui.view">
        <field name="name">blg.product.selection.line.form</field>
        <field name="model">blg.product.selection.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" readonly="1"/></h1>
                        <h3 class="text-muted">
                            Référence : <field name="product_code" readonly="1"/>
                        </h3>
                    </div>

                    <group>
                        <group name="product_info" string="Informations produit">
                            <field name="product_category" readonly="1"/>
                            <field name="unit_price" readonly="1" widget="monetary"/>
                            <field name="quantity" required="1"/>
                            <field name="subtotal" readonly="1" widget="monetary"/>
                        </group>
                        
                        <group name="location_info" string="Localisation">
                            <field name="room_type"/>
                            <field name="room_number"/>
                            <field name="floor_level"/>
                        </group>
                    </group>

                    <group name="descriptions" string="Descriptions">
                        <field name="description" nolabel="1" placeholder="Description personnalisée du produit..."/>
                        <field name="notes" nolabel="1" placeholder="Notes techniques ou spécifications particulières..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Enregistrer" special="save" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard -->
    <record id="action_product_selection_wizard" model="ir.actions.act_window">
        <field name="name">Sélection de produits</field>
        <field name="res_model">blg.product.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_lot_id': active_id,
            'default_order_id': context.get('order_id'),
        }</field>
    </record>
</odoo>
