  </data>
  <record id="view_new_project_form" model="ir.ui.view">
        <field name="name">new.project.form</field>
        <field name="model">new.project</field>
        <field name="arch" type="xml">
            <form string="Nouveau Projet">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_new_project_tree" model="ir.ui.view">
        <field name="name">new.project.tree</field>
        <field name="model">new.project</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Action pour ouvrir la vue -->
    <record id="action_new_project" model="ir.actions.act_window">
        <field name="name">Nouveaux Projets</field>
        <field name="res_model">new.project</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_new_project_root" name="Nouveaux Projets"/>
    <menuitem id="menu_new_project" name="Gestion des projets" parent="menu_new_project_root" action="action_new_project"/>
