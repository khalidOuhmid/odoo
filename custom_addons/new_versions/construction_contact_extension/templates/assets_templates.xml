<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Bundle pour les emails -->
        <template id="email_assets" name="Email Assets Bundle">
            <link rel="stylesheet" type="text/css" href="/construction_contact_extension/static/src/css/email_styles.css"/>
        </template>

        <!-- Assets pour les wizards -->
        <template id="wizard_assets" name="Wizard Assets Bundle">
            <link rel="stylesheet" type="text/css" href="/construction_contact_extension/static/src/css/wizard_modern.css"/>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/wizard_interactions.js"></script>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/form_validation.js"></script>
        </template>

        <!-- Assets pour les statistiques -->
        <template id="stats_assets" name="Statistics Assets Bundle">
            <link rel="stylesheet" type="text/css" href="/construction_contact_extension/static/src/css/charts.css"/>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/chart_configurations.js"></script>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/dashboard_widgets.js"></script>
        </template>

        <!-- Assets pour la validation de documents -->
        <template id="document_validation_assets" name="Document Validation Assets">
            <link rel="stylesheet" type="text/css" href="/construction_contact_extension/static/src/css/document_validation.css"/>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/document_preview.js"></script>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/validation_workflow.js"></script>
        </template>

        <!-- Assets pour les notifications -->
        <template id="notification_assets" name="Notification Assets">
            <link rel="stylesheet" type="text/css" href="/construction_contact_extension/static/src/css/notifications.css"/>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/notification_center.js"></script>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/real_time_updates.js"></script>
        </template>

        <!-- Bundle mobile spécifique -->
        <template id="mobile_assets" name="Mobile Assets Bundle">
            <link rel="stylesheet" type="text/css" href="/construction_contact_extension/static/src/css/mobile.css"/>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/mobile_optimizations.js"></script>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/touch_interactions.js"></script>
        </template>

        <!-- Assets pour l'impression -->
        <template id="print_assets" name="Print Assets Bundle">
            <link rel="stylesheet" type="text/css" href="/construction_contact_extension/static/src/css/print.css" media="print"/>
        </template>

        <!-- Fonts et icônes -->
        <template id="fonts_icons_assets" name="Fonts and Icons Assets">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
        </template>

        <!-- Variables CSS globales -->
        <template id="css_variables" name="CSS Variables">
            <style>
                :root {
                    --primary-color: #1e40af;
                    --primary-hover: #1e3a8a;
                    --success-color: #16a34a;
                    --warning-color: #eab308;
                    --danger-color: #dc2626;
                    --info-color: #0ea5e9;
                    --gray-50: #f8fafc;
                    --gray-100: #f1f5f9;
                    --gray-200: #e2e8f0;
                    --gray-300: #cbd5e1;
                    --gray-400: #94a3b8;
                    --gray-500: #64748b;
                    --gray-600: #475569;
                    --gray-700: #334155;
                    --gray-800: #1e293b;
                    --gray-900: #0f172a;
                    --border-radius: 8px;
                    --border-radius-lg: 12px;
                    --box-shadow: 0 4px 20px rgba(0,0,0,0.08);
                    --box-shadow-lg: 0 8px 32px rgba(0,0,0,0.12);
                    --transition: all 0.2s ease;
                    --font-family: 'Inter', system-ui, -apple-system, sans-serif;
                }
            </style>
        </template>

        <!-- Configuration de développement -->
        <template id="dev_assets" name="Development Assets" active="False">
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/dev/debug_tools.js"></script>
            <script type="text/javascript" src="/construction_contact_extension/static/src/js/dev/performance_monitor.js"></script>
            <link rel="stylesheet" type="text/css" href="/construction_contact_extension/static/src/css/dev/debug.css"/>
        </template>

        <!-- Assets conditionnels selon les modules installés -->
        <template id="conditional_assets" name="Conditional Assets">
            <!-- Si le module website est installé -->
            <t t-if="request.env['ir.module.module'].sudo().search([('name', '=', 'website'), ('state', '=', 'installed')])">
                <link rel="stylesheet" type="text/css" href="/construction_contact_extension/static/src/css/website_integration.css"/>
                <script type="text/javascript" src="/construction_contact_extension/static/src/js/website_portal.js"></script>
            </t>

            <!-- Si le module documents est installé -->
            <t t-if="request.env['ir.module.module'].sudo().search([('name', '=', 'documents'), ('state', '=', 'installed')])">
                <script type="text/javascript" src="/construction_contact_extension/static/src/js/documents_integration.js"></script>
            </t>

            <!-- Si le module sign est installé -->
            <t t-if="request.env['ir.module.module'].sudo().search([('name', '=', 'sign'), ('state', '=', 'installed')])">
                <script type="text/javascript" src="/construction_contact_extension/static/src/js/signature_integration.js"></script>
            </t>
        </template>

        <!-- Optimisations de performance -->
        <template id="performance_optimizations" name="Performance Optimizations">
            <!-- Préchargement des ressources critiques -->
            <link rel="preload" href="/construction_contact_extension/static/src/css/portal.css" as="style"/>
            <link rel="preload" href="/construction_contact_extension/static/src/js/portal_upload.js" as="script"/>

            <!-- DNS prefetch pour les CDNs -->
            <link rel="dns-prefetch" href="//fonts.googleapis.com"/>
            <link rel="dns-prefetch" href="//cdnjs.cloudflare.com"/>

            <!-- Lazy loading pour les assets non-critiques -->
            <script>
                // Chargement différé des librairies non-critiques
                setTimeout(function() {
                    var scripts = [
                        '/construction_contact_extension/static/lib/chart.min.js',
                        '/construction_contact_extension/static/lib/qrcode.min.js'
                    ];
                    scripts.forEach(function(src) {
                        var script = document.createElement('script');
                        script.src = src;
                        script.async = true;
                        document.head.appendChild(script);
                    });
                }, 1000);
            </script>
        </template>

    </data>
</odoo>
