<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Rapport de statistiques détaillées -->
        <template id="statistics_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="partner">
                    <t t-call="web.external_layout">
                        <div class="page">

                            <!-- En-tête -->
                            <div class="row mb-5">
                                <div class="col-12 text-center">
                                    <h1 class="mb-3">📊 Rapport Statistiques Détaillé</h1>
                                    <h2 class="text-primary"><t t-esc="partner.name"/></h2>
                                    <p class="text-muted">
                                        Période d'analyse : du <t t-esc="(datetime.datetime.now() - datetime.timedelta(days=90)).strftime('%d/%m/%Y')"/>
                                        au <t t-esc="datetime.datetime.now().strftime('%d/%m/%Y')"/>
                                    </p>
                                </div>
                            </div>

                            <!-- Scores principaux -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card border-primary">
                                        <div class="card-header bg-primary text-white">
                                            <h4 class="mb-0">🎯 Indicateurs Clés de Performance</h4>
                                        </div>
                                        <div class="card-body">
                                            <div class="row text-center">
                                                <div class="col-md-3">
                                                    <div class="border rounded p-3 mb-3">
                                                        <h2 class="text-success mb-1"><t t-esc="partner.document_health_score"/>%</h2>
                                                        <h6 class="text-muted">SCORE SANTÉ</h6>
                                                        <div class="progress mt-2" style="height: 10px;">
                                                            <div class="progress-bar bg-success"
                                                                 t-att-style="'width: ' + str(partner.document_health_score) + '%'"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="border rounded p-3 mb-3">
                                                        <h2 class="text-primary mb-1"><t t-esc="partner.document_completion_rate"/>%</h2>
                                                        <h6 class="text-muted">COMPLÉTUDE</h6>
                                                        <div class="progress mt-2" style="height: 10px;">
                                                            <div class="progress-bar bg-primary"
                                                                 t-att-style="'width: ' + str(partner.document_completion_rate) + '%'"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="border rounded p-3 mb-3">
                                                        <h2 class="text-info mb-1"><t t-esc="partner.reliability_score"/>%</h2>
                                                        <h6 class="text-muted">FIABILITÉ</h6>
                                                        <div class="progress mt-2" style="height: 10px;">
                                                            <div class="progress-bar bg-info"
                                                                 t-att-style="'width: ' + str(partner.reliability_score) + '%'"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="border rounded p-3 mb-3">
                                                        <h2 class="text-warning mb-1"><t t-esc="partner.active_projects_count"/></h2>
                                                        <h6 class="text-muted">PROJETS ACTIFS</h6>
                                                        <div class="mt-2">
                                                            <i class="fa fa-building text-warning" style="font-size: 24px;"></i>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Répartition des documents -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header bg-info text-white">
                                            <h5 class="mb-0">📄 Répartition des Documents</h5>
                                        </div>
                                        <div class="card-body">
                                            <t t-set="total_docs" t-value="len(partner.document_ids)"/>
                                            <t t-set="valid_docs" t-value="len([d for d in partner.document_ids if d.state == 'valid'])"/>
                                            <t t-set="expired_docs" t-value="len([d for d in partner.document_ids if d.state == 'expired'])"/>
                                            <t t-set="pending_docs" t-value="len([d for d in partner.document_ids if d.state == 'to_check'])"/>
                                            <t t-set="rejected_docs" t-value="len([d for d in partner.document_ids if d.state == 'rejected'])"/>

                                            <div class="row text-center">
                                                <div class="col-6 mb-3">
                                                    <h4 class="text-success"><t t-esc="valid_docs"/></h4>
                                                    <small>Documents Valides</small>
                                                </div>
                                                <div class="col-6 mb-3">
                                                    <h4 class="text-danger"><t t-esc="expired_docs"/></h4>
                                                    <small>Documents Expirés</small>
                                                </div>
                                                <div class="col-6">
                                                    <h4 class="text-info"><t t-esc="pending_docs"/></h4>
                                                    <small>À Vérifier</small>
                                                </div>
                                                <div class="col-6">
                                                    <h4 class="text-warning"><t t-esc="rejected_docs"/></h4>
                                                    <small>Rejetés</small>
                                                </div>
                                            </div>

                                            <!-- Graphique simple en barres -->
                                            <div class="mt-3">
                                                <div class="progress mb-2" style="height: 25px;">
                                                    <div class="progress-bar bg-success"
                                                         t-att-style="'width: ' + str(valid_docs * 100 / total_docs if total_docs > 0 else 0) + '%'">
                                                        <t t-esc="valid_docs"/>
                                                    </div>
                                                    <div class="progress-bar bg-danger"
                                                         t-att-style="'width: ' + str(expired_docs * 100 / total_docs if total_docs > 0 else 0) + '%'">
                                                        <t t-esc="expired_docs"/>
                                                    </div>
                                                    <div class="progress-bar bg-info"
                                                         t-att-style="'width: ' + str(pending_docs * 100 / total_docs if total_docs > 0 else 0) + '%'">
                                                        <t t-esc="pending_docs"/>
                                                    </div>
                                                    <div class="progress-bar bg-warning"
                                                         t-att-style="'width: ' + str(rejected_docs * 100 / total_docs if total_docs > 0 else 0) + '%'">
                                                        <t t-esc="rejected_docs"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header bg-success text-white">
                                            <h5 class="mb-0">⏱️ Historique Temporel</h5>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-sm">
                                                <tr>
                                                    <td><strong>Premier upload :</strong></td>
                                                    <td>
                                                        <t t-if="partner.document_ids">
                                                            <t t-esc="min([d.upload_date for d in partner.document_ids if d.upload_date]).strftime('%d/%m/%Y')"/>
                                                        </t>
                                                        <t t-else="">N/A</t>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Dernier upload :</strong></td>
                                                    <td>
                                                        <t t-if="partner.document_ids">
                                                            <t t-esc="max([d.upload_date for d in partner.document_ids if d.upload_date]).strftime('%d/%m/%Y')"/>
                                                        </t>
                                                        <t t-else="">N/A</t>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Uploads derniers 30j :</strong></td>
                                                    <td>
                                                        <t t-esc="len([d for d in partner.document_ids if d.upload_date and d.upload_date >= (datetime.datetime.now() - datetime.timedelta(days=30)).date()])"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Prochaine expiration :</strong></td>
                                                    <td>
                                                        <t t-if="partner.next_document_expiry">
                                                            <span class="text-warning">
                                                                <t t-esc="partner.next_document_expiry.strftime('%d/%m/%Y')"/>
                                                            </span>
                                                        </t>
                                                        <t t-else="">N/A</t>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Analyse par type de document -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header bg-secondary text-white">
                                            <h5 class="mb-0">📊 Analyse par Type de Document</h5>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Type de Document</th>
                                                        <th>Obligatoire</th>
                                                        <th>Statut</th>
                                                        <th>Date Upload</th>
                                                        <th>Date Expiration</th>
                                                        <th>Jours Restants</th>
                                                        <th>Qualité</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <!-- Documents obligatoires -->
                                                    <t t-set="mandatory_types" t-value="request.env['document.type'].sudo().search([('is_mandatory', '=', True)])"/>
                                                    <t t-foreach="mandatory_types" t-as="doc_type">
                                                        <t t-set="doc" t-value="partner.get_documents_by_type(doc_type.id)"/>
                                                        <tr>
                                                            <td><strong><t t-esc="doc_type.name"/></strong></td>
                                                            <td><span class="badge badge-danger">OUI</span></td>
                                                            <td>
                                                                <t t-if="doc">
                                                                    <span t-att-class="'badge badge-' + {
                                                                        'valid': 'success',
                                                                        'expired': 'danger',
                                                                        'expiring': 'warning',
                                                                        'to_check': 'info',
                                                                        'rejected': 'danger'
                                                                    }.get(doc[0].state, 'secondary')">
                                                                        <t t-esc="doc[0].state.title()"/>
                                                                    </span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="badge badge-secondary">Manquant</span>
                                                                </t>
                                                            </td>
                                                            <td>
                                                                <t t-if="doc and doc[0].upload_date">
                                                                    <t t-esc="doc[0].upload_date.strftime('%d/%m/%Y')"/>
                                                                </t>
                                                                <t t-else="">-</t>
                                                            </td>
                                                            <td>
                                                                <t t-if="doc and doc[0].expiry_date">
                                                                    <span t-att-class="'text-' + ('danger' if doc[0].is_expired else 'warning' if doc[0].is_expiring_soon else 'success')">
                                                                        <t t-esc="doc[0].expiry_date.strftime('%d/%m/%Y')"/>
                                                                    </span>
                                                                </t>
                                                                <t t-else="">N/A</t>
                                                            </td>
                                                            <td>
                                                                <t t-if="doc and doc[0].expiry_date">
                                                                    <t t-set="days_left" t-value="(doc[0].expiry_date - datetime.date.today()).days"/>
                                                                    <span t-att-class="'badge badge-' + ('danger' if days_left &lt; 0 else 'warning' if days_left &lt; 30 else 'success')">
                                                                        <t t-esc="days_left"/> j
                                                                    </span>
                                                                </t>
                                                                <t t-else="">-</t>
                                                            </td>
                                                            <td>
                                                                <t t-if="doc">
                                                                    <div class="progress" style="height: 15px;">
                                                                        <div t-att-class="'progress-bar bg-' + ('success' if doc[0].state == 'valid' else 'warning' if doc[0].state == 'to_check' else 'danger')"
                                                                             t-att-style="'width: ' + str({'valid': 100, 'to_check': 75, 'rejected': 25, 'expired': 10}.get(doc[0].state, 50)) + '%'">
                                                                        </div>
                                                                    </div>
                                                                </t>
                                                                <t t-else="">
                                                                    <div class="progress" style="height: 15px;">
                                                                        <div class="progress-bar bg-secondary" style="width: 0%"></div>
                                                                    </div>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <!-- Recommandations -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="card border-primary">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0 text-primary">💡 Recommandations et Actions</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <h6 class="text-success">✅ Points Forts</h6>
                                                    <ul class="list-unstyled">
                                                        <t t-if="partner.document_completion_rate >= 80">
                                                            <li><i class="fa fa-check text-success"></i> Excellent taux de complétude</li>
                                                        </t>
                                                        <t t-if="not partner.has_expired_documents">
                                                            <li><i class="fa fa-check text-success"></i> Aucun document expiré</li>
                                                        </t>
                                                        <t t-if="partner.reliability_score >= 85">
                                                            <li><i class="fa fa-check text-success"></i> Très bonne fiabilité</li>
                                                        </t>
                                                    </ul>
                                                </div>
                                                <div class="col-md-6">
                                                    <h6 class="text-warning">⚠️ Points d'Amélioration</h6>
                                                    <ul class="list-unstyled">
                                                        <t t-if="partner.has_expired_documents">
                                                            <li><i class="fa fa-exclamation-triangle text-danger"></i> Documents expirés à renouveler</li>
                                                        </t>
                                                        <t t-if="partner.has_expiring_documents">
                                                            <li><i class="fa fa-clock text-warning"></i> Documents expirant bientôt</li>
                                                        </t>
                                                        <t t-if="partner.document_completion_rate &lt; 70">
                                                            <li><i class="fa fa-file text-info"></i> Dossier incomplet</li>
                                                        </t>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- Action pour le rapport de statistiques -->
        <record id="action_statistics_report" model="ir.actions.report">
            <field name="name">Rapport Statistiques</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">construction_contact_extension.statistics_report</field>
            <field name="report_file">construction_contact_extension.statistics_report</field>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
