<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Rapport principal des documents partenaires -->
        <template id="partner_document_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="partner">
                    <t t-call="web.external_layout">
                        <div class="page">

                            <!-- En-tête du rapport -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h1 class="text-center mb-3">
                                        📋 Rapport Documents Administratifs
                                    </h1>
                                    <h2 class="text-center text-primary">
                                        <t t-esc="partner.name"/>
                                    </h2>
                                </div>
                            </div>

                            <!-- Informations générales -->
                            <div class="row mb-4">
                                <div class="col-6">
                                    <div class="card">
                                        <div class="card-header bg-primary text-white">
                                            <h5 class="mb-0">📊 Informations Générales</h5>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-borderless">
                                                <tr>
                                                    <td><strong>Entreprise :</strong></td>
                                                    <td><t t-esc="partner.name"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Email :</strong></td>
                                                    <td><t t-esc="partner.email or 'Non renseigné'"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Téléphone :</strong></td>
                                                    <td><t t-esc="partner.phone or 'Non renseigné'"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Spécialités :</strong></td>
                                                    <td>
                                                        <t t-if="partner.speciality_ids">
                                                            <span t-foreach="partner.speciality_ids" t-as="spec" class="badge badge-info me-1">
                                                                <t t-esc="spec.name"/>
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            Non renseignées
                                                        </t>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="card">
                                        <div class="card-header bg-success text-white">
                                            <h5 class="mb-0">📈 Scores et Métriques</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row text-center">
                                                <div class="col-4">
                                                    <div class="border rounded p-2">
                                                        <h3 class="text-success"><t t-esc="partner.document_completion_rate"/>%</h3>
                                                        <small>Complétude</small>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="border rounded p-2">
                                                        <h3 class="text-primary"><t t-esc="partner.document_health_score"/>%</h3>
                                                        <small>Santé</small>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="border rounded p-2">
                                                        <h3 class="text-info"><t t-esc="partner.reliability_score"/>%</h3>
                                                        <small>Fiabilité</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Statut global -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <t t-if="partner.has_expired_documents">
                                        <div class="alert alert-danger">
                                            <h5>⚠️ Attention : Documents Expirés</h5>
                                            <p>Ce sous-traitant a des documents expirés qui nécessitent un renouvellement immédiat.</p>
                                        </div>
                                    </t>
                                    <t t-elif="partner.has_expiring_documents">
                                        <div class="alert alert-warning">
                                            <h5>⏰ Documents Expirant Bientôt</h5>
                                            <p>Certains documents de ce sous-traitant vont expirer dans les 30 prochains jours.</p>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="alert alert-success">
                                            <h5>✅ Dossier Conforme</h5>
                                            <p>Tous les documents sont à jour et valides.</p>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Liste des documents -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header bg-info text-white">
                                            <h5 class="mb-0">📄 Documents</h5>
                                        </div>
                                        <div class="card-body p-0">
                                            <table class="table table-striped mb-0">
                                                <thead class="table-dark">
                                                    <tr>
                                                        <th>Type de Document</th>
                                                        <th>Statut</th>
                                                        <th>Date Upload</th>
                                                        <th>Date Expiration</th>
                                                        <th>Validé par</th>
                                                        <th>Fichier</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="partner.document_ids" t-as="doc">
                                                        <tr>
                                                            <td><strong><t t-esc="doc.document_type_id.name"/></strong></td>
                                                            <td>
                                                                <span t-att-class="'badge badge-' + {
                                                                    'valid': 'success',
                                                                    'expired': 'danger',
                                                                    'expiring': 'warning',
                                                                    'to_check': 'info',
                                                                    'rejected': 'danger',
                                                                    'missing': 'secondary'
                                                                }.get(doc.state, 'secondary')">
                                                                    <t t-esc="{
                                                                        'valid': 'Valide',
                                                                        'expired': 'Expiré',
                                                                        'expiring': 'Expire bientôt',
                                                                        'to_check': 'À vérifier',
                                                                        'rejected': 'Rejeté',
                                                                        'missing': 'Manquant'
                                                                    }.get(doc.state, doc.state.title())"/>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <t t-if="doc.upload_date">
                                                                    <t t-esc="doc.upload_date.strftime('%d/%m/%Y')"/>
                                                                </t>
                                                                <t t-else="">-</t>
                                                            </td>
                                                            <td>
                                                                <t t-if="doc.expiry_date">
                                                                    <span t-att-class="'text-' + ('danger' if doc.is_expired else 'warning' if doc.is_expiring_soon else 'success')">
                                                                        <t t-esc="doc.expiry_date.strftime('%d/%m/%Y')"/>
                                                                    </span>
                                                                </t>
                                                                <t t-else="">N/A</t>
                                                            </td>
                                                            <td>
                                                                <t t-if="doc.validated_by">
                                                                    <t t-esc="doc.validated_by.name"/>
                                                                </t>
                                                                <t t-else="">-</t>
                                                            </td>
                                                            <td>
                                                                <t t-if="doc.filename">
                                                                    <small><t t-esc="doc.filename"/></small><br/>
                                                                    <span class="text-muted"><t t-esc="doc.file_size_human"/></span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="text-muted">Pas de fichier</span>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </t>

                                                    <!-- Si aucun document -->
                                                    <t t-if="not partner.document_ids">
                                                        <tr>
                                                            <td colspan="6" class="text-center text-muted">
                                                                Aucun document trouvé
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>



                            <!-- Pied de page avec informations de génération -->
                            <div class="row mt-5">
                                <div class="col-12 text-center">
                                    <hr/>
                                    <small class="text-muted">
                                        Rapport généré le <t t-esc="datetime.datetime.now().strftime('%d/%m/%Y à %H:%M')"/>
                                        par <t t-esc="user.name"/> | BLG Groupe
                                    </small>
                                </div>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- Rapport de synthèse pour plusieurs partenaires -->
        <template id="partner_document_summary_report">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">

                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h1>📊 Rapport de Synthèse Documents</h1>
                                <h3 class="text-muted">Sous-traitants BLG Groupe</h3>
                            </div>
                        </div>

                        <!-- Statistiques globales -->
                        <div class="row mb-4">
                            <div class="col-3 text-center">
                                <div class="card bg-primary text-white">
                                    <div class="card-body">
                                        <h2><t t-esc="len(docs)"/></h2>
                                        <p>Sous-traitants</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3 text-center">
                                <div class="card bg-success text-white">
                                    <div class="card-body">
                                        <h2><t t-esc="sum(1 for p in docs if p.documents_complete_modern)"/></h2>
                                        <p>Dossiers Complets</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3 text-center">
                                <div class="card bg-warning text-white">
                                    <div class="card-body">
                                        <h2><t t-esc="sum(1 for p in docs if p.has_expiring_documents)"/></h2>
                                        <p>Docs Expirant</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3 text-center">
                                <div class="card bg-danger text-white">
                                    <div class="card-body">
                                        <h2><t t-esc="sum(1 for p in docs if p.has_expired_documents)"/></h2>
                                        <p>Docs Expirés</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tableau de synthèse -->
                        <div class="row">
                            <div class="col-12">
                                <table class="table table-striped">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Sous-traitant</th>
                                            <th>Complétude</th>
                                            <th>Score Santé</th>
                                            <th>Documents Valides</th>
                                            <th>À Vérifier</th>
                                            <th>Expirés</th>
                                            <th>Statut Global</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="docs" t-as="partner">
                                            <tr>
                                                <td><strong><t t-esc="partner.name"/></strong></td>
                                                <td>
                                                    <div class="progress" style="height: 20px;">
                                                        <div class="progress-bar bg-success"
                                                             t-att-style="'width: ' + str(partner.document_completion_rate) + '%'">
                                                            <t t-esc="partner.document_completion_rate"/>%
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span t-att-class="'badge badge-' + ('success' if partner.document_health_score >= 80 else 'warning' if partner.document_health_score >= 50 else 'danger')">
                                                        <t t-esc="partner.document_health_score"/>%
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <t t-esc="len([d for d in partner.document_ids if d.state == 'valid'])"/>
                                                </td>
                                                <td class="text-center">
                                                    <t t-esc="len([d for d in partner.document_ids if d.state == 'to_check'])"/>
                                                </td>
                                                <td class="text-center">
                                                    <span class="text-danger">
                                                        <t t-esc="len([d for d in partner.document_ids if d.state == 'expired'])"/>
                                                    </span>
                                                </td>
                                                <td>
                                                    <t t-if="partner.has_expired_documents">
                                                        <span class="badge badge-danger">Critique</span>
                                                    </t>
                                                    <t t-elif="partner.has_expiring_documents">
                                                        <span class="badge badge-warning">Attention</span>
                                                    </t>
                                                    <t t-elif="partner.documents_complete_modern">
                                                        <span class="badge badge-success">Conforme</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge badge-info">En cours</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </template>

        <!-- Action pour le rapport des documents partenaires -->
        <record id="action_partner_document_report" model="ir.actions.report">
            <field name="name">Rapport Documents Partenaires</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">construction_contact_extension.partner_document_report</field>
            <field name="report_file">construction_contact_extension.partner_document_report</field>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
