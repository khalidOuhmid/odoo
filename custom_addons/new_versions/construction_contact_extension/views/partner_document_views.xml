<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue liste des documents partenaires -->
    <record id="view_partner_document_list" model="ir.ui.view">
        <field name="name">partner.document.list</field>
        <field name="model">partner.document</field>
        <field name="arch" type="xml">
            <list string="Documents Partenaires" create="true" delete="true">
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state in ['expired', 'rejected']"
                       decoration-info="state == 'to_check'"
                       decoration-muted="state == 'missing'"/>
                <field name="filename"/>
                <field name="upload_date"/>
                <field name="expiry_date"/>
                <field name="days_until_expiry"
                       decoration-danger="days_until_expiry &lt; 0"
                       decoration-warning="days_until_expiry &lt;= 30 and days_until_expiry &gt;= 0"/>
                <field name="file_size_human"/>
                <field name="validated_by"/>
                <field name="validation_date"/>

                <!-- Actions -->
                <button name="action_validate" type="object"
                        string="Valider"
                        class="btn btn-sm btn-success"
                        icon="fa-check"
                        invisible="state != 'to_check'"
                        groups="construction_contact_extension.group_document_validator"/>

                <button name="action_reject" type="object"
                        string="Rejeter"
                        class="btn btn-sm btn-danger"
                        icon="fa-times"
                        invisible="state not in ['to_check', 'valid']"
                        groups="construction_contact_extension.group_document_validator"/>

                <button name="action_download" type="object"
                        string="Télécharger"
                        class="btn btn-sm btn-outline-primary"
                        icon="fa-download"
                        invisible="not file_content"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire des documents partenaires -->
    <record id="view_partner_document_form" model="ir.ui.view">
        <field name="name">partner.document.form</field>
        <field name="model">partner.document</field>
        <field name="arch" type="xml">
            <form string="Document Partenaire">
                <header>
                    <button name="action_validate" string="Valider"
                            type="object" class="btn-success"
                            invisible="state != 'to_check'"
                            groups="construction_contact_extension.group_document_validator"/>
                    <button name="action_reject" string="Rejeter"
                            type="object" class="btn-danger"
                            invisible="state not in ['to_check', 'valid']"
                            groups="construction_contact_extension.group_document_validator"/>
                    <button name="action_download" string="Télécharger"
                            type="object" class="btn-primary"
                            invisible="not file_content"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="missing,to_check,valid"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informations Générales">
                            <field name="partner_id" required="1"/>
                            <field name="document_type_id" required="1"/>
                            <field name="filename" readonly="1"/>
                            <field name="file_size_human" readonly="1"/>
                        </group>

                        <group string="Dates">
                            <field name="upload_date" readonly="1"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_until_expiry" readonly="1"
                                   decoration-danger="days_until_expiry &lt; 0"
                                   decoration-warning="days_until_expiry &lt;= 30 and days_until_expiry &gt;= 0"/>
                            <field name="is_expired" readonly="1"/>
                            <field name="is_expiring_soon" readonly="1"/>
                        </group>
                    </group>

                    <group string="Validation">
                        <group>
                            <field name="validated_by" readonly="1"/>
                            <field name="validation_date" readonly="1"/>
                            <field name="can_be_validated" readonly="1"/>
                            <field name="can_be_rejected" readonly="1"/>
                        </group>
                    </group>

                    <group string="Notes de Validation" invisible="not validation_notes">
                        <field name="validation_notes" readonly="1" nolabel="1"/>
                    </group>

                    <group string="Fichier">
                        <field name="file_content"
                               filename="filename"
                               widget="binary"/>
                    </group>
                </sheet>

                <chatter></chatter>
            </form>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="view_partner_document_search" model="ir.ui.view">
        <field name="name">partner.document.search</field>
        <field name="model">partner.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="filename"/>
                <field name="state"/>

                <!-- Filtres par état -->
                <filter string="À vérifier" name="to_check"
                        domain="[('state', '=', 'to_check')]"/>
                <filter string="Valides" name="valid"
                        domain="[('state', '=', 'valid')]"/>
                <filter string="Expirés" name="expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter string="Expirant bientôt" name="expiring"
                        domain="[('state', '=', 'expiring')]"/>
                <filter string="Rejetés" name="rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter string="Manquants" name="missing"
                        domain="[('state', '=', 'missing')]"/>

                <!-- Filtres par type -->
                <separator/>
                <filter string="Carte d'identité" name="identity_card"
                        domain="[('document_type_id.code', '=', 'identity_card')]"/>
                <filter string="URSSAF" name="urssaf"
                        domain="[('document_type_id.code', '=', 'urssaf')]"/>
                <filter string="KBIS" name="kbis"
                        domain="[('document_type_id.code', '=', 'kbis')]"/>
                <filter string="Assurance" name="insurance"
                        domain="[('document_type_id.code', '=', 'insurance')]"/>
                <filter string="RIB" name="rib"
                        domain="[('document_type_id.code', '=', 'rib')]"/>

                <!-- Filtres par date -->
                <separator/>
                <filter string="Uploadés aujourd'hui" name="uploaded_today"
                        domain="[('upload_date', '>=', context_today())]"/>
                <filter string="Expire dans 30 jours" name="expiring_30"
                        domain="[('expiry_date', '&lt;=', (context_today() + datetime.timedelta(days=30))), ('expiry_date', '&gt;=', context_today())]"/>

                <!-- Groupes -->
                <group expand="0" string="Group By">
                    <filter string="Partenaire" name="group_by_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Type de document" name="group_by_type"
                            context="{'group_by': 'document_type_id'}"/>
                    <filter string="État" name="group_by_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Date d'upload" name="group_by_upload"
                            context="{'group_by': 'upload_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action principale -->
    <record id="action_partner_document" model="ir.actions.act_window">
        <field name="name">Documents Partenaires</field>
        <field name="res_model">partner.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_check': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun document trouvé
            </p>
            <p>
                Les documents des partenaires sous-traitants apparaissent ici.
            </p>
        </field>
    </record>

</odoo>
