<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Règles pour partner.document -->
        <record id="partner_document_user_rule" model="ir.rule">
            <field name="name">Documents Partenaires : Accès Utilisateur</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="groups" eval="[(4, ref('group_subcontractor_user'))]"/>
            <field name="domain_force">[('partner_id.is_subcontractor', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="partner_document_manager_rule" model="ir.rule">
            <field name="name">Documents Partenaires : Accès Gestionnaire</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="groups" eval="[(4, ref('group_subcontractor_manager'))]"/>
            <field name="domain_force">[('partner_id.is_subcontractor', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="partner_document_validator_rule" model="ir.rule">
            <field name="name">Documents Partenaires : Accès Validateur</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="groups" eval="[(4, ref('group_document_validator'))]"/>
            <field name="domain_force">[('state', 'in', ['to_check', 'valid', 'rejected'])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Règles pour document.archive -->
        <record id="document_archive_user_rule" model="ir.rule">
            <field name="name">Archives Documents : Accès Utilisateur</field>
            <field name="model_id" ref="model_document_archive"/>
            <field name="groups" eval="[(4, ref('group_subcontractor_user'))]"/>
            <field name="domain_force">[('partner_id.is_subcontractor', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="document_archive_manager_rule" model="ir.rule">
            <field name="name">Archives Documents : Accès Gestionnaire</field>
            <field name="model_id" ref="model_document_archive"/>
            <field name="groups" eval="[(4, ref('group_subcontractor_manager'))]"/>
            <field name="domain_force">[('partner_id.is_subcontractor', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="document_archive_admin_rule" model="ir.rule">
            <field name="name">Archives Documents : Accès Admin</field>
            <field name="model_id" ref="model_document_archive"/>
            <field name="groups" eval="[(4, ref('group_archive_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Règles pour res.partner (sous-traitants uniquement) -->
        <record id="res_partner_subcontractor_rule" model="ir.rule">
            <field name="name">Partenaires : Accès Sous-traitants</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('group_subcontractor_user'))]"/>
            <field name="domain_force">['|', ('is_subcontractor', '=', True), ('is_subcontractor', '=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Règles pour portal (accès externe) -->
        <record id="partner_document_portal_rule" model="ir.rule">
            <field name="name">Documents : Accès Portail</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="groups" eval="[(4, ref('group_portal_subcontractor'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Règles restrictives pour les données sensibles -->
        <record id="document_archive_sensitive_rule" model="ir.rule">
            <field name="name">Archives : Restriction Données Sensibles</field>
            <field name="model_id" ref="model_document_archive"/>
            <field name="groups" eval="[(4, ref('group_subcontractor_user'))]"/>
            <field name="domain_force">[('archive_reason', '!=', 'security_breach')]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
