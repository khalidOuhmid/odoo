<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Catégorie de sécurité pour le module -->
        <record id="module_construction_contact_extension" model="ir.module.category">
            <field name="name">Construction - Contacts Extension</field>
            <field name="description">Gestion des sous-traitants et documents</field>
            <field name="sequence">15</field>
        </record>

        <!-- Groupe : Utilisateur Base -->
        <record id="group_subcontractor_user" model="res.groups">
            <field name="name">Sous-traitants : Utilisateur</field>
            <field name="category_id" ref="module_construction_contact_extension"/>
            <field name="comment">Accès en lecture aux sous-traitants et leurs documents</field>
        </record>

        <!-- Groupe : Gestionnaire Sous-traitants -->
        <record id="group_subcontractor_manager" model="res.groups">
            <field name="name">Sous-traitants : Gestionnaire</field>
            <field name="category_id" ref="module_construction_contact_extension"/>
            <field name="implied_ids" eval="[(4, ref('group_subcontractor_user'))]"/>
            <field name="comment">Gestion complète des sous-traitants, création de liens portail</field>
        </record>

        <!-- Groupe : Validateur Documents -->
        <record id="group_document_validator" model="res.groups">
            <field name="name">Documents : Validateur</field>
            <field name="category_id" ref="module_construction_contact_extension"/>
            <field name="implied_ids" eval="[(4, ref('group_subcontractor_user'))]"/>
            <field name="comment">Validation et rejet des documents des sous-traitants</field>
        </record>

        <!-- Groupe : Administrateur Archives -->
        <record id="group_archive_admin" model="res.groups">
            <field name="name">Archives : Administrateur</field>
            <field name="category_id" ref="module_construction_contact_extension"/>
            <field name="implied_ids" eval="[(4, ref('group_document_validator'))]"/>
            <field name="comment">Gestion des archives et suppressions définitives</field>
        </record>

        <!-- Groupe : Conducteur de Travaux -->
        <record id="group_conducteur_travaux" model="res.groups">
            <field name="name">Conducteur de Travaux</field>
            <field name="category_id" ref="module_construction_contact_extension"/>
            <field name="implied_ids" eval="[(4, ref('group_subcontractor_manager')), (4, ref('group_document_validator'))]"/>
            <field name="comment">Accès complet pour les conducteurs de travaux</field>
        </record>

        <!-- Groupe : Directeur Général -->
        <record id="group_directeur_general" model="res.groups">
            <field name="name">Direction Générale</field>
            <field name="category_id" ref="module_construction_contact_extension"/>
            <field name="implied_ids" eval="[(4, ref('group_conducteur_travaux')), (4, ref('group_archive_admin'))]"/>
            <field name="comment">Accès administrateur complet</field>
        </record>

        <!-- Attribution automatique des groupes aux administrateurs système -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_directeur_general'))]"/>
        </record>

        <!-- Règles spéciales pour les portails -->
        <record id="group_portal_subcontractor" model="res.groups">
            <field name="name">Portail : Sous-traitant</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Accès portail pour les sous-traitants externes</field>
        </record>

    </data>
</odoo>
