<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="construction_sale.LotProductSelector" owl="1">
        <div class="lot-product-selector">
            <div class="row">
                <!-- Sélection des lots -->
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">
                                <i class="fa fa-cubes"/> Lots disponibles
                            </h5>
                        </div>
                        <div class="card-body">
                            <t t-if="state.loading">
                                <div class="text-center">
                                    <i class="fa fa-spinner fa-spin"/> Chargement...
                                </div>
                            </t>
                            <t t-else="">
                                <t t-if="state.lots.length === 0">
                                    <div class="alert alert-info">
                                        <i class="fa fa-info-circle"/> Aucun lot disponible
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="list-group">
                                        <t t-foreach="state.lots" t-as="lot" t-key="lot.id">
                                            <button 
                                                class="list-group-item list-group-item-action"
                                                t-att-class="state.selectedLot === lot.id ? 'active' : ''"
                                                t-on-click="() => this.onLotSelected(lot.id)">
                                                <strong t-esc="lot.name"/>
                                            </button>
                                        </t>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Sélection des produits -->
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">
                                <i class="fa fa-shopping-cart"/> Produits disponibles
                            </h5>
                        </div>
                        <div class="card-body">
                            <t t-if="!state.selectedLot">
                                <div class="alert alert-warning">
                                    <i class="fa fa-hand-o-left"/> Sélectionnez d'abord un lot
                                </div>
                            </t>
                            <t t-elif="state.loading">
                                <div class="text-center">
                                    <i class="fa fa-spinner fa-spin"/> Chargement des produits...
                                </div>
                            </t>
                            <t t-else="">
                                <div class="row">
                                    <t t-foreach="state.products" t-as="product" t-key="product.id">
                                        <div class="col-md-6 col-lg-4 mb-3">
                                            <div class="card product-card h-100">
                                                <t t-if="product.image_128">
                                                    <img 
                                                        t-att-src="'data:image/png;base64,' + product.image_128" 
                                                        class="card-img-top" 
                                                        style="height: 150px; object-fit: cover;"
                                                        t-att-alt="product.name"/>
                                                </t>
                                                <div class="card-body d-flex flex-column">
                                                    <h6 class="card-title" t-esc="product.name"/>
                                                    <p class="card-text text-muted">
                                                        <strong t-esc="product.list_price"/> €
                                                    </p>
                                                    <button 
                                                        class="btn btn-primary btn-sm mt-auto"
                                                        t-on-click="() => this.addProductToQuote(product.id)">
                                                        <i class="fa fa-plus"/> Ajouter
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                                
                                <t t-if="state.products.length === 0">
                                    <div class="alert alert-info">
                                        <i class="fa fa-info-circle"/> Aucun produit disponible pour ce lot
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates> 