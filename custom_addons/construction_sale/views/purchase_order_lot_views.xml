<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vue formulaire bon de commande par lot -->
        <record id="view_purchase_order_lot_form" model="ir.ui.view">
            <field name="name">purchase.order.lot.form</field>
            <field name="model">purchase.order.lot</field>
            <field name="arch" type="xml">
                <form string="Bon de commande par lot">
                    <header>
                        <button name="action_send_subcontractor" 
                                type="object" 
                                class="btn-primary" 
                                string="Envoyer au sous-traitant"
                                invisible="state != 'draft'"/>
                        <button name="action_confirm" 
                                type="object" 
                                class="btn-success" 
                                string="Confirmer"
                                invisible="state not in ['draft', 'sent']"/>
                        <button name="action_mark_done" 
                                type="object" 
                                class="btn-info" 
                                string="Marquer comme terminé"
                                invisible="state != 'confirmed'"/>
                        <button name="action_cancel" 
                                type="object" 
                                class="btn-danger" 
                                string="Annuler"
                                invisible="state in ['done', 'cancel']"/>
                        
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,sent,confirmed,done"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Informations principales">
                                <field name="sale_order_id" readonly="1"/>
                                <field name="chantier_id" readonly="1"/>
                                <field name="lot_id"/>
                                <field name="partner_id" domain="[('is_company', '=', True), ('supplier_rank', '>', 0)]"/>
                            </group>
                            <group string="Dates">
                                <field name="date_order"/>
                                <field name="date_planned"/>
                                <field name="date_delivery"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Lignes de commande" name="order_lines">
                                <field name="order_line">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id"/>
                                        <field name="name"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom"/>
                                        <field name="price_unit"/>
                                        <field name="taxes_id" widget="many2many_tags"/>
                                        <field name="price_subtotal"/>
                                        <field name="room" optional="show"/>
                                        <field name="floor" optional="show"/>
                                    </tree>
                                </field>
                                
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="amount_untaxed" string="Sous-total HT"/>
                                    <field name="amount_tax" string="Taxes"/>
                                    <div class="oe_subtotal_footer_separator oe_inline">
                                        <label for="amount_total"/>
                                        <field name="amount_total" nolabel="1" class="oe_subtotal_footer_range"/>
                                    </div>
                                </group>
                            </page>

                            <page string="Autres informations" name="other_info">
                                <group>
                                    <group string="Conditions">
                                        <field name="payment_term_id"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                    </group>
                                </group>
                                
                                <group string="Notes et conditions">
                                    <field name="notes" nolabel="1" placeholder="Conditions particulières, notes techniques..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vue liste bon de commande par lot -->
        <record id="view_purchase_order_lot_tree" model="ir.ui.view">
            <field name="name">purchase.order.lot.tree</field>
            <field name="model">purchase.order.lot</field>
            <field name="arch" type="xml">
                <tree string="Bons de commande par lot"
                      decoration-info="state == 'draft'"
                      decoration-warning="state == 'sent'"
                      decoration-success="state == 'confirmed'"
                      decoration-muted="state == 'cancel'">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="chantier_id"/>
                    <field name="lot_id"/>
                    <field name="date_order"/>
                    <field name="date_planned"/>
                    <field name="amount_total" widget="monetary"/>
                    <field name="state" widget="badge"/>
                    <field name="currency_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Vue kanban bon de commande par lot -->
        <record id="view_purchase_order_lot_kanban" model="ir.ui.view">
            <field name="name">purchase.order.lot.kanban</field>
            <field name="model">purchase.order.lot</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="lot_id"/>
                    <field name="amount_total"/>
                    <field name="state"/>
                    <field name="date_planned"/>
                    <field name="currency_id"/>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <br/>
                                            <div class="text-muted">
                                                <i class="fa fa-user"/>
                                                <field name="partner_id"/>
                                            </div>
                                        </div>
                                        <div class="o_kanban_record_body">
                                            <div class="o_kanban_record_title">
                                                <i class="fa fa-wrench"/>
                                                <field name="lot_id"/>
                                            </div>
                                            <div>
                                                <i class="fa fa-calendar"/>
                                                <field name="date_planned"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="amount_total" widget="monetary"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="state" widget="label_selection" 
                                                   options="{'classes': {'draft': 'secondary', 'sent': 'warning', 'confirmed': 'success', 'done': 'info', 'cancel': 'light'}}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vue recherche/filtres -->
        <record id="view_purchase_order_lot_search" model="ir.ui.view">
            <field name="name">purchase.order.lot.search</field>
            <field name="model">purchase.order.lot</field>
            <field name="arch" type="xml">
                <search string="Rechercher bons de commande">
                    <field name="name" string="Référence"/>
                    <field name="partner_id" string="Sous-traitant"/>
                    <field name="chantier_id" string="Chantier"/>
                    <field name="lot_id" string="Lot"/>
                    
                    <filter string="Brouillons" name="filter_draft" 
                            domain="[('state', '=', 'draft')]"/>
                    <filter string="Envoyés" name="filter_sent" 
                            domain="[('state', '=', 'sent')]"/>
                    <filter string="Confirmés" name="filter_confirmed" 
                            domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Terminés" name="filter_done" 
                            domain="[('state', '=', 'done')]"/>
                    
                    <separator/>
                    <filter string="Ce mois" name="filter_this_month"
                            domain="[('date_order', '&gt;=', datetime.datetime.now().replace(day=1))]"/>
                    <filter string="Échéance proche" name="filter_due_soon"
                            domain="[('date_planned', '&lt;=', (datetime.datetime.now() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    
                    <group expand="0" string="Grouper par">
                        <filter string="Sous-traitant" name="group_partner" 
                                context="{'group_by': 'partner_id'}"/>
                        <filter string="Chantier" name="group_chantier" 
                                context="{'group_by': 'chantier_id'}"/>
                        <filter string="Lot" name="group_lot" 
                                context="{'group_by': 'lot_id'}"/>
                        <filter string="État" name="group_state" 
                                context="{'group_by': 'state'}"/>
                        <filter string="Date prévue" name="group_date_planned" 
                                context="{'group_by': 'date_planned'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action principale -->
        <record id="action_purchase_order_lot" model="ir.actions.act_window">
            <field name="name">Bons de commande par lot</field>
            <field name="res_model">purchase.order.lot</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_purchase_order_lot_search"/>
            <field name="context">{
                'search_default_filter_draft': 1,
                'search_default_filter_sent': 1,
                'search_default_filter_confirmed': 1
            }</field>
            <field name="help" type="html">
                <div class="o_view_nocontent_empty_folder">
                    <div class="text-center">
                        <i class="fa fa-file-text-o fa-3x text-muted mb-3"/>
                        <h3>Aucun bon de commande</h3>
                        <p class="text-muted">
                            Les bons de commande par lot sont générés lors du découpage des devis.
                        </p>
                    </div>
                </div>
            </field>
        </record>

        <!-- Vue formulaire ligne de bon de commande -->
        <record id="view_purchase_order_lot_line_form" model="ir.ui.view">
            <field name="name">purchase.order.lot.line.form</field>
            <field name="model">purchase.order.lot.line</field>
            <field name="arch" type="xml">
                <form string="Ligne de bon de commande">
                    <sheet>
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="product_qty"/>
                                <field name="product_uom"/>
                            </group>
                            <group>
                                <field name="price_unit"/>
                                <field name="taxes_id" widget="many2many_tags"/>
                                <field name="price_subtotal"/>
                                <field name="price_total"/>
                            </group>
                        </group>
                        
                        <group string="Informations spécifiques">
                            <group>
                                <field name="room"/>
                                <field name="floor"/>
                            </group>
                            <group>
                                <field name="sale_line_id" readonly="1" invisible="not sale_line_id"/>
                            </group>
                        </group>
                        
                        <group string="Notes techniques">
                            <field name="notes" nolabel="1" placeholder="Notes techniques, instructions particulières..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo> 