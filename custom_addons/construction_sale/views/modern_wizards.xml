<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========== WIZARD D'AJOUT DE PRODUITS ========== -->
    
    <record id="construction_product_wizard_form" model="ir.ui.view">
        <field name="name">construction.product.wizard.form</field>
        <field name="model">construction.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter des produits">
                <header>
                    <button name="action_confirm_selection" string="Confirmer" type="object" 
                            class="btn-primary" invisible="not selected_products"/>
                    <button name="action_clear_selection" string="Vider" type="object" 
                            class="btn-secondary" invisible="not selected_products"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>Ajouter des produits</h1>
                        <h2>
                            Devis : <field name="sale_order_id" readonly="1" nolabel="1"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group name="selection" string="Sélection">
                            <field name="selected_lot_id" 
                                   domain="[('id', 'in', available_lots)]"
                                   placeholder="Choisir un lot..."/>
                            <field name="available_lots" invisible="1"/>
                        </group>
                        
                        <group name="stats" string="Statistiques">
                            <field name="total_items" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="🔍 Rechercher des produits" name="search">
                            <group>
                                <group name="search_filters" string="Filtres de recherche">
                                    <field name="search_term" placeholder="Rechercher..."/>
                                    <field name="category_filter"/>
                                    <field name="show_only_lot_products"/>
                                </group>
                            </group>
                            
                            <separator string="Produits disponibles"/>
                            
                            <div class="text-muted small mb-2">
                                <i class="fa fa-info-circle"/> 
                                Les produits créés apparaîtront automatiquement dans cette liste.
                                <span invisible="not show_only_lot_products">
                                    (Filtré par lot sélectionné)
                                </span>
                            </div>
                            
                            <field name="available_products" nolabel="1" widget="many2many">
                                <list string="Produits disponibles" create="false" edit="false" delete="false" 
                                      decoration-info="1">
                                    <field name="display_name"/>
                                    <field name="default_code"/>
                                    <field name="categ_id"/>
                                    <field name="list_price" widget="monetary"/>
                                </list>
                            </field>
                            
                            <div class="text-center mt16">
                                <p class="text-muted">
                                    <i class="fa fa-info-circle"/> 
                                    Double-cliquez sur un produit pour l'ajouter à votre sélection
                                </p>
                            </div>
                            
                            <div class="text-center mt16">
                                <button name="action_create_quick_product" string="➕ Créer un nouveau produit" 
                                        type="object" class="btn-secondary"/>
                                <button name="action_refresh_products" string="🔄 Actualiser" 
                                        type="object" class="btn-link" 
                                        title="Actualiser la liste des produits"/>
                            </div>
                        </page>
                        
                        <page string="🛒 Sélection" name="selection">
                            <field name="selected_products" nolabel="1">
                                <list editable="bottom" decoration-muted="quantity == 0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="product_code" readonly="1"/>
                                    <field name="product_category" readonly="1"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" readonly="1"/>
                                    <field name="subtotal" readonly="1" sum="Total"/>
                                    <field name="room_location" placeholder="Ex: Salon"/>
                                    <field name="floor_level"/>
                                    <field name="notes" placeholder="Commentaires..."/>
                                    <button name="action_remove_line" type="object" 
                                            string="Supprimer" class="btn-link text-danger"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ========== WIZARD DE CRÉATION RAPIDE ========== -->
    
    <record id="construction_quick_product_wizard_form" model="ir.ui.view">
        <field name="name">construction.quick.product.wizard.form</field>
        <field name="model">construction.quick.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Créer un produit">
                <header>
                    <button name="action_create_product" string="Créer le produit" 
                            type="object" class="btn-primary"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>Nouveau produit</h1>
                        <h3>
                            <field name="product_preview" readonly="1" nolabel="1" 
                                   placeholder="Aperçu du produit"/>
                        </h3>
                    </div>
                    
                    <group>
                        <group name="basic_info" string="Informations de base">
                            <field name="name" placeholder="Ex: Prise électrique simple"/>
                            <field name="default_code" placeholder="Ex: ELEC-001"/>
                            <field name="categ_id"/>
                            <field name="lot_id" invisible="1"/>
                        </group>
                        
                        <group name="pricing" string="Prix">
                            <field name="list_price" widget="monetary"/>
                            <field name="standard_price" widget="monetary"/>
                        </group>
                    </group>
                    
                    <group name="options" string="Options">
                        <field name="description_sale" 
                               placeholder="Description qui apparaîtra sur le devis..."/>
                        <group>
                            <field name="add_to_selection"/>
                            <field name="quantity" invisible="not add_to_selection"/>
                        </group>
                    </group>
                    
                    <field name="wizard_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ========== VUE SALE.ORDER ÉPURÉE ========== -->
    
    <record id="sale_order_construction_form" model="ir.ui.view">
        <field name="name">sale.order.construction.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Ajout des champs construction dans l'en-tête -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="chantier_id" 
                       invisible="not chantier_id and not context.get('default_chantier_id')"/>
                <field name="lot_ids" widget="many2many_tags" 
                       invisible="not lot_ids and not chantier_id"/>
            </xpath>
            
            <!-- Ajout des boutons d'actions dans l'en-tête -->
            <xpath expr="//button[@name='action_quotation_send']" position="after">
                <button name="action_organize_by_lots" string="📋 Organiser par lots" 
                        type="object" class="btn-secondary"
                        invisible="state not in ['draft', 'sent'] or not lot_ids"/>
                <button name="action_add_product_wizard" string="➕ Ajouter produits" 
                        type="object" class="btn-primary"
                        invisible="state not in ['draft', 'sent']"/>
            </xpath>
            
            <!-- États personnalisés -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,sale,validated,no_follow</attribute>
            </xpath>
            
            <!-- Informations supplémentaires dans les lignes -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="after">
                <field name="room_location" optional="hide"/>
                <field name="floor_level" optional="hide"/>
                <field name="construction_notes" optional="hide"/>
            </xpath>
            
            <!-- Statistiques du devis -->
            <xpath expr="//group[@name='sale_total']" position="before">
                <group name="construction_stats" string="Statistiques construction" 
                       invisible="not chantier_id">
                    <field name="order_line_count" readonly="1"/>
                    <field name="total_quantity" readonly="1"/>
                </group>
            </xpath>
            
        </field>
    </record>
    
    <!-- ========== ACTIONS ========== -->
    
    <record id="action_construction_product_wizard" model="ir.actions.act_window">
        <field name="name">Ajouter des produits</field>
        <field name="res_model">construction.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="construction_product_wizard_form"/>
    </record>
    
    <record id="action_construction_quick_product_wizard" model="ir.actions.act_window">
        <field name="name">Créer un produit rapide</field>
        <field name="res_model">construction.quick.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="construction_quick_product_wizard_form"/>
    </record>
    
</odoo> 