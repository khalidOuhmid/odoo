<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========== WIZARD DE CRÉATION DE DEVIS INTELLIGENT ========== -->
    
    <record id="construction_quote_wizard_form_modern" model="ir.ui.view">
        <field name="name">construction.quote.wizard.form.modern</field>
        <field name="model">construction.quote.wizard</field>
        <field name="arch" type="xml">
            <form string="Assistant de création de devis intelligent" class="construction-quote-wizard">
                <header>
                    <button name="action_confirm_selection" string="✅ Confirmer et ajouter" 
                            type="object" class="btn-primary" 
                            invisible="not selected_line_ids"/>
                    <button name="action_clear_selection" string="🗑️ Vider la sélection" 
                            type="object" class="btn-secondary" 
                            invisible="not selected_line_ids"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>🚀 Assistant intelligent de devis</h1>
                        <h2>
                            <i class="fa fa-building-o"/> <field name="chantier_id" readonly="1" nolabel="1"/>
                        </h2>
                        <h3>
                            <i class="fa fa-file-text-o"/> Devis : <field name="sale_order_id" readonly="1" nolabel="1"/>
                        </h3>
                    </div>
                    
                    <!-- Champs cachés pour le calcul -->
                    <group invisible="1">
                        <field name="available_product_ids"/>
                        <field name="currency_id"/>
                    </group>
                    
                    <!-- Résumé de l'activité -->
                    <div class="alert alert-info" role="alert">
                        <div class="row">
                            <div class="col-md-8">
                                <strong><i class="fa fa-lightbulb-o"/> Guide d'utilisation :</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Sélectionnez les <strong>lots</strong> à traiter</li>
                                    <li>Recherchez et ajoutez des <strong>produits</strong> par lot</li>
                                    <li>Confirmez pour organiser automatiquement votre devis</li>
                                </ul>
                            </div>
                            <div class="col-md-4">
                                <div class="text-center">
                                    <span class="badge badge-primary badge-pill" style="font-size: 1.2em;">
                                        <field name="line_count" readonly="1"/> ligne(s)
                                    </span>
                                    <br/>
                                    <small class="text-muted">sélectionnée(s)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <group>
                        <group name="selection" string="📋 Sélection des lots">
                            <field name="lot_ids" widget="many2many_tags" 
                                   placeholder="Sélectionnez les lots à traiter..."
                                   help="Choisissez un ou plusieurs lots pour organiser votre devis"/>
                        </group>
                        
                        <group name="statistics" string="📊 Résumé de sélection">
                            <field name="total_quantity" readonly="1"/>
                            <field name="total_amount" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Onglet de recherche principal -->
                        <page string="🔍 Rechercher des produits" name="search_products">
                            <group>
                                <group name="search_filters" string="Filtres intelligents">
                                    <field name="search_term" 
                                           placeholder="🔎 Tapez pour rechercher..."
                                           help="Recherche dans nom, référence, description et code-barres"/>
                                    <field name="category_filter_id" 
                                           placeholder="Toutes les catégories"
                                           help="Filtrer par catégorie de produit"/>
                                    <field name="show_lot_products_only" 
                                           help="Afficher uniquement les produits liés aux lots sélectionnés"/>
                                </group>
                            </group>
                            
                            <separator string="Catalogue des produits"/>
                            
                            <!-- Message d'aide -->
                            <div class="alert alert-light" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-info-circle fa-2x me-3 text-info"/>
                                    <div>
                                        <strong>Mode d'emploi :</strong>
                                        Sélectionnez et double-cliquez sur les produits pour les ajouter à votre devis.
                                        Utilisez les filtres pour affiner votre recherche.
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Liste des produits avec design moderne -->
                            <field name="available_product_ids" nolabel="1" widget="many2many">
                                <list string="Produits disponibles" create="false" edit="false" delete="false"
                                      decoration-info="1" decoration-bf="list_price &gt; 0"
                                      class="available_products_list">
                                    <field name="image_128" widget="image" width="50px" height="50px"/>
                                    <field name="display_name"/>
                                    <field name="default_code"/>
                                    <field name="categ_id"/>
                                    <field name="list_price" widget="monetary" sum="Total"/>
                                    <button name="action_add_product" 
                                            type="object" 
                                            icon="fa-plus-circle" 
                                            title="Ajouter ce produit"
                                            class="btn-sm btn-primary"
                                            context="{'wizard_id': parent.id}"/>
                                </list>
                            </field>
                            
                            <!-- Actions rapides -->
                            <div class="d-flex justify-content-center mt-3">
                                <button name="action_create_quick_product" 
                                        string="➕ Nouveau produit" 
                                        type="object" 
                                        class="btn btn-secondary me-2"
                                        help="Créer rapidement un nouveau produit"/>
                                <button name="action_refresh_products" 
                                        string="🔄 Actualiser" 
                                        type="object" 
                                        class="btn btn-outline-secondary"
                                        help="Actualiser la liste des produits"/>
                            </div>
                        </page>
                        
                        <!-- Onglet de gestion de la sélection -->
                        <page string="🛒 Ma sélection" name="selection_management">
                            
                            <!-- Message si aucune sélection -->
                            <div class="alert alert-warning text-center" 
                                 invisible="selected_line_ids" role="alert">
                                <i class="fa fa-shopping-cart fa-3x mb-3"/>
                                <h4>Aucun produit sélectionné</h4>
                                <p class="mb-0">
                                    Utilisez l'onglet <strong>"Rechercher"</strong> pour ajouter des produits à votre devis.
                                </p>
                            </div>
                            
                            <!-- Liste éditable de la sélection -->
                            <field name="selected_line_ids" nolabel="1" invisible="not selected_line_ids">
                                <list editable="bottom" 
                                      decoration-muted="quantity == 0"
                                      decoration-success="quantity &gt; 0"
                                      class="selected_lines_list">
                                    <field name="sequence" widget="handle"/>
                                    
                                    <!-- Informations produit -->
                                    <field name="product_id" readonly="1" 
                                           options="{'no_create': True, 'no_edit': True}"/>
                                    <field name="product_code" readonly="1"/>
                                    <field name="product_category" readonly="1"/>
                                    
                                    <!-- Attribution aux lots -->
                                    <field name="lot_id" 
                                           placeholder="Lot à assigner..."
                                    />
                                    
                                    <!-- Quantités et prix -->
                                    <field name="quantity" sum="Total qté"/>
                                    <field name="price_unit" readonly="1" widget="monetary"/>
                                    <field name="subtotal" readonly="1" sum="Total €" widget="monetary"/>
                                    
                                    <!-- Localisation détaillée -->
                                    <field name="room_location" optional="hide" 
                                           placeholder="Ex: Salon, Cuisine..."/>
                                    <field name="floor_level" optional="hide"/>
                                    <field name="construction_notes" optional="hide" 
                                           placeholder="Notes techniques..."/>
                                    
                                    <!-- Action de suppression -->
                                    <button name="action_remove_line" 
                                            type="object" 
                                            icon="fa-trash-o" 
                                            title="Supprimer cette ligne" 
                                            class="btn-link text-danger"/>
                                </list>
                            </field>
                            
                            <!-- Résumé financier -->
                            <div class="row mt-3" invisible="not selected_line_ids">
                                <div class="col-md-6">
                                    <div class="alert alert-success">
                                        <strong><i class="fa fa-calculator"/> Résumé :</strong>
                                        <br/>
                                        <field name="line_count" readonly="1"/> ligne(s) |
                                        <field name="total_quantity" readonly="1"/> unité(s) |
                                        <strong><field name="total_amount" readonly="1" widget="monetary"/></strong>
                                    </div>
                                </div>
                                <div class="col-md-6 text-end">
                                    <button name="action_clear_selection" 
                                            string="🗑️ Vider tout" 
                                            type="object" 
                                            class="btn btn-outline-danger"
                                            confirm="Êtes-vous sûr de vouloir vider votre sélection ?"/>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ========== ACTION POUR LE WIZARD MODERNE ========== -->
    
    <record id="action_construction_quote_wizard_modern" model="ir.actions.act_window">
        <field name="name">Assistant intelligent de devis</field>
        <field name="res_model">construction.quote.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="construction_quote_wizard_form_modern"/>
    </record>
    
</odoo> 