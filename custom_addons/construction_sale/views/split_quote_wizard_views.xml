<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vue Wizard Découpage Devis -->
        <record id="view_split_quote_wizard_form" model="ir.ui.view">
            <field name="name">split.quote.wizard.form</field>
            <field name="model">split.quote.wizard</field>
            <field name="arch" type="xml">
                <form string="Découper le devis">
                    <header>
                        <field name="state" invisible="1"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <i class="fa fa-scissors text-primary mr-2"/>
                                Découper le devis
                            </h1>
                        </div>

                        <!-- Informations du devis -->
                        <group>
                            <group string="Informations du devis">
                                <field name="sale_order_id" readonly="1"/>
                                <field name="chantier_id" readonly="1"/>
                                <field name="order_amount_total" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="Statistiques">
                                <field name="split_line_count" readonly="1"/>
                                <field name="total_split_amount" readonly="1"/>
                                <field name="remaining_amount" readonly="1"/>
                                <field name="subcontractor_count" readonly="1"/>
                            </group>
                        </group>

                        <!-- Lots à découper -->
                        <field name="split_line_ids">
                            <tree editable="bottom">
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="lot_category_id" readonly="1"/>
                                <field name="lot_id" readonly="1"/>
                                <field name="subcontractor_id"/>
                                <field name="amount_assigned" widget="monetary"/>
                                <field name="related_lines_count" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </tree>
                        </field>

                        <div class="mt-3">
                            <button name="action_auto_assign_amounts" 
                                    type="object"
                                    class="btn btn-secondary">
                                <i class="fa fa-magic"/>
                                Répartition automatique
                            </button>
                        </div>
                    </sheet>

                    <footer>
                        <button name="action_create_purchase_orders" 
                                type="object" 
                                class="btn-primary" 
                                string="Créer les bons de commande">
                        </button>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action pour le wizard -->
        <record id="action_split_quote_wizard" model="ir.actions.act_window">
            <field name="name">Découper le devis</field>
            <field name="res_model">split.quote.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_sale_order_id': active_id}</field>
        </record>

    </data>
</odoo> 