<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension of the Sale Order Form View -->
    <record id="view_order_form_inherit_construction" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.construction</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Header Button - Smart Quote Builder -->
            <xpath expr="//header" position="inside">
                <!-- Draft/Sent: Normal button -->
                <button name="action_open_quote_builder"
                        string="Smart Quote Builder"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ['draft', 'sent']"/>
                
                <!-- Confirmed/Done: Admin edit button with warning (handled in Python) -->
                <button name="action_open_quote_builder"
                        string="Éditer (Mode Admin)"
                        type="object"
                        class="btn-warning"
                        invisible="state not in ['sale', 'done']"
                        groups="sales_team.group_sale_manager"/>
                
                <button name="action_resequence_lines"
                        string="↻ Organiser par Lot"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ['draft', 'sent']"/>
                
                <button name="%(construction_sale.action_sale_to_purchase_wizard)d"
                        string="Generate Purchase Orders"
                        type="action"
                        class="btn-secondary"
                        invisible="state not in ['sale', 'done']"
                        groups="sales_team.group_sale_manager"/>
            </xpath>

            <!-- Add Construction Site and Lots in the header -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="chantier_id" options="{'no_create': True}"/>
                <field name="lot_ids" widget="many2many_tags" 
                       options="{'no_create': True}"
                       domain="[('chantier_id', '=', chantier_id)]"/>
            </xpath>

            <!-- Add Columns to the Order Lines List -->
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="lot_id" optional="show"/>
                <field name="room_location" optional="show"/>
                <field name="color" optional="hide"/>
                <field name="dimensions" optional="hide"/>
            </xpath>

            <!-- Add Dimension Fields for "Métré" Calculator -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="dimension_l" optional="hide" string="L (m)"/>
                <field name="dimension_w" optional="hide" string="W (m)"/>
                <field name="dimension_h" optional="hide" string="H (m)"/>
            </xpath>

            <!-- Add Cost & Margin Fields -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="price_buy" optional="hide" 
                       groups="construction_core.group_construction_user,construction_core.group_construction_admin"/>
                <field name="target_margin_percent" optional="hide" string="Margin %"
                       groups="construction_core.group_construction_user,construction_core.group_construction_admin"/>
            </xpath>

            <!-- Technical Notes Column -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <field name="construction_notes" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
