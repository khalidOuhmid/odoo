<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ========== VUE FORMULAIRE SALE.ORDER CONSTRUCTION ========== -->
        
        <record id="sale_order_construction_form" model="ir.ui.view">
            <field name="name">sale.order.construction.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                
                <!-- Ajouter la classe CSS spécifique au formulaire -->
                <xpath expr="//form" position="attributes">
                    <attribute name="class">o_construction_sale</attribute>
                </xpath>
                
                <!-- Ajout des champs construction dans l'en-tête -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <!-- Toujours charger chantier_id mais le rendre invisible si vide -->
                    <field name="chantier_id" invisible="1"/>
                    <field name="chantier_id" 
                           invisible="not chantier_id and not context.get('default_chantier_id', False)"
                           options="{'no_create': True, 'no_edit': True}"/>
                    <field name="lot_ids" widget="many2many_tags" 
                           invisible="not lot_ids and not chantier_id"
                           domain="[('id', 'in', chantier_id.lots_ids if chantier_id else [])]"/>
                </xpath>
                
                <!-- Modification des boutons d'action -->
                <xpath expr="//button[@name='action_quotation_send']" position="after">
                    <button name="action_open_quote_wizard" 
                            string="🚀 Assistant intelligent" 
                            type="object" 
                            class="btn-primary"
                            invisible="state not in ['draft', 'sent'] or not chantier_id"/>

                </xpath>
                
                <!-- Bouton de validation spécialisé -->
                <xpath expr="//button[@name='action_confirm']" position="attributes">
                    <attribute name="invisible">chantier_id</attribute>
                </xpath>
                <xpath expr="//button[@name='action_confirm']" position="after">
                    <button name="action_validate_quote" 
                            string="Valider le devis" 
                            type="object" 
                            class="btn-primary"
                            invisible="state not in ['draft', 'sent'] or not chantier_id"/>
                </xpath>
                
                <!-- Informations supplémentaires dans les lignes -->
                <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="after">
                    <field name="room_location" optional="hide" placeholder="Localisation"/>
                    <field name="floor_level" optional="hide"/>
                    <field name="construction_notes" optional="hide" placeholder="Notes techniques"/>
                </xpath>
                
                <!-- Ajouter une classe spécifique aux lignes de construction -->
                <xpath expr="//field[@name='order_line']//list" position="attributes">
                    <attribute name="class">o_construction_lines</attribute>
                </xpath>
                
                <!-- Statistiques du devis construction -->
                <xpath expr="//group[@name='sale_total']" position="before">
                    <group name="construction_stats" 
                           string="Statistiques construction" 
                           invisible="not chantier_id">
                        <field name="order_line_count" readonly="1"/>
                        <field name="total_quantity" readonly="1"/>
                    </group>
                </xpath>
                
            </field>
        </record>
        
        <!-- ========== VUE LISTE SALE.ORDER CONSTRUCTION ========== -->
        
        <record id="sale_order_construction_tree" model="ir.ui.view">
            <field name="name">sale.order.construction.tree</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                
                <!-- Ajouter classe CSS spécifique à la liste -->
                <xpath expr="//list" position="attributes">
                    <attribute name="class">o_construction_sale_list</attribute>
                </xpath>
                
                <!-- Ajout des colonnes construction -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="chantier_id" optional="show"/>
                    <field name="lot_ids" widget="many2many_tags" optional="hide"/>
                </xpath>
                
                <!-- Affichage du nombre de lignes -->
                <xpath expr="//field[@name='amount_total']" position="after">
                    <field name="order_line_count" optional="hide" string="Nb lignes"/>
                </xpath>
                
            </field>
        </record>
        
        <!-- ========== VUE KANBAN SALE.ORDER CONSTRUCTION ========== -->
        
        <record id="sale_order_construction_kanban" model="ir.ui.view">
            <field name="name">sale.order.construction.kanban</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
            <field name="arch" type="xml">
                
                <!-- Ajouter les champs nécessaires à la vue kanban -->
                <xpath expr="//field[@name='state']" position="after">
                    <field name="chantier_id"/>
                    <field name="lot_ids"/>
                    <field name="order_line_count"/>
                    <field name="total_quantity"/>
                </xpath>
                
            </field>
        </record>
        
        <!-- ========== ACTIONS SPÉCIALISÉES ========== -->
        
        <record id="action_sale_orders_construction" model="ir.actions.act_window">
            <field name="name">Devis construction</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('chantier_id', '!=', False)]</field>
            <field name="context">{
                'search_default_chantier_id': 1,
                'default_chantier_id': active_id,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créez votre premier devis construction !
                </p>
                <p>
                    Utilisez l'assistant intelligent pour créer rapidement 
                    des devis organisés par lots de construction.
                </p>
            </field>
        </record>
        
    </data>
</odoo> 