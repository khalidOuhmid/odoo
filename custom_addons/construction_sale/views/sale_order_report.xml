<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit_construction" inherit_id="sale.report_saleorder_document">
        <xpath expr="//td[@name='td_name']" position="inside">
            <t t-if="line.product_id.description_sale">
                <br/>
                <span t-field="line.product_id.description_sale" class="text-muted small" style="display:block; margin-top: 4px; font-style: italic;"/>
            </t>
            <t t-if="line.lot_id">
                <br/>
                <span class="badge rounded-pill bg-light text-dark border">
                    Lot: <span t-field="line.lot_id.name"/>
                </span>
            </t>
        </xpath>
    </template>
</odoo>
