<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========== POPUP SIMPLE D'AJOUT DE PRODUIT ========== -->

    <record id="product_add_dialog_form" model="ir.ui.view">
        <field name="name">construction.product.dialog.form</field>
        <field name="model">construction.product.dialog</field>
        <field name="arch" type="xml">
            <form string="Ajouter un produit" options="{'no_save': true, 'no_discard': true}">
                <header>

                </header>

                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="product_name" readonly="1" nolabel="1"/>
                        </h2>
                        <h3 class="text-muted">
                            Coût (base) : <field name="base_price" readonly="1" widget="monetary"/>
                        </h3>
                    </div>

                    <!-- Champs cachés -->
                    <group invisible="1">
                        <field name="quote_wizard_id"/>
                        <field name="product_id"/>
                        <field name="available_lot_ids"/>
                    </group>

                    <group>
                        <group string="📦 Quantité et unité">
                            <field name="quantity"
                                   decoration-danger="quantity &lt;= 0"/>
                            <field name="uom_id" 
                                   placeholder="Sélectionner une unité..."
                                   help="m², ml, lots, kg, pièces, etc."/>
                        </group>

                        <group string="💰 Tarification">
                            <field name="margin_percent"/>
                            <field name="unit_price" readonly="1" widget="monetary"/>
                            <field name="total_price" readonly="1" widget="monetary"
                                   decoration-success="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="📍 Localisation">
                            <field name="room_number" placeholder="S01, C12..."/>
                            <field name="room_location" placeholder="Salon, Cuisine..."/>
                        </group>

                        <group string="🏗️ Lot">
                            <field name="lot_id"
                                   placeholder="Sélectionner un lot..."
                                   domain="[('id', 'in', available_lot_ids)]"/>
                        </group>
                    </group>

                    <group string="📝 Description/Notes">
                        <field name="description" nolabel="1"
                               placeholder="Notes techniques, spécifications..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_add" string="✅ Confirmer et ajouter"
                            type="object" class="btn-primary"
                            title="Ajouter ce produit au devis"/>
                    <button name="action_cancel" string="❌ Annuler"
                            type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ========== POPUP CRÉATION DE PRODUIT ========== -->

    <record id="product_creator_form" model="ir.ui.view">
        <field name="name">construction.product.creator.form</field>
        <field name="model">construction.product.creator</field>
        <field name="arch" type="xml">
            <form string="Créer un nouveau produit" options="{'no_save': true, 'no_discard': true}">
                <header>

                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>🆕 Nouveau produit personnalisé</h1>
                        <p class="text-muted">Créez un produit spécifique à vos besoins et ajoutez-le directement au
                            devis</p>
                    </div>

                    <!-- Champs cachés -->
                    <group invisible="1">
                        <field name="quote_wizard_id"/>
                    </group>

                    <group>
                        <group string="📦 Informations produit">
                            <field name="name"/>
                            <field name="default_code"/>
                            <field name="categ_id"/>
                            <field name="uom_id" 
                                   placeholder="Sélectionner une unité..."
                                   help="m², ml, lots, kg, pièces, etc."/>
                        </group>

                        <group string="💰 Tarification">
                            <field name="standard_price" string="Coût" widget="monetary"/>
                            <span class="o_form_label">Prix de vente (calculé) = Coût × (1 + Marge %)</span>
                            <field name="computed_sale_price" string="Prix de vente (calculé)" widget="monetary"/>
                            <field name="list_price" invisible="1"/>
                        </group>
                    </group>

                    <group string="📝 Description">
                        <field name="description_sale" nolabel="1"/>
                    </group>

                    <group>
                        <group string="🏗️ Lot associé">
                            <field name="lot_ids" nolabel="1"/>
                        </group>


                    </group>
                </sheet>
                <footer>
                    <button name="action_create_product" string="✅ Créer le produit"
                            type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler"
                            type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ========== ACTION POUR AJOUTER DEPUIS LE CATALOGUE ========== -->

    <record id="action_add_product_from_catalog" model="ir.actions.act_window">
        <field name="name">Ajouter un produit</field>
        <field name="res_model">construction.product.dialog</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="product_add_dialog_form"/>
        <field name="context">{
            'default_product_id': context.get('default_product_id'),
            'default_quote_wizard_id': context.get('default_quote_wizard_id'),
        }</field>

    </record>

    <!-- ========== ÉDITEUR DE LIGNE ========== -->

    <record id="line_editor_form" model="ir.ui.view">
        <field name="name">construction.line.editor.form</field>
        <field name="model">construction.line.editor</field>
        <field name="arch" type="xml">
            <form string="Modifier la ligne" options="{'no_save': true, 'no_discard': true}">
                <header>

                </header>

                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="product_name" readonly="1" nolabel="1"/>
                        </h2>
                    </div>

                    <!-- Champs cachés -->
                    <group invisible="1">
                        <field name="quote_line_id"/>
                        <field name="available_lot_ids"/>
                    </group>

                    <group>
                        <group string="📦 Quantité et unité">
                            <field name="quantity"
                                   decoration-danger="quantity &lt;= 0"/>
                            <field name="uom_id" 
                                   placeholder="Sélectionner une unité..."
                                   help="m², ml, lots, kg, pièces, etc."/>
                        </group>

                        <group string="💰 Tarification">
                            <field name="price_unit" widget="monetary"/>
                            <field name="margin_percent"/>
                        </group>
                    </group>

                    <group>
                        <group string="📍 Localisation">
                            <field name="room_number" placeholder="S01, C12..."/>
                            <field name="room_location" placeholder="Salon, Cuisine..."/>
                        </group>

                        <group string="🏗️ Lot">
                            <field name="lot_id"
                                   placeholder="Sélectionner un lot..."
                                   domain="[('id', 'in', available_lot_ids)]"/>
                        </group>
                    </group>

                    <group string="📝 Notes">
                        <field name="construction_notes" nolabel="1"
                               placeholder="Notes techniques, spécifications..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_changes" string="✅ Sauvegarder"
                            type="object" class="btn-primary"
                            title="Sauvegarder les modifications"/>
                    <button name="action_cancel" string="❌ Annuler"
                            type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ========== POPUP DE CONFIRMATION D'ANNULATION ========== -->

    <record id="wizard_cancel_confirm_form" model="ir.ui.view">
        <field name="name">construction.wizard.cancel.confirm.form</field>
        <field name="model">construction.wizard.cancel.confirm</field>
        <field name="arch" type="xml">
            <form string="Attention - Progression en cours" options="{'no_save': true, 'no_discard': true}">
                <header>

                </header>

                <sheet>
                    <div class="alert alert-warning text-center" role="alert">
                        <h3><i class="fa fa-exclamation-triangle"/> Attention</h3>
                        <p>Vous avez <strong><field name="line_count" readonly="1"/> produit(s)</strong> sélectionné(s) en attente d'ajout au devis.</p>
                        <p>Si vous fermez maintenant, <strong>vous risquez de perdre votre progression</strong>.</p>
                    </div>

                    <!-- Champs cachés -->
                    <group invisible="1">
                        <field name="wizard_id"/>
                    </group>

                    <div class="text-center mt16">
                        <h4>Que voulez-vous faire ?</h4>
                    </div>
                </sheet>
                <footer>
                    <button name="action_save_and_close" string="💾 Sauvegarder et fermer"
                            type="object" class="btn-success"
                            title="Ajouter les produits sélectionnés au devis et fermer"/>
                    <button name="action_continue_wizard" string="↩️ Continuer l'assistant"
                            type="object" class="btn-primary"
                            title="Retourner à l'assistant pour continuer"/>
                    <button name="action_confirm_cancel" string="🗑️ Fermer sans sauvegarder"
                            type="object" class="btn-danger"
                            title="Perdre la progression et fermer"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>