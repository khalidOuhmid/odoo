<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Template email pour contrats de sous-traitance -->
        <record id="email_template_subcontractor_contract" model="mail.template">
            <field name="name">Contrat de sous-traitance</field>
            <field name="model_id" ref="model_construction_subcontractor_contract"/>
            <field name="subject">Contrat de sous-traitance - {{ object.chantier_id.name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.subcontractor_id.email }}</field>
            <field name="partner_to">{{ object.subcontractor_id.id }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Bonjour {{ object.subcontractor_id.name }},</p>
                    
                    <p>Veuillez trouver ci-joint votre contrat de sous-traitance pour le chantier <strong>{{ object.chantier_id.name }}</strong>.</p>
                    
                    <div style="margin: 20px 0px; padding: 15px; background-color: #f8f9fa; border-left: 4px solid #007bff;">
                        <h3 style="margin-top: 0px;">📋 Détails du contrat</h3>
                        <ul>
                            <li><strong>Numéro :</strong> {{ object.contract_number }}</li>
                            <li><strong>Chantier :</strong> {{ object.chantier_id.name }}</li>
                            <li><strong>Adresse :</strong> {{ object.chantier_id.address }}</li>
                            <li><strong>Montant :</strong> {{ object.total_amount }} {{ object.currency_id.symbol }}</li>
                            <li><strong>Date de début :</strong> {{ object.start_date }}</li>
                        </ul>
                    </div>
                    
                    <p>Vous pouvez également consulter et signer le contrat en ligne :</p>
                    <p style="text-align: center; margin: 20px 0px;">
                        <a href="{{ object.portal_url }}" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
                            🌐 Accéder au portail
                        </a>
                    </p>
                    
                    <p>Pour toute question concernant ce contrat, n'hésitez pas à nous contacter.</p>
                    
                    <p>Cordialement,<br/>
                    {{ user.company_id.name }}</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
            <field name="attachment_ids" eval="[(6, 0, [])]"/>
        </record>

    </data>
</odoo>
