<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- =================== CATÉGORIES DE PRODUITS =================== -->
        
        <record id="test_product_category_electricity" model="product.category">
            <field name="name">Électricité</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <record id="test_product_category_plumbing" model="product.category">
            <field name="name">Plomberie</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <record id="test_product_category_painting" model="product.category">
            <field name="name">Peinture</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <record id="test_product_category_masonry" model="product.category">
            <field name="name">Maçonnerie</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <!-- =================== PRODUITS DE SERVICE =================== -->
        
        <record id="test_product_electricity_service" model="product.template">
            <field name="name">Installation électrique complète</field>
            <field name="categ_id" ref="test_product_category_electricity"/>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price" eval="8500.0"/>
            <field name="standard_price" eval="7000.0"/>
            <field name="description">Installation électrique complète incluant tableau, prises, éclairage</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <record id="test_product_plumbing_service" model="product.template">
            <field name="name">Installation plomberie complète</field>
            <field name="categ_id" ref="test_product_category_plumbing"/>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price" eval="12000.0"/>
            <field name="standard_price" eval="10000.0"/>
            <field name="description">Installation plomberie complète incluant salle de bain, cuisine, chauffage</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <record id="test_product_painting_service" model="product.template">
            <field name="name">Peinture intérieure et extérieure</field>
            <field name="categ_id" ref="test_product_category_painting"/>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price" eval="3500.0"/>
            <field name="standard_price" eval="2800.0"/>
            <field name="description">Peinture intérieure et extérieure avec finitions</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <record id="test_product_masonry_service" model="product.template">
            <field name="name">Gros œuvre - Fondations et structure</field>
            <field name="categ_id" ref="test_product_category_masonry"/>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price" eval="45000.0"/>
            <field name="standard_price" eval="38000.0"/>
            <field name="description">Gros œuvre incluant fondations, murs porteurs, charpente, toiture</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <record id="test_product_electricity_house_service" model="product.template">
            <field name="name">Installation électrique maison</field>
            <field name="categ_id" ref="test_product_category_electricity"/>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price" eval="15000.0"/>
            <field name="standard_price" eval="12000.0"/>
            <field name="description">Installation électrique complète pour maison individuelle</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <record id="test_product_plumbing_house_service" model="product.template">
            <field name="name">Installation plomberie maison</field>
            <field name="categ_id" ref="test_product_category_plumbing"/>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price" eval="18000.0"/>
            <field name="standard_price" eval="15000.0"/>
            <field name="description">Installation plomberie complète, 2 salles de bain, cuisine</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <record id="test_product_painting_house_service" model="product.template">
            <field name="name">Peinture complète maison</field>
            <field name="categ_id" ref="test_product_category_painting"/>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price" eval="8000.0"/>
            <field name="standard_price" eval="6500.0"/>
            <field name="description">Peinture intérieure et extérieure, finitions complètes</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <!-- =================== PRODUITS MATÉRIEL =================== -->
        
        <record id="test_product_electrical_material" model="product.template">
            <field name="name">Matériel électrique</field>
            <field name="categ_id" ref="test_product_category_electricity"/>
            <field name="type">consu</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="list_price" eval="150.0"/>
            <field name="standard_price" eval="120.0"/>
            <field name="description">Matériel électrique divers (prises, interrupteurs, câbles)</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <record id="test_product_plumbing_material" model="product.template">
            <field name="name">Matériel plomberie</field>
            <field name="categ_id" ref="test_product_category_plumbing"/>
            <field name="type">consu</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="list_price" eval="200.0"/>
            <field name="standard_price" eval="160.0"/>
            <field name="description">Matériel plomberie divers (tuyaux, robinets, raccords)</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <record id="test_product_paint_material" model="product.template">
            <field name="name">Peinture et accessoires</field>
            <field name="categ_id" ref="test_product_category_painting"/>
            <field name="type">consu</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="list_price" eval="50.0"/>
            <field name="standard_price" eval="40.0"/>
            <field name="description">Peinture et accessoires de peinture</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

        <record id="test_product_masonry_material" model="product.template">
            <field name="name">Matériel maçonnerie</field>
            <field name="categ_id" ref="test_product_category_masonry"/>
            <field name="type">consu</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="list_price" eval="300.0"/>
            <field name="standard_price" eval="250.0"/>
            <field name="description">Matériel maçonnerie divers (ciment, briques, parpaings)</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
        </record>

    </data>
</odoo>
