<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Contract Generation Wizard Views -->
        
        <!-- Main wizard form view -->
        <record id="view_contract_generation_wizard_form" model="ir.ui.view">
            <field name="name">construction.contract.generation.wizard.form</field>
            <field name="model">construction.contract.generation.wizard</field>
            <field name="arch" type="xml">
                <form string="Contract Generation Wizard" class="o_contract_generation_wizard">
                    <header>
                        <!-- Step buttons -->
                        <button name="action_generate_preview"
                                string="Generate Preview"
                                type="object"
                                class="btn-primary"
                                invisible="current_step != 'config'"
                                data-hotkey="p"/>
                        
                        <button name="action_generate_contract"
                                string="Generate Contract"
                                type="object"
                                class="btn-success"
                                invisible="current_step != 'preview'"
                                data-hotkey="g"/>
                        
                        <button name="action_back_to_config"
                                string="Back to Configuration"
                                type="object"
                                class="btn-secondary"
                                invisible="current_step == 'config'"/>
                        
                        <button name="action_modify_and_regenerate"
                                string="Modify and Regenerate"
                                type="object"
                                class="btn-warning"
                                invisible="current_step != 'preview'"/>
                        
                        <!-- Step indicator -->
                        <field name="current_step" widget="statusbar" statusbar_visible="config,preview,finalize"/>
                    </header>
                    
                    <sheet>
                        <!-- Configuration Step -->
                        <div invisible="current_step != 'config'">
                            <div class="oe_title">
                                <h1>Contract Configuration</h1>
                            </div>
                            
                            <!-- Main configuration -->
                            <group>
                                <group string="Basic Information">
                                    <field name="chantier_id" options="{'no_create': True}"/>
                                    <field name="subcontractor_id" options="{'no_create': True}"/>
                                    <field name="lot_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                                
                                <group string="Contract Terms">
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="total_amount" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="payment_terms"/>
                                    <field name="warranty_period"/>
                                    <field name="insurance_required"/>
                                </group>
                            </group>
                            
                            <!-- Additional information -->
                            <group>
                                <group string="Legal Information">
                                    <field name="urssaf_code"/>
                                </group>
                                
                                <group string="Additional Information">
                                    <field name="notes" nolabel="1" placeholder="Additional notes for the contract..."/>
                                </group>
                            </group>
                            
                            <!-- Multi-lot information -->
                            <div invisible="not is_multi_lot">
                                <div class="alert alert-info">
                                    <strong>Multi-Lot Contract</strong><br/>
                                    This contract will include <field name="lot_count" readonly="1"/> lot(s): <field name="lot_names" readonly="1"/>
                                </div>
                            </div>
                            
                            <!-- Options -->
                            <group>
                                <group string="Generation Options">
                                    <field name="send_email"/>
                                    <field name="auto_send"/>
                                </group>
                            </group>
                        </div>
                        
                        <!-- Preview Step -->
                        <div invisible="current_step != 'preview'">
                            <div class="oe_title">
                                <h1>Contract Preview</h1>
                            </div>
                            
                            <!-- Preview content -->
                            <div class="o_contract_preview">
                                <field name="preview_html" widget="html" nolabel="1"/>
                            </div>
                        </div>
                        
                        <!-- Finalization Step -->
                        <div invisible="current_step != 'finalize'">
                            <div class="oe_title">
                                <h1>Contract Generated Successfully</h1>
                            </div>
                            
                            <!-- Contract information -->
                            <group>
                                <group string="Generated Contract">
                                    <field name="generated_contract_id" readonly="1"/>
                                    <field name="generated_contract_number" readonly="1"/>
                                    <field name="generated_contract_state" readonly="1"/>
                                </group>
                            </group>
                            
                            <!-- Success message -->
                            <div class="alert alert-success">
                                <strong>Contract Generated Successfully!</strong><br/>
                                The contract has been created and is ready for use.
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Wizard action -->
        <record id="action_contract_generation_wizard" model="ir.actions.act_window">
            <field name="name">Contract Generation Wizard</field>
            <field name="res_model">construction.contract.generation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="help" type="html">
                <div class="o_view_nocontent_smiling_face">
                    <p>Generate construction contracts</p>
                    <p>Create professional contracts for your construction projects.</p>
                </div>
            </field>
        </record>
        
        <!-- Menu items -->
        <menuitem id="menu_contract_generation_wizard"
                  name="Contract Generation"
                  parent="construction_base.menu_construction_management"
                  action="action_contract_generation_wizard"
                  sequence="10"/>
        
        <!-- Context menu for construction sites -->
        <record id="action_contract_generation_from_chantier" model="ir.actions.act_window">
            <field name="name">Generate Contract</field>
            <field name="res_model">construction.contract.generation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_chantier_id': active_id}</field>
        </record>
        
        <!-- Context menu for lots -->
        <record id="action_contract_generation_from_lot" model="ir.actions.act_window">
            <field name="name">Generate Contract</field>
            <field name="res_model">construction.contract.generation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_lot_ids': [(6, 0, [active_id])]}</field>
        </record>
        
    </data>
</odoo>
