<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================================================================
             WIZARD GÉNÉRATION CONTRAT - Odoo 18
        ===================================================================-->

        <!-- Vue principale du wizard -->
        <record id="view_contract_generation_wizard_form" model="ir.ui.view">
            <field name="name">construction.contract.generation.wizard.form</field>
            <field name="model">construction.contract.generation.wizard</field>
            <field name="arch" type="xml">
                <form string="Générateur de contrats" class="o_contract_generation_wizard">
                    <header>
                        <!-- Boutons selon l'étape -->
                        <button name="action_generate_preview"
                                string="👁️ Générer aperçu"
                                type="object"
                                class="btn-primary"
                                invisible="current_step != 'config'"
                                data-hotkey="p"/>

                        <button name="action_generate_final_contract"
                                string="📄 Générer contrat final"
                                type="object"
                                class="btn-success"
                                invisible="current_step != 'preview'"
                                data-hotkey="g"/>

                        <button name="action_back_to_config"
                                string="◀️ Retour à la configuration"
                                type="object"
                                class="btn-secondary"
                                invisible="current_step == 'config'"/>

                        <button name="action_modify_and_regenerate"
                                string="🔄 Modifier et régénérer"
                                type="object"
                                class="btn-warning"
                                invisible="current_step != 'preview'"
                                data-hotkey="m"/>

                        <button special="cancel"
                                string="Fermer"
                                class="btn-secondary"/>
                    </header>

                    <sheet class="o_form_sheet_bg">
                            <!-- Indicateur de progression -->
                        <div class="o_wizard_steps mb-4">
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: 33%;" invisible="current_step != 'config'"/>
                                <div class="progress-bar bg-primary" role="progressbar" style="width: 66%;" invisible="current_step != 'preview'"/>
                                <div class="progress-bar bg-primary" role="progressbar" style="width: 100%;" invisible="current_step != 'finalize'"/>
                            </div>
                            <div class="d-flex justify-content-between mt-2">
                                <div class="text-center text-primary fw-bold" invisible="current_step != 'config'">
                                    <i class="fa fa-cog fa-2x mb-1"/>
                                    <div><small>Configuration</small></div>
                                </div>
                                <div class="text-center text-muted" invisible="current_step == 'config'">
                                    <i class="fa fa-cog fa-2x mb-1"/>
                                    <div><small>Configuration</small></div>
                                </div>

                                <div class="text-center text-primary fw-bold" invisible="current_step != 'preview'">
                                    <i class="fa fa-eye fa-2x mb-1"/>
                                    <div><small>Aperçu</small></div>
                                </div>
                                 <div class="text-center text-muted" invisible="current_step == 'preview'">
                                    <i class="fa fa-eye fa-2x mb-1"/>
                                    <div><small>Aperçu</small></div>
                                </div>

                                <div class="text-center text-success fw-bold" invisible="current_step != 'finalize'">
                                    <i class="fa fa-check fa-2x mb-1"/>
                                    <div><small>Finalisation</small></div>
                                </div>
                                 <div class="text-center text-muted" invisible="current_step == 'finalize'">
                                    <i class="fa fa-check fa-2x mb-1"/>
                                    <div><small>Finalisation</small></div>
                                </div>
                            </div>
                        </div>

                        <!-- Titre avec étape actuelle -->
                        <div class="oe_title mb-4">
                            <div class="d-flex align-items-center mb-3">
                                <span class="fa fa-file-contract fa-3x text-primary me-3"></span>
                                <div>
                                    <h1 class="mb-0">
                                        <span invisible="current_step != 'config'">⚙️ Configuration du contrat</span>
                                        <span invisible="current_step != 'preview'">👁️ Aperçu du contrat</span>
                                        <span invisible="current_step != 'finalize'">✅ Contrat généré</span>
                                    </h1>
                                    <p class="text-muted mb-0">
                                        <span invisible="current_step != 'config'">Configurez les paramètres du contrat</span>
                                        <span invisible="current_step != 'preview'">Vérifiez et validez l'aperçu</span>
                                        <span invisible="current_step != 'finalize'">Contrat créé avec succès</span>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- ÉTAPE 1 : CONFIGURATION -->
                        <div invisible="current_step != 'config'">
                            <div class="alert alert-info mb-4">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-info-circle me-2"></i>
                                    <div>
                                        <strong>Étape 1 :</strong> Configurez les informations du contrat
                                    </div>
                                </div>
                            </div>

                            <notebook class="o_notebook">
                                <!-- Informations générales -->
                                <page string="📋 Informations générales" name="general_config">
                                    <div class="row">
                                        <div class="col-lg-6">
                                            <group string="🎯 Projet" class="mb-4">
                                                <field name="chantier_id"
                                                       required="1"
                                                       options="{'no_create': True}"/>
                                                <field name="subcontractor_id"
                                                       required="1"
                                                       domain="[('supplier_rank', '>', 0)]"
                                                       context="{'default_supplier_rank': 1}"/>
                                                <field name="lot_ids"
                                                       widget="many2many_tags"
                                                       domain="[('chantier_id', '=', chantier_id)]"
                                                       required="1"/>
                                            </group>
                                        </div>

                                        <div class="col-lg-6">
                                            <group string="💰 Financier" class="mb-4">
                                                <field name="total_amount"
                                                       widget="monetary"
                                                       required="1"/>
                                                <field name="currency_id" invisible="1"/>
                                                <field name="payment_terms" required="1"/>
                                            </group>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-6">
                                            <group string="📅 Planning" class="mb-4">
                                                <field name="start_date" required="1"/>
                                                <field name="end_date"/>
                                            </group>
                                        </div>

                                        <div class="col-lg-6">
                                            <group string="🛡️ Garanties" class="mb-4">
                                                <field name="warranty_period"/>
                                                <field name="insurance_required"/>
                                            </group>
                                            <group string="📊 Code URSSAF" class="mb-4">
                                                <field name="urssaf_code" required="1"/>
                                            </group>
                                        </div>
                                    </div>
                                </page>

                                <!-- Notes et options -->
                                <page string="📝 Notes et options" name="notes_config">
                                    <group string="📝 Notes contractuelles">
                                        <field name="notes"
                                               nolabel="1"
                                               placeholder="Ajoutez ici des clauses spéciales, notes ou commentaires pour ce contrat..."
                                               widget="text"/>
                                    </group>

                                    <group string="📧 Options d'envoi">
                                        <field name="send_email"/>
                                        <field name="auto_send"/>
                                    </group>
                                </page>
                            </notebook>
                        </div>

                        <!-- ÉTAPE 2 : APERÇU -->
                        <div invisible="current_step != 'preview'">
                            <div class="alert alert-success mb-4">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-check-circle me-2"></i>
                                    <div>
                                        <strong>Aperçu généré !</strong> Vérifiez le contenu avant génération finale
                                    </div>
                                </div>
                            </div>

                            <!-- Résumé des paramètres -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">📋 Résumé de la configuration</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <strong>🏗️ Chantier :</strong><br/>
                                            <field name="chantier_id" readonly="1" options="{'no_open': True}"/>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>👷 Sous-traitant :</strong><br/>
                                            <field name="subcontractor_id" readonly="1" options="{'no_open': True}"/>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>📦 Lots :</strong><br/>
                                            <field name="lot_ids" readonly="1" widget="many2many_tags" options="{'no_open': True}"/>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>💰 Montant :</strong><br/>
                                            <field name="total_amount" readonly="1" widget="monetary"/>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-4">
                                            <strong>📅 Début :</strong> <field name="start_date" readonly="1"/>
                                        </div>
                                        <div class="col-md-4">
                                            <strong>💳 Paiement :</strong>
                                            <field name="payment_terms" readonly="1"/>
                                        </div>
                                        <div class="col-md-4">
                                            <strong>🛡️ Garantie :</strong>
                                            <field name="warranty_period" readonly="1"/> mois
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Aperçu HTML -->
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-eye me-2"></i>
                                        Aperçu du contrat
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div style="max-height: 600px; overflow-y: auto; border: 1px solid #dee2e6;">
                                        <field name="preview_html" widget="html" readonly="1"/>
                                    </div>
                                </div>
                                <div class="card-footer bg-light">
                                    <small class="text-muted">
                                        <i class="fa fa-info-circle"></i>
                                        Cet aperçu correspond exactement au PDF qui sera généré
                                    </small>
                                </div>
                            </div>

                            <!-- Options finales -->
                            <div class="card mt-4">
                                <div class="card-header bg-warning">
                                    <h5 class="mb-0">
                                        <i class="fa fa-cogs me-2"></i>
                                        Options de génération finale
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-check form-switch mb-3">
                                                <field name="send_email" widget="boolean_toggle"/>
                                                <label for="send_email" class="form-check-label ms-2">
                                                    <strong>📧 Envoyer par email</strong><br/>
                                                    <small class="text-muted">Envoyer automatiquement le contrat au sous-traitant</small>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check form-switch mb-3">
                                                <field name="auto_send" widget="boolean_toggle"/>
                                                <label for="auto_send" class="form-check-label ms-2">
                                                    <strong>🔄 Envoi automatique</strong><br/>
                                                    <small class="text-muted">Renvoyer automatiquement après modification</small>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ÉTAPE 3 : FINALISATION -->
                        <div invisible="current_step != 'finalize'">
                            <div class="alert alert-success mb-4">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-check-circle fa-2x me-3"></i>
                                    <div>
                                        <h4 class="mb-1">🎉 Contrat généré avec succès !</h4>
                                        <p class="mb-0">Le contrat a été créé et
                                        <span invisible="not send_email">envoyé par email au sous-traitant</span>
                                        <span invisible="send_email">est prêt à être envoyé</span>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Informations du contrat généré -->
                            <div class="card" invisible="not generated_contract_id">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-file-contract me-2"></i>
                                        Contrat généré
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <h6>📄 Informations du contrat</h6>
                                            <p><strong>Numéro :</strong> <field name="generated_contract_number" readonly="1"/></p>
                                            <p><strong>État :</strong> <field name="generated_contract_state" readonly="1"/></p>
                                            <p><strong>Créé le :</strong> <field name="generated_contract_create_date" readonly="1"/></p>
                                        </div>
                                        <div class="col-md-4 text-end">
                                            <button name="%(action_subcontractor_contract)d"
                                                    string="👁️ Voir le contrat"
                                                    type="action"
                                                    class="btn btn-primary btn-lg"
                                                    context="{'default_id': generated_contract_id}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Actions suivantes -->
                            <div class="card mt-4">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-rocket me-2"></i>
                                        Prochaines étapes
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4 text-center">
                                            <i class="fa fa-envelope fa-3x text-info mb-2"></i>
                                            <h6>📧 Envoi</h6>
                                            <p><small>Le contrat
                                            <span invisible="not send_email">a été envoyé</span>
                                            <span invisible="send_email">peut être envoyé</span>
                                            au sous-traitant</small></p>
                                        </div>
                                        <div class="col-md-4 text-center">
                                            <i class="fa fa-signature fa-3x text-warning mb-2"></i>
                                            <h6>✍️ Signature</h6>
                                            <p><small>Le sous-traitant peut signer électroniquement via le portail</small></p>
                                        </div>
                                        <div class="col-md-4 text-center">
                                            <i class="fa fa-play fa-3x text-success mb-2"></i>
                                            <h6>🚀 Démarrage</h6>
                                            <p><small>Les travaux peuvent commencer après signature</small></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Champs cachés pour le contexte -->
                        <field name="current_step" invisible="1"/>
                        <field name="preview_ready" invisible="1"/>
                        <field name="generated_contract_id" invisible="1"/>
                    </sheet>

                    <!-- CSS personnalisé pour Odoo 18 -->
                    <style>
                        .o_contract_generation_wizard .card {
                            border-radius: 8px;
                            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
                            margin-bottom: 1.5rem;
                        }

                        .o_contract_generation_wizard .card-header {
                            border-radius: 8px 8px 0 0;
                            font-weight: 600;
                        }

                        .o_contract_generation_wizard .progress {
                            border-radius: 10px;
                            background-color: #e9ecef;
                        }

                        .o_contract_generation_wizard .progress-bar {
                            border-radius: 10px;
                            transition: width 0.3s ease;
                        }

                        .o_contract_generation_wizard .o_wizard_steps {
                            background: #f8f9fa;
                            padding: 20px;
                            border-radius: 8px;
                            border: 1px solid #dee2e6;
                        }

                        .o_contract_generation_wizard .btn {
                            border-radius: 6px;
                            font-weight: 500;
                        }

                        .o_contract_generation_wizard .alert {
                            border-radius: 6px;
                            border: none;
                        }

                        .o_contract_generation_wizard .form-check-input {
                            border-radius: 1rem;
                        }

                        .o_contract_generation_wizard .o_notebook .nav-link {
                            border-radius: 8px 8px 0 0;
                            font-weight: 500;
                        }

                        .o_contract_generation_wizard .o_notebook .nav-link.active {
                            background-color: #0d6efd;
                            border-color: #0d6efd;
                            color: white;
                        }
                    </style>
                </form>
            </field>
        </record>

        <!-- ================================================================
             VUES SPÉCIFIQUES PAR ÉTAPE (Optionnelles)
        ===================================================================-->

        <!-- Vue pour l'étape de configuration uniquement -->
        <record id="view_contract_generation_wizard_config" model="ir.ui.view">
            <field name="name">construction.contract.generation.wizard.config</field>
            <field name="model">construction.contract.generation.wizard</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="view_contract_generation_wizard_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form[hasclass('o_contract_generation_wizard')]" position="attributes">
                    <attribute name="class">o_contract_generation_wizard o_wizard_config_step</attribute>
                </xpath>
            </field>
        </record>

        <!-- ================================================================
             ACTIONS
        ===================================================================-->

        <!-- Action principale -->
        <record id="action_contract_generation_wizard" model="ir.actions.act_window">
            <field name="name">📋 Générateur de contrats de sous-traitance</field>
            <field name="res_model">construction.contract.generation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_contract_generation_wizard_form"/>
            <field name="context">{
                'dialog_size': 'extra-large',
                'create': False
            }</field>
            <field name="help" type="html">
                <div class="o_view_nocontent_smiling_face">
                    <div class="text-center py-5">
                        <i class="fa fa-file-contract fa-5x text-primary mb-4" style="opacity: 0.6;"></i>
                        <h3 class="text-primary">Générateur de contrats</h3>
                        <p class="lead text-muted mb-4">
                            Créez des contrats de sous-traitance professionnels en 3 étapes
                        </p>
                        <div class="row justify-content-center">
                            <div class="col-md-8">
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <div class="card border-primary">
                                            <div class="card-body text-center">
                                                <i class="fa fa-cog fa-2x text-primary mb-2"></i>
                                                <h5>Configuration</h5>
                                                <p class="small mb-0">Sélectionnez chantier, lots et conditions</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="card border-warning">
                                            <div class="card-body text-center">
                                                <i class="fa fa-eye fa-2x text-warning mb-2"></i>
                                                <h5>Aperçu</h5>
                                                <p class="small mb-0">Vérifiez et modifiez le contrat</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="card border-success">
                                            <div class="card-body text-center">
                                                <i class="fa fa-check fa-2x text-success mb-2"></i>
                                                <h5>Génération</h5>
                                                <p class="small mb-0">Créez et envoyez le contrat final</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </field>
        </record>

        <!-- Action rapide depuis un lot -->
        <record id="action_contract_generation_from_lot" model="ir.actions.act_window">
            <field name="name">📋 Nouveau contrat pour ce lot</field>
            <field name="res_model">construction.contract.generation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_contract_generation_wizard_form"/>
            <field name="context">{
                'dialog_size': 'extra-large',
                'create': False,
                'default_chantier_id': active_model == 'construction.lot' and context.get('chantier_id'),
                'default_lot_ids': active_model == 'construction.lot' and [(6, 0, [active_id])],
                'from_lot': True
            }</field>
        </record>
    </data>
</odoo>
