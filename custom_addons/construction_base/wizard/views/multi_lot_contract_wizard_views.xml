<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire du wizard -->
    <record id="view_multi_lot_contract_wizard_form" model="ir.ui.view">
        <field name="name">construction.multi.lot.contract.wizard.form</field>
        <field name="model">construction.multi.lot.contract.wizard</field>
        <field name="arch" type="xml">
            <form string="Contrat unifié - Plusieurs lots">
                <header>
                    <button name="action_generate_contract"
                            string="📄 Générer contrat"
                            type="object"
                            class="btn-primary"
                            icon="fa-file-text"
                            invisible="contract_generated"/>
                    <button name="action_generate_preview"
                            string="👁️ Aperçu"
                            type="object"
                            class="btn-secondary"
                            icon="fa-eye"
                            attrs="{'invisible': [('preview_ready', '=', True)]}"/>
                    <button name="action_view_contract"
                            string="👁️ Voir contrat"
                            type="object"
                            class="btn-info"
                            icon="fa-eye"
                            invisible="not contract_generated"/>
                    <button name="action_view_purchase_orders"
                            string="🛒 Bons de commande"
                            type="object"
                            class="btn-secondary"
                            icon="fa-shopping-cart"
                            invisible="not lot_ids"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="subcontractor_id" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="chantier_id" readonly="1"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group>
                            <field name="lot_count" readonly="1"/>
                            <field name="total_amount" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="contract_generated" invisible="1"/>
                            <field name="generated_contract_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Onglet Lots -->
                        <page string="📦 Lots concernés" name="lots">
                            <field name="lot_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="price" widget="monetary"/>
                                    <field name="price_from_quote" widget="monetary" string="Prix devis"/>
                                    <field name="is_finished" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- Onglet Documents -->
                        <page string="📋 Documents disponibles" name="documents">
                            <div class="alert alert-info">
                                <h4>📄 Documents qui seront joints au contrat</h4>
                                <p>Le contrat généré inclura automatiquement tous les documents disponibles pour chaque lot.</p>
                            </div>
                            <group>
                                <group>
                                    <field name="include_cctp"/>
                                    <field name="include_general_planning"/>
                                </group>
                                <group>
                                    <field name="include_subcontractor_planning"/>
                                    <field name="include_purchase_orders"/>
                                </group>
                            </group>
                            <field name="available_documents" nolabel="1"/>
                        </page>
                        
                        <!-- Onglet Configuration -->
                        <page string="⚙️ Configuration contrat" name="config">
                            <group>
                                <group>
                                    <field name="contract_start_date"/>
                                    <field name="contract_end_date"/>
                                    <field name="payment_terms"/>
                                </group>
                                <group>
                                    <field name="warranty_period"/>
                                    <field name="insurance_required"/>
                                    <field name="urssaf_code"/>
                                </group>
                            </group>
                            
                            <field name="contract_notes" placeholder="Notes additionnelles pour le contrat..."/>
                            
                            <group>
                                <group>
                                    <field name="send_email"/>
                                </group>
                                <group>
                                    <field name="auto_send"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <group attrs="{'invisible': [('preview_ready', '=', False)]}">
                        <separator string="Aperçu"/>
                        <field name="preview_html" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action pour ouvrir le wizard -->
    <record id="action_multi_lot_contract_wizard" model="ir.actions.act_window">
        <field name="name">Contrat unifié - Plusieurs lots</field>
        <field name="res_model">construction.multi.lot.contract.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
