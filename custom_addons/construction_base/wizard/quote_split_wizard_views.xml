<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================
             FORMULAIRE WIZARD
        ===================================================================-->
        <record id="view_quote_split_wizard_form" model="ir.ui.view">
            <field name="name">construction.quote.split.wizard.form</field>
            <field name="model">construction.quote.split.wizard</field>
            <field name="arch" type="xml">
                <form string="Division de devis par lots">
                    
                    <!-- HEADER avec état -->
                    <header>
                        <!-- Boutons selon l'état -->
                        <button name="action_preview_split"
                                string="📋 Prévisualiser"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'select'"/>
                        
                        <button name="action_execute_split"
                                string="🔀 Diviser maintenant"
                                type="object"
                                class="btn-success"
                                invisible="state != 'preview'"
                                confirm="Êtes-vous sûr de vouloir diviser ce devis ? Cette action ne peut pas être annulée."/>
                        
                        <button name="action_view_subquotes"
                                string="📋 Voir les sous-devis"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'done'"/>
                        
                        <button name="action_back_to_select"
                                string="◀ Retour"
                                type="object"
                                class="btn-secondary"
                                invisible="state not in ['preview', 'error']"/>
                        
                        <!-- Indicateur d'état -->
                        <field name="state" widget="statusbar" statusbar_visible="select,preview,done"/>
                    </header>

                    <sheet>
                        
                        <!-- Titre et info du chantier -->
                        <div class="oe_title">
                            <h1>
                                <i class="fa fa-code-fork text-warning"/>
                                Division de devis par lots
                            </h1>
                            <h3>
                                <field name="chantier_id" readonly="1"/>
                            </h3>
                        </div>

                        <!-- ÉTAPE 1 : Sélection -->
                        <div invisible="state != 'select'" class="o_quote_split_select">
                            
                            <div class="alert alert-info">
                                <h4><i class="fa fa-info-circle"/> Étape 1 : Sélection du devis</h4>
                                <p>Choisissez le devis principal à diviser en sous-devis par lot.</p>
                            </div>

                            <group>
                                <group string="Devis disponibles">
                                    <field name="available_quote_ids" invisible="1"/>
                                    <field name="selected_quote_id" 
                                           domain="[('id', 'in', available_quote_ids)]"
                                           required="1"
                                           options="{'no_create': True}"/>
                                </group>
                                
                                <group string="Lots concernés">
                                    <field name="lot_ids" widget="many2many_tags" readonly="1"/>
                                </group>
                            </group>

                            <!-- Conditions -->
                            <div class="mt-3">
                                <h5>✅ Conditions requises :</h5>
                                <ul class="list-unstyled">
                                    <li><i class="fa fa-check text-success"/> Chantier au stage "Finalisation dossier"</li>
                                    <li><i class="fa fa-check text-success"/> Devis confirmé avec lots assignés</li>
                                    <li><i class="fa fa-check text-success"/> Sous-traitants assignés au projet</li>
                                </ul>
                            </div>

                        </div>

                        <!-- ÉTAPE 2 : Aperçu -->
                        <div invisible="state != 'preview'" class="o_quote_split_preview">
                            
                            <div class="alert alert-warning">
                                <h4><i class="fa fa-eye"/> Étape 2 : Aperçu de la division</h4>
                                <p>Vérifiez comment le devis sera divisé avant d'exécuter l'opération.</p>
                            </div>

                            <!-- Avertissements d'assignation -->
                            <field name="assignment_warnings" readonly="1" nolabel="1"/>

                            <group>
                                <group string="Devis sélectionné">
                                    <field name="selected_quote_id" readonly="1"/>
                                    <field name="lot_ids" widget="many2many_tags" readonly="1"/>
                                </group>
                                
                                <group string="Options de division">
                                    <field name="auto_assign_suggested" 
                                           invisible="not show_suggestions"
                                           help="Assigner automatiquement les sous-traitants suggérés au chantier avant la division"/>
                                </group>
                            </group>

                            <!-- Section des sous-traitants suggérés -->
                            <div invisible="not show_suggestions" class="o_quote_split_suggestions">
                                <separator string="💡 Sous-traitants spécialisés suggérés"/>
                                <div class="alert alert-info">
                                    <p>Des sous-traitants spécialisés ont été trouvés mais ne sont pas encore assignés à ce chantier.</p>
                                </div>
                                
                                <group>
                                    <field name="suggested_subcontractors" 
                                           widget="many2many_tags" 
                                           readonly="1"
                                           nolabel="1"/>
                                </group>
                                
                                <div class="mt-2">
                                    <button name="action_assign_suggested_subcontractors"
                                            string="🔗 Assigner ces sous-traitants au chantier"
                                            type="object"
                                            class="btn-warning"
                                            help="Ajouter automatiquement ces sous-traitants au chantier"/>
                                </div>
                            </div>

                            <!-- Assignations prévues -->
                            <separator string="📋 Assignations prévues"/>
                            <group>
                                <field name="subcontractor_assignments" readonly="1" nolabel="1"/>
                            </group>

                            <!-- Aperçu détaillé -->
                            <separator string="💰 Aperçu financier de la division"/>
                            <field name="preview_text" readonly="1" nolabel="1"/>

                        </div>

                        <!-- ÉTAPE 3 : Succès -->
                        <div invisible="state != 'done'" class="o_quote_split_done">
                            
                            <div class="alert alert-success">
                                <h4><i class="fa fa-check-circle"/> Division terminée avec succès !</h4>
                                <field name="result_message" readonly="1" nolabel="1"/>
                            </div>

                            <group string="Sous-devis créés">
                                <field name="created_subquote_ids" readonly="1" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="amount_total" widget="monetary"/>
                                        <field name="state" widget="badge" decoration-success="state == 'sale'" decoration-info="state in ('draft', 'sent')"/>
                                    </list>
                                </field>
                            </group>

                        </div>

                        <!-- ÉTAPE ERREUR -->
                        <div invisible="state != 'error'" class="o_quote_split_error">
                            
                            <div class="alert alert-danger">
                                <h4><i class="fa fa-exclamation-triangle"/> Erreur lors de la division</h4>
                                <field name="error_message" readonly="1" nolabel="1"/>
                            </div>

                            <div class="alert alert-info">
                                <h5>Solutions possibles :</h5>
                                <ul>
                                    <li>Vérifiez que le chantier est au stage "Finalisation dossier"</li>
                                    <li>Assurez-vous que le devis a des lots assignés</li>
                                    <li>Vérifiez que des sous-traitants sont assignés au projet</li>
                                    <li>Contactez l'administrateur si le problème persiste</li>
                                </ul>
                            </div>

                        </div>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- ================================================================
             ACTIONS
        ===================================================================-->
        
        <!-- Action pour ouvrir le wizard -->
        <record id="action_quote_split_wizard" model="ir.actions.act_window">
            <field name="name">Division de devis par lots</field>
            <field name="res_model">construction.quote.split.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_quote_split_wizard_form"/>
            <field name="target">new</field>
            <field name="context">{'default_chantier_id': active_id}</field>
        </record>

    </data>
</odoo> 