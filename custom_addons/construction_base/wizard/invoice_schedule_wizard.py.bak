# -*- coding: utf-8 -*-
"""
Wizard pour configurer un cycle de facturation sur un chantier
"""

from odoo import api, fields, models, _
from odoo.exceptions import ValidationError


class I                raise ValidationError(
                "Un planning de facturation basé sur le cycle '{}' "
                "existe déjà pour ce chantier. Supprimez-le d'abord si vous souhaitez le recréer.".format(
                    self.invoice_type_id.name
                ))iceScheduleWizard(models.TransientModel):
    """Assistant pour créer un planning de facturation basé sur un cycle et un devis"""
    
    _name = 'construction.invoice.schedule.wizard'
    _description = 'Assistant de planning de facturation'

    # =================== CHAMPS PRINCIPAUX ===================
    
    chantier_id = fields.Many2one(
        'construction.chantier',
        string='Chantier',
        required=True,
        readonly=True
    )
    
    invoice_type_id = fields.Many2one(
        'construction.invoice_type',
        string='Cycle de facturation',
        required=True,
        domain="[('active', '=', True)]",
        help="Cycle de facturation à appliquer"
    )
    
    quote_id = fields.Many2one(
        'sale.order',
        string='Devis de référence',
        required=True,
        domain="[('chantier_id', '=', chantier_id), ('state', 'in', ['sale', 'done'])]",
        help="Devis accepté servant de base pour calculer les montants"
    )
    
    # =================== SÉLECTION DES LOTS ===================
    
    lot_ids = fields.Many2many(
        'construction.lot',
        string='Lots concernés',
        domain="[('id', 'in', available_lot_ids)]",
        help="Lots du chantier concernés par cette facturation"
    )
    
    available_lot_ids = fields.Many2many(
        'construction.lot',
        compute='_compute_available_lots',
        string='Lots disponibles'
    )
    
    all_lots = fields.Boolean(
        string='Tous les lots',
        default=True,
        help="Cocher pour inclure tous les lots du chantier"
    )
    
    # =================== MARGE ===================
    
    margin_percentage = fields.Float(
        string='Marge à déduire (%)',
        default=0.0,
        help="Marge à déduire des montants du devis pour calculer le prix final des lots"
    )
    
    # =================== INFORMATIONS CALCULÉES ===================
    
    quote_total = fields.Monetary(
        string='Total du devis',
        related='quote_id.amount_total',
        currency_field='currency_id'
    )
    
    currency_id = fields.Many2one(
        related='chantier_id.currency_id'
    )
    
    estimated_total = fields.Monetary(
        string='Total estimé (après marge)',
        compute='_compute_estimated_total',
        currency_field='currency_id',
        help="Montant total estimé après application de la marge"
    )
    
    cycle_summary = fields.Html(
        string='Aperçu du cycle',
        compute='_compute_cycle_summary'
    )
    
    # =================== MÉTHODES CALCULÉES ===================
    
    @api.depends('chantier_id', 'quote_id')
    def _compute_available_lots(self):
        for wizard in self:
            if wizard.chantier_id:
                wizard.available_lot_ids = wizard.chantier_id.lots_ids
            else:
                wizard.available_lot_ids = False
    
    @api.depends('quote_total', 'margin_percentage')
    def _compute_estimated_total(self):
        for wizard in self:
            if wizard.quote_total and wizard.margin_percentage:
                wizard.estimated_total = wizard.quote_total * (1 - wizard.margin_percentage / 100)
            else:
                wizard.estimated_total = wizard.quote_total or 0.0
    
    @api.depends('invoice_type_id')
    def _compute_cycle_summary(self):
        for wizard in self:
            if wizard.invoice_type_id:
                lines_html = ""
                for line in wizard.invoice_type_id.line_ids:
                    trigger_text = "À la signature" if line.is_advance_payment else "{}% d'avancement".format(line.trigger_percentage)
                    lines_html += """
                    <tr>
                        <td>{}</td>
                        <td class="text-center">{}</td>
                        <td class="text-end">{}%</td>
                    </tr>
                    """.format(line.name, trigger_text, line.percentage)
                
                wizard.cycle_summary = """
                <div class="alert alert-info">
                    <h5><i class="fa fa-info-circle"></i> Cycle: {}</h5>
                    <p>{}</p>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Étape</th>
                                <th class="text-center">Déclenchement</th>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            {}
                        </tbody>
                        <tfoot>
                            <tr class="table-active">
                                <th>Total</th>
                                <th></th>
                                <th class="text-end">{}%</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                """.format(
                    wizard.invoice_type_id.name,
                    wizard.invoice_type_id.description or '',
                    lines_html,
                    wizard.invoice_type_id.total_percentage
                )
            else:
                wizard.cycle_summary = ""
    
    # =================== ONCHANGE ===================
    
    @api.onchange('all_lots')
    def _onchange_all_lots(self):
        if self.all_lots and self.available_lot_ids:
            self.lot_ids = self.available_lot_ids
        elif not self.all_lots:
            self.lot_ids = False
    
    @api.onchange('chantier_id')
    def _onchange_chantier_id(self):
        # Reset des sélections quand le chantier change
        self.quote_id = False
        self.lot_ids = False
    
    # =================== CONTRAINTES ===================
    
    @api.constrains('margin_percentage')
    def _check_margin_percentage(self):
        for wizard in self:
            if wizard.margin_percentage < 0 or wizard.margin_percentage > 100:
                raise ValidationError("La marge doit être comprise entre 0% et 100%.")
    
    # =================== ACTIONS ===================
    
    def action_create_schedule(self):
        """Créer le planning de facturation"""
        self.ensure_one()
        
        if not self.lot_ids:
            raise ValidationError("Veuillez sélectionner au moins un lot.")
        
        # Vérifier qu'il n'y a pas déjà un planning pour ce chantier avec ce cycle
        existing = self.env['construction.invoice.schedule'].search([
            ('chantier_id', '=', self.chantier_id.id),
            ('invoice_type_line_id.invoice_type_id', '=', self.invoice_type_id.id)
        ])
        
        if existing:
            raise ValidationError(
                f"Un planning de facturation basé sur le cycle '{self.invoice_type_id.name}' "
                f"existe déjà pour ce chantier. Supprimez-le d'abord si vous souhaitez le recréer."
            )
        
        # Créer le planning
        schedules = self.invoice_type_id.create_invoice_schedule_for_chantier(
            chantier_id=self.chantier_id.id,
            quote_id=self.quote_id.id,
            lot_ids=self.lot_ids.ids,
            margin_percentage=self.margin_percentage
        )
        
        # Retourner la vue des planifications créées
        return {
            'type': 'ir.actions.act_window',
            'name': f'Planning de facturation - {self.chantier_id.name}',
            'res_model': 'construction.invoice.schedule',
            'view_mode': 'list,form',
            'domain': [('id', 'in', schedules.ids)],
            'context': {
                'default_chantier_id': self.chantier_id.id,
            },
            'target': 'current',
        }
    
    def action_preview_schedule(self):
        """Prévisualiser le planning sans le créer"""
        self.ensure_one()
        
        if not self.lot_ids:
            raise ValidationError("Veuillez sélectionner au moins un lot.")
        
        # Calculer les montants prévisualisés
        preview_data = []
        total_amount = 0.0
        
        # Calculer le montant total des lots sélectionnés
        if self.quote_id and self.lot_ids:
            for lot in self.lot_ids:
                lot_section_name = f"📋 {lot.name}"
                section_line = self.quote_id.order_line.filtered(
                    lambda line: line.display_type == 'line_section' and 
                    line.name == lot_section_name
                )
                
                if section_line:
                    section_sequence = section_line.sequence
                    next_section = self.quote_id.order_line.filtered(
                        lambda line: line.display_type == 'line_section' and 
                        line.sequence > section_sequence
                    ).sorted('sequence')
                    
                    end_sequence = next_section[0].sequence if next_section else float('inf')
                    
                    lot_lines = self.quote_id.order_line.filtered(
                        lambda line: not line.display_type and 
                        section_sequence < line.sequence < end_sequence
                    )
                    
                    lot_subtotal = sum(lot_lines.mapped('price_subtotal'))
                    total_amount += lot_subtotal
        
        # Appliquer la marge
        total_with_margin = total_amount * (1 - self.margin_percentage / 100)
        
        # Calculer pour chaque étape
        for line in self.invoice_type_id.line_ids:
            amount = total_with_margin * (line.percentage / 100)
            preview_data.append({
                'name': line.name,
                'trigger_percentage': line.trigger_percentage,
                'amount_percentage': line.percentage,
                'amount': amount,
                'is_advance_payment': line.is_advance_payment,
            })
        
        # Générer le HTML de prévisualisation
        preview_html = f"""
        <div class="alert alert-success">
            <h4><i class="fa fa-eye"></i> Prévisualisation du planning</h4>
            <p><strong>Chantier:</strong> {self.chantier_id.name}</p>
            <p><strong>Devis:</strong> {self.quote_id.name} ({self.quote_total:,.2f} €)</p>
            <p><strong>Lots:</strong> {', '.join(self.lot_ids.mapped('name'))}</p>
            <p><strong>Marge appliquée:</strong> {self.margin_percentage}%</p>
            <p><strong>Montant total après marge:</strong> {total_with_margin:,.2f} €</p>
            
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Étape</th>
                        <th>Déclenchement</th>
                        <th>% Facturation</th>
                        <th class="text-end">Montant (€)</th>
                    </tr>
                </thead>
                <tbody>
        """
        
        for data in preview_data:
            trigger_text = "À la signature" if data['is_advance_payment'] else f"{data['trigger_percentage']}%"
            preview_html += f"""
                <tr>
                    <td>{data['name']}</td>
                    <td>{trigger_text}</td>
                    <td>{data['amount_percentage']}%</td>
                    <td class="text-end">{data['amount']:,.2f} €</td>
                </tr>
            """
        
        preview_html += f"""
                </tbody>
                <tfoot>
                    <tr class="table-active">
                        <th colspan="3">Total</th>
                        <th class="text-end">{total_with_margin:,.2f} €</th>
                    </tr>
                </tfoot>
            </table>
        </div>
        """
        
        return {
            'type': 'ir.actions.act_window',
            'name': 'Prévisualisation du planning de facturation',
            'res_model': 'construction.invoice.schedule.wizard',
            'view_mode': 'form',
            'res_id': self.id,
            'target': 'new',
            'context': {
                'preview_html': preview_html,
            }
        }
