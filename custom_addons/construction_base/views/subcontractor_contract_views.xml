<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================
             FORMULAIRE CONTRAT
        ===================================================================-->
        <record id="view_subcontractor_contract_form" model="ir.ui.view">
            <field name="name">construction.subcontractor.contract.form</field>
            <field name="model">construction.subcontractor.contract</field>
            <field name="arch" type="xml">
                <form string="Contrat de sous-traitance">
                    <header>
                        <button name="action_send_contract"
                                string="📧 Envoyer"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        
                        <button name="action_view_portal"
                                string="🌐 Voir portail"
                                type="object"
                                class="btn-info"
                                invisible="not portal_url"/>
                        
                        <button name="action_download_pdf"
                                string="📄 Télécharger PDF"
                                type="object"
                                class="btn-secondary"
                                invisible="not contract_pdf"/>
                        
                        <field name="state" widget="statusbar" statusbar_visible="draft,sent,active"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nom du contrat"/>
                            </h1>
                            <h3>
                                <field name="contract_number" readonly="1"/>
                            </h3>
                        </div>
                        
                        <group>
                            <group string="📋 Informations générales">
                                <field name="chantier_id"/>
                                <field name="subcontractor_id"/>
                                <field name="lot_ids" widget="many2many_tags"/>
                            </group>
                            
                            <group string="💰 Conditions financières">
                                <field name="total_amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="payment_terms"/>
                                <field name="payment_terms_custom" invisible="payment_terms != 'custom'"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="📅 Délais">
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                            
                            <group string="🛡️ Garanties">
                                <field name="warranty_period"/>
                                <field name="insurance_required"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="📄 Document" name="document">
                                <group>
                                    <field name="contract_pdf" widget="binary" filename="filename"/>
                                    <field name="filename" invisible="1"/>
                                    <field name="portal_url" readonly="1"/>
                                </group>
                            </page>
                            
                            <page string="✍️ Signature" name="signature">
                                <group>
                                    <field name="signature_state" widget="badge"/>
                                    <field name="signed_date" readonly="1"/>
                                    <field name="signature_ip" readonly="1"/>
                                    <field name="signature_comment"/>
                                </group>
                            </page>
                            
                            <page string="📝 Notes" name="notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ================================================================
             LISTE CONTRATS
        ===================================================================-->
        <record id="view_subcontractor_contract_list" model="ir.ui.view">
            <field name="name">construction.subcontractor.contract.list</field>
            <field name="model">construction.subcontractor.contract</field>
            <field name="arch" type="xml">
                <list string="Contrats de sous-traitance"
                      decoration-success="state == 'active'"
                      decoration-info="state == 'sent'"
                      decoration-muted="state == 'completed'">
                    <field name="name"/>
                    <field name="contract_number"/>
                    <field name="chantier_id"/>
                    <field name="subcontractor_id"/>
                    <field name="total_amount" widget="monetary" sum="Total"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="signature_state" widget="badge"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- ================================================================
             KANBAN CONTRATS
        ===================================================================-->
        <record id="view_subcontractor_contract_kanban" model="ir.ui.view">
            <field name="name">construction.subcontractor.contract.kanban</field>
            <field name="model">construction.subcontractor.contract</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_construction_contract_kanban">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="contract_number"/>
                    <field name="chantier_id"/>
                    <field name="subcontractor_id"/>
                    <field name="total_amount"/>
                    <field name="start_date"/>
                    <field name="signature_state"/>
                    <field name="state"/>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <small class="o_kanban_record_subtitle text-muted">
                                                <field name="contract_number"/>
                                            </small>
                                        </div>
                                    </div>
                                    
                                    <div class="o_kanban_record_body">
                                        <div>
                                            <strong>Chantier :</strong> <field name="chantier_id"/>
                                        </div>
                                        <div>
                                            <strong>Sous-traitant :</strong> <field name="subcontractor_id"/>
                                        </div>
                                        <div>
                                            <strong>Montant :</strong> <field name="total_amount" widget="monetary"/>
                                        </div>
                                        <div>
                                            <strong>Signature :</strong> <field name="signature_state" widget="badge"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ================================================================
             ACTION CONTRATS
        ===================================================================-->
        <record id="action_subcontractor_contract" model="ir.actions.act_window">
            <field name="name">📄 Contrats de sous-traitance</field>
            <field name="res_model">construction.subcontractor.contract</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_subcontractor_contract_kanban"/>
            <field name="help" type="html">
                <div class="o_view_nocontent_empty_folder">
                    <div class="text-center">
                        <i class="fa fa-file-text fa-3x text-muted mb-3"/>
                        <h3>Aucun contrat de sous-traitance</h3>
                        <p class="text-muted">
                            Créez votre premier contrat de sous-traitance
                        </p>
                    </div>
                </div>
            </field>
        </record>

    </data>
</odoo> 