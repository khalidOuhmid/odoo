<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================================================================
             VUES POUR LES CONTRATS DE SOUS-TRAITANCE
        ===================================================================-->

        <!-- Vue formulaire -->
        <record id="view_subcontractor_contract_form" model="ir.ui.view">
            <field name="name">construction.subcontractor.contract.form</field>
            <field name="model">construction.subcontractor.contract</field>
            <field name="arch" type="xml">
                <form string="Contrat de sous-traitance">
                    <header>
                        <button name="action_send_contract"
                                string="📧 Envoyer contrat"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_view_portal"
                                string="🌐 Voir portail"
                                type="object"
                                class="btn-secondary"
                                invisible="not portal_url"/>
                        <button name="action_download_pdf"
                                string="📄 Télécharger PDF"
                                type="object"
                                class="btn-secondary"
                                invisible="not contract_pdf"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,sent,active,completed"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                            <h3>
                                <field name="contract_number" readonly="1"/>
                            </h3>
                        </div>

                        <group>
                            <group string="Informations principales">
                                <field name="chantier_id" readonly="1"/>
                                <field name="subcontractor_id" readonly="1"/>
                                <field name="lot_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                            <group string="Conditions contractuelles">
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="total_amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="payment_terms"/>
                                <field name="warranty_period"/>
                                <field name="insurance_required"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="📄 Documents" name="documents">
                                <group>
                                    <group string="Contrat">
                                        <field name="contract_pdf" widget="binary" filename="filename"/>
                                        <field name="filename" invisible="1"/>
                                        <field name="portal_url" widget="url"/>
                                    </group>
                                </group>
                            </page>

                            <page string="✍️ Signature" name="signature">
                                <group>
                                    <group string="État de la signature">
                                        <field name="signature_state" readonly="1"/>
                                        <field name="signed_date" readonly="1"/>
                                        <field name="signature_ip" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Commentaire">
                                    <field name="signature_comment" nolabel="1" readonly="1"/>
                                </group>
                            </page>

                            <page string="📝 Notes" name="notes">
                                <field name="notes" nolabel="1" placeholder="Notes internes sur le contrat..."/>
                            </page>
                        </notebook>
                    </sheet>

                  <chatter></chatter>
                </form>
            </field>
        </record>

        <!-- Vue liste -->
        <record id="view_subcontractor_contract_tree" model="ir.ui.view">
            <field name="name">construction.subcontractor.contract.tree</field>
            <field name="model">construction.subcontractor.contract</field>
            <field name="arch" type="xml">
                <list string="Contrats de sous-traitance" decoration-success="state == 'active'" decoration-muted="state == 'cancelled'">
                    <field name="contract_number"/>
                    <field name="name"/>
                    <field name="chantier_id"/>
                    <field name="subcontractor_id"/>
                    <field name="total_amount" widget="monetary"/>
                    <field name="start_date"/>
                    <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'sent'" decoration-warning="state == 'draft'"/>
                    <field name="signature_state" widget="badge" decoration-success="signature_state == 'signed'" decoration-warning="signature_state == 'sent'"/>
                </list>
            </field>
        </record>

        <!-- Vue recherche -->
        <record id="view_subcontractor_contract_search" model="ir.ui.view">
            <field name="name">construction.subcontractor.contract.search</field>
            <field name="model">construction.subcontractor.contract</field>
            <field name="arch" type="xml">
                <search string="Rechercher contrats">
                    <field name="name"/>
                    <field name="contract_number"/>
                    <field name="chantier_id"/>
                    <field name="subcontractor_id"/>
                    <separator/>
                    <filter string="Brouillons" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Envoyés" name="sent" domain="[('state', '=', 'sent')]"/>
                    <filter string="Actifs" name="active" domain="[('state', '=', 'active')]"/>
                    <separator/>
                    <filter string="Signés" name="signed" domain="[('signature_state', '=', 'signed')]"/>
                    <filter string="Non signés" name="not_signed" domain="[('signature_state', '!=', 'signed')]"/>
                    <separator/>
                    <group expand="0" string="Grouper par">
                        <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                        <filter string="Sous-traitant" name="group_subcontractor" context="{'group_by': 'subcontractor_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action principale -->
        <record id="action_subcontractor_contract" model="ir.actions.act_window">
            <field name="name">Contrats de sous-traitance</field>
            <field name="res_model">construction.subcontractor.contract</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <div class="o_view_nocontent_smiling_face">
                    <p>Créez votre premier contrat de sous-traitance</p>
                    <p>Les contrats permettent de formaliser les accords avec vos sous-traitants.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
