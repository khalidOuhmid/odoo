<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List view for lot templates -->
        <record id="view_construction_lot_template_tree" model="ir.ui.view">
            <field name="name">construction.lot.template.tree</field>
            <field name="model">construction.lot.template</field>
            <field name="arch" type="xml">
                <list string="Templates de lots">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="color" widget="color"/>
                    <field name="description"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Form view for lot templates -->
        <record id="view_construction_lot_template_form" model="ir.ui.view">
            <field name="name">construction.lot.template.form</field>
            <field name="model">construction.lot.template</field>
            <field name="arch" type="xml">
                <form string="Template de lot">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <widget name="web_ribbon" title="Archivé" bg_color="bg-danger" invisible="active"/>
                        <group>
                            <group>
                                <field name="active" invisible="1"/>
                                <field name="name" required="1"/>
                                <field name="code" required="1"/>
                                <field name="color" widget="color"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Description du type de lot..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for lot templates -->
        <record id="action_construction_lot_template" model="ir.actions.act_window">
            <field name="name">Templates de lots</field>
            <field name="res_model">construction.lot.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer votre premier template de lot !
                </p>
                <p>
                    Les templates de lots définissent les types de lots standards qui seront automatiquement créés lors de la création d'un nouveau chantier.
                </p>
            </field>
        </record>

        <!-- Menu item for lot templates -->
        <menuitem id="menu_construction_lot_template"
                  name="Templates de lots"
                  parent="menu_construction_root"
                  action="action_construction_lot_template"
                  sequence="90"/>

    </data>
</odoo>
