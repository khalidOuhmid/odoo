<odoo>
    <data>
        <!-- Formulaire de téléversement du contrat de sous-traitance (public) -->
        <template id="subcontractor_contract_upload_form" name="Téléversement Contrat Sous-traitance">
            <t t-call="web.frontend_layout">
                <link rel="stylesheet"
                      href="https://fonts.googleapis.com/css?family=Inter:400,500,600,700&amp;display=swap"/>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
                <t t-set="title">Contrat de sous-traitance - BLG Groupe</t>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <style>
                    body, .o_document_portal {
                        font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
                        background: linear-gradient(135deg, #f8fafc 0%, #e9f0fa 100%);
                        min-height: 100vh;
                        color: #334155;
                    }

                    .o_document_portal .section-title {
                        font-size: 1.75rem;
                        font-weight: 700;
                        color: #1e40af;
                        margin-bottom: 1.25rem;
                        letter-spacing: -0.01em;
                    }

                    .o_document_portal .upload-card {
                        border-radius: 16px;
                        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
                        border: 1px solid rgba(226, 232, 240, 0.8);
                        background: #fff;
                        transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
                    }

                    .o_document_portal .upload-card:hover {
                        transform: translateY(-3px);
                        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
                    }

                    .o_document_portal .card-header {
                        background: rgba(248, 250, 252, 0.7);
                        border-bottom: 1px solid rgba(226, 232, 240, 0.7);
                        border-radius: 16px 16px 0 0;
                        padding: 1rem 1.25rem;
                    }

                    .o_document_portal .file-upload-wrapper {
                        position: relative;
                        border: 2px dashed #cbd5e1;
                        border-radius: 12px;
                        padding: 2rem 1.5rem;
                        text-align: center;
                        background: #f8fafc;
                        transition: all 0.2s ease;
                        cursor: pointer;
                    }

                    .o_document_portal .file-upload-wrapper:hover,
                    .o_document_portal .file-upload-wrapper.dragover {
                        background: #f1f5f9;
                        border-color: #94a3b8;
                    }

                    .o_document_portal .file-upload-input {
                        position: absolute;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        opacity: 0;
                        cursor: pointer;
                        z-index: 10;
                    }

                    .o_document_portal .upload-content {
                        pointer-events: none;
                    }

                    .o_document_portal .upload-content .fa-file-pdf {
                        color: #1e40af;
                        font-size: 2.2rem;
                        margin-bottom: 0.75rem;
                    }

                    .o_document_portal .upload-text {
                        color: #64748b;
                        font-weight: 500;
                        font-size: 0.95rem;
                        line-height: 1.5;
                    }

                    .o_document_portal .uploaded-file {
                        display: none;
                        background: #f0fdf4;
                        border: 1px solid #dcfce7;
                        border-radius: 10px;
                        padding: 0.75rem 1rem;
                        margin-top: 0.75rem;
                        font-weight: 500;
                        color: #166534;
                        animation: fadeSlideIn 0.3s forwards;
                        align-items: center;
                    }

                    .o_document_portal .uploaded-file .fa-check-circle {
                        color: #16a34a;
                        margin-right: 0.5rem;
                    }

                    .o_document_portal .uploaded-file .filename {
                        color: #166534;
                        font-size: 0.9rem;
                        text-overflow: ellipsis;
                        overflow: hidden;
                        white-space: nowrap;
                        flex: 1;
                    }

                    .o_document_portal .alert {
                        border-radius: 12px;
                        font-size: 0.975rem;
                        border: none;
                        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.08);
                    }

                    .o_document_portal .alert-success {
                        background-color: #f0fdf4;
                        color: #166534;
                        border-left: 4px solid #22c55e;
                    }

                    .o_document_portal .alert-danger {
                        background-color: #fee2e2;
                        color: #b91c1c;
                        border-left: 4px solid #dc2626;
                    }

                    .o_document_portal .btn {
                        border-radius: 10px;
                        font-weight: 500;
                        padding: 0.65rem 1.25rem;
                        transition: all 0.2s ease;
                    }

                    .o_document_portal .btn-primary {
                        background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
                        border: none;
                        box-shadow: 0 2px 8px rgba(30, 64, 175, 0.25);
                    }

                    .o_document_portal .btn-primary:hover,
                    .o_document_portal .btn-primary:focus {
                        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
                        box-shadow: 0 4px 12px rgba(30, 64, 175, 0.35);
                        transform: translateY(-1px);
                    }

                    .o_document_portal .custom-header {
                        padding: 1.25rem 0;
                        background: rgba(255, 255, 255, 0.7);
                        backdrop-filter: blur(10px);
                        -webkit-backdrop-filter: blur(10px);
                        border-bottom: 1px solid rgba(226, 232, 240, 0.8);
                    }

                    .o_document_portal .brand-logo {
                        height: 42px;
                    }

                    .o_document_portal .brand-text {
                        font-size: 1.5rem;
                        font-weight: 700;
                        color: #1e40af;
                        margin-left: 0.75rem;
                        letter-spacing: -0.01em;
                    }

                    @keyframes fadeSlideIn {
                        0% {
                            opacity: 0;
                            transform: translateY(-8px);
                        }
                        100% {
                            opacity: 1;
                            transform: translateY(0);
                        }
                    }
                </style>
                <div class="o_document_portal d-flex flex-column min-vh-100">
                    <div class="custom-header py-3">
                        <div class="container d-flex align-items-center">
                            <img t-att-src="'/blg_contacts_extension/static/src/img/icon.png'"
                                 alt="Logo"
                                 class="brand-logo"
                                 onerror="this.onerror=null; this.src='/web/static/img/logo.png'"/>
                            <span class="brand-text">BLG Groupe</span>
                        </div>
                    </div>
                    <div class="container flex-grow-1 py-5">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="text-center mb-4">
                                    <div class="section-title">Téléversement du contrat de sous-traitance</div>
                                    <p class="text-muted mb-0">Merci de déposer votre contrat signé au format PDF</p>
                                </div>
                                <div t-if="success" class="alert alert-success mb-4">
                                    <i class="fa fa-check-circle me-2"></i>
                                    Contrat téléversé avec succès. Il sera vérifié prochainement par notre équipe.
                                </div>
                                <div t-if="error" class="alert alert-danger mb-4">
                                    <i class="fa fa-exclamation-triangle me-2"></i>
                                    <t t-esc="error"/>
                                </div>
                                <t t-if="contract_download_url">
                                    <div class="alert alert-info mb-4 text-center">
                                        <i class="fa fa-download me-2"></i>
                                        <a t-att-href="contract_download_url" class="btn btn-outline-primary"
                                           download="download">
                                            Télécharger le contrat de sous-traitance à signer (PDF)
                                        </a>

                                    </div>
                                </t>
                                <t t-if="documents">
                                    <div class="card mb-4">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0">Vos documents</h5>
                                        </div>
                                        <div class="card-body p-3">
                                            <table class="table table-bordered table-sm align-middle mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Type</th>
                                                        <th>Nom</th>
                                                        <th>Date</th>
                                                        <th>Fichier</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="documents" t-as="doc">
                                                        <tr>
                                                            <td><t t-esc="doc.document_type"/></td>
                                                            <td><t t-esc="doc.name"/></td>
                                                            <td><t t-esc="doc.create_date and doc.create_date.strftime('%d/%m/%Y') or ''"/></td>
                                                            <td>
                                                                <a t-att-href="'/web/content/construction.document/' + str(doc.id) + '/file_data?download=true'"
                                                                   target="_blank"
                                                                   class="btn btn-outline-secondary btn-sm">
                                                                    <i class="fa fa-download"></i> Télécharger
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </t>
                                <form method="post" enctype="multipart/form-data" id="contractUploadForm"
                                      autocomplete="off">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="card upload-card mb-4">
                                        <div class="card-header">
                                            <h5 class="mb-0 fw-bold">Contrat de sous-traitance (PDF)</h5>
                                        </div>
                                        <div class="card-body p-4">
                                            <div class="mb-3">
                                                <div class="file-upload-wrapper" id="dropzone-contract">
                                                    <input type="file" name="contract_file" id="contract_file"
                                                           class="file-upload-input" required accept="application/pdf"/>
                                                    <div class="upload-content">
                                                        <i class="fa fa-file-pdf upload-icon"></i>
                                                        <div class="upload-text">
                                                            Glissez votre fichier PDF ici<br/>ou cliquez pour parcourir
                                                        </div>
                                                    </div>
                                                </div>
                                                <div id="uploaded-file-contract" class="uploaded-file">
                                                    <i class="fa fa-check-circle"></i>
                                                    <span class="filename"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-center mt-4">
                                        <button type="submit" id="submitBtn" class="btn btn-primary btn-lg px-4 py-2">
                                            <i class="fa fa-upload me-2"></i>Envoyer le contrat
                                        </button>
                                        <div class="mt-2 small text-muted">
                                            <i class="fa fa-shield-alt me-1"></i>
                                            Transmission sécurisée
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function() {
                    const input = document.getElementById('contract_file');
                    const uploadedFileEl = document.getElementById('uploaded-file-contract');
                    const filenameEl = uploadedFileEl ? uploadedFileEl.querySelector('.filename') : null;
                    input.addEventListener('change', function() {
                    if (input.files &amp; input.files[0]) {
                    const file = input.files[0];
                    if (filenameEl) {
                    filenameEl.textContent = file.name;
                    uploadedFileEl.style.display = 'flex';
                    }
                    }
                    });
                    });
                </script>
            </t>
        </template>

        <!-- Template d'erreur pour token invalide ou expiré -->
        <template id="subcontractor_contract_upload_error" name="Erreur Téléversement Contrat">
            <t t-call="web.frontend_layout">
                <link rel="stylesheet"
                      href="https://fonts.googleapis.com/css?family=Inter:400,600,700&amp;display=swap"/>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
                <t t-set="title">Erreur - BLG Groupe</t>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <div class="o_document_portal d-flex flex-column min-vh-100">
                    <div class="custom-header">
                        <div class="container d-flex align-items-center">
                            <img t-att-src="'/blg_contacts_extension/static/src/img/icon.png'" alt="Logo"
                                 class="brand-logo"
                                 onerror="this.onerror=null; this.src='/web/static/img/logo.png'"/>
                            <span class="brand-text">BLG Groupe</span>
                        </div>
                    </div>
                    <div class="container flex-grow-1 py-5">
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-6 text-center">
                                <div class="card border-0 shadow p-5">
                                    <div class="mb-4">
                                        <i class="fa fa-exclamation-circle text-danger" style="font-size: 4rem;"></i>
                                    </div>
                                    <h2 class="mb-3">Lien expiré ou invalide</h2>
                                    <p class="text-muted mb-4">
                                        Ce lien n'est plus valide ou a déjà été utilisé.<br/>
                                        Merci de contacter l'équipe BLG Groupe si vous pensez qu'il s'agit d'une erreur.
                                    </p>
                                    <div class="d-flex justify-content-center gap-2">
                                        <button onclick="window.close();" class="btn btn-outline-secondary px-4">
                                            <i class="fa fa-times me-2"></i>Fermer
                                        </button>
                                        <a href="/" class="btn btn-outline-secondary px-4">
                                            <i class="fa fa-arrow-left me-2"></i>Retour accueil
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo> 