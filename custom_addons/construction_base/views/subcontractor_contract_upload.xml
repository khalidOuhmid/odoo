<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================================================================
             TEMPLATES PORTAIL SIGNATURE CONTRATS
        ===================================================================-->

        <!-- Template d'accès refusé -->
        <template id="contract_access_denied" name="Accès refusé - Contrat">
            <t t-call="web.frontend_layout">
                <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:400,500,600,700&amp;display=swap"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
                <t t-set="title">Accès refusé - BLG Groupe</t>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>

                <style>
                    body, .o_contract_portal {
                        font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
                        background: linear-gradient(135deg, #f8fafc 0%, #e9f0fa 100%);
                        min-height: 100vh;
                        color: #334155;
                    }
                    .o_contract_portal .custom-header {
                        padding: 1.25rem 0;
                        background: rgba(255, 255, 255, 0.7);
                        backdrop-filter: blur(10px);
                        border-bottom: 1px solid rgba(226, 232, 240, 0.8);
                    }
                    .o_contract_portal .brand-logo {
                        height: 42px;
                    }
                    .o_contract_portal .brand-text {
                        font-size: 1.5rem;
                        font-weight: 700;
                        color: #1e40af;
                        margin-left: 0.75rem;
                        letter-spacing: -0.01em;
                    }
                    .o_contract_portal .error-card {
                        border-radius: 16px;
                        box-shadow: 0 8px 32px rgba(15, 23, 42, 0.1);
                        border: 1px solid rgba(226, 232, 240, 0.8);
                        background: #fff;
                    }
                    .o_contract_portal .btn {
                        border-radius: 10px;
                        font-weight: 500;
                        padding: 0.65rem 1.25rem;
                        transition: all 0.2s ease;
                    }
                </style>

                <div class="o_contract_portal d-flex flex-column min-vh-100">
                    <div class="custom-header">
                        <div class="container d-flex align-items-center">
                            <img src="/construction_base/static/src/img/blg_logo.png"
                                 alt="Logo BLG GROUPE"
                                 class="brand-logo"
                                 onerror="this.onerror=null; this.src='/web/static/img/logo.png'"/>
                            <span class="brand-text">BLG Groupe</span>
                        </div>
                    </div>

                    <div class="container flex-grow-1 py-5">
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-6">
                                <div class="error-card text-center p-5">
                                    <div class="mb-4">
                                        <i class="fa fa-lock text-danger" style="font-size: 4rem;"></i>
                                    </div>
                                    <h2 class="mb-3 text-danger">Accès non autorisé</h2>
                                    <p class="text-muted mb-4">
                                        <t t-esc="error or 'Vous n\'avez pas les autorisations nécessaires pour accéder à ce contrat.'"/>
                                    </p>
                                    <p class="small text-muted mb-4">
                                        Si vous pensez qu'il s'agit d'une erreur, veuillez contacter l'équipe BLG Groupe.
                                    </p>
                                    <div class="d-flex justify-content-center gap-2">
                                        <button onclick="window.close();" class="btn btn-outline-secondary">
                                            <i class="fa fa-times me-2"></i>Fermer
                                        </button>
                                        <a href="/" class="btn btn-outline-primary">
                                            <i class="fa fa-home me-2"></i>Accueil
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Template page de signature (MODERNIZED) -->
        <template id="contract_signature_page" name="Signature de contrat">
            <t t-call="web.frontend_layout">
                <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:400,500,600,700&amp;display=swap"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
                <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>

                <t t-set="title">Signature de contrat - BLG Groupe</t>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>

                <div class="o_contract_portal d-flex flex-column min-vh-100" style="font-family: 'Inter', system-ui, -apple-system, sans-serif !important; background: linear-gradient(135deg, #f8fafc 0%, #e9f0fa 100%); color: #334155;">
                    <div class="custom-header py-3" style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid rgba(226,232,240,0.8);">
                        <div class="container d-flex align-items-center">
                            <img src="/construction_base/static/src/img/blg_logo.png" alt="Logo BLG GROUPE" class="brand-logo" style="height: 42px;" onerror="this.onerror=null; this.src='/web/static/img/logo.png'"/>
                            <span class="brand-text" style="font-size: 1.5rem; font-weight: 700; color: #1e40af; margin-left: 0.75rem; letter-spacing: -0.01em;">BLG Groupe</span>
                        </div>
                    </div>

                    <div class="container flex-grow-1 py-5">
                        <div class="row justify-content-center">
                            <div class="col-lg-10">
                                <div class="text-center mb-4">
                                    <h1 style="font-size: 1.75rem; font-weight: 700; color: #1e40af; margin-bottom: 1.25rem; letter-spacing: -0.01em;">Signature électronique du contrat</h1>
                                    <p class="text-muted mb-0">Veuillez vérifier les informations et signer le contrat ci-dessous.</p>
                                </div>

                                <!-- Informations du contrat -->
                                <div class="mb-4" style="border-radius: 16px; box-shadow: 0 4px 20px rgba(15,23,42,0.08); border: 1px solid rgba(226,232,240,0.8); background: #fff;">
                                    <div class="card-header" style="background: rgba(248,250,252,0.7); border-bottom: 1px solid rgba(226,232,240,0.7); border-radius: 16px 16px 0 0; padding: 1rem 1.25rem;">
                                        <h5 class="mb-0 fw-bold">Détails du contrat</h5>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Chantier:</strong> <t t-esc="chantier.name"/></p>
                                                <p><strong>Sous-traitant:</strong> <t t-esc="subcontractor.name"/></p>
                                                <p><strong>Numéro:</strong> <t t-esc="contract.contract_number"/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>Montant:</strong> <span t-field="contract.total_amount" t-options='{"widget": "monetary", "display_currency": contract.currency_id}'/></p>
                                                <p><strong>Date début:</strong> <span t-field="contract.start_date" t-options='{"format": "dd/MM/yyyy"}'/></p>
                                                <p><strong>Lots:</strong> <t t-esc="', '.join(contract.lot_ids.mapped('name'))"/></p>
                                            </div>
                                        </div>
                                         <div class="text-center mt-3">
                                            <a t-att-href="'/portal/contract/%s/html_preview?access_token=%s' % (contract.id, access_token)" target="_blank" class="btn btn-outline-primary me-2">
                                                <i class="fa fa-eye me-2"></i>Prévisualiser
                                            </a>
                                            <a t-att-href="'/portal/contract/%s/download?access_token=%s' % (contract.id, access_token)" class="btn btn-outline-secondary">
                                                <i class="fa fa-download me-2"></i>Télécharger PDF
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Formulaire de signature -->
                                <form method="post" id="signatureForm">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="signature_image" id="signature_image"/>

                                    <div style="border-radius: 16px; box-shadow: 0 4px 20px rgba(15,23,42,0.08); border: 1px solid rgba(226,232,240,0.8); background: #fff;">
                                        <div class="card-header" style="background: rgba(248,250,252,0.7); border-bottom: 1px solid rgba(226,232,240,0.7); border-radius: 16px 16px 0 0; padding: 1rem 1.25rem;">
                                            <h5 class="mb-0 fw-bold">✍️ Votre Signature</h5>
                                        </div>
                                        <div class="card-body p-4">
                                            <div id="signature-wrapper" style="position: relative; width: 100%; height: 200px; border: 2px dashed #cbd5e1; border-radius: 12px; background-color: #f8fafc; touch-action: none;">
                                                <canvas id="signature-pad" class="signature-pad"></canvas>
                                            </div>
                                            <div class="text-center mt-2">
                                                <button type="button" id="clear-signature" class="btn btn-sm btn-outline-secondary">Effacer</button>
                                            </div>
                                            <div class="mb-3 mt-3">
                                                <label for="signature_comment" class="form-label">Commentaire (optionnel)</label>
                                                <textarea name="signature_comment" id="signature_comment" class="form-control" rows="2" placeholder="Ajoutez un commentaire..."></textarea>
                                            </div>
                                            <div class="alert alert-warning mt-3">
                                                <i class="fa fa-exclamation-triangle me-2"></i>
                                                <strong>Important:</strong> Cette signature électronique a la même valeur légale qu'une signature manuscrite.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="text-center mt-4">
                                        <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                                            <i class="fa fa-check me-2"></i>Signer le contrat
                                        </button>
                                        <div class="mt-2 small text-muted">
                                            <i class="fa fa-shield-alt me-1"></i>Signature sécurisée avec horodatage
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function() {
                        var canvas = document.getElementById('signature-pad');
                        var signaturePad = new SignaturePad(canvas, {
                            backgroundColor: 'rgb(248, 252, 252)'
                        });

                        function resizeCanvas() {
                            var wrapper = document.getElementById('signature-wrapper');
                            var ratio =  Math.max(window.devicePixelRatio || 1, 1);
                            canvas.width = wrapper.offsetWidth * ratio;
                            canvas.height = wrapper.offsetHeight * ratio;
                            canvas.getContext("2d").scale(ratio, ratio);
                            signaturePad.clear();
                        }

                        window.addEventListener("resize", resizeCanvas);
                        resizeCanvas();

                        document.getElementById('clear-signature').addEventListener('click', function () {
                            signaturePad.clear();
                        });

                        document.getElementById('signatureForm').addEventListener('submit', function(e) {
                            if (signaturePad.isEmpty()) {
                                alert("Veuillez signer le contrat avant de continuer.");
                                e.preventDefault();
                                return false;
                            }
                            var signatureImage = document.getElementById('signature_image');
                            signatureImage.value = signaturePad.toDataURL('image/png');
                            
                            const submitBtn = document.getElementById('submitBtn');
                            submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i>Traitement en cours...';
                            submitBtn.disabled = true;
                        });
                    });
                </script>
            </t>
        </template>
        
        <!-- Template contrat déjà signé (RESTORED) -->
        <template id="contract_already_signed" name="Contrat déjà signé">
            <t t-call="web.frontend_layout">
                <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:400,500,600,700&amp;display=swap"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
                <t t-set="title">Contrat déjà signé - BLG Groupe</t>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <div class="o_contract_portal d-flex flex-column min-vh-100" style="font-family: 'Inter', system-ui, -apple-system, sans-serif !important; background: linear-gradient(135deg, #f8fafc 0%, #e9f0fa 100%); color: #334155;">
                    <div class="custom-header" style="padding: 1.25rem 0; background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(226, 232, 240, 0.8);">
                        <div class="container d-flex align-items-center">
                            <img src="/construction_base/static/src/img/blg_logo.png" alt="Logo BLG GROUPE" class="brand-logo" style="height: 42px;" onerror="this.onerror=null; this.src='/web/static/img/logo.png'"/>
                            <span class="brand-text" style="font-size: 1.5rem; font-weight: 700; color: #1e40af; margin-left: 0.75rem;">BLG Groupe</span>
                        </div>
                    </div>
                    <div class="container flex-grow-1 py-5">
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-6">
                                <div class="text-center p-5" style="border-radius: 16px; box-shadow: 0 8px 32px rgba(15, 23, 42, 0.1); background: #fff;">
                                    <div class="mb-4">
                                        <i class="fa fa-check-circle text-success" style="font-size: 4rem;"></i>
                                    </div>
                                    <h2 class="mb-3 text-success">✅ Contrat déjà signé</h2>
                                    <p class="text-muted mb-4">Ce contrat a déjà été signé électroniquement.</p>
                                    <div class="alert alert-info">
                                        <p class="mb-2"><strong>📄 Numéro :</strong> <t t-esc="contract.contract_number"/></p>
                                        <p class="mb-2"><strong>📅 Signé le :</strong> <t t-esc="contract.signed_date" t-options='{"widget": "datetime", "format": "dd/MM/yyyy"}'/></p>
                                        <p class="mb-0"><strong>✍️ État :</strong> Signé et actif</p>
                                    </div>
                                    <div class="mt-4">
                                        <button onclick="window.close();" class="btn btn-outline-secondary me-2">
                                            <i class="fa fa-times me-2"></i>Fermer
                                        </button>
                                        <a t-att-href="contract.portal_url.replace('/sign', '/download')" class="btn btn-primary">
                                            <i class="fa fa-download me-2"></i>Télécharger PDF
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Template signature réussie (RESTORED) -->
        <template id="contract_signature_success" name="Signature réussie">
            <t t-call="web.frontend_layout">
                <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:400,500,600,700&amp;display=swap"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
                <t t-set="title">Signature réussie - BLG Groupe</t>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                 <div class="o_contract_portal d-flex flex-column min-vh-100" style="font-family: 'Inter', system-ui, -apple-system, sans-serif !important; background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); color: #334155;">
                    <div class="custom-header" style="padding: 1.25rem 0; background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(226, 232, 240, 0.8);">
                        <div class="container d-flex align-items-center">
                            <img src="/construction_base/static/src/img/blg_logo.png" alt="Logo BLG GROUPE" class="brand-logo" style="height: 42px;" onerror="this.onerror=null; this.src='/web/static/img/logo.png'"/>
                            <span class="brand-text" style="font-size: 1.5rem; font-weight: 700; color: #16a34a; margin-left: 0.75rem;">BLG Groupe</span>
                        </div>
                    </div>
                    <div class="container flex-grow-1 py-5">
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-6">
                                <div class="text-center p-5" style="border-radius: 16px; box-shadow: 0 8px 32px rgba(34, 197, 94, 0.15); background: #fff; border: 2px solid #bbf7d0;">
                                    <div class="mb-4">
                                        <i class="fa fa-check-circle text-success" style="font-size: 5rem;"></i>
                                    </div>
                                    <h1 class="mb-3 text-success">🎉 Signature réussie !</h1>
                                    <p class="lead text-muted mb-4">Votre contrat a été signé électroniquement avec succès.</p>
                                    <div class="d-flex justify-content-center gap-3 mt-4">
                                        <a t-att-href="contract.portal_url.replace('/sign', '/download')" class="btn btn-success btn-lg">
                                            <i class="fa fa-download me-2"></i>Télécharger le contrat signé
                                        </a>
                                        <button onclick="window.close();" class="btn btn-outline-secondary btn-lg">
                                            <i class="fa fa-times me-2"></i>Fermer
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Template erreur de signature (RESTORED) -->
        <template id="contract_signature_error" name="Erreur de signature">
            <t t-call="web.frontend_layout">
                <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:400,500,600,700&amp;display=swap"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
                <t t-set="title">Erreur de signature - BLG Groupe</t>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <div class="o_contract_portal d-flex flex-column min-vh-100" style="font-family: 'Inter', system-ui, -apple-system, sans-serif !important; background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); color: #334155;">
                    <div class="custom-header" style="padding: 1.25rem 0; background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(226, 232, 240, 0.8);">
                        <div class="container d-flex align-items-center">
                            <img src="/construction_base/static/src/img/blg_logo.png" alt="Logo BLG GROUPE" class="brand-logo" style="height: 42px;" onerror="this.onerror=null; this.src='/web/static/img/logo.png'"/>
                            <span class="brand-text" style="font-size: 1.5rem; font-weight: 700; color: #dc2626; margin-left: 0.75rem;">BLG Groupe</span>
                        </div>
                    </div>
                    <div class="container flex-grow-1 py-5">
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-6">
                                <div class="text-center p-5" style="border-radius: 16px; box-shadow: 0 8px 32px rgba(220, 38, 38, 0.15); background: #fff; border: 2px solid #fecaca;">
                                    <div class="mb-4">
                                        <i class="fa fa-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
                                    </div>
                                    <h2 class="mb-3 text-danger">❌ Erreur de signature</h2>
                                    <p class="text-muted mb-4">
                                        <t t-esc="error or 'Une erreur est survenue lors de la signature. Veuillez réessayer.'"/>
                                    </p>
                                    <div class="d-flex justify-content-center gap-3">
                                        <button onclick="window.location.reload();" class="btn btn-primary">
                                            <i class="fa fa-refresh me-2"></i>Réessayer
                                        </button>
                                        <button onclick="window.close();" class="btn btn-outline-secondary">
                                            <i class="fa fa-times me-2"></i>Fermer
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
