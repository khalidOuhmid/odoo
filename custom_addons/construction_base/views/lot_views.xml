<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Construction Lot Form View -->
    <record id="view_construction_lot_form" model="ir.ui.view">
        <field name="name">construction.lot.form</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <form string="Lot de construction">
                <header>
                    <button name="action_open_lot_document_wizard"
                            string="📁 Gérer documents"
                            type="object"
                            class="btn-info"
                            icon="fa-folder-open"
                            help="Gérer les documents du lot et envoyer l'email au sous-traitant"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="standard_lot_id" options="{'no_create': True}" context="{'default_name': name, 'default_code': code}"/>
                            <field name="name" placeholder="Nom du lot"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chantier_id" readonly="1"/>
                            <field name="code"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="price" widget="monetary"/>
                            <field name="price_from_quote" widget="monetary"/>
                            <field name="is_finished"/>
                            <field name="quote_state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sous-traitants" name="subcontractors">
                            <field name="subcontractor_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Articles" name="order_lines">
                            <field name="order_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Planning" name="planning">
                            <group>
                                <field name="lot_date_start"/>
                                <field name="lot_date_end"/>
                            </group>
                            <field name="planning_task_ids"/>
                        </page>
                        <page string="Documents" name="documents">
                            <group>
                                <group string="📄 Contrat de sous-traitance">
                                    <field name="document_subcontractor_contract" 
                                           filename="contrat_sous_traitance.pdf"
                                           help="Contrat de sous-traitance pour ce lot"/>
                                </group>
                                <group string="📋 CCTP">
                                    <field name="document_cctp" 
                                           filename="cctp.pdf"
                                           help="Cahier des Clauses Techniques Particulières"/>
                                </group>
                            </group>
                            <group>
                                <group string="📅 Planning général">
                                    <field name="document_general_planning" 
                                           filename="planning_general.pdf"
                                           help="Planning général du chantier"/>
                                </group>
                                <group string="👷 Planning sous-traitant">
                                    <field name="document_subcontractor_planning" 
                                           filename="planning_sous_traitant.pdf"
                                           help="Planning spécifique au sous-traitant"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes internes sur le lot..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Construction Lot Tree View -->
    <record id="view_construction_lot_tree" model="ir.ui.view">
        <field name="name">construction.lot.tree</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <list string="Lots de construction">
                <field name="name"/>
                <field name="code"/>
                <field name="chantier_id"/>
                <field name="price" widget="monetary"/>
                <field name="price_from_quote" widget="monetary"/>
                <field name="is_finished"/>
                <field name="subcontractor_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
</odoo>
