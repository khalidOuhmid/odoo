<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================
             WIZARD PRÉVISUALISATION CONTRAT
        ===================================================================-->
        <record id="view_contract_preview_wizard_form" model="ir.ui.view">
            <field name="name">construction.contract.preview.wizard.form</field>
            <field name="model">construction.contract.preview.wizard</field>
            <field name="arch" type="xml">
                <form string="Génération de contrat de sous-traitance">
                    <header>
                        <button name="action_preview_contract"
                                string="👁️ Générer aperçu"
                                type="object"
                                class="btn-info"
                                icon="fa-eye"/>
                        
                        <button name="action_generate_final_contract"
                                string="📄 Générer contrat final"
                                type="object"
                                class="btn-primary"
                                icon="fa-file-text-o"
                                invisible="not preview_pdf"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>📋 Configuration du contrat</h1>
                            <p class="text-muted">Configurez les informations du contrat et générez un aperçu avant création finale.</p>
                        </div>
                        
                        <group>
                            <group string="📋 Informations générales">
                                <field name="chantier_id"/>
                                <field name="subcontractor_id"/>
                                <field name="lot_ids" widget="many2many_tags"/>
                            </group>
                            
                            <group string="💰 Conditions financières">
                                <field name="total_amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="payment_terms"/>
                                <field name="payment_terms_custom" invisible="payment_terms != 'custom'"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="📅 Délais">
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                            
                            <group string="🛡️ Garanties">
                                <field name="warranty_period"/>
                                <field name="insurance_required"/>
                            </group>
                        </group>
                        
                        <group string="📝 Notes additionnelles">
                            <field name="notes" nolabel="1" placeholder="Notes ou commentaires pour le contrat..."/>
                        </group>
                        
                        <!-- Section Aperçu -->
                        <div class="alert alert-info" invisible="not preview_pdf">
                            <h4><i class="fa fa-eye"/> Aperçu généré</h4>
                            <p>Un aperçu du contrat a été généré. Vous pouvez le télécharger pour vérifier le contenu avant de créer le contrat final.</p>
                        </div>
                        
                        <group string="👁️ Aperçu du contrat" invisible="not preview_pdf">
                            <field name="preview_pdf" widget="binary" filename="preview_filename"/>
                            <field name="preview_filename" invisible="1"/>
                        </group>
                        
                        <group string="⚙️ Options de génération" invisible="not preview_pdf">
                            <field name="generate_pdf"/>
                            <field name="send_email"/>
                            <field name="create_portal_link"/>
                        </group>
                        
                        <!-- Instructions -->
                        <div class="alert alert-warning" invisible="preview_pdf">
                            <h4><i class="fa fa-info-circle"/> Instructions</h4>
                            <ol>
                                <li>Configurez les informations du contrat ci-dessus</li>
                                <li>Cliquez sur "👁️ Générer aperçu" pour voir le contrat</li>
                                <li>Vérifiez l'aperçu et ajustez si nécessaire</li>
                                <li>Cliquez sur "📄 Générer contrat final" pour créer le contrat</li>
                            </ol>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ================================================================
             ACTION WIZARD PRÉVISUALISATION
        ===================================================================-->
        <record id="action_contract_preview_wizard" model="ir.actions.act_window">
            <field name="name">Générer contrat de sous-traitance</field>
            <field name="res_model">construction.contract.preview.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="help" type="html">
                <div class="o_view_nocontent_empty_folder">
                    <div class="text-center">
                        <i class="fa fa-file-text fa-3x text-muted mb-3"/>
                        <h3>Configuration du contrat</h3>
                        <p class="text-muted">
                            Configurez les informations du contrat de sous-traitance
                        </p>
                    </div>
                </div>
            </field>
        </record>

    </data>
</odoo> 