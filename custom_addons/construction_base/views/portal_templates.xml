<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================================================================
             TEMPLATES PORTAL POUR LA SIGNATURE PAR ÉTAPES
        ===================================================================-->

        <!-- Page d'accueil de signature -->
        <template id="contract_signature_page" name="Signature de contrat - Accueil">
            <t t-call="web.layout">
                <t t-set="head">
                    <link rel="stylesheet" href="/construction_base/static/src/css/portal_signature.css"/>
                    <script src="/construction_base/static/src/js/portal_signature.js" type="text/javascript"/>
                </t>
                
                <div class="signature-container">
                    <!-- Header avec logo -->
                    <div class="signature-header">
                        <div class="header-content">
                            <div class="logo-section">
                                <img src="/construction_base/static/src/img/blg_logo.png" alt="BLG GROUPE" class="logo"/>
                                <span class="company-name">BLG GROUPE</span>
                            </div>
                        </div>
                    </div>

                    <!-- Contenu principal -->
                    <div class="main-content">
                        <div class="content-wrapper">
                            <!-- Informations du contrat -->
                            <div class="contract-summary">
                                <div class="summary-card">
                                    <h2>Signature Électronique</h2>
                                    <p class="subtitle">Contrat de sous-traitance</p>
                                    
                                    <div class="contract-details">
                                        <div class="detail-row">
                                            <span class="label">Contrat:</span>
                                            <span class="value"><t t-esc="contract.name"/></span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Chantier:</span>
                                            <span class="value"><t t-esc="chantier.name"/></span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Sous-traitant:</span>
                                            <span class="value"><t t-esc="subcontractor.name"/></span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Montant:</span>
                                            <span class="value"><t t-esc="'{:,.2f}'.format(contract.total_amount)"/> €</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Pages à signer:</span>
                                            <span class="value"><t t-esc="total_pages"/></span>
                                        </div>
                                    </div>
                                    
                                    <div class="action-buttons">
                                        <a t-attf-href="/portal/contract/{{contract.id}}/signature_step?access_token={{access_token}}&amp;page_number=1" 
                                           class="btn btn-primary btn-large">
                                            <i class="fa fa-pencil"></i>
                                            Commencer la signature
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Instructions -->
                            <div class="page-content">
                                <div class="content-card">
                                    <div class="page-header">
                                        <h3>Instructions de signature</h3>
                                        <p class="page-subtitle">Processus de signature par étapes</p>
                                    </div>
                                    
                                    <div class="page-body">
                                        <div class="instructions-content">
                                            <div class="instruction-step">
                                                <div class="step-number">1</div>
                                                <div class="step-content">
                                                    <h4>Parcourir le document</h4>
                                                    <p>Vous allez être guidé page par page à travers le contrat.</p>
                                                </div>
                                            </div>
                                            <div class="instruction-step">
                                                <div class="step-number">2</div>
                                                <div class="step-content">
                                                    <h4>Apposer vos initiales</h4>
                                                    <p>Sur chaque page, vous devrez apposer vos initiales pour confirmer que vous avez lu et compris le contenu.</p>
                                                </div>
                                            </div>
                                            <div class="instruction-step">
                                                <div class="step-number">3</div>
                                                <div class="step-content">
                                                    <h4>Signer le document</h4>
                                                    <p>Une fois toutes les pages parcourues, vous pourrez signer électroniquement le contrat complet.</p>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Avertissement légal -->
                                        <div class="legal-warning">
                                            <div class="warning-box">
                                                <div class="warning-icon">
                                                    <i class="fa fa-exclamation-triangle"></i>
                                                </div>
                                                <div class="warning-content">
                                                    <h4>Avertissement légal</h4>
                                                    <p>En signant ce document, vous acceptez d'être lié par toutes les conditions contractuelles qu'il contient.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Page de signature par étape -->
        <template id="contract_signature_step" name="Signature de contrat - Étape">
            <t t-call="web.layout">
                <t t-set="head">
                    <link rel="stylesheet" href="/construction_base/static/src/css/portal_signature.css"/>
                    <script src="/construction_base/static/src/js/portal_signature.js" type="text/javascript"/>
                </t>
                
                <div class="signature-container">
                    <!-- Header avec logo et progression -->
                    <div class="signature-header">
                        <div class="header-content">
                            <div class="logo-section">
                                <img src="/construction_base/static/src/img/blg_logo.png" alt="BLG GROUPE" class="logo"/>
                                <span class="company-name">BLG GROUPE</span>
                            </div>
                            <div class="progress-section">
                                <div class="progress-info">
                                    <span class="current-step">Étape <t t-esc="page_number"/></span>
                                    <span class="total-steps">sur <t t-esc="total_pages"/></span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" t-attf-style="width: #{progress_percentage}%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contenu principal -->
                    <div class="main-content">
                        <div class="content-wrapper">
                            <!-- Informations du contrat -->
                            <div class="contract-summary">
                                <div class="summary-card">
                                    <h2>Signature électronique</h2>
                                    <p class="subtitle">Page <t t-esc="page_number"/> sur <t t-esc="total_pages"/></p>
                                    
                                    <div class="contract-details">
                                        <div class="detail-row">
                                            <span class="label">Chantier:</span>
                                            <span class="value"><t t-esc="chantier.name"/></span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Sous-traitant:</span>
                                            <span class="value"><t t-esc="subcontractor.name"/></span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Montant:</span>
                                            <span class="value"><t t-esc="'{:,.2f}'.format(contract.total_amount)"/> €</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Contenu de la page courante -->
                            <div class="page-content">
                                <div class="content-card">
                                    <div class="page-header">
                                        <h3><t t-esc="current_page.title"/></h3>
                                        <p class="page-subtitle"><t t-esc="current_page.subtitle"/></p>
                                    </div>
                                    
                                    <div class="page-body" t-raw="current_page.content"/>
                                    
                                    <!-- Zone d'initiales en bas de page -->
                                    <div class="initials-zone">
                                        <div class="initials-section">
                                            <h4>Validation de cette page</h4>
                                            <p>En apposant vos initiales, vous confirmez avoir lu et compris le contenu de cette page.</p>
                                            
                                            <form method="post" class="initials-form">
                                                <div class="initials-input-group">
                                                    <label for="initials">Vos initiales :</label>
                                                    <input type="text" id="initials" name="initials_data" 
                                                           class="initials-input" 
                                                           placeholder="Ex: JD" maxlength="10" required="required"/>
                                                    <div class="initials-preview">
                                                        <span class="preview-label">Aperçu :</span>
                                                        <span id="initials-preview" class="preview-text">-</span>
                                                    </div>
                                                </div>
                                                
                                                <div class="form-actions">
                                                    <button type="submit" class="btn btn-primary btn-large">
                                                        <i class="fa fa-check"></i>
                                                        Valider cette page
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Navigation des pages -->
                            <div class="page-navigation">
                                <div class="nav-container">
                                    <!-- Bouton Précédent -->
                                    <div class="nav-button">
                                        <t t-if="page_number > 1 and contract.is_page_initialed(page_number - 1)">
                                            <a t-attf-href="/portal/contract/{{contract.id}}/signature_step?access_token={{access_token}}&amp;page_number={{page_number - 1}}" 
                                               class="btn btn-secondary">
                                                <i class="fa fa-chevron-left"></i> Précédent
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <button class="btn btn-secondary" disabled="disabled">
                                                <i class="fa fa-chevron-left"></i> Précédent
                                            </button>
                                        </t>
                                    </div>
                                    
                                    <!-- Indicateur de page -->
                                    <div class="page-indicator">
                                        <span class="current-page">Page <t t-esc="page_number"/></span>
                                        <span class="page-separator">/</span>
                                        <span class="total-pages"><t t-esc="total_pages"/></span>
                                    </div>
                                    
                                    <!-- Bouton Suivant (désactivé jusqu'à validation) -->
                                    <div class="nav-button">
                                        <button class="btn btn-secondary" disabled="disabled">
                                            Suivant <i class="fa fa-chevron-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    <![CDATA[
                    // Mise à jour en temps réel de l'aperçu des initiales
                    document.getElementById('initials').addEventListener('input', function() {
                        const value = this.value.toUpperCase();
                        const preview = document.getElementById('initials-preview');
                        preview.textContent = value || '-';
                        preview.style.color = value.length >= 2 ? '#28a745' : '#dc3545';
                        
                        // Activer/désactiver le bouton de validation
                        const submitBtn = document.querySelector('.initials-form button[type="submit"]');
                        submitBtn.disabled = value.length < 2;
                    });
                    ]]>
                </script>
            </t>
        </template>

        <!-- Page finale de signature -->
        <template id="contract_signature_final" name="Signature de contrat - Finale">
            <t t-call="web.layout">
                <t t-set="head">
                    <link rel="stylesheet" href="/construction_base/static/src/css/portal_signature.css"/>
                    <script src="/construction_base/static/src/js/portal_signature.js" type="text/javascript"/>
                </t>
                
                <div class="signature-container">
                    <!-- Header avec logo et progression -->
                    <div class="signature-header">
                        <div class="header-content">
                            <div class="logo-section">
                                <img src="/construction_base/static/src/img/blg_logo.png" alt="BLG GROUPE" class="logo"/>
                                <span class="company-name">BLG GROUPE</span>
                            </div>
                            <div class="progress-section">
                                <div class="progress-info">
                                    <span class="current-step">Signature finale</span>
                                    <span class="total-steps">Étape finale</span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: 100%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contenu principal -->
                    <div class="main-content">
                        <div class="content-wrapper">
                            <!-- Informations du contrat -->
                            <div class="contract-summary">
                                <div class="summary-card">
                                    <h2>Signature finale du contrat</h2>
                                    <p class="subtitle">Toutes les pages ont été validées. Vous pouvez maintenant signer le contrat.</p>
                                    
                                    <div class="contract-details">
                                        <div class="detail-row">
                                            <span class="label">Contrat:</span>
                                            <span class="value"><t t-esc="contract.name"/></span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Sous-traitant:</span>
                                            <span class="value"><t t-esc="subcontractor.name"/></span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Chantier:</span>
                                            <span class="value"><t t-esc="chantier.name"/></span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Montant:</span>
                                            <span class="value"><t t-esc="'{:,.2f}'.format(contract.total_amount)"/> €</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Pages validées:</span>
                                            <span class="value"><t t-esc="contract.get_signature_progress_summary()['initialed_pages']"/> / <t t-esc="contract.get_signature_progress_summary()['total_pages']"/></span>
                                        </div>
                                    </div>
                                    
                                    <div class="success-indicator">
                                        <div class="success-icon">
                                            <i class="fa fa-check-circle"></i>
                                        </div>
                                        <p>Toutes les pages ont été parcourues et validées</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Zone de signature finale -->
                            <div class="page-content">
                                <div class="content-card">
                                    <div class="page-header">
                                        <h3>Signature électronique</h3>
                                        <p class="page-subtitle">Apposez votre signature pour valider définitivement le contrat</p>
                                    </div>
                                    
                                    <div class="page-body">
                                        <div class="signature-section">
                                            <h4>Votre signature</h4>
                                            <p>Veuillez signer électroniquement le contrat pour le valider définitivement.</p>
                                            
                                            <form method="post" class="signature-form">
                                                <div class="signature-canvas-section">
                                                    <label for="signature-canvas">Zone de signature :</label>
                                                    <div class="canvas-container">
                                                        <canvas id="signature-canvas" width="400" height="200"></canvas>
                                                        <div class="canvas-controls">
                                                            <button type="button" id="clear-signature" class="btn btn-outline">
                                                                <i class="fa fa-eraser"></i> Effacer
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <input type="hidden" id="signature-data" name="signature_image"/>
                                                </div>
                                                
                                                <div class="signature-comment-section">
                                                    <label for="signature-comment">Commentaire (optionnel) :</label>
                                                    <textarea id="signature-comment" name="signature_comment" 
                                                              class="form-control" rows="3" 
                                                              placeholder="Ajoutez un commentaire si nécessaire..."></textarea>
                                                </div>
                                                
                                                <div class="form-actions">
                                                    <button type="submit" id="submit-signature" class="btn btn-primary btn-large" disabled="disabled">
                                                        <i class="fa fa-signature"></i>
                                                        Signer le contrat
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                    
                                    <!-- Avertissement légal -->
                                    <div class="legal-warning">
                                        <div class="warning-box">
                                            <div class="warning-icon">
                                                <i class="fa fa-exclamation-triangle"></i>
                                            </div>
                                            <div class="warning-content">
                                                <h4>Avertissement légal</h4>
                                                <p>En signant ce document, vous acceptez d'être lié par toutes les conditions contractuelles qu'il contient. 
                                                Cette signature électronique a la même valeur juridique qu'une signature manuscrite.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    <![CDATA[
                    // Initialisation du canvas de signature
                    const canvas = document.getElementById('signature-canvas');
                    const ctx = canvas.getContext('2d');
                    let isDrawing = false;
                    let hasSignature = false;

                    // Configuration du canvas
                    ctx.strokeStyle = '#000';
                    ctx.lineWidth = 2;
                    ctx.lineCap = 'round';

                    // Gestion du dessin
                    canvas.addEventListener('mousedown', startDrawing);
                    canvas.addEventListener('mousemove', draw);
                    canvas.addEventListener('mouseup', stopDrawing);
                    canvas.addEventListener('mouseout', stopDrawing);

                    // Gestion tactile
                    canvas.addEventListener('touchstart', startDrawing);
                    canvas.addEventListener('touchmove', draw);
                    canvas.addEventListener('touchend', stopDrawing);

                    function startDrawing(e) {
                        isDrawing = true;
                        draw(e);
                    }

                    function draw(e) {
                        if (!isDrawing) return;
                        
                        e.preventDefault();
                        const rect = canvas.getBoundingClientRect();
                        const x = (e.clientX || e.touches[0].clientX) - rect.left;
                        const y = (e.clientY || e.touches[0].clientY) - rect.top;
                        
                        ctx.lineTo(x, y);
                        ctx.stroke();
                        ctx.beginPath();
                        ctx.moveTo(x, y);
                        
                        hasSignature = true;
                        updateSubmitButton();
                    }

                    function stopDrawing() {
                        isDrawing = false;
                        ctx.beginPath();
                    }

                    // Effacer la signature
                    document.getElementById('clear-signature').addEventListener('click', function() {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        hasSignature = false;
                        updateSubmitButton();
                    });

                    // Mise à jour du bouton de soumission
                    function updateSubmitButton() {
                        const submitBtn = document.getElementById('submit-signature');
                        submitBtn.disabled = !hasSignature;
                    }

                    // Soumission du formulaire
                    document.querySelector('.signature-form').addEventListener('submit', function(e) {
                        if (!hasSignature) {
                            e.preventDefault();
                            alert('Veuillez apposer votre signature avant de continuer.');
                            return;
                        }
                        
                        // Convertir le canvas en base64
                        const signatureData = canvas.toDataURL();
                        document.getElementById('signature-data').value = signatureData;
                    });
                    ]]>
                </script>
            </t>
        </template>

        <!-- Page de succès -->
        <template id="contract_signature_success" name="Signature de contrat - Succès">
            <t t-call="web.layout">
                <div class="signature-container">
                    <div class="main-content">
                        <div class="content-wrapper">
                            <div class="page-content">
                                <div class="content-card">
                                    <div class="success-indicator">
                                        <div class="success-icon">
                                            <i class="fa fa-check-circle"></i>
                                        </div>
                                        <h1>Signature réussie !</h1>
                                        <p>Le contrat a été signé électroniquement avec succès.</p>
                                        
                                        <div class="contract-details">
                                            <h3>Détails du contrat</h3>
                                            <div class="detail-row">
                                                <span class="label">Contrat :</span>
                                                <span class="value"><t t-esc="contract.name"/></span>
                                            </div>
                                            <div class="detail-row">
                                                <span class="label">Numéro :</span>
                                                <span class="value"><t t-esc="contract.contract_number"/></span>
                                            </div>
                                            <div class="detail-row">
                                                <span class="label">Date de signature :</span>
                                                <span class="value"><t t-esc="contract.signed_date.strftime('%d/%m/%Y à %H:%M') if contract.signed_date else 'Non définie'"/></span>
                                            </div>
                                        </div>
                                        
                                        <div class="action-buttons">
                                            <a t-attf-href="/portal/contract/{{contract.id}}/download?access_token={{access_token}}" 
                                               class="btn btn-primary">
                                                <i class="fa fa-download"></i>
                                                Télécharger le contrat signé
                                            </a>
                                            <a t-attf-href="/portal/contract/{{contract.id}}/verify_signature?access_token={{access_token}}" 
                                               class="btn btn-secondary">
                                                <i class="fa fa-shield"></i>
                                                Vérifier la signature
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Page d'erreur -->
        <template id="contract_signature_error" name="Signature de contrat - Erreur">
            <t t-call="web.layout">
                <div class="signature-container">
                    <div class="main-content">
                        <div class="content-wrapper">
                            <div class="page-content">
                                <div class="content-card">
                                    <div class="error-indicator">
                                        <div class="error-icon">
                                            <i class="fa fa-exclamation-triangle"></i>
                                        </div>
                                        <h1>Erreur de signature</h1>
                                        <p>Une erreur s'est produite lors de la signature du contrat.</p>
                                        
                                        <div class="error-details">
                                            <p><strong>Erreur :</strong> <t t-esc="error"/></p>
                                        </div>
                                        
                                        <div class="action-buttons">
                                            <a t-attf-href="/portal/contract/{{contract.id}}/sign?access_token={{access_token}}" 
                                               class="btn btn-primary">
                                                <i class="fa fa-refresh"></i>
                                                Réessayer
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Page d'accès refusé -->
        <template id="contract_access_denied" name="Accès refusé">
            <t t-call="web.layout">
                <div class="signature-container">
                    <div class="main-content">
                        <div class="content-wrapper">
                            <div class="page-content">
                                <div class="content-card">
                                    <div class="access-denied-indicator">
                                        <div class="access-denied-icon">
                                            <i class="fa fa-lock"></i>
                                        </div>
                                        <h1>Accès refusé</h1>
                                        <p><t t-esc="error"/></p>
                                        
                                        <div class="action-buttons">
                                            <a href="/" class="btn btn-primary">
                                                <i class="fa fa-home"></i>
                                                Retour à l'accueil
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Page déjà signé -->
        <template id="contract_already_signed" name="Contrat déjà signé">
            <t t-call="web.layout">
                <div class="signature-container">
                    <div class="main-content">
                        <div class="content-wrapper">
                            <div class="page-content">
                                <div class="content-card">
                                    <div class="already-signed-indicator">
                                        <div class="already-signed-icon">
                                            <i class="fa fa-check-double"></i>
                                        </div>
                                        <h1>Contrat déjà signé</h1>
                                        <p>Ce contrat a déjà été signé électroniquement.</p>
                                        
                                        <div class="contract-details">
                                            <div class="detail-row">
                                                <span class="label">Date de signature :</span>
                                                <span class="value"><t t-esc="contract.signed_date.strftime('%d/%m/%Y à %H:%M') if contract.signed_date else 'Non définie'"/></span>
                                            </div>
                                        </div>
                                        
                                        <div class="action-buttons">
                                            <a t-attf-href="/portal/contract/{{contract.id}}/download?access_token={{access_token}}" 
                                               class="btn btn-primary">
                                                <i class="fa fa-download"></i>
                                                Télécharger le contrat
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
