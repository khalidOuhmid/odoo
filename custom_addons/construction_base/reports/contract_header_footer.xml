<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template pour le header de toutes les pages -->
        <template id="contract_header_template" name="Header contrat">
            <style>
                body {
                    margin: 0;
                    padding: 0;
                    font-family: 'Segoe UI', Arial, sans-serif;
                    font-size: 12px;
                }
                .header-container {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 10px;
                    border-bottom: 1px solid #333;
                    padding-bottom: 5px;
                }
                .header-logo {
                    height: 50px;
                    max-width: 100%;
                }
                .header-title {
                    color: #333;
                    font-size: 22px;
                    font-weight: bold;
                    margin: 0;
                }
                .header-subtitle {
                    color: #666;
                    margin: 5px 0 0 0;
                    font-size: 12px;
                }
            </style>
            <table class="header-container">
                <tr>
                    <td style="width: 15%; text-align: left; vertical-align: middle;">
                        <img t-if="blg_logo" t-att-src="blg_logo" alt="Logo BLG GROUPE" class="header-logo"/>
                    </td>
                    <td style="width: 70%; text-align: center; vertical-align: middle;">
                        <h1 class="header-title">Contrat de sous-traitance</h1>
                        <p class="header-subtitle">BLG GROUPE - Document contractuel</p>
                    </td>
                    <td style="width: 15%; text-align: right; vertical-align: middle;">
                        <img t-if="blg_logo" t-att-src="blg_logo" alt="Logo BLG GROUPE" class="header-logo"/>
                    </td>
                </tr>
            </table>
        </template>

        <!-- Template pour le footer avec numérotation -->
        <template id="contract_footer_template" name="Footer contrat">
            <style>
                body {
                    margin: 0;
                    padding: 0;
                    font-family: 'Segoe UI', Arial, sans-serif;
                    font-size: 10px;
                    color: #666;
                }
                .footer-container {
                    width: 100%;
                    text-align: center;
                    padding: 5px 0;
                }
                .page-number {
                    font-size: 10px;
                    color: #666;
                }
            </style>
            <div class="footer-container">
                <span class="page-number">Page <span class="page"></span></span>
            </div>
        </template>
    </data>
</odoo> 