<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template QWeb: Facture chantier inspirée du contrat de sous-traitance -->
        <template id="chantier_invoice_template" name="Facture Chantier BLG">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or env.company"/>
                <t t-set="client" t-value="o.partner_id"/>
                <t t-set="formatted_date" t-value="o.invoice_date.strftime('%d/%m/%Y') if o.invoice_date else fields.Date.today().strftime('%d/%m/%Y')"/>

                <div class="page" style="font-family: 'Segoe UI', Arial, sans-serif; font-size:12px; color:#2c3e50;">
                    <!-- En-tête -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:12px; border-bottom:1px solid #333; padding-bottom:6px;">
                        <tr>
                            <td style="width:60%; vertical-align:top;">
                                <h2 style="margin:0; color:#20B2AA;"><t t-esc="(o.invoice_origin or 'Facture') + ' - ' + formatted_date"/></h2>
                                <p style="margin:4px 0 0 0;">Référence: <strong><t t-esc="o.name or 'N/A'"/></strong></p>
                                <p style="margin:2px 0 0 0;">Date: <strong><t t-esc="formatted_date"/></strong></p>
                                <p style="margin:2px 0 0 0;">Chantier: <strong><t t-esc="o.invoice_origin or 'N/A'"/></strong></p>
                                <p style="margin:2px 0 0 0;">Étape: <strong><t t-esc="o.ref or ''"/></strong></p>
                            </td>
                            <td style="width:40%; vertical-align:top; text-align:right;">
                                <t t-set="blg_logo" t-value="env['construction.contract.service']._get_blg_images_base64().get('logo')"/>
                                <t t-if="blg_logo">
                                    <img t-att-src="blg_logo" alt="BLG" style="height:50px; margin-bottom:6px;"/>
                                </t>
                                <p style="margin:0; font-weight:bold;"><t t-esc="company.name"/></p>
                                <p style="margin:2px 0 0 0;"><t t-esc="company.street or ''"/></p>
                                <p style="margin:2px 0 0 0;"><t t-esc="(company.zip or '') + ' ' + (company.city or '')"/></p>
                                <p style="margin:2px 0 0 0;">SIREN: <t t-esc="company.company_registry or ''"/></p>
                            </td>
                        </tr>
                    </table>

                    <!-- Informations client -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:18px;">
                        <tr>
                            <td style="width:50%; vertical-align:top; border:1px solid #e9ecef; padding:8px;">
                                <p style="margin:0 0 6px 0; color:#20B2AA; font-weight:600;">Facturé à</p>
                                <p style="margin:0; font-weight:bold;"><t t-esc="client.name"/></p>
                                <t t-if="client.street"><p style="margin:2px 0 0 0;"><t t-esc="client.street"/></p></t>
                                <t t-if="client.zip or client.city"><p style="margin:2px 0 0 0;"><t t-esc="client.zip or ''"/> <t t-esc="client.city or ''"/></p></t>
                                <t t-if="client.vat"><p style="margin:2px 0 0 0;">TVA: <t t-esc="client.vat"/></p></t>
                            </td>
                            <td style="width:50%; vertical-align:top; border:1px solid #e9ecef; border-left:none; padding:8px;">
                                <p style="margin:0 0 6px 0; color:#20B2AA; font-weight:600;">Informations</p>
                                <p style="margin:0;">Modele: <strong>Facture chantier</strong></p>
                                <p style="margin:2px 0 0 0;">Devise: <t t-esc="o.currency_id.name"/></p>
                            </td>
                        </tr>
                    </table>

                    <!-- Lignes -->
                    <table style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr style="background: linear-gradient(135deg, #20B2AA 0%, #1a9999 100%); color:#fff;">
                                <th style="padding:10px; text-align:left;">Désignation</th>
                                <th style="padding:10px; text-align:right; width:80px;">Qté</th>
                                <th style="padding:10px; text-align:right; width:120px;">PU</th>
                                <th style="padding:10px; text-align:right; width:140px;">Sous-total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="l">
                                <tr>
                                    <td style="padding:8px; border-bottom:1px solid #e9ecef;"><t t-esc="l.name"/></td>
                                    <td style="padding:8px; border-bottom:1px solid #e9ecef; text-align:right;"><t t-esc="('%.2f' % (l.quantity or 0))"/></td>
                                    <td style="padding:8px; border-bottom:1px solid #e9ecef; text-align:right;"><t t-esc="('%.2f' % (l.price_unit or 0))"/></td>
                                    <td style="padding:8px; border-bottom:1px solid #e9ecef; text-align:right;"><t t-esc="('%.2f' % (l.price_subtotal or 0))"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totaux -->
                    <table style="width:100%; border-collapse:collapse; margin-top:12px;">
                        <tr>
                            <td style="width:60%;"></td>
                            <td style="width:40%;">
                                <table style="width:100%; border-collapse:collapse;">
                                    <tr>
                                        <td style="padding:6px; text-align:right; border-bottom:1px solid #e9ecef;">Total HT</td>
                                        <td style="padding:6px; text-align:right; border-bottom:1px solid #e9ecef;"><t t-esc="('%.2f' % (o.amount_untaxed or 0))"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:6px; text-align:right; border-bottom:1px solid #e9ecef;">Taxes</td>
                                        <td style="padding:6px; text-align:right; border-bottom:1px solid #e9ecef;"><t t-esc="('%.2f' % (o.amount_tax or 0))"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:8px; text-align:right; font-weight:bold;">Total TTC</td>
                                        <td style="padding:8px; text-align:right; font-weight:bold;"><t t-esc="('%.2f' % (o.amount_total or 0))"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Footer -->
                    <div style="margin-top:18px; font-size:10px; color:#666; text-align:center;">
                        <p style="margin:0;">Document généré par BLG GROUPE</p>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>


