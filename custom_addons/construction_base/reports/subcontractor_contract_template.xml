<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="subcontractor_contract_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">

                <style>
                    body,div { font-family: 'Arial',sans-serif; font-size: 11.3pt; }
                    .contract-header { text-align: center; font-size:24px; font-weight: bold; margin-bottom: 35px; margin-top: 20px;}
                    .logo-wrap { display:flex; justify-content:space-between; align-items: center;}
                    .logo { width:65px;}
                    .main-table { width:100%; border-spacing:0; margin-bottom:35px;}
                    .main-table td, .main-table th { padding: 7px 12px; vertical-align: top;}
                    .main-table th { color: #5bc0be; font-weight: bold; font-size: 13pt; background: #f5f5f5;}
                    .main-table td { border-bottom: 1px solid #e0e0e0;}
                    .value-title { font-weight:bold; color:#5bc0be;}
                    .value-bold { font-weight:bold; }
                    .highlight { color:#e91e63; font-weight:bold; }
                    .section-title { margin-top:22px; margin-bottom: 7px; font-size:15px; font-weight:bold; color: #5bc0be;}
                    .content-section { margin-bottom:13px; margin-top:2px; line-height:1.5;}
                    .content-section ul { margin-bottom: 10px; }
                    .payment-table { width: 85%; margin:auto; border-collapse: collapse; margin-top:12px; }
                    .payment-table th, .payment-table td { border:1px solid #b0b0b0; padding:7px 8px; text-align:center;}
                    .payment-table th { background-color:#f5f5f5; color: #5bc0be;}
                    .signature-row { width:100%; display:flex; justify-content:space-between; align-items:end; margin-top: 50px;}
                    .signature-col { width:32%; text-align:center; font-size: 11.5pt;}
                    hr { border: none; border-top:1.5px solid #b0b0b0; margin: 15px 0;}
                </style>

                <!-- HEADER -->
                <div class="logo-wrap">
                    <img t-att-src="'/your_module/static/img/logo-blg.png'" alt="Logo" class="logo"/>
                    <div class="contract-header">Contrat de sous-traitance</div>
                    <img t-att-src="'/your_module/static/img/logo-blg.png'" alt="Logo" class="logo"/>
                </div>

                <!-- TABLE Parties contractantes -->
                <table class="main-table">
                    <tr>
                        <th>Contractant général</th>
                        <th>L'entreprise</th>
                    </tr>
                    <tr>
                        <td>
                            <span class="value-bold">B.L.G GROUPE</span><br/>
                            44 rue commanderie des templiers<br/>
                            33440 Ambarès
                        </td>
                        <td>
                            <span class="highlight" t-field="doc.subcontractor_id.name"/>
                            <br/><span t-field="doc.subcontractor_id.street"/>,
                            <span t-field="doc.subcontractor_id.zip"/> <span t-field="doc.subcontractor_id.city"/>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="value-title">Références à rappeler impérativement</span><br/>
                            Chantier : <span t-field="doc.chantier_id.name"/>
                        </td>
                        <td>
                            Immatriculation / justificatif &lt; 3 mois:<br />
                            <t t-if="doc.subcontractor_id.vat">TVA: <span t-field="doc.subcontractor_id.vat"/></t>
                            <t t-if="not doc.subcontractor_id.vat">Identifiant: <span t-field="doc.subcontractor_id.ref"/></t>
                            <br />
                            Registre du commerce: <span class="highlight">443 342 - Travaux de peinture et vitrerie</span>
                        </td>
                    </tr>
                </table>

                <!-- Section 1 : Désignation des prestations -->
                <div class="section-title">1 - Désignation des prestations</div>
                <div class="content-section">
                    <span class="value-title">OPÉRATION :</span> <span t-field="doc.lot_id.name"/><br/>
                    <span class="value-title">MAITRE D'ŒUVRE :</span> B.L.G GROUPE<br/>
                    <span class="value-title">NATURE DES TRAVAUX :</span> <span t-field="doc.lot_id.description"/><br/>
                    <span class="value-title">LIEU D'EXÉCUTION :</span> <span t-field="doc.chantier_id.address"/><br/>
                    <span class="value-title">OBJET DE LA PRÉSENTE :</span> Travaux de <span class="highlight">Peinture</span>
                </div>

                <!-- Section 2 : Prix -->
                <div class="section-title">2 - Prix</div>
                <div class="content-section">
                    <div>
                        <span class="highlight" t-field="doc.lot_id.price"/> €<br/><br/>
                        Le prix est ferme et non révisable. « AUTOLIQUIDATION, article 242 nonies A de l'annexe II au code général des impôts ».<br/>
                        Ce prix comprend l’ensemble des coûts, frais et débours de l’Entreprise nécessaires à la bonne exécution du Contrat. Aucun supplément ne pourra être demandé.<br/>
                        L’Entreprise renonce expressément à l’application au bénéfice des dispositions de l’article 1195 du Code Civil.
                    </div>
                </div>
                <hr/>

                <!-- Section 3 : Échéancier de paiement -->
                <div class="section-title">3 - Échéancier de paiement</div>
                <div class="content-section">
                    Le prix est payable selon l’échéancier suivant :
                    <table class="payment-table">
                        <thead>
                            <tr>
                                <th>Avancement chantier</th>
                                <th>Facturation</th>
                                <th>Montant (€) HT + TTC</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>30%</td><td>30%</td>
                                <td class="highlight"><t t-esc="'%.0f' % (doc.lot_id.price * 0.3)"/></td>
                            </tr>
                            <tr>
                                <td>70%</td><td>100%</td>
                                <td class="highlight"><t t-esc="'%.0f' % (doc.lot_id.price * 0.7)"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div style="margin-top:6px;font-size:10pt;">
                      La gestion financière est assurée en compte tiers séquestré. Le PV de réception signé déclenche la libération des fonds (max 30 jours après réception des justificatifs signés).
                    </div>
                </div>

                <hr style="page-break-after: always;"/>

                <!-- Section 4 : Délais -->
                <div class="section-title">4 - Délais</div>
                <div class="content-section">Suivant planning prévisionnel en annexe, tout planning remis par BLG GROUPE en cours d’exécution du marché aura valeur contractuelle.</div>

                <!-- Section 5 : Documents contractuels et annexes -->
                <div class="section-title">5 - Documents contractuels et annexes</div>
                <div class="content-section">
                    <ul>
                        <li>La présente commande et le cas échéant ses annexes : plans d’exécution, notice descriptive, etc.</li>
                        <li>Les « conditions générales de commande jointes »</li>
                    </ul>
                </div>

                <!-- Section 6 : Documents à transmettre -->
                <div class="section-title">6 - Documents à transmettre à BLG GROUPE</div>
                <div class="content-section">
                    Le prestataire remet à la signature et tous les 6 mois :
                    <ul>
                        <li>Extrait Kbis actualisé</li>
                        <li>Attestations sociales &amp; d'assurances (valide sur toute la durée du chantier)</li>
                        <li>Attestations de mise à jour et conformité réglementaire</li>
                    </ul>
                </div>

                <!-- Section 7 : Validité -->
                <div class="section-title">7 - Validité</div>
                <div class="content-section">
                    Cette commande est nulle si non retournée acceptée, accompagnée des documents demandés sous 5 jours.
                    Tout commencement d’exécution vaut acceptation sans réserve.
                </div>

                <!-- Signatures -->
                <div style="margin-top:40px; text-align: center;">
                    <div>Fait à Bordeaux, le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></div>
                </div>
                <div class="signature-row">
                    <div class="signature-col">
                        L'entreprise<br/>Pour BLG GROUPE<br/><br/><br/>
                        <div style="border-top:1px solid #000; margin-top:30px; font-size:10pt;">(signature et cachet)</div>
                    </div>
                    <div class="signature-col">
                        En 2 exemplaires originaux
                    </div>
                    <div class="signature-col">
                        Le prestataire<br/><br/><br/>
                        <div style="border-top:1px solid #000; margin-top:30px; font-size:10pt;">(signature et cachet)</div>
                    </div>
                </div>

                </t>
            </t>
        </template>

        <!-- Report Action -->
        <record id="action_subcontractor_contract_report" model="ir.actions.report">
            <field name="name">Contrat de sous-traitance</field>
            <field name="model">lot.document.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">construction_base.subcontractor_contract_template</field>
            <field name="report_file">construction_base.subcontractor_contract_template</field>
            <field name="print_report_name">'Contrat_sous_traitance_%s' % (object.lot_id.name or 'N_A').replace('/', '_')</field>
        </record>
    </data>
</odoo>
