<odoo>
    <data>
        <!-- Rapport pour le contrat de sous-traitance -->
        <record id="action_subcontractor_contract_report" model="ir.actions.report">
            <field name="name">Contrat de sous-traitance</field>
            <field name="model">lot.document.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">construction_base.contrat_sous_traitance_template</field>
            <field name="report_file">construction_base.contrat_sous_traitance_template</field>
            <field name="print_report_name">'Contrat_sous_traitance_%s' % (object.lot_id.name or 'N/A').replace('/', '_')</field>
        </record>

        <!-- Action de report pour la facture chantier BLG -->
        <record id="action_chantier_invoice_report" model="ir.actions.report">
            <field name="name">Facture Chantier BLG</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">construction_base.chantier_invoice_template</field>
            <field name="report_file">construction_base.chantier_invoice_template</field>
            <field name="print_report_name">'Facture_%s' % (object.name or 'N/A').replace('/', '_')</field>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>
    </data>
</odoo>
