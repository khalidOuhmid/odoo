<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Report utilisant votre template complet -->
        <record id="report_subcontractor_contract" model="ir.actions.report">
            <field name="name">Contrat de sous-traitance</field>
            <field name="model">construction.subcontractor.contract</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">construction_base.contrat_sous_traitance_template</field>
            <field name="report_file">construction_base.contrat_sous_traitance_template</field>
            <field name="print_report_name">'Contrat_%s_%s' % (object.subcontractor_id.name, object.contract_number)</field>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>

        <!-- Séquence pour les numéros de contrat -->
        <record id="seq_construction_contract" model="ir.sequence">
            <field name="name">Contrats de sous-traitance</field>
            <field name="code">construction.contract</field>
            <field name="prefix">CT-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
