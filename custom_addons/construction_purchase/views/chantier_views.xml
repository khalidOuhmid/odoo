<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Chantier Form Extension for Purchase - Simplified -->
    <record id="view_construction_chantier_form_purchase" model="ir.ui.view">
        <field name="name">construction.chantier.form.purchase</field>
        <field name="model">construction.chantier</field>
        <field name="inherit_id" ref="construction_core.view_construction_chantier_form"/>
        <field name="arch" type="xml">
            <!-- Add Purchase tab with actions only (no fields that don't exist yet) -->
            <xpath expr="//notebook" position="inside">
                <page string="💰 Achats" name="purchases">
                    <group>
                        <group string="Actions Achats">
                            <button name="action_create_purchase_orders" type="object"
                                    string="🛒 Créer Commandes Groupées"
                                    class="btn-primary"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
