<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH -->
    <record id="view_planning_task_search" model="ir.ui.view">
        <field name="name">construction.planning.task.search</field>
        <field name="model">construction.planning.task</field>
        <field name="arch" type="xml">
            <search string="Recherche Planning">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="partner_id"/>
                <filter string="Mes Tâches" name="my_tasks" domain="[('partner_id.user_ids', 'in', uid)]"/>
                <filter string="Interne" name="internal" domain="[('resource_type', '=', 'internal')]"/>
                <filter string="Sous-traitance" name="external" domain="[('resource_type', '=', 'external')]"/>
                <group expand="0" string="Group By">
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Ressource" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Lot" name="group_lot" context="{'group_by': 'lot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- GANTT VIEW (Enterprise or Compatible Lib) -->
    <!-- Assuming web_gantt presence or similar. If Community, this might need a custom widget -->
    <record id="view_planning_task_gantt" model="ir.ui.view">
        <field name="name">construction.planning.task.gantt</field>
        <field name="model">construction.planning.task</field>
        <field name="arch" type="xml">
            <gantt string="Planning Chantier"
                   date_start="date_start"
                   date_stop="date_end"
                   default_group_by="chantier_id"
                   color="partner_id"
                   scales="day,week,month"
                   precision="{'day': 'hour:full', 'week': 'day:full', 'month': 'day:full'}"
                   thumbnails="{'partner_id': 'image_128'}">
                <field name="name"/>
                <field name="partner_id"/>
                <templates>
                    <div t-name="gantt-popover">
                        <div><strong><field name="name"/></strong></div>
                        <div><field name="chantier_id"/></div>
                        <div><field name="partner_id"/> (<field name="progress"/>%)</div>
                    </div>
                </templates>
            </gantt>
        </field>
    </record>

    <!-- CALENDAR -->
    <record id="view_planning_task_calendar" model="ir.ui.view">
        <field name="name">construction.planning.task.calendar</field>
        <field name="model">construction.planning.task</field>
        <field name="arch" type="xml">
            <calendar string="Calendrier" date_start="date_start" date_stop="date_end" color="partner_id" mode="month">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <!-- PIVOT (Resource Capacity) -->
    <record id="view_planning_task_pivot" model="ir.ui.view">
        <field name="name">construction.planning.task.pivot</field>
        <field name="model">construction.planning.task</field>
        <field name="arch" type="xml">
            <pivot string="Analyse Charge Ressource" display_quantity="true">
                <field name="partner_id" type="row"/>
                <field name="date_start" interval="week" type="col"/>
                <field name="duration_days" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_planning_task_form" model="ir.ui.view">
        <field name="name">construction.planning.task.form</field>
        <field name="model">construction.planning.task</field>
        <field name="arch" type="xml">
            <form string="Tâche de Planning">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Titre de la tâche"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chantier_id"/>
                            <field name="lot_id"/>
                            <field name="partner_id"/>
                            <field name="resource_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration_days"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dépendances">
                            <field name="predecessor_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_construction_planning" model="ir.actions.act_window">
        <field name="name">Planning Général</field>
        <field name="res_model">construction.planning.task</field>
        <field name="view_mode">gantt,calendar,pivot,tree,form</field>
        <field name="context">{'search_default_group_chantier': 1}</field>
    </record>
    
    <record id="action_construction_planning_resource" model="ir.actions.act_window">
        <field name="name">Planning Ressources</field>
        <field name="res_model">construction.planning.task</field>
        <field name="view_mode">gantt,pivot,tree</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>
</odoo>
