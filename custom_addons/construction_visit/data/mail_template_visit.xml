<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- ============= EMAIL TEMPLATE: Visit Notification (BLG Charte) ============= -->
        <record id="email_template_visit_notification" model="mail.template">
            <field name="name">Visite: Notification BLG</field>
            <field name="model_id" ref="model_construction_visit"/>
            <field name="subject">📅 Visite programmée - {{ object.chantier_id.name }}</field>
            <field name="email_from">{{ (object.chantier_id.company_id.email if object.chantier_id.company_id.email else object.create_uid.email_formatted) or user.email_formatted }}</field>
            <field name="body_html" type="html">
<div style="font-family: 'Times New Roman', Times, serif; max-width: 600px; margin: 0 auto; border: 1px solid #E5E3E2; background-color: #FFFFFF;">
    <!-- Header BLG Style: Solid Bordeaux -->
    <div style="background-color: #92564C; color: white; padding: 25px; text-align: center;">
        <h2 style="margin:0; font-family: 'Times New Roman', Times, serif; letter-spacing: 1px; text-transform: uppercase;">
            BLG GROUPE
        </h2>
        <p style="color: rgba(255,255,255,0.9); margin: 5px 0 0 0; font-size: 14px; font-style: italic;">
            Visite de Chantier Programmée
        </p>
    </div>
    
    <!-- Main Content -->
    <div style="padding: 30px; background-color: #FFFFFF; color: #978A86;">
        <p style="font-size: 16px; margin-bottom: 20px;">
            Bonjour,
        </p>
        
        <p style="font-size: 15px; line-height: 1.5; color: #978A86;">
            Vous êtes convié(e) à une visite de chantier. Veuillez trouver ci-dessous les détails de l'intervention :
        </p>
        
        <!-- Information Card (Enterprise Style: Beige) -->
        <div style="background-color: #D4C5BC; border-left: 4px solid #92564C; padding: 20px; margin: 25px 0;">
            <table style="width: 100%; border-collapse: collapse; font-family: 'Times New Roman', Times, serif;">
                <tr>
                    <td style="padding: 8px 0; vertical-align: top; width: 120px;">
                        <span style="color: #92564C; font-weight: bold; text-transform: uppercase; font-size: 12px;">Chantier</span>
                    </td>
                    <td style="padding: 8px 0;">
                        <span style="color: #505050; font-weight: bold; font-size: 15px;">
                            <t t-out="object.chantier_id.name">Nom du Chantier</t>
                        </span>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; vertical-align: top;">
                        <span style="color: #92564C; font-weight: bold; text-transform: uppercase; font-size: 12px;">Date</span>
                    </td>
                    <td style="padding: 8px 0;">
                        <span style="color: #505050; font-size: 15px;">
                            <t t-out="object.date.strftime('%d/%m/%Y à %H:%M')">Date</t>
                        </span>
                        <span style="color: #505050; font-size: 13px; font-style: italic;">
                            (Durée: <t t-out="object.duration"/>h)
                        </span>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; vertical-align: top;">
                        <span style="color: #92564C; font-weight: bold; text-transform: uppercase; font-size: 12px;">Motif</span>
                    </td>
                    <td style="padding: 8px 0;">
                        <span style="color: #505050;">
                            <t t-if="object.visit_type == 'initial'">Visite Initiale</t>
                            <t t-if="object.visit_type == 'progress'">Suivi de Chantier</t>
                            <t t-if="object.visit_type == 'quality'">Contrôle Qualité</t>
                            <t t-if="object.visit_type == 'final'">Réception</t>
                        </span>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; vertical-align: top;">
                        <span style="color: #92564C; font-weight: bold; text-transform: uppercase; font-size: 12px;">Adresse</span>
                    </td>
                    <td style="padding: 8px 0;">
                        <span style="color: #505050;">
                            <t t-out="object.chantier_id.address or 'Non renseignée'">Adresse</t>
                            <t t-if="object.chantier_id.city">, <t t-out="object.chantier_id.city"/></t>
                        </span>
                    </td>
                </tr>
            </table>
        </div>

        <!-- Action Buttons -->
        <div style="text-align: center; margin: 30px 0;">
            <a t-att-href="object.get_maps_url()" 
               style="display: inline-block; background-color: #92564C; color: white; padding: 12px 25px; 
                      text-decoration: none; border-radius: 2px; font-weight: bold; font-family: 'Times New Roman', Times, serif; margin: 0 5px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                Voir sur Google Maps
            </a>
            <a t-att-href="object.get_waze_url()" 
               style="display: inline-block; background-color: #FFFFFF; border: 1px solid #92564C; color: #92564C; padding: 11px 24px; 
                      text-decoration: none; border-radius: 2px; font-weight: bold; font-family: 'Times New Roman', Times, serif; margin: 0 5px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                Ouvrir dans Waze
            </a>
        </div>
        
        <!-- Participants -->
        <t t-if="object.participant_ids">
            <div style="margin-top: 25px; font-size: 13px;">
                <strong style="color: #92564C; text-transform: uppercase;">Participants :</strong>
                <ul style="margin: 10px 0 0 0; padding-left: 20px; color: #505050;">
                    <t t-foreach="object.participant_ids" t-as="participant">
                        <li style="margin-bottom: 5px;">
                            <t t-out="participant.name"/>
                            <t t-if="participant.email"><span style="color: #978A86;"> (<t t-out="participant.email"/>)</span></t>
                        </li>
                    </t>
                </ul>
            </div>
        </t>
        
        <!-- Footer -->
        <div style="font-size: 12px; color: #AEADAB; margin-top: 40px; border-top: 1px solid #E5E3E2; padding-top: 15px; text-align: center;">
            <p style="margin-bottom: 5px;">BLG GROUPE - Service Technique</p>
            <p style="margin: 0;"><em>Ce message est automatique. Merci de ne pas y répondre directement.</em></p>
        </div>
    </div>
</div>
            </field>
            <field name="lang">{{ object.chantier_id.client.lang or 'fr_FR' }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- ============= EMAIL TEMPLATE: Visit Report (BLG Charte) ============= -->
        <record id="email_template_visit_report" model="mail.template">
            <field name="name">Visite: Envoi Rapport BLG</field>
            <field name="model_id" ref="model_construction_visit"/>
            <field name="subject">📋 Compte-rendu de visite - {{ object.chantier_id.name }}</field>
            <field name="email_from">{{ (object.chantier_id.company_id.email if object.chantier_id.company_id.email else object.create_uid.email_formatted) or user.email_formatted }}</field>
            <field name="body_html" type="html">
<div style="font-family: 'Times New Roman', Times, serif; max-width: 600px; margin: 0 auto; border: 1px solid #E5E3E2; background-color: #FFFFFF;">
    <!-- Header BLG Style: Solid Bordeaux -->
    <div style="background-color: #92564C; color: white; padding: 25px; text-align: center;">
        <h2 style="margin:0; font-family: 'Times New Roman', Times, serif; letter-spacing: 1px; text-transform: uppercase;">
            BLG GROUPE
        </h2>
        <p style="color: rgba(255,255,255,0.9); margin: 5px 0 0 0; font-size: 14px; font-style: italic;">
            Compte-Rendu de Visite
        </p>
    </div>
    
    <!-- Main Content -->
    <div style="padding: 30px; background-color: #FFFFFF; color: #978A86;">
        <p style="font-size: 16px; margin-bottom: 20px;">
            Bonjour,
        </p>
        
        <p style="font-size: 15px; line-height: 1.5; color: #978A86;">
            Veuillez trouver ci-joint le compte-rendu de la visite effectuée le 
            <strong><t t-out="object.date.strftime('%d/%m/%Y')">Date</t></strong> 
            sur le chantier <strong><t t-out="object.chantier_id.name">Chantier</t></strong>.
        </p>
        
        <!-- Visit Summary Card (Beige #D4C5BC) -->
        <div style="background-color: #D4C5BC; border-left: 4px solid #92564C; padding: 20px; margin: 25px 0;">
            <p style="margin: 0; color: #92564C; font-weight: bold; font-family: 'Times New Roman', Times, serif; font-size: 16px;">
                <t t-out="object.name">Titre de la visite</t>
            </p>
            <p style="margin: 5px 0 0 0; color: #505050; font-size: 14px; font-style: italic;">
                Type: 
                <t t-if="object.visit_type == 'initial'">Visite Initiale</t>
                <t t-if="object.visit_type == 'progress'">Suivi de Chantier</t>
                <t t-if="object.visit_type == 'quality'">Contrôle Qualité</t>
                <t t-if="object.visit_type == 'final'">Réception</t>
            </p>
        </div>
        
        <p style="font-size: 15px; line-height: 1.5; color: #978A86;">
            N'hésitez pas à nous contacter pour toute question.
        </p>
        
        <!-- Footer -->
        <div style="font-size: 12px; color: #AEADAB; margin-top: 40px; border-top: 1px solid #E5E3E2; padding-top: 15px; text-align: center;">
            <p style="margin-bottom: 5px;">BLG GROUPE - Service Technique</p>
            <p style="margin: 0;"><em>Ce message est automatique. Merci de ne pas y répondre directement.</em></p>
        </div>
    </div>
</div>
            </field>
            <field name="lang">{{ object.chantier_id.client.lang or 'fr_FR' }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
