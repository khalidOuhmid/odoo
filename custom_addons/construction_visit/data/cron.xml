<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- TASK-001: Cron Job - Auto-send visit notifications (48h before) -->
        <record id="cron_visit_notifications" model="ir.cron">
            <field name="name">Visites: Envoi automatique des notifications (48h)</field>
            <field name="model_id" ref="model_construction_visit"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_visit_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
