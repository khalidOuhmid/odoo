<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH, LIST, FORM, CALENDAR VIEWS -->
    
    <record id="view_visit_search" model="ir.ui.view">
        <field name="name">construction.visit.search</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <search string="Rechercher Visites">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="user_ids"/>
                <filter string="Mes visites" name="my_visits" domain="[('user_ids', 'in', uid)]"/>
                <filter string="À venir" name="upcoming" domain="[('date', '&gt;=', context_today())]"/>
                <group expand="0" string="Group By">
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_visit_tree" model="ir.ui.view">
        <field name="name">construction.visit.tree</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
             <list string="Visites" 
                  decoration-info="state == 'planned'"
                  decoration-muted="state == 'completed'">
                <field name="date"/>
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="visit_type" widget="badge"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_visit_form" model="ir.ui.view">
        <field name="name">construction.visit.form</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <form string="Visite">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="oe_highlight" invisible="state not in ['draft', 'planned']"/>
                    <button name="action_start" string="Démarrer" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_complete" string="Terminer" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,confirmed,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Titre de la visite"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="chantier_id"/>
                            <field name="date"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group>
                            <field name="visit_type"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observations">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                        <page string="Compte Rendu">
                            <field name="report" placeholder="CR..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_visit_calendar" model="ir.ui.view">
        <field name="name">construction.visit.calendar</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <calendar string="Planning Visites" date_start="date" color="chantier_id" mode="week">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_construction_visit" model="ir.actions.act_window">
        <field name="name">Visites</field>
        <field name="res_model">construction.visit</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
