<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_visit_search" model="ir.ui.view">
        <field name="name">construction.visit.search</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <search string="Rechercher Visites">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="participant_ids"/>
                <filter string="Mes visites" name="my_visits" 
                        domain="[('participant_ids', 'in', [uid])]"/>
                <filter string="À venir" name="upcoming" 
                        domain="[('date', '&gt;=', context_today())]"/>
                <filter string="À notifier" name="to_notify" 
                        domain="[('state', '=', 'confirmed'), ('notification_sent', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Chantier" name="group_chantier" 
                            context="{'group_by': 'chantier_id'}"/>
                    <filter string="État" name="group_state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" 
                            context="{'group_by': 'visit_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_visit_tree" model="ir.ui.view">
        <field name="name">construction.visit.tree</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <list string="Visites" 
                  decoration-info="state == 'planned'"
                  decoration-warning="state == 'confirmed' and notification_sent == False"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="date" widget="datetime"/>
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="visit_type" widget="badge"/>
                <field name="participant_ids" widget="many2many_avatar"/>
                <field name="notification_sent" widget="boolean_toggle" readonly="1"/>
                <field name="report_generated" widget="boolean_toggle" readonly="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW - Modern Sheet with Workflow Buttons -->
    <record id="view_visit_form" model="ir.ui.view">
        <field name="name">construction.visit.form</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <form string="Visite de Chantier" edit="true" force_save="1">
                <header>
                    <!-- State Transition Buttons -->
                    <button name="action_plan" string="Planifier" type="object" 
                            class="btn-secondary" icon="fa-calendar" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirmer" type="object" 
                            class="oe_highlight" icon="fa-check" invisible="state not in ['draft', 'planned']"/>
                    <button name="action_start" string="Demarrer" type="object" 
                            class="oe_highlight" icon="fa-play" invisible="state != 'confirmed'"/>
                    <button name="action_complete" string="Terminer" type="object" 
                            class="oe_highlight" icon="fa-flag-checkered" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Annuler" type="object" 
                            class="btn-secondary" icon="fa-times" invisible="state in ['completed', 'cancelled']"/>
                    
                    <!-- Workflow Buttons -->
                    <button name="action_send_notification" string="Envoyer Notification" 
                            type="object" class="btn-primary" icon="fa-envelope-o"
                            invisible="not show_send_notification"/>
                    <button name="action_generate_report" string="Generer Rapport" 
                            type="object" class="btn-success" icon="fa-file-pdf-o"
                            invisible="not show_generate_report"/>
                    <button name="action_send_report" string="Envoyer Rapport" 
                            type="object" class="btn-warning" icon="fa-send"
                            invisible="not show_send_report"/>
                    
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,planned,confirmed,in_progress,completed"/>
                </header>
                
                <sheet>
                    <!-- Hidden fields for visibility computation -->
                    <field name="show_send_notification" invisible="1"/>
                    <field name="show_generate_report" invisible="1"/>
                    <field name="show_send_report" invisible="1"/>
                    <field name="notification_sent" invisible="1"/>
                    <field name="report_generated" invisible="1"/>
                    <field name="report_sent" invisible="1"/>
                    
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_generate_report"
                                icon="fa-file-pdf-o" invisible="state != 'completed' or report_generated">
                            <span class="o_stat_text">Générer PDF</span>
                        </button>
                    </div>
                    
                    <!-- Status Badges -->
                    <widget name="web_ribbon" title="Notifiée" bg_color="bg-info" 
                            invisible="not notification_sent"/>
                    <widget name="web_ribbon" title="Rapport OK" bg_color="bg-success" 
                            invisible="not report_generated"/>
                    
                    <!-- Title -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Titre de la visite"/>
                        </h1>
                    </div>
                    
                    <!-- Main Info -->
                    <group>
                        <group string="Informations">
                            <field name="chantier_id" options="{'no_create': True}"/>
                            <field name="visit_type"/>
                            <field name="date"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group string="Participants">
                            <field name="participant_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"
                                   placeholder="Ajouter des participants..."/>
                        </group>
                    </group>
                    
                    <!-- Chantier Address (Read-only info) -->
                    <group string="Adresse du Chantier" invisible="not chantier_id">
                        <field name="chantier_address" readonly="1"/>
                        <field name="chantier_city" readonly="1"/>
                    </group>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description détaillée de la visite..."/>
                        </page>
                        <!-- Tab 1: Notes & Observations -->
                        <page string="Observations" name="observations">
                            <field name="notes" placeholder="Notez vos observations pendant la visite..."/>
                        </page>
                        
                        <!-- Tab 2: Media (Photos, Videos, Documents) - Available when visit started -->
                        <page string="Media" name="media" invisible="state in ['draft', 'planned', 'confirmed']">
                            <separator string="Photos"/>
                            <field name="photo_ids" widget="many2many_binary" options="{'accepted_file_extensions': 'image/*'}"/>
                            
                            <separator string="Videos"/>
                            <field name="video_ids" widget="many2many_binary" options="{'accepted_file_extensions': 'video/*'}"/>
                            
                            <separator string="Documents"/>
                            <field name="document_ids" widget="many2many_binary"/>
                            
                            <div class="alert alert-info" invisible="photo_ids or video_ids or document_ids">
                                <i class="fa fa-info-circle me-2"/>
                                Ajoutez des photos, videos et documents pour les inclure dans le rapport.
                            </div>
                        </page>
                        
                        <!-- Tab 3: Report (visible after completion) -->
                        <page string="Compte Rendu" name="report" invisible="state not in ['completed', 'cancelled']">
                            <!-- PDF generated: download button + HTML preview -->
                            <div invisible="not report_generated">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <button name="action_download_report_pdf"
                                            string="Télécharger le PDF"
                                            type="object"
                                            class="btn-primary"
                                            icon="fa-download"/>
                                    <span class="text-muted small">
                                        <i class="fa fa-check-circle text-success me-1"/>
                                        Rapport généré
                                    </span>
                                </div>
                                <div class="border rounded p-3 bg-light mb-3">
                                    <field name="report_html" widget="html" readonly="1" nolabel="1"
                                           style="max-height: 600px; overflow-y: auto;"/>
                                </div>
                            </div>
                            <!-- No PDF yet: editable text field -->
                            <field name="report" placeholder="Rédigez le compte-rendu détaillé..."
                                   invisible="report_generated"/>
                            <div class="alert alert-info" invisible="report_generated or state != 'completed'">
                                <i class="fa fa-info-circle me-2"/>
                                Utilisez le bouton <strong>Générer Rapport</strong> pour créer le PDF officiel.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                
                <!-- Footer with action buttons for modal dialog -->
                <footer>
                    <button string="Terminer" name="action_complete" type="object" 
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button string="Sauvegarder" special="save" class="btn-success"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
                
                <chatter/>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_visit_kanban" model="ir.ui.view">
        <field name="name">construction.visit.kanban</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="visit_type"/>
                <field name="participant_ids"/>
                <field name="notification_sent"/>
                <field name="report_generated"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="chantier_id"/>
                                <br/>
                                <i class="fa fa-calendar me-1"/>
                                <field name="date" widget="date"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <span t-if="record.notification_sent.raw_value" 
                                      class="badge bg-info" title="Notification envoyée">📧</span>
                                <span t-if="record.report_generated.raw_value" 
                                      class="badge bg-success" title="Rapport généré">📄</span>
                                <field name="participant_ids" widget="many2many_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- CALENDAR VIEW -->
    <record id="view_visit_calendar" model="ir.ui.view">
        <field name="name">construction.visit.calendar</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <calendar string="Planning Visites" date_start="date" color="chantier_id" mode="week">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="visit_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_construction_visit" model="ir.actions.act_window">
        <field name="name">Visites</field>
        <field name="res_model">construction.visit</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="search_view_id" ref="view_visit_search"/>
        <field name="context">{'search_default_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Planifier une nouvelle visite de chantier
            </p>
        </field>
    </record>
</odoo>
