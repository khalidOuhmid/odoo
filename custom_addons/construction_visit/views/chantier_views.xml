<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Chantier Form to add Visits Tab -->
    <record id="view_construction_chantier_form_visit" model="ir.ui.view">
        <field name="name">construction.chantier.form.visit</field>
        <field name="model">construction.chantier</field>
        <field name="inherit_id" ref="construction_core.view_construction_chantier_form"/>
        <field name="arch" type="xml">
            <!-- Add Button Box Item -->
            <div name="button_box" position="inside">
                <button name="action_view_visits"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="visit_count"/>
                        </span>
                        <span class="o_stat_text">Visites</span>
                    </div>
                </button>
            </div>
            
            <!-- Replace existing Visits Tab in notebook -->
            <xpath expr="//page[@name='visits']" position="replace">
                <page string="Visites" name="visits" invisible="not show_visits">
                    <div class="alert alert-info mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-info-circle me-3"/>
                            <div>
                                <strong>Nota Bene :</strong> 
                                Cet onglet permet de planifier et suivre les visites techniques (initiales, contrôles, réceptions) 
                                directement depuis le chantier.
                            </div>
                        </div>
                    </div>
                    
                    <!-- Planifier Button ABOVE the table -->
                    <div class="mb-3">
                        <button name="action_plan_visit" type="object" string="Planifier une visite"
                                class="btn btn-primary" icon="fa-plus"/>
                    </div>
                    
                    <!-- Inline Visits List - Click to edit in popup -->
                    <field name="visit_ids" nolabel="1" context="{'form_view_ref': 'construction_visit.view_visit_form'}" options="{'no_create': True}">
                        <list decoration-info="state == 'planned'"
                              decoration-warning="state == 'confirmed'"
                              decoration-success="state == 'completed'"
                              decoration-muted="state == 'cancelled'"
                              open_form_view="True">
                            <field name="date" widget="datetime"/>
                            <field name="name"/>
                            <field name="visit_type" widget="badge"/>
                            <field name="participant_ids" widget="many2many_tags"/>
                            <field name="notification_sent" widget="boolean" readonly="1"/>
                            <field name="state" widget="badge"/>
                            <button name="action_confirm" type="object" 
                                    invisible="state not in ['draft', 'planned']"
                                    title="Confirmer" icon="fa-check" class="text-success"/>
                            <button name="action_send_notification" type="object" 
                                    invisible="state != 'confirmed' or notification_sent"
                                    title="Envoyer notification" icon="fa-envelope" class="text-info"/>
                            <button name="action_generate_report" type="object" 
                                    invisible="state != 'completed' or report_generated"
                                    title="Générer Rapport" icon="fa-file-text" class="text-primary"/>
                             <button name="action_send_report" type="object" 
                                    invisible="not report_generated or report_sent"
                                    title="Envoyer Rapport" icon="fa-paper-plane" class="text-success"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
