<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_chantier_form_visit" model="ir.ui.view">
        <field name="name">construction.chantier.form.visit</field>
        <field name="model">construction.chantier</field>
        <field name="inherit_id" ref="construction_core.view_construction_chantier_form"/>
        <field name="arch" type="xml">
            <!-- Add Button Box Item -->
            <div name="button_box" position="inside">
                <button name="action_view_visits"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="visit_count"/>
                        </span>
                        <span class="o_stat_text">Visites</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
