<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Visit Report Action -->
    <record id="action_report_visit" model="ir.actions.report">
        <field name="name">Compte-rendu de visite</field>
        <field name="model">construction.visit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construction_visit.report_visit_document</field>
        <field name="report_file">construction_visit.report_visit_document</field>
        <field name="print_report_name">'Visite_%s_%s' % (object.chantier_id.reference or 'REF', object.date.strftime('%Y%m%d'))</field>
        <field name="binding_model_id" ref="model_construction_visit"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Visit Report Template - BLG Charte (Mission 4) -->
    <template id="report_visit_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Segoe UI', Arial, sans-serif;">
                        
                        <!-- BLG Header with Gradient -->
                        <div style="background: linear-gradient(135deg, #92564C, #D4C5BC); 
                                    padding: 25px 30px; margin: -20px -20px 30px -20px; border-radius: 0 0 10px 10px;">
                            <div class="row">
                                <div class="col-8">
                                    <h1 style="color: #FFFFFF; margin: 0; font-size: 28px; font-weight: 600;">
                                        COMPTE-RENDU DE VISITE
                                    </h1>
                                    <p style="color: rgba(255,255,255,0.9); margin: 10px 0 0 0; font-size: 16px;">
                                        <t t-out="doc.name">Visite</t>
                                    </p>
                                </div>
                                <div class="col-4 text-end">
                                    <div style="background: #FFFFFF; display: inline-block; padding: 10px 20px; border-radius: 6px;">
                                        <span style="color: #92564C; font-weight: 600; font-size: 14px;">
                                            BLG GROUPE
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Visit Info Cards -->
                        <div class="row" style="margin-bottom: 25px;">
                            <div class="col-6">
                                <div style="background: #F9F8F7; border-left: 4px solid #92564C; padding: 20px; border-radius: 0 8px 8px 0;">
                                    <h4 style="color: #92564C; margin: 0 0 15px 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">
                                        Informations Chantier
                                    </h4>
                                    <table style="width: 100%;">
                                        <tr>
                                            <td style="color: #AEADAB; padding: 5px 0; width: 40%;">Chantier</td>
                                            <td style="color: #978A86; font-weight: 500;">
                                                <t t-out="doc.chantier_id.name">Chantier</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 5px 0;">Référence</td>
                                            <td style="color: #978A86;">
                                                <t t-out="doc.chantier_id.reference or '-'">Ref</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 5px 0;">Client</td>
                                            <td style="color: #978A86;">
                                                <t t-out="doc.chantier_id.client.name or '-'">Client</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 5px 0;">Adresse</td>
                                            <td style="color: #978A86;">
                                                <t t-out="doc.chantier_id.address or '-'">Adresse</t>
                                                <t t-if="doc.chantier_id.city">
                                                    <br/><t t-out="doc.chantier_id.city"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background: #F9F8F7; border-left: 4px solid #D4C5BC; padding: 20px; border-radius: 0 8px 8px 0;">
                                    <h4 style="color: #92564C; margin: 0 0 15px 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">
                                        Informations Visite
                                    </h4>
                                    <table style="width: 100%;">
                                        <tr>
                                            <td style="color: #AEADAB; padding: 5px 0; width: 40%;">Date</td>
                                            <td style="color: #978A86; font-weight: 500;">
                                                <t t-out="doc.date.strftime('%d/%m/%Y à %H:%M')">Date</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 5px 0;">Durée</td>
                                            <td style="color: #978A86;">
                                                <t t-out="doc.duration"/>h
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 5px 0;">Type</td>
                                            <td style="color: #978A86;">
                                                <t t-if="doc.visit_type == 'initial'">Visite Initiale</t>
                                                <t t-if="doc.visit_type == 'progress'">Suivi de Chantier</t>
                                                <t t-if="doc.visit_type == 'quality'">Contrôle Qualité</t>
                                                <t t-if="doc.visit_type == 'final'">Réception</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 5px 0;">État</td>
                                            <td>
                                                <span style="background: #92564C; color: white; padding: 3px 10px; border-radius: 12px; font-size: 12px;">
                                                    <t t-if="doc.state == 'completed'">Terminée</t>
                                                    <t t-else=""><t t-out="doc.state"/></t>
                                                </span>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Participants (Unified - Mission 1) -->
                        <div style="background: #FFFFFF; border: 1px solid #E5E3E2; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
                            <h4 style="color: #92564C; margin: 0 0 15px 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">
                                👥 Participants
                            </h4>
                            <div class="row">
                                <t t-foreach="doc.participant_ids" t-as="participant">
                                    <div class="col-4" style="margin-bottom: 10px;">
                                        <div style="display: flex; align-items: center;">
                                            <div style="width: 35px; height: 35px; background: #D4C5BC; border-radius: 50%; 
                                                        display: flex; align-items: center; justify-content: center; margin-right: 10px;">
                                                <span style="color: #92564C; font-weight: 600; font-size: 14px;">
                                                    <t t-out="participant.name[:2].upper()">XX</t>
                                                </span>
                                            </div>
                                            <div>
                                                <span style="color: #978A86; font-weight: 500;">
                                                    <t t-out="participant.name">Participant</t>
                                                </span>
                                                <br/>
                                                <span style="color: #AEADAB; font-size: 11px;">
                                                    <t t-out="participant.function or participant.email or ''"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="not doc.participant_ids">
                                    <div class="col-12">
                                        <p style="color: #AEADAB; font-style: italic;">Aucun participant enregistré</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                        
                        <!-- Notes & Observations -->
                        <div t-if="doc.notes" style="background: #FFFFFF; border: 1px solid #E5E3E2; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
                            <h4 style="color: #92564C; margin: 0 0 15px 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">
                                📝 Notes et Observations
                            </h4>
                            <div style="color: #978A86; line-height: 1.6;" t-raw="doc.notes"/>
                        </div>
                        
                        <!-- Compte Rendu -->
                        <div t-if="doc.report" style="background: #FFFFFF; border: 1px solid #E5E3E2; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
                            <h4 style="color: #92564C; margin: 0 0 15px 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">
                                📄 Compte-Rendu Détaillé
                            </h4>
                            <div style="color: #978A86; line-height: 1.6;" t-raw="doc.report"/>
                        </div>
                        
                        <!-- Photos Section - Embedded Images Grid -->
                        <div t-if="doc.photo_ids" style="background: #FFFFFF; border: 1px solid #E5E3E2; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
                            <h4 style="color: #92564C; margin: 0 0 15px 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">
                                <i class="fa fa-camera" style="margin-right: 8px;"/>Photos (<t t-out="len(doc.photo_ids)"/>)
                            </h4>
                            <div class="row">
                                <t t-foreach="doc.photo_ids" t-as="photo">
                                    <div class="col-4" style="margin-bottom: 15px;">
                                        <div style="background: #F9F8F7; border-radius: 8px; padding: 10px; text-align: center;">
                                            <img t-att-src="'data:%s;base64,%s' % (photo.mimetype, photo.datas.decode('utf-8') if photo.datas else '')" 
                                                 style="max-width: 100%; max-height: 200px; border-radius: 6px; object-fit: contain;"
                                                 t-att-alt="photo.name"/>
                                            <p style="color: #AEADAB; font-size: 10px; margin: 8px 0 0 0; word-break: break-word;">
                                                <t t-out="photo.name[:30]"/>
                                                <t t-if="len(photo.name) > 30">...</t>
                                            </p>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                        
                        <!-- Videos Section -->
                        <div t-if="doc.video_ids" style="background: #FFFFFF; border: 1px solid #E5E3E2; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
                            <h4 style="color: #92564C; margin: 0 0 15px 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">
                                <i class="fa fa-video-camera" style="margin-right: 8px;"/>Videos (<t t-out="len(doc.video_ids)"/>)
                            </h4>
                            <ul style="list-style: none; padding: 0; margin: 0;">
                                <t t-foreach="doc.video_ids" t-as="video">
                                    <li style="padding: 8px 12px; background: #F9F8F7; border-radius: 6px; margin-bottom: 8px;">
                                        <i class="fa fa-play-circle" style="color: #92564C; margin-right: 10px;"/>
                                        <span style="color: #978A86;"><t t-out="video.name"/></span>
                                        <span style="color: #AEADAB; font-size: 11px; margin-left: 10px;">
                                            (<t t-out="'%.1f' % (video.file_size / 1024 / 1024)" /> Mo)
                                        </span>
                                    </li>
                                </t>
                            </ul>
                        </div>
                        
                        <!-- Documents Section -->
                        <div t-if="doc.document_ids" style="background: #FFFFFF; border: 1px solid #E5E3E2; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
                            <h4 style="color: #92564C; margin: 0 0 15px 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">
                                <i class="fa fa-file-o" style="margin-right: 8px;"/>Documents Joints (<t t-out="len(doc.document_ids)"/>)
                            </h4>
                            <ul style="list-style: none; padding: 0; margin: 0;">
                                <t t-foreach="doc.document_ids" t-as="document">
                                    <li style="padding: 8px 12px; background: #F9F8F7; border-radius: 6px; margin-bottom: 8px;">
                                        <i class="fa fa-file-text-o" style="color: #92564C; margin-right: 10px;"/>
                                        <span style="color: #978A86;"><t t-out="document.name"/></span>
                                        <span style="color: #AEADAB; font-size: 11px; margin-left: 10px;">
                                            (<t t-out="document.mimetype"/>)
                                        </span>
                                    </li>
                                </t>
                            </ul>
                        </div>
                        
                        <!-- Signatures -->
                        <div class="row" style="margin-top: 50px; page-break-inside: avoid;">
                            <div class="col-6 text-center">
                                <div style="border-top: 2px solid #E5E3E2; padding-top: 10px; margin: 0 30px;">
                                    <p style="color: #AEADAB; margin: 0; font-size: 12px;">Signature BLG Groupe</p>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top: 2px solid #E5E3E2; padding-top: 10px; margin: 0 30px;">
                                    <p style="color: #AEADAB; margin: 0; font-size: 12px;">Signature Client</p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Footer -->
                        <div style="border-top: 1px solid #E5E3E2; padding-top: 20px; margin-top: 40px; text-align: center;">
                            <p style="color: #AEADAB; font-size: 11px; margin: 0;">
                                Document généré le <t t-out="datetime.datetime.now().strftime('%d/%m/%Y à %H:%M')"/>
                                — BLG Groupe © Tous droits réservés
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
