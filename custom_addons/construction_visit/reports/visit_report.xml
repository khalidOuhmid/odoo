<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Visit Report Action -->
    <record id="action_report_visit" model="ir.actions.report">
        <field name="name">Compte-rendu de visite</field>
        <field name="model">construction.visit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construction_visit.report_visit_document</field>
        <field name="report_file">construction_visit.report_visit_document</field>
        <field name="print_report_name">'Visite_%s_%s' % (object.chantier_id.reference or 'REF', object.date.strftime('%Y%m%d'))</field>
        <field name="binding_model_id" ref="model_construction_visit"/>
        <field name="binding_type">report</field>
    </record>

    <!--
         Visit Report Template: BLG Charte Graphique 2025
         
         TASK-002: Full BLG branding with logo from construction_contract,
         inheriting the BLG color palette and typography.
         
         Logo: /construction_contract/static/src/img/Logo.png
    -->
    <template id="report_visit_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Times New Roman', Times, 'Liberation Serif', serif; font-size: 11pt; line-height: 1.45; color: #2B2B2B; width: 100%;">
                        
                        <!-- ======================== HEADER BLG ======================== -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 2px solid #92564C;">
                            <!-- Logo BLG (from construction_contract) -->
                            <div style="flex-shrink: 0;">
                                <img src="/construction_contract/static/src/img/Logo.png" 
                                     style="height: 60px; width: auto;" 
                                     alt="BLG Groupe"/>
                            </div>
                            <!-- Document Title -->
                            <div style="text-align: right;">
                                <h1 style="margin: 0; font-family: Georgia, 'Times New Roman', Times, serif; color: #92564C; font-size: 22pt; text-transform: uppercase; letter-spacing: 0.03em; font-weight: 600;">
                                    Compte-Rendu de Visite
                                </h1>
                                <p style="margin: 5px 0 0 0; color: #AEADAB; font-size: 11pt; font-style: italic;">
                                    <t t-out="doc.name">Visite</t>
                                </p>
                            </div>
                        </div>
                        
                        <!-- ======================== INFO CARDS ======================== -->
                        <div class="row" style="margin-bottom: 25px;">
                            <!-- Chantier Info -->
                            <div class="col-6">
                                <div style="background: #F9F8F7; border-left: 4px solid #92564C; padding: 18px; height: 100%;">
                                    <h4 style="color: #92564C; margin: 0 0 12px 0; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; font-family: Georgia, serif; font-weight: 600;">
                                        Informations Chantier
                                    </h4>
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="color: #AEADAB; padding: 4px 0; width: 35%; font-size: 10pt;">Chantier</td>
                                            <td style="color: #978A86; font-weight: 600; font-size: 11pt;">
                                                <t t-out="doc.chantier_id.name">Chantier</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 4px 0; font-size: 10pt;">Référence</td>
                                            <td style="color: #978A86; font-size: 10pt;">
                                                <t t-out="doc.chantier_id.reference or '-'">Ref</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 4px 0; font-size: 10pt;">Client</td>
                                            <td style="color: #978A86; font-size: 10pt;">
                                                <t t-out="doc.chantier_id.client.name or '-'">Client</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 4px 0; font-size: 10pt;">Adresse</td>
                                            <td style="color: #978A86; font-size: 10pt;">
                                                <t t-out="doc.chantier_id.address or '-'">Adresse</t>
                                                <t t-if="doc.chantier_id.city">
                                                    <br/><t t-out="doc.chantier_id.city"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            <!-- Visit Info -->
                            <div class="col-6">
                                <div style="background: #F9F8F7; border-left: 4px solid #D4C5BC; padding: 18px; height: 100%;">
                                    <h4 style="color: #92564C; margin: 0 0 12px 0; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; font-family: Georgia, serif; font-weight: 600;">
                                        Informations Visite
                                    </h4>
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="color: #AEADAB; padding: 4px 0; width: 35%; font-size: 10pt;">Date</td>
                                            <td style="color: #978A86; font-weight: 600; font-size: 11pt;">
                                                <t t-out="doc.date.strftime('%d/%m/%Y à %H:%M')">Date</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 4px 0; font-size: 10pt;">Durée</td>
                                            <td style="color: #978A86; font-size: 10pt;">
                                                <t t-out="doc.duration"/>h
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 4px 0; font-size: 10pt;">Type</td>
                                            <td style="color: #978A86; font-size: 10pt;">
                                                <t t-if="doc.visit_type == 'initial'">Visite Initiale</t>
                                                <t t-if="doc.visit_type == 'follow_up'">Suivi de Chantier</t>
                                                <t t-if="doc.visit_type == 'technical'">Visite Technique</t>
                                                <t t-if="doc.visit_type == 'final'">Réception Finale</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #AEADAB; padding: 4px 0; font-size: 10pt;">État</td>
                                            <td>
                                                <span style="background: #92564C; color: white; padding: 2px 10px; border-radius: 10px; font-size: 9pt; text-transform: uppercase;">
                                                    <t t-if="doc.state == 'completed'">Terminée</t>
                                                    <t t-elif="doc.state == 'in_progress'">En Cours</t>
                                                    <t t-elif="doc.state == 'confirmed'">Confirmée</t>
                                                    <t t-else=""><t t-out="doc.state"/></t>
                                                </span>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        
                        <!-- ======================== PARTICIPANTS ======================== -->
                        <div style="background: #FFFFFF; border: 1px solid #E5E3E2; padding: 18px; margin-bottom: 20px; page-break-inside: avoid;">
                            <h4 style="color: #92564C; margin: 0 0 12px 0; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; font-family: Georgia, serif; font-weight: 600; border-bottom: 1px solid #AEADAB; padding-bottom: 5px;">
                                Participants
                            </h4>
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="background-color: #92564C; color: #FFFFFF; padding: 8px 12px; font-family: Georgia, serif; font-weight: 600; text-align: left; font-size: 10pt;">Nom</th>
                                        <th style="background-color: #92564C; color: #FFFFFF; padding: 8px 12px; font-family: Georgia, serif; font-weight: 600; text-align: left; font-size: 10pt;">Fonction</th>
                                        <th style="background-color: #92564C; color: #FFFFFF; padding: 8px 12px; font-family: Georgia, serif; font-weight: 600; text-align: left; font-size: 10pt;">Email</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.participant_ids" t-as="participant">
                                        <tr>
                                            <td style="padding: 6px 12px; border: 1px solid #E5E3E2; color: #978A86; font-size: 10pt;">
                                                <t t-out="participant.name">Participant</t>
                                            </td>
                                            <td style="padding: 6px 12px; border: 1px solid #E5E3E2; color: #978A86; font-size: 10pt;">
                                                <t t-out="participant.function or '-'"/>
                                            </td>
                                            <td style="padding: 6px 12px; border: 1px solid #E5E3E2; color: #AEADAB; font-size: 10pt;">
                                                <t t-out="participant.email or '-'"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <t t-if="not doc.participant_ids">
                                <p style="color: #AEADAB; font-style: italic; margin: 10px 0 0 0; font-size: 10pt;">Aucun participant enregistré</p>
                            </t>
                        </div>
                        
                        <!-- ======================== MOTIF ======================== -->
                        <div t-if="doc.motif" style="background: rgba(212, 197, 188, 0.15); border-left: 3px solid #92564C; padding: 15px 18px; margin-bottom: 20px; page-break-inside: avoid;">
                            <h4 style="color: #92564C; margin: 0 0 8px 0; font-size: 11pt; font-family: Georgia, serif; font-weight: 600;">
                                Motif de la Visite
                            </h4>
                            <p style="color: #978A86; margin: 0; font-size: 10pt; text-align: justify; line-height: 1.5;">
                                <t t-out="doc.motif"/>
                            </p>
                        </div>
                        
                        <!-- ======================== NOTES & OBSERVATIONS ======================== -->
                        <div t-if="doc.notes" style="background: #FFFFFF; border: 1px solid #E5E3E2; padding: 18px; margin-bottom: 20px; page-break-inside: avoid;">
                            <h4 style="color: #92564C; margin: 0 0 12px 0; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; font-family: Georgia, serif; font-weight: 600; border-bottom: 1px solid #AEADAB; padding-bottom: 5px;">
                                Notes et Observations
                            </h4>
                            <div style="color: #978A86; line-height: 1.6; font-size: 10pt; text-align: justify;" t-raw="doc.notes"/>
                        </div>
                        
                        <!-- ======================== COMPTE-RENDU ======================== -->
                        <div t-if="doc.report" style="background: #FFFFFF; border: 1px solid #E5E3E2; padding: 18px; margin-bottom: 20px;">
                            <h4 style="color: #92564C; margin: 0 0 12px 0; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; font-family: Georgia, serif; font-weight: 600; border-bottom: 1px solid #AEADAB; padding-bottom: 5px;">
                                Compte-Rendu Détaillé
                            </h4>
                            <div style="color: #978A86; line-height: 1.6; font-size: 10pt; text-align: justify;" t-raw="doc.report"/>
                        </div>
                        
                        <!-- ======================== PHOTOS ======================== -->
                        <div t-if="doc.photo_ids" style="background: #FFFFFF; border: 1px solid #E5E3E2; padding: 18px; margin-bottom: 20px;">
                            <h4 style="color: #92564C; margin: 0 0 12px 0; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; font-family: Georgia, serif; font-weight: 600; border-bottom: 1px solid #AEADAB; padding-bottom: 5px;">
                                Photos (<t t-out="len(doc.photo_ids)"/>)
                            </h4>
                            <div class="row">
                                <t t-foreach="doc.photo_ids" t-as="photo">
                                    <div class="col-6" style="margin-bottom: 16px;">
                                        <div style="background: #F9F8F7; padding: 10px; text-align: center; page-break-inside: avoid;">
                                            <img t-att-src="'data:%s;base64,%s' % (photo.mimetype, photo.datas.decode('utf-8') if photo.datas else '')"
                                                 style="max-width: 100%; max-height: 300px; object-fit: contain;"
                                                 t-att-alt="photo.name"/>
                                            <p style="color: #AEADAB; font-size: 8pt; margin: 6px 0 0 0; word-break: break-word;">
                                                <t t-out="photo.name[:40]"/>
                                                <t t-if="len(photo.name) > 40">...</t>
                                            </p>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                        
                        <!-- ======================== VIDEOS ======================== -->
                        <div t-if="doc.video_ids" style="background: #FFFFFF; border: 1px solid #E5E3E2; padding: 18px; margin-bottom: 20px; page-break-inside: avoid;">
                            <h4 style="color: #92564C; margin: 0 0 12px 0; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; font-family: Georgia, serif; font-weight: 600; border-bottom: 1px solid #AEADAB; padding-bottom: 5px;">
                                Vidéos (<t t-out="len(doc.video_ids)"/>)
                            </h4>
                            <table style="width: 100%; border-collapse: collapse;">
                                <t t-foreach="doc.video_ids" t-as="video">
                                    <tr>
                                        <td style="padding: 6px 12px; border: 1px solid #E5E3E2; color: #978A86; font-size: 10pt;">
                                            <t t-out="video.name"/>
                                        </td>
                                        <td style="padding: 6px 12px; border: 1px solid #E5E3E2; color: #AEADAB; font-size: 9pt; text-align: right; width: 80px;">
                                            <t t-out="'%.1f' % (video.file_size / 1024 / 1024)"/> Mo
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                        
                        <!-- ======================== DOCUMENTS ======================== -->
                        <div t-if="doc.document_ids" style="background: #FFFFFF; border: 1px solid #E5E3E2; padding: 18px; margin-bottom: 20px; page-break-inside: avoid;">
                            <h4 style="color: #92564C; margin: 0 0 12px 0; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; font-family: Georgia, serif; font-weight: 600; border-bottom: 1px solid #AEADAB; padding-bottom: 5px;">
                                Documents Joints (<t t-out="len(doc.document_ids)"/>)
                            </h4>
                            <table style="width: 100%; border-collapse: collapse;">
                                <t t-foreach="doc.document_ids" t-as="document">
                                    <tr>
                                        <td style="padding: 6px 12px; border: 1px solid #E5E3E2; color: #978A86; font-size: 10pt;">
                                            <t t-out="document.name"/>
                                        </td>
                                        <td style="padding: 6px 12px; border: 1px solid #E5E3E2; color: #AEADAB; font-size: 9pt; text-align: right; width: 120px;">
                                            <t t-out="document.mimetype"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                        
                        <!-- ======================== SIGNATURES ======================== -->
                        <div class="row" style="margin-top: 40px; page-break-inside: avoid;">
                            <div class="col-6 text-center">
                                <div style="border: 1px solid #AEADAB; min-height: 100px; padding: 10px; background-color: #FAFAFA; margin: 0 15px;">
                                    <p style="color: #AEADAB; font-style: italic; font-size: 9pt; margin: 30px 0 0 0;">Signature BLG Groupe</p>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border: 1px solid #AEADAB; min-height: 100px; padding: 10px; background-color: #FAFAFA; margin: 0 15px;">
                                    <p style="color: #AEADAB; font-style: italic; font-size: 9pt; margin: 30px 0 0 0;">Signature Client</p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- ======================== FOOTER ======================== -->
                        <div style="border-top: 1px solid #E5E3E2; padding-top: 15px; margin-top: 30px; text-align: center;">
                            <p style="color: #AEADAB; font-size: 8pt; margin: 0; line-height: 1.5;">
                                Document généré le <t t-out="datetime.datetime.now().strftime('%d/%m/%Y à %H:%M')"/>
                                — BLG Groupe © Tous droits réservés
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
