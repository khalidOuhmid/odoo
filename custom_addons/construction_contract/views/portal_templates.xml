<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_contract_sign_template" name="Sign Contract">
        <t t-call="portal.portal_layout">
            <div class="card shadow-sm">
                <div class="card-header bg-white p-4">
                    <div class="row">
                        <div class="col-8">
                            <h2 class="mb-0">Contrat <span t-field="contract.name"/></h2>
                            <p class="text-muted mb-0">Chantier: <span t-field="contract.chantier_id.name"/></p>
                        </div>
                        <div class="col-4 text-end">
                            <span t-field="contract.state" class="badge rounded-pill bg-info"/>
                        </div>
                    </div>
                </div>
                
                <div class="card-body p-0">
                    <!-- PDF Preview (Mock using Iframe or PDF.js) -->
                    <div class="alert alert-info m-3" role="alert">
                        <i class="fa fa-info-circle"/> Veuillez relire le contrat ci-dessous avant de signer.
                        (Fusion CCTP + Annexes incluse).
                    </div>
                    
                    <div class="text-center p-5 border-bottom bg-light">
                        <h3 class="text-muted">PDF Viewer Integration (Yousign Style)</h3>
                        <p>Le PDF fusionné s'affiche ici page par page.</p>
                        <!-- In prod: Use PDF.js here -->
                    </div>
                </div>

                <div class="card-footer p-4 bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkConditions" required="required"/>
                                <label class="form-check-label" for="checkConditions">
                                    Je certifie avoir lu et accepté les conditions du CCTP et du contrat.
                                </label>
                            </div>
                        </div>
                        <form t-attf-action="/my/contracts/#{contract.id}/accept" method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fa fa-pen-nib me-2"/> Signer le Contrat
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_contract_signed_success" name="Contract Signed">
        <t t-call="portal.portal_layout">
            <div class="text-center mt-5">
                <div class="display-1 text-success mb-4"><i class="fa fa-check-circle"/></div>
                <h1>Félicitations !</h1>
                <p class="lead">Le contrat <strong><span t-field="contract.name"/></strong> a été signé avec succès.</p>
                <a href="/my/home" class="btn btn-secondary mt-3">Retour à l'accueil</a>
            </div>
        </t>
    </template>
</odoo>
