<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- MAIN SIGNATURE PORTAL TEMPLATE                             -->
    <!-- ========================================================== -->

    <template id="signature_portal_template" name="Contract Signature Portal">
        <t t-call="portal.portal_layout">
            <t t-call-assets="construction_contract.assets_signature_portal"/>
            <t t-set="additional_title">Contract Signature</t>

            <div class="signature-portal-wrapper"
                 t-att-data-contract-id="contract.id"
                 t-att-data-access-token="access_token">
                <div class="container mt-4">
                <div class="row">
                    <div class="col-12">

                        <!-- Header -->
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white">
                                <h3 class="mb-0">
                                    <i class="fa fa-file-text-o"/> Contract Signature
                                </h3>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h5>Contract: <t t-esc="contract.name"/></h5>
                                        <p class="mb-1">
                                            <strong>Construction Site:</strong>
                                            <t t-esc="contract.chantier_id.name"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Subcontractor:</strong>
                                            <t t-esc="contract.subcontractor_id.name"/>
                                        </p>
                                    </div>
                                    <div class="col-md-6 text-right">
                                        <h4 class="text-success">
                                            <t t-esc="'{:,.2f}'.format(contract.total_amount_ttc)"/>
                                            <t t-esc="contract.currency_id.symbol"/>
                                        </h4>
                                        <p class="text-muted">
                                            <small>Work Period:
                                                <t t-esc="contract.start_date.strftime('%d/%m/%Y')"/> -
                                                <t t-esc="contract.end_date.strftime('%d/%m/%Y')"/>
                                            </small>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Progress Indicator -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <h5>Reading Progress</h5>
                                <div class="progress" style="height: 30px;">
                                    <div class="progress-bar progress-bar-striped"
                                         role="progressbar"
                                         t-att-style="'width: ' + str(validation_status.get('completion_rate', 0)) + '%'"
                                         t-att-aria-valuenow="validation_status.get('completion_rate', 0)"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        <span class="font-weight-bold">
                                            <t t-esc="'{:.0f}'.format(validation_status.get('completion_rate', 0))"/>%
                                        </span>
                                    </div>
                                </div>
                                <p class="mt-2 mb-0">
                                    <strong>
                                        <t t-esc="len(validation_status.get('validated_pages', []))"/> /
                                        <t t-esc="validation_status.get('total_pages', 0)"/> pages validated
                                    </strong>
                                    <t t-if="validation_status.get('remaining_pages', 0) > 0">
                                        (<t t-esc="validation_status.get('remaining_pages', 0)"/> remaining)
                                    </t>
                                </p>
                            </div>
                        </div>

                        <!-- PDF Viewer -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Contract Document</h5>
                            </div>
                            <div class="card-body p-0">
                                <iframe id="pdf-viewer"
                                        t-att-src="pdf_url"
                                        style="width: 100%; height: 800px; border: none;">
                                </iframe>
                            </div>
                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="btn-group">
                                            <button id="btn-prev-page" class="btn btn-secondary">
                                                <i class="fa fa-chevron-left"/> Previous
                                            </button>
                                            <button id="btn-next-page" class="btn btn-secondary">
                                                Next <i class="fa fa-chevron-right"/>
                                            </button>
                                        </div>
                                        <span class="ml-3">
                                            Page <span id="current-page">1</span> /
                                            <span id="total-pages"><t t-esc="contract.pdf_page_count"/></span>
                                        </span>
                                    </div>
                                    <div class="col-md-6 text-right">
                                        <button id="btn-validate-page" class="btn btn-success">
                                            <i class="fa fa-check"/> Validate This Page
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Signature Section -->
                        <div class="card mb-4">
                            <div class="card-header"
                                 t-attf-class="card-header #{can_sign and 'bg-success text-white' or 'bg-light'}">
                                <h5 class="mb-0">
                                    <i class="fa fa-pencil"/> Electronic Signature
                                </h5>
                            </div>
                            <div class="card-body">
                                <t t-if="can_sign">
                                    <div class="alert alert-success">
                                        <i class="fa fa-check-circle"/>
                                        All pages validated! You can now sign the contract.
                                    </div>

                                    <h6>Draw your signature below:</h6>
                                    <div class="signature-pad-container">
                                        <canvas id="signature-pad"
                                                style="border: 2px solid #ddd; width: 100%; max-width: 600px; height: 200px; cursor: crosshair;">
                                        </canvas>
                                    </div>

                                    <div class="mt-3">
                                        <button id="btn-clear-signature" class="btn btn-secondary">
                                            <i class="fa fa-eraser"/> Clear
                                        </button>
                                        <button id="btn-sign-contract" class="btn btn-success btn-lg float-right">
                                            <i class="fa fa-check-circle"/> Sign Contract
                                        </button>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-warning">
                                        <i class="fa fa-exclamation-triangle"/>
                                        You must validate all <t t-esc="validation_status.get('total_pages', 0)"/> pages
                                        before you can sign the contract.
                                    </div>
                                    <p>
                                        Please read each page carefully and click "Validate This Page"
                                        at the bottom of the PDF viewer.
                                    </p>
                                </t>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- JavaScript Data -->
            <script type="text/javascript">
                var contractId = <t t-esc="contract.id"/>;
                var accessToken = '<t t-esc="access_token"/>';
                var totalPages = <t t-esc="contract.pdf_page_count"/>;
                var validatedPages = <t t-raw="json.dumps(validation_status.get('validated_pages', []))"/>;
                var canSign = <t t-esc="'true' if can_sign else 'false'"/>;
            </script>
            </div>

        </t>
    </template>

    <!-- ========================================================== -->
    <!-- CONFIRMATION TEMPLATE (After Signature)                   -->
    <!-- ========================================================== -->

    <template id="signature_confirmation_template" name="Signature Confirmation">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Contract Signed</t>

            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-8">

                        <!-- Success Message -->
                        <div class="card border-success">
                            <div class="card-header bg-success text-white text-center">
                                <h2 class="mb-0">
                                    <i class="fa fa-check-circle fa-3x mb-3"/>
                                    <br/>Contract Successfully Signed!
                                </h2>
                            </div>
                            <div class="card-body">
                                <div class="text-center mb-4">
                                    <h4>Contract <t t-esc="contract.name"/></h4>
                                    <p class="text-muted">
                                        Signed on <t t-esc="contract.signature_date.strftime('%d/%m/%Y at %H:%M')"/>
                                    </p>
                                </div>

                                <div class="alert alert-info">
                                    <h5><i class="fa fa-info-circle"/> What happens next?</h5>
                                    <ul class="mb-0">
                                        <li>You will receive a confirmation email with the signed contract PDF</li>
                                        <li>A certificate of completion has been generated for legal proof</li>
                                        <li>Our team will contact you to coordinate the work start date</li>
                                    </ul>
                                </div>

                                <!-- Download Buttons -->
                                <div class="row mt-4">
                                    <div class="col-md-6 mb-3">
                                        <a t-attf-href="/my/contract/#{contract.id}/download_signed?access_token=#{access_token}"
                                           class="btn btn-primary btn-block btn-lg">
                                            <i class="fa fa-download"/> Download Signed Contract
                                        </a>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <a t-attf-href="/my/contract/#{contract.id}/download_certificate?access_token=#{access_token}"
                                           class="btn btn-secondary btn-block btn-lg">
                                            <i class="fa fa-certificate"/> Download Certificate
                                        </a>
                                    </div>
                                </div>

                                <!-- Signature Details -->
                                <t t-if="signature">
                                    <hr/>
                                    <h5>Signature Details</h5>
                                    <table class="table table-sm">
                                        <tr>
                                            <td style="width: 40%;"><strong>Signer:</strong></td>
                                            <td><t t-esc="signature.signer_name"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Date:</strong></td>
                                            <td><t t-esc="signature.signature_date.strftime('%d/%m/%Y %H:%M:%S')"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>IP Address:</strong></td>
                                            <td><t t-esc="signature.ip_address"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Device:</strong></td>
                                            <td>
                                                <t t-esc="dict(signature._fields['device_type'].selection).get(signature.device_type, 'Unknown')"/>
                                            </td>
                                        </tr>
                                    </table>
                                </t>

                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </t>
    </template>

    <!-- ========================================================== -->
    <!-- ERROR TEMPLATES                                            -->
    <!-- ========================================================== -->

    <!-- Contract Not Found -->
    <template id="contract_not_found" name="Contract Not Found">
        <t t-call="portal.portal_layout">
            <div class="container mt-5">
                <div class="alert alert-danger text-center">
                    <h3><i class="fa fa-exclamation-triangle"/> Contract Not Found</h3>
                    <p>The contract you are looking for does not exist or has been removed.</p>
                </div>
            </div>
        </t>
    </template>

    <!-- Token Expired -->
    <template id="token_expired" name="Access Token Expired">
        <t t-call="portal.portal_layout">
            <div class="container mt-5">
                <div class="alert alert-warning text-center">
                    <h3><i class="fa fa-clock-o"/> Access Link Expired</h3>
                    <p>
                        The access link for contract <strong><t t-esc="contract.name"/></strong>
                        has expired on <t t-esc="contract.token_expiry_date.strftime('%d/%m/%Y')"/>.
                    </p>
                    <p class="mb-0">
                        Please contact us to request a new link.
                    </p>
                </div>
            </div>
        </t>
    </template>

    <!-- Already Signed -->
    <template id="already_signed" name="Contract Already Signed">
        <t t-call="portal.portal_layout">
            <div class="container mt-5">
                <div class="alert alert-info text-center">
                    <h3><i class="fa fa-check-circle"/> Contract Already Signed</h3>
                    <p>
                        Contract <strong><t t-esc="contract.name"/></strong>
                        has already been signed on <t t-esc="contract.signature_date.strftime('%d/%m/%Y')"/>.
                    </p>
                    <div class="mt-3">
                        <a t-attf-href="/my/contract/#{contract.id}/download_signed?access_token=#{request.params.get('access_token')}"
                           class="btn btn-primary">
                            <i class="fa fa-download"/> Download Signed Contract
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Contract Unavailable -->
    <template id="contract_unavailable" name="Contract Unavailable">
        <t t-call="portal.portal_layout">
            <div class="container mt-5">
                <div class="alert alert-danger text-center">
                    <h3><i class="fa fa-ban"/> Contract Unavailable</h3>
                    <p>
                        Contract <strong><t t-esc="contract.name"/></strong>
                        is currently unavailable for signature.
                    </p>
                    <p class="mb-0">
                        Current status: <strong><t t-esc="dict(contract._fields['state'].selection).get(contract.state)"/></strong>
                    </p>
                </div>
            </div>
        </t>
    </template>

</odoo>
