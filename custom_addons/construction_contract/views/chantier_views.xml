<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extension: Add Contracts Smart Button to Chantier -->
    <record id="view_chantier_form_contract" model="ir.ui.view">
        <field name="name">construction.chantier.form.contract</field>
        <field name="model">construction.chantier</field>
        <field name="inherit_id" ref="construction_base.view_construction_chantier_form_pro"/>
        <field name="arch" type="xml">

            <!-- Add smart button in button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_contracts" type="object"
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="contract_count" widget="statinfo" string="Contracts"/>
                </button>
            </xpath>

            <!-- Add "Create Contract" button inside Lots tab -->
            <xpath expr="//page[@name='lots']/div[@class='oe_button_box']" position="inside">
                <button name="action_open_contract_builder"
                        string="➕ Live Contract Builder"
                        type="object"
                        class="btn btn-primary"/>
            </xpath>

            <!-- Optional header shortcut -->
            <xpath expr="//header" position="inside">
                <button name="action_open_contract_builder"
                        string="Live Contract Builder"
                        type="object"
                        class="btn-primary"/>
            </xpath>

        </field>
    </record>

</odoo>
