<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extension: Add Contracts Smart Button and Kanban Lots to Chantier -->
    <record id="view_chantier_form_contract" model="ir.ui.view">
        <field name="name">construction.chantier.form.contract</field>
        <field name="model">construction.chantier</field>
        <field name="inherit_id" ref="construction_core.view_construction_chantier_form"/>
        <field name="arch" type="xml">

            <!-- Add clean smart button for Contracts -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_contracts" type="object"
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="contract_count" widget="statinfo" string="Contrats"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>

