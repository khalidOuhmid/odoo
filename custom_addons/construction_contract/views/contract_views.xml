<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- TREE VIEW                                                  -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_tree" model="ir.ui.view">
        <field name="name">construction.contract.tree</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='draft'"
                  decoration-warning="state=='sent'"
                  decoration-success="state=='signed'"
                  decoration-muted="state=='cancelled'">
                <field name="name" string="Référence"/>
                <field name="chantier_id" string="Chantier"/>
                <field name="subcontractor_id" string="Sous-Traitant"/>
                <field name="date" string="Date"/>
                <field name="start_date" string="Début"/>
                <field name="end_date" string="Fin"/>
                <field name="total_amount_ttc" widget="monetary" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-warning="state in ('sent', 'in_progress')"
                       decoration-success="state=='signed'"
                       decoration-danger="state=='cancelled'"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- FORM VIEW - REDESIGNED FOR OFFICE WORKERS                 -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_form" model="ir.ui.view">
        <field name="name">construction.contract.form</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <form string="Contrat de Sous-Traitance">
                <header>
                    <!-- ACTION PRINCIPALE: Brouillon → Générer HTML -->
                    <button name="action_generate_contract_html" string="Générer Contrat"
                            type="object" class="btn-primary"
                            icon="fa-magic"
                            invisible="state != 'draft'"
                            groups="group_construction_pilote,group_construction_admin"
                            help="Générer le brouillon du contrat depuis le modèle"/>

                    <!-- ACTION: Généré → Éditer -->
                    <button name="action_open_contract_editor" string="Éditer Contrat"
                            type="object" class="btn-secondary"
                            icon="fa-pencil"
                            invisible="state != 'generated'"
                            groups="group_construction_pilote,group_construction_admin"
                            help="Ouvrir l'éditeur visuel pour modifier le contrat"/>

                    <!-- ACTION PRINCIPALE: Généré → Générer PDF Final -->
                    <button name="action_generate_pdf" string="Générer PDF Final"
                            type="object" class="btn-primary"
                            icon="fa-file-pdf-o"
                            invisible="state != 'generated'"
                            groups="group_construction_pilote,group_construction_admin"
                            help="Générer le document PDF final pour signature"/>

                    <!-- ACTION PRINCIPALE: Envoyé → Envoyer pour Signature -->
                    <button name="action_send_for_signature" string="Envoyer pour Signature"
                            type="object" class="btn-success"
                            icon="fa-paper-plane"
                            invisible="state != 'sent'"
                            help="Envoyer le contrat au sous-traitant par email et SMS"/>

                    <!-- ACTION PRINCIPALE: Envoyé → Renvoyer ou Rappel -->
                    <button name="action_send_for_signature" string="Renvoyer le Contrat"
                            type="object" class="btn-primary"
                            icon="fa-repeat"
                            invisible="state != 'sent'"
                            groups="group_construction_pilote,group_construction_admin"
                            confirm="Ceci renverra l'invitation de signature. Continuer ?"
                            help="Renvoyer l'invitation de signature au sous-traitant"/>

                    <button name="action_send_reminder" string="Envoyer un Rappel"
                            type="object" class="btn-warning"
                            icon="fa-bell"
                            invisible="state not in ('sent', 'in_progress')"
                            groups="group_construction_pilote,group_construction_admin"
                            help="Envoyer un rappel au sous-traitant"/>

                    <!-- Voir le Portail -->
                    <button name="action_view_portal" string="Voir le Portail"
                            type="object"
                            icon="fa-external-link"
                            invisible="state not in ('sent', 'in_progress')"
                            groups="group_construction_pilote,group_construction_admin"
                            help="Ouvrir le portail de signature dans un nouvel onglet"/>

                    <!-- Actions pour contrat signé -->
                    <button name="action_download_pdf" string="Télécharger le PDF"
                            type="object"
                            icon="fa-download"
                            invisible="state != 'signed'"
                            help="Télécharger le contrat signé en PDF"/>

                    <button name="action_download_certificate" string="Télécharger le Certificat"
                            type="object"
                            icon="fa-certificate"
                            invisible="state != 'signed'"
                            help="Télécharger le certificat de signature"/>

                    <!-- Actions administrateur -->
                    <button name="action_regenerate_pdf" string="Régénérer le PDF"
                            type="object"
                            invisible="state not in ('generated', 'sent')"
                            groups="group_construction_admin"
                            confirm="Ceci régénérera le PDF. Continuer ?"/>

                    <button name="action_cancel" string="Annuler le Contrat"
                            type="object"
                            invisible="state in ('signed', 'cancelled')"
                            groups="group_construction_admin"
                            confirm="Êtes-vous sûr de vouloir annuler ce contrat ?"/>

                    <!-- Barre de statut -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,sent,in_progress,signed"
                           options="{'clickable': '0'}"/>
                </header>

                <sheet>
                    <!-- ============================================== -->
                    <!-- BANNIÈRES DE STATUT                            -->
                    <!-- ============================================== -->
                    
                    <!-- Bannière: Brouillon -->
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-pencil fa-2x me-3"/>
                            <div>
                                <h5 class="mb-1">
                                    <strong>Brouillon</strong>
                                </h5>
                                <p class="mb-0">
                                    Le contrat est en cours de préparation. Complétez les informations ci-dessous puis cliquez sur 
                                    <strong>"Générer le PDF"</strong> pour créer le document.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Bannière: PDF Généré -->
                    <div class="alert alert-success" role="alert" invisible="state != 'generated'">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-check-circle fa-2x me-3"/>
                            <div>
                                <h5 class="mb-1">
                                    <strong>PDF Généré avec Succès</strong>
                                </h5>
                                <p class="mb-0">
                                    Le document PDF est prêt. Cliquez sur <strong>"Envoyer pour Signature"</strong> pour l'envoyer au sous-traitant.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Bannière: Envoyé -->
                    <div class="alert alert-warning" role="alert" invisible="state != 'sent'">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-clock-o fa-2x me-3"/>
                            <div>
                                <h5 class="mb-1">
                                    <strong>En Attente de Signature</strong>
                                </h5>
                                <p class="mb-0">
                                    Le contrat a été envoyé au sous-traitant le <field name="sent_date" widget="date" readonly="1" class="fw-bold"/>.
                                    <span invisible="not token_expiry_date">
                                        Le lien expire le <field name="token_expiry_date" widget="date" readonly="1" class="fw-bold"/>.
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Bannière: En Cours de Signature -->
                    <div class="alert alert-info" role="alert" invisible="state != 'in_progress'">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-spinner fa-pulse fa-2x me-3"/>
                            <div>
                                <h5 class="mb-1">
                                    <strong>Signature en Cours</strong>
                                </h5>
                                <p class="mb-0">
                                    Le sous-traitant a commencé le processus de signature. Consultez l'onglet "Signature" pour voir la progression.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Bannière: Signé -->
                    <div class="alert alert-success" role="alert" invisible="state != 'signed'">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-check-circle fa-2x me-3"/>
                            <div>
                                <h5 class="mb-1">
                                    <strong>Contrat Signé</strong>
                                </h5>
                                <p class="mb-0">
                                    Le contrat a été signé le <field name="signature_date" widget="datetime" readonly="1" class="fw-bold"/>.
                                    Vous pouvez télécharger le PDF signé et le certificat.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Bannière: Annulé -->
                    <div class="alert alert-danger" role="alert" invisible="state != 'cancelled'">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-times-circle fa-2x me-3"/>
                            <div>
                                <h5 class="mb-1">
                                    <strong>Contrat Annulé</strong>
                                </h5>
                                <p class="mb-0">
                                    Ce contrat a été annulé et n'est plus actif.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- TITRE ET BOUTONS INTELLIGENTS                  -->
                    <!-- ============================================== -->
                    
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo"
                                   string="Bons de Commande"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="oe_inline" placeholder="Référence du contrat"/>
                        </h1>
                        <!-- KPIs -->
                        <div class="d-flex align-items-center mt-2 flex-wrap gap-2">
                            <span class="badge rounded-pill text-bg-primary fs-6">
                                <i class="fa fa-money"/> <field name="total_amount_ttc" widget="monetary" options="{'currency_field': 'currency_id'}" class="ms-1 oe_inline"/>
                            </span>
                            <span class="badge rounded-pill text-bg-info fs-6">
                                <i class="fa fa-cubes"/> <field name="lot_count" class="ms-1 oe_inline"/> Lots
                            </span>
                            <span invisible="pending_deliverable_count == 0" class="badge rounded-pill text-bg-warning fs-6">
                                <i class="fa fa-clock-o"/> <field name="pending_deliverable_count" class="ms-1 oe_inline"/> Livrables en attente
                            </span>
                            <span class="badge rounded-pill text-bg-danger fs-6" invisible="state not in ('sent', 'in_progress') or days_until_expiry > 2">
                                <i class="fa fa-hourglass-end"/> <field name="days_until_expiry" class="ms-1 oe_inline"/> jours restants
                            </span>
                            <span class="badge rounded-pill text-bg-secondary fs-6" invisible="state not in ('sent', 'in_progress') or days_until_expiry &lt;= 2">
                                <i class="fa fa-hourglass-half"/> <field name="days_until_expiry" class="ms-1 oe_inline"/> jours restants
                            </span>
                        </div>
                    </div>
                    <group>
                        <group string="🏗️ Chantier" class="oe_group_card">
                            <field name="chantier_id" 
                                   string="Chantier"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"
                                   help="Sélectionnez le chantier concerné par ce contrat"/>
                            <field name="lot_ids" 
                                   string="Lots"
                                   widget="many2many_tags"
                                   domain="[('chantier_id', '=', chantier_id)]"
                                   readonly="state != 'draft'"
                                   help="Lots de travaux concernés par ce contrat"/>
                        </group>

                        <group string="👷 Sous-Traitant" class="oe_group_card">
                            <field name="subcontractor_id" 
                                   string="Sous-Traitant"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"
                                   help="Entreprise sous-traitante qui signera le contrat"/>
                        </group>
                    </group>

                    <!-- Template Management Section -->
                    <group string="📝 Gestion du Modèle" class="oe_group_card" invisible="state != 'draft'">
                        <group>
                            <label for="template_id" string="Modèle de Contrat"/>
                            <div class="o_row">
                                <field name="template_id" 
                                       readonly="state != 'draft'"
                                       options="{'no_create': True}"
                                       class="oe_inline"
                                       help="Modèle utilisé pour générer le contrat"/>
                                <button name="%(action_construction_contract_template)d" 
                                        string="Gérer les Modèles"
                                        type="action"
                                        icon="fa-cog"
                                        class="btn-link oe_inline"
                                        help="Ouvrir la gestion des modèles de contrat"/>
                            </div>
                            <div class="alert alert-info mt-2" role="alert" invisible="not template_id">
                                <i class="fa fa-info-circle"/> 
                                Le modèle sélectionné sera utilisé pour générer le document PDF du contrat.
                            </div>
                        </group>
                    </group>

                    <group>
                        <group string="📅 Calendrier" class="oe_group_card">
                            <field name="date" 
                                   string="Date du Contrat"
                                   readonly="state != 'draft'"
                                   help="Date d'établissement du contrat"/>
                            <field name="start_date" 
                                   string="Début des Travaux"
                                   readonly="state != 'draft'"
                                   help="Date prévue de début des travaux"/>
                            <field name="end_date" 
                                   string="Fin des Travaux"
                                   readonly="state != 'draft'"
                                   help="Date prévue de fin des travaux"/>
                            <field name="signature_date" 
                                   string="Date de Signature"
                                   readonly="1" 
                                   invisible="not signature_date"
                                   help="Date à laquelle le contrat a été signé"/>
                        </group>

                        <group string="💰 Montants" class="oe_group_card">
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount_ttc" 
                                   string="Montant Total TTC"
                                   widget="monetary"
                                   class="oe_subtotal_footer_separator"
                                   style="font-size: 1.5em; font-weight: bold;"
                                   help="Montant total du contrat toutes taxes comprises"/>
                            <field name="retention_rate" 
                                   string="Taux de Retenue de Garantie"
                                   readonly="state != 'draft'"
                                   help="Pourcentage retenu en garantie (0–20%)"/>
                            <field name="retention_amount" 
                                   string="Montant de la Retenue"
                                   widget="monetary"
                                   invisible="retention_amount == 0"
                                   help="Montant retenu en garantie"/>
                        </group>
                    </group>

                    <!-- Informations de notification (visible uniquement après envoi) -->
                    <group invisible="state in ('draft', 'generated', 'cancelled')">
                        <group string="📬 Notifications" class="oe_group_card">
                            <field name="email_sent" 
                                   string="Email Envoyé"
                                   widget="boolean" 
                                   readonly="1"
                                   help="Indique si l'email a été envoyé au sous-traitant"/>
                            <field name="sms_sent" 
                                   string="SMS Envoyé"
                                   widget="boolean" 
                                   readonly="1"
                                   help="Indique si le SMS a été envoyé au sous-traitant"/>
                            <field name="last_reminder_date" 
                                   string="Dernier Rappel"
                                   readonly="1"
                                   invisible="not last_reminder_date"
                                   help="Date du dernier rappel envoyé"/>
                            <field name="portal_url" 
                                   string="Lien du Portail"
                                   widget="url" 
                                   readonly="1"
                                   invisible="not portal_url"
                                   help="Lien vers le portail de signature"/>
                        </group>
                    </group>

                    <!-- ============================================== -->
                    <!-- ONGLETS                                        -->
                    <!-- ============================================== -->
                    
                    <!-- ============================================== -->
                    <!-- ONGLETS                                        -->
                    <!-- ============================================== -->
                    
                    <notebook>
                        <!-- Onglet 1: Informations -->
                        <page string="📋 Informations" name="info">
                            <group>
                                <group string="🏗️ Chantier" class="oe_group_card">
                                    <field name="chantier_id" 
                                           string="Chantier"
                                           options="{'no_create': True}"
                                           readonly="state != 'draft'"
                                           help="Sélectionnez le chantier concerné par ce contrat"/>
                                    <field name="lot_ids" 
                                           string="Lots"
                                           widget="many2many_tags"
                                           domain="[('chantier_id', '=', chantier_id)]"
                                           readonly="state != 'draft'"
                                           help="Lots de travaux concernés par ce contrat"/>
                                </group>
        
                                <group string="👷 Sous-Traitant" class="oe_group_card">
                                    <field name="subcontractor_id" 
                                           string="Sous-Traitant"
                                           options="{'no_create': True}"
                                           readonly="state != 'draft'"
                                           help="Entreprise sous-traitante qui signera le contrat"/>
                                </group>
                            </group>
                            
                            <group>
                                <group string="📝 Gestion du Modèle" class="oe_group_card" invisible="state != 'draft'">
                                    <label for="template_id" string="Modèle de Contrat"/>
                                    <div class="o_row">
                                        <field name="template_id" 
                                               readonly="state != 'draft'"
                                               options="{'no_create': True}"
                                               class="oe_inline"
                                               help="Modèle utilisé pour générer le contrat"/>
                                        <button name="%(action_construction_contract_template)d" 
                                                string="Gérer les Modèles"
                                                type="action"
                                                icon="fa-cog"
                                                class="btn-link oe_inline"
                                                help="Ouvrir la gestion des modèles de contrat"/>
                                    </div>
                                    <div class="alert alert-info mt-2" role="alert" invisible="not template_id">
                                        <i class="fa fa-info-circle"/> 
                                        Le modèle sélectionné sera utilisé pour générer le document PDF du contrat.
                                    </div>
                                </group>
                                <group string="📅 Calendrier" class="oe_group_card">
                                    <field name="date" string="Date du Contrat" readonly="state != 'draft'"/>
                                    <field name="start_date" string="Début des Travaux" readonly="state != 'draft'"/>
                                    <field name="end_date" string="Fin des Travaux" readonly="state != 'draft'"/>
                                    <field name="signature_date" string="Date de Signature" readonly="1" invisible="not signature_date"/>
                                </group>
                            </group>
                            
                            <group string="💰 Montants" class="oe_group_card">
                                <field name="currency_id" invisible="1"/>
                                <field name="total_amount_ht" string="Montant HT" widget="monetary" readonly="1"/>
                                <field name="total_amount_tva" string="TVA" widget="monetary" readonly="1"/>
                                <field name="total_amount_ttc" 
                                       string="Montant Total TTC"
                                       widget="monetary"
                                       class="oe_subtotal_footer_separator"
                                       style="font-size: 1.5em; font-weight: bold;"/>
                                <field name="retention_rate"
                                       string="Taux de Retenue"
                                       readonly="state != 'draft'"/>
                                <field name="retention_amount" 
                                       string="Montant de la Retenue"
                                       widget="monetary"
                                       invisible="retention_amount == 0"/>
                            </group>
                            
                            <!-- PDF Preview embed -->
                            <div class="alert alert-info mt-4" role="alert" invisible="state != 'draft' or not pdf_document">
                                <i class="fa fa-info-circle"/> 
                                <strong>Aperçu du contrat :</strong> Visualisez le document PDF généré ci-dessous.
                            </div>
                            <field name="pdf_filename" invisible="1"/>
                            <field name="pdf_document" 
                                   widget="pdf_viewer"
                                   filename="pdf_filename" 
                                   nolabel="1"
                                   invisible="not pdf_document"/>
                        </page>

                        <!-- Onglet 2: Documents Contractuels -->
                        <page string="📎 Documents Contractuels" name="contractual_docs">
                            <div class="alert alert-info mb-3" role="alert">
                                <i class="fa fa-info-circle"/> 
                                Documents de référence issus des lots et du chantier qui constituent les annexes du contrat.
                            </div>
                            <field name="contractual_document_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="document_type"/>
                                    <field name="lot_id"/>
                                    <field name="state" widget="badge" decoration-success="state == 'present'" decoration-danger="state == 'missing'"/>
                                    <field name="is_auto_attached" widget="boolean_toggle"/>
                                    <field name="attachment_id" filename="attachment_id"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet 3: Livrables -->
                        <page string="✅ Livrables" name="deliverables">
                            <field name="deliverable_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Nom"/>
                                    <field name="deliverable_type" string="Type"/>
                                    <field name="is_mandatory" string="Obligatoire" widget="boolean_toggle"/>
                                    <field name="merge_in_contract" string="Fusionner au contrat" widget="boolean_toggle"/>
                                    <field name="document" string="Fichier" filename="document_name"/>
                                    <field name="document_name" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet 4: Signature -->
                        <page string="🖋️ Signature" name="signature" invisible="state not in ('in_progress', 'signed')">
                            <group>
                                <group string="Progression et Preuve" class="oe_group_card">
                                    <field name="pdf_page_count" string="Nombre de Pages" readonly="1"/>
                                    <!-- Signature BLG -->
                                    <field name="blg_signatory_id" readonly="1"/>
                                    <field name="blg_signature_date" readonly="1"/>
                                    <field name="blg_signature_image" widget="image" readonly="1"/>
                                    <!-- Signature ST -->
                                    <field name="signer_full_name" readonly="1"/>
                                    <field name="signer_ip" readonly="1"/>
                                    <field name="signer_user_agent" readonly="1"/>
                                    <field name="signer_gps" readonly="1"/>
                                    <field name="document_hash_sha256" readonly="1"/>
                                </group>
                            </group>
                            <group string="Logs de Validation des Pages" class="mt-4" invisible="not page_validation_log">
                                <field name="page_validation_log" readonly="1" nolabel="1"/>
                            </group>
                        </page>

                        <!-- Onglet 5: Historique -->
                        <page string="📜 Historique" name="history">
                            <group string="Notifications &amp; Accès" class="oe_group_card">
                                <field name="email_sent" widget="boolean" readonly="1"/>
                                <field name="sms_sent" widget="boolean" readonly="1"/>
                                <field name="last_reminder_date" readonly="1"/>
                                <field name="sent_date" readonly="1"/>
                                <field name="portal_url" widget="url" readonly="1" invisible="not portal_url"/>
                                <field name="access_token" readonly="1" password="True"/>
                            </group>
                            <group string="Avancé" class="oe_group_card" groups="group_construction_admin">
                                <field name="active" string="Actif"/>
                                <field name="custom_html_override" widget="ace" options="{'mode': 'html'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- KANBAN VIEW                                                -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_kanban" model="ir.ui.view">
        <field name="name">construction.contract.kanban</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="subcontractor_id"/>
                <field name="total_amount_ttc"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-building-o"/> <field name="chantier_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-user"/> <field name="subcontractor_id"/>
                                </div>
                                <div class="text-success">
                                    <strong>
                                        <field name="total_amount_ttc" widget="monetary"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'info', 'sent': 'warning', 'signed': 'success'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- SEARCH VIEW                                                -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_search" model="ir.ui.view">
        <field name="name">construction.contract.search</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Contrat" filter_domain="[('name', 'ilike', self)]"/>
                <field name="chantier_id" string="Chantier"/>
                <field name="subcontractor_id" string="Sous-Traitant"/>

                <filter string="Brouillon" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Envoyé" name="filter_sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter string="En Cours" name="filter_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Signé" name="filter_signed"
                        domain="[('state', '=', 'signed')]"/>

                <separator/>
                <filter string="Ce Mois" name="filter_this_month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>

                <separator/>
                <filter string="Archivé" name="filter_archived"
                        domain="[('active', '=', False)]"/>

                <group expand="0" string="Grouper Par">
                    <filter string="Chantier" name="group_chantier"
                            context="{'group_by': 'chantier_id'}"/>
                    <filter string="Sous-Traitant" name="group_subcontractor"
                            context="{'group_by': 'subcontractor_id'}"/>
                    <filter string="Statut" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Mois" name="group_month"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- ACTION                                                     -->
    <!-- ========================================================== -->

    <record id="action_construction_contract" model="ir.actions.act_window">
        <field name="name">Contrats de Sous-Traitance</field>
        <field name="res_model">construction.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'search_default_filter_sent': 1,
            'search_default_filter_in_progress': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier contrat de sous-traitance
            </p>
            <p>
                Les contrats vous permettent de formaliser les accords avec vos sous-traitants<br/>
                avec signature électronique et traçabilité juridique complète.
            </p>
        </field>
    </record>

    <!-- Action pour le modèle de signature (audit admin) -->
    <record id="action_construction_contract_signature" model="ir.actions.act_window">
        <field name="name">Signatures Électroniques</field>
        <field name="res_model">construction.contract.signature</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
