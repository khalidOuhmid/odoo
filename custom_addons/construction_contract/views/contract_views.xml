<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- TREE VIEW                                                  -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_tree" model="ir.ui.view">
        <field name="name">construction.contract.tree</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='draft'"
                  decoration-warning="state=='sent'"
                  decoration-success="state=='signed'"
                  decoration-muted="state=='cancelled'">
                <field name="name" string="Reference"/>
                <field name="chantier_id"/>
                <field name="subcontractor_id"/>
                <field name="date"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_amount_ttc" widget="monetary" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-warning="state in ('sent', 'in_progress')"
                       decoration-success="state=='signed'"
                       decoration-danger="state=='cancelled'"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- FORM VIEW                                                  -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_form" model="ir.ui.view">
        <field name="name">construction.contract.form</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Draft state buttons -->
                    <button name="action_generate_pdf" string="Generate PDF"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="group_construction_pilote,group_construction_admin"/>

                    <!-- Generated state buttons -->
                    <button name="action_send_for_signature" string="Send for Signature"
                            type="object" class="btn-primary"
                            invisible="state != 'generated'"
                            groups="group_construction_pilote,group_construction_admin"/>

                    <button name="action_regenerate_pdf" string="Regenerate PDF"
                            type="object"
                            invisible="state not in ('generated', 'sent')"
                            groups="group_construction_pilote,group_construction_admin"/>

                    <!-- Sent/In Progress state buttons -->
                    <button name="action_send_reminder" string="Send Reminder"
                            type="object"
                            invisible="state not in ('sent', 'in_progress')"
                            groups="group_construction_pilote,group_construction_admin"/>

                    <button name="action_view_portal" string="View Portal"
                            type="object" icon="fa-external-link"
                            invisible="state not in ('sent', 'in_progress')"
                            groups="group_construction_pilote,group_construction_admin"/>

                    <!-- Signed state buttons -->
                    <button name="action_download_pdf" string="Download PDF"
                            type="object" icon="fa-download"
                            invisible="state != 'signed'"/>

                    <button name="action_download_certificate" string="Download Certificate"
                            type="object" icon="fa-certificate"
                            invisible="state != 'signed'"/>

                    <button name="action_view_signature_details" string="Signature Details"
                            type="object"
                            invisible="state != 'signed'"/>

                    <!-- Cancel button -->
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('signed', 'cancelled')"
                            groups="group_construction_admin"
                            confirm="Are you sure you want to cancel this contract?"/>

                    <!-- Status bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,sent,in_progress,signed"/>
                </header>

                <sheet>
                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="oe_inline"/>
                        </h1>
                    </div>

                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_deliverables" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="deliverable_ids" invisible="1"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="deliverable_ids" widget="statinfo"
                                           string="Deliverables" nolabel="1"/>
                                </span>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group string="Construction Site &amp; Subcontractor">
                            <field name="chantier_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="subcontractor_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="lot_ids" widget="many2many_tags"
                                   domain="[('chantier_id', '=', chantier_id)]"
                                   readonly="state != 'draft'"/>
                        </group>

                        <group string="Dates">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="sent_date" readonly="1" invisible="not sent_date"/>
                            <field name="signature_date" readonly="1" invisible="not signature_date"/>
                        </group>
                    </group>

                    <group>
                        <group string="Financial Information">
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount_ht" widget="monetary"/>
                            <field name="total_amount_tva" widget="monetary"/>
                            <field name="total_amount_ttc" widget="monetary"
                                   class="oe_subtotal_footer_separator"/>
                            <field name="retention_rate" readonly="state != 'draft'"/>
                            <field name="retention_amount" widget="monetary"/>
                        </group>

                        <group string="Template &amp; Portal">
                            <field name="template_id" readonly="state != 'draft'"/>
                            <field name="access_token" readonly="1" password="True"/>
                            <field name="token_expiry_date" readonly="1"
                                   invisible="not token_expiry_date"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab: PDF Document -->
                        <page string="PDF Document" name="pdf" invisible="not pdf_document">
                            <group>
                                <field name="pdf_filename" invisible="1"/>
                                <field name="pdf_page_count" readonly="1"/>
                                <field name="pdf_hash_before_signature" readonly="1"
                                       password="True"/>
                                <field name="pdf_hash_after_signature" readonly="1"
                                       password="True" invisible="not pdf_hash_after_signature"/>
                            </group>
                            <field name="pdf_document" widget="pdf_viewer"
                                   filename="pdf_filename"/>
                        </page>

                        <!-- Tab: Purchase Orders -->
                        <page string="Purchase Orders" name="purchase_orders">
                            <field name="purchase_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab: Deliverables -->
                        <page string="Deliverables" name="deliverables"
                              groups="group_construction_pilote,group_construction_admin">
                            <field name="deliverable_ids">
                                <list editable="bottom" class="contract-deliverable-list">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="deliverable_type"/>
                                    <field name="is_mandatory"/>
                                    <field name="included_in_contract"/>
                                    <field name="document" filename="document_name"/>
                                    <field name="document_name" invisible="1"/>
                                    <field name="file_size_readable"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab: Signature Details -->
                        <page string="Signature" name="signature"
                              invisible="state not in ('in_progress', 'signed')">
                            <group>
                                <group string="Page Validation Status">
                                    <field name="pdf_page_count" readonly="1"/>
                                    <field name="page_validation_ids" readonly="1" nolabel="1">
                                        <list>
                                            <field name="page_number"/>
                                            <field name="validated_date"/>
                                            <field name="time_spent" widget="float_time"/>
                                            <field name="validation_method"/>
                                        </list>
                                    </field>
                                </group>

                                <group string="Electronic Signature" invisible="not signature_id">
                                    <field name="signature_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab: Certificate -->
                        <page string="Certificate" name="certificate"
                              invisible="not certificate_of_completion">
                            <group>
                                <field name="certificate_filename" invisible="1"/>
                                <field name="certificate_of_completion" widget="pdf_viewer"
                                       filename="certificate_filename"/>
                            </group>
                        </page>

                        <!-- Tab: Technical Info (Admin only) -->
                        <page string="Technical Information" name="technical"
                              groups="group_construction_admin">
                            <group>
                                <group>
                                    <field name="email_sent" readonly="1"/>
                                    <field name="sms_sent" readonly="1"/>
                                    <field name="last_reminder_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="active"/>
                                </group>
                                <group>
                                    <field name="custom_html_override" widget="ace"
                                           options="{'mode': 'html'}" nolabel="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- KANBAN VIEW                                                -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_kanban" model="ir.ui.view">
        <field name="name">construction.contract.kanban</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="subcontractor_id"/>
                <field name="total_amount_ttc"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-building-o"/> <field name="chantier_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-user"/> <field name="subcontractor_id"/>
                                </div>
                                <div class="text-success">
                                    <strong>
                                        <field name="total_amount_ttc" widget="monetary"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'info', 'sent': 'warning', 'signed': 'success'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- SEARCH VIEW                                                -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_search" model="ir.ui.view">
        <field name="name">construction.contract.search</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Contract" filter_domain="[('name', 'ilike', self)]"/>
                <field name="chantier_id"/>
                <field name="subcontractor_id"/>

                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Sent" name="filter_sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter string="In Progress" name="filter_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Signed" name="filter_signed"
                        domain="[('state', '=', 'signed')]"/>

                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>

                <separator/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Construction Site" name="group_chantier"
                            context="{'group_by': 'chantier_id'}"/>
                    <filter string="Subcontractor" name="group_subcontractor"
                            context="{'group_by': 'subcontractor_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Month" name="group_month"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- ACTION                                                     -->
    <!-- ========================================================== -->

    <record id="action_construction_contract" model="ir.actions.act_window">
        <field name="name">Subcontractor Contracts</field>
        <field name="res_model">construction.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'search_default_filter_sent': 1,
            'search_default_filter_in_progress': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subcontractor contract
            </p>
            <p>
                Contracts allow you to formalize agreements with subcontractors<br/>
                with electronic signature and full legal traceability.
            </p>
        </field>
    </record>

    <!-- Action for signature model (admin audit) -->
    <record id="action_construction_contract_signature" model="ir.actions.act_window">
        <field name="name">Electronic Signatures</field>
        <field name="res_model">construction.contract.signature</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
