<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- TREE VIEW                                                  -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_template_tree" model="ir.ui.view">
        <field name="name">construction.contract.template.tree</field>
        <field name="model">construction.contract.template</field>
        <field name="arch" type="xml">
            <list decoration-bf="is_default">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="contract_count"/>
                <field name="last_used_date"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- FORM VIEW                                                  -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_template_form" model="ir.ui.view">
        <field name="name">construction.contract.template.form</field>
        <field name="model">construction.contract.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_editor" string="Open Visual Editor"
                            type="object" class="btn-primary" icon="fa-edit"/>
                    <button name="action_preview_pdf" string="Preview PDF"
                            type="object" icon="fa-file-pdf-o"/>
                    <button name="action_duplicate" string="Duplicate"
                            type="object" icon="fa-copy"/>
                    <button name="action_set_as_default" string="Set as Default"
                            type="object" invisible="is_default"
                            confirm="This will unset the current default template. Continue?"/>
                    <button name="action_view_contracts" string="View Contracts Using This Template"
                            type="object" invisible="contract_count == 0"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts" type="object"
                                class="oe_stat_button" icon="fa-file-text">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g., Standard Subcontractor Contract"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="last_used_date" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="description" placeholder="Internal description of this template's purpose..."/>
                    </group>

                    <notebook>
                        <!-- Tab: Variables -->
                        <page string="Available Variables" name="variables">
                            <field name="variable_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code" placeholder="{{ contract.name }}"/>
                                    <field name="category"/>
                                    <field name="variable_type"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab: HTML Preview -->
                        <page string="HTML Content" name="html">
                            <group>
                                <field name="grapesjs_html" widget="ace"
                                       options="{'mode': 'html'}" nolabel="1"/>
                            </group>
                        </page>

                        <!-- Tab: CSS Preview -->
                        <page string="CSS Styles" name="css">
                            <group>
                                <field name="grapesjs_css" widget="ace"
                                       options="{'mode': 'css'}" nolabel="1"/>
                            </group>
                        </page>

                        <!-- Tab: GrapesJS Data (technical) -->
                        <page string="GrapesJS Data" name="grapesjs_data" groups="base.group_no_one">
                            <group>
                                <field name="grapesjs_components" widget="ace"
                                       options="{'mode': 'json'}" nolabel="1"/>
                            </group>
                            <group>
                                <field name="grapesjs_styles" widget="ace"
                                       options="{'mode': 'json'}" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- ACTION                                                     -->
    <!-- ========================================================== -->

    <record id="action_construction_contract_template" model="ir.actions.act_window">
        <field name="name">Contract Templates</field>
        <field name="res_model">construction.contract.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first contract template
            </p>
            <p>
                Templates allow you to create reusable contract formats<br/>
                that can be customized with a visual editor.
            </p>
        </field>
    </record>

</odoo>
