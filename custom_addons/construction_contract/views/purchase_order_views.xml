<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_contract_form" model="ir.ui.view">
        <field name="name">purchase.order.contract.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase_delivery_invoice']" position="before">
                <page string="Contract (GrapeJS)" name="contract_grapejs">
                    <header>
                        <button name="action_open_contract_editor" 
                                string="Edit Contract Template" 
                                type="object" 
                                class="btn btn-primary" 
                                icon="fa-pencil-square-o"/>
                        <button name="action_generate_pdf" 
                                string="Generate PDF" 
                                type="object" 
                                class="btn btn-secondary" 
                                icon="fa-file-pdf-o"/>
                    </header>
                    <group>
                        <field name="contract_id" readonly="1"/>
                    </group>
                    <div class="alert alert-warning" invisible="contract_template_html">
                        No contract content defined. Click "Edit Contract Template" to start.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
