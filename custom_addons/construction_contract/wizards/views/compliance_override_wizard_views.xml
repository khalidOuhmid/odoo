<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Vue formulaire du wizard de dérogation conformité            -->
    <!-- Bouton "Confirmer malgré tout" visible uniquement pour        -->
    <!-- group_construction_admin et group_construction_pilote         -->
    <!-- ============================================================ -->

    <record id="view_compliance_override_wizard_form" model="ir.ui.view">
        <field name="name">construction.compliance.override.wizard.form</field>
        <field name="model">construction.compliance.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Dérogation — Documents non conformes">

                <!-- Alerte visuelle -->
                <div class="alert alert-warning" role="alert">
                    <strong>⚠ Attention</strong> — Ce sous-traitant présente des documents non conformes.
                    Une dérogation doit être motivée et sera tracée de façon permanente.
                </div>

                <group>
                    <group string="Sous-traitant">
                        <field name="partner_id" readonly="1"/>
                        <field name="non_compliant_docs" readonly="1" widget="text"/>
                    </group>
                    <group string="Informations de dérogation">
                        <field name="override_by_id" readonly="1"/>
                        <field name="override_date" readonly="1"/>
                    </group>
                </group>

                <group string="Raison de la dérogation *">
                    <field name="override_reason"
                           nolabel="1"
                           widget="text"
                           placeholder="Décrivez la raison de la dérogation (minimum 20 caractères)…"/>
                </group>

                <footer>
                    <!-- Bouton "Confirmer malgré tout" : visible admin et pilote uniquement -->
                    <button name="action_confirm_override"
                            string="Confirmer malgré tout"
                            type="object"
                            class="btn-danger"
                            invisible="not (user.has_group('construction_core.group_construction_admin') or user.has_group('construction_contract.group_construction_pilote'))"/>

                    <!-- Message informatif pour les utilisateurs sans droits -->
                    <span class="text-danger"
                          invisible="user.has_group('construction_core.group_construction_admin') or user.has_group('construction_contract.group_construction_pilote')">
                        Vous n'avez pas les droits pour accorder une dérogation.
                        Contactez un administrateur ou un pilote.
                    </span>

                    <button string="Annuler"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Vue liste du journal de dérogation -->
    <record id="view_compliance_override_log_list" model="ir.ui.view">
        <field name="name">construction.compliance.override.log.list</field>
        <field name="model">construction.compliance.override.log</field>
        <field name="arch" type="xml">
            <list string="Journal de dérogation conformité" create="0" delete="0">
                <field name="override_date" string="Date"/>
                <field name="partner_id" string="Sous-traitant"/>
                <field name="chantier_id" string="Chantier"/>
                <field name="contract_id" string="Contrat"/>
                <field name="override_by_id" string="Accordé par"/>
                <field name="non_compliant_docs" string="Documents"/>
                <field name="override_reason" string="Raison"/>
            </list>
        </field>
    </record>

    <record id="action_compliance_override_log" model="ir.actions.act_window">
        <field name="name">Journal de Dérogation Conformité</field>
        <field name="res_model">construction.compliance.override.log</field>
        <field name="view_mode">list</field>
        <field name="groups_id" eval="[(4, ref('construction_core.group_construction_admin'))]"/>
    </record>

</odoo>
