<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_contract_validation_wizard_form" model="ir.ui.view">
        <field name="name">construction.contract.validation.wizard.form</field>
        <field name="model">construction.contract.validation.wizard</field>
        <field name="arch" type="xml">
            <form string="Documents Manquants">
                <group>
                    <div class="alert alert-danger" role="alert">
                        <strong>Impossible de générer le contrat !</strong><br/>
                        Certains documents ou conditions obligatoires sont manquants.
                    </div>
                </group>
                <group>
                    <field name="missing_items" nolabel="1"/>
                    <field name="lot_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_force_generate" 
                            string="⚠️ Forcer la génération (Déconseillé)" 
                            type="object" 
                            class="btn-danger"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
