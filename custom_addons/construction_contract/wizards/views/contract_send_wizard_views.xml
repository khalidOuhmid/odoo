<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Contract Send Wizard Form View - Enterprise Grade            -->
    <!-- ============================================================ -->
    
    <record id="contract_send_wizard_form" model="ir.ui.view">
        <field name="name">contract.send.wizard.form</field>
        <field name="model">contract.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Envoyer le Contrat">
                <sheet>
                    <!-- Header Banner -->
                    <div class="alert alert-info mb-4" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-paper-plane fa-2x me-3"/>
                            <div>
                                <strong>Envoi du Contrat</strong>
                                <p class="mb-0 text-muted">Le sous-traitant recevra une notification avec un lien sécurisé pour signer le contrat.</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Hidden Fields -->
                    <field name="contract_id" invisible="1"/>
                    
                    <!-- Contract Info Section -->
                    <group>
                        <group string="Informations du Contrat">
                            <field name="subcontractor_id" readonly="1"/>
                            <field name="chantier_id" readonly="1"/>
                        </group>
                        <group string="Contact">
                            <field name="recipient_email" placeholder="email@exemple.com"/>
                            <field name="recipient_phone" placeholder="+33 6 XX XX XX XX"/>
                        </group>
                    </group>
                    
                    <separator/>
                    
                    <!-- Notification Methods -->
                    <group string="Méthode de Notification" col="4">
                        <field name="send_email" widget="boolean_toggle"/>
                        <field name="send_sms" widget="boolean_toggle"/>
                    </group>
                    
                    <separator/>
                    
                    <!-- Portal Link (Always Visible) -->
                    <group string="Lien de Signature">
                        <field name="portal_url" widget="CopyClipboardChar" readonly="1" 
                               string="URL du Portail"
                               help="Copiez ce lien pour l'envoyer manuellement si nécessaire"/>
                    </group>
                    
                    <separator/>
                    
                    <!-- Message Preview -->
                    <group string="Aperçu du Message">
                        <field name="message_preview" nolabel="1" readonly="1" 
                               widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Envoyer" name="action_send" type="object" 
                            class="btn-primary" icon="fa-paper-plane"
                            confirm="Confirmer l'envoi du contrat ?"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action to open wizard -->
    <record id="action_contract_send_wizard" model="ir.actions.act_window">
        <field name="name">Envoyer le Contrat</field>
        <field name="res_model">contract.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
