<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_contract_signature" model="mail.template">
            <field name="name">Contrat : Demande de Signature</field>
            <field name="model_id" ref="model_construction_contract"/>
            <field name="subject">Signature de votre contrat - {{ object.chantier_id.name }}</field>
            <field name="email_from">{{ (object.create_uid.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Bonjour <t t-out="object.partner_id.name"/>,
                        <br/><br/>
                        Veuillez trouver ci-joint votre contrat de sous-traitance pour le chantier <strong><t t-out="object.chantier_id.name"/></strong>.
                        <br/><br/>
                        Merci de bien vouloir le signer électroniquement via notre portail en cliquant sur le bouton ci-dessous :
                        <br/><br/>
                        <div style="text-align: center;">
                            <a t-att-href="object.get_base_url() + '/my/contracts/' + str(object.id) + '/sign'" 
                               style="background-color: #875A7B; padding: 10px 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;">
                                Signer le Contrat
                            </a>
                        </div>
                        <br/><br/>
                        Cordialement,
                        <br/>
                        L'équipe Travaux.
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
