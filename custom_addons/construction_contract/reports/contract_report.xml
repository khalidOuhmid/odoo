<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- REPORT ACTION                                              -->
    <!-- ========================================================== -->

    <record id="action_report_contract" model="ir.actions.report">
        <field name="name">Contract PDF</field>
        <field name="model">construction.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construction_contract.report_contract_document</field>
        <field name="report_file">construction_contract.report_contract_document</field>
        <field name="print_report_name">'Contract_%s' % object.name</field>
        <field name="binding_model_id" ref="model_construction_contract"/>
        <field name="binding_type">report</field>
    </record>

    <!-- REPORT TEMPLATE (QWeb Native) -->
    <!-- ========================================================== -->

    <template id="report_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="contract">
                <t t-call="web.basic_layout">
                    <div class="page custom-contract-page">
                        
                        <!-- 1. THE GRAPEJS DYNAMIC CONTRACT HTML -->
                        <div class="contract-body-content">
                            <t t-if="contract.contract_template_html">
                                <!-- Using t-out for Odoo 16+ safely evaluating HTML -->
                                <t t-out="contract.contract_template_html"/>
                            </t>
                            <t t-else="">
                                <div class="alert alert-warning text-center">
                                    <h3>Contrat non généré</h3>
                                    <p>Veuillez générer le template du contrat avant de l'imprimer.</p>
                                </div>
                            </t>
                        </div>

                        <!-- 2. LOT DOCUMENTS & ANNEXES (BUG-02) -->
                        <t t-if="contract.contractual_document_ids">
                            <t t-foreach="contract.contractual_document_ids" t-as="cdoc">
                                <div style="page-break-before: always; padding: 20px;">
                                    <h2 style="color: #666; font-family: sans-serif; margin-bottom: 20px; text-transform: uppercase;">
                                        Annexe : <t t-if="cdoc.document_type == 'cctp'">CCTP</t>
                                        <t t-elif="cdoc.document_type == 'planning_lot'">Planning Sous-Traitant</t>
                                        <t t-elif="cdoc.document_type == 'planning_general'">Planning Général</t>
                                        <t t-elif="cdoc.document_type == 'bon_de_commande'">Bon de Commande</t>
                                        <t t-else=""><t t-esc="cdoc.document_type"/></t>
                                    </h2>
                                    
                                    <t t-if="cdoc.attachment_id">
                                        <!-- If the attachment is an image, we embed it directly -->
                                        <t t-if="'image' in cdoc.attachment_id.mimetype">
                                            <div style="text-align: center;">
                                                <img t-att-src="'data:%s;base64,%s' % (cdoc.attachment_id.mimetype, cdoc.attachment_id.datas.decode('utf-8'))" style="max-width: 100%; max-height: 900px;" alt="Annexe"/>
                                            </div>
                                        </t>
                                        <!-- If it's a PDF, we print a placeholder (wkhtmltopdf cannot embed another PDF) -->
                                        <t t-else="">
                                            <div style="border: 2px dashed #17a2b8; padding: 40px; text-align: center; font-family: sans-serif; margin-top: 50px; background-color: #f8f9fa;">
                                                <h3 style="color: #17a2b8; margin-bottom: 15px;">Document joint : <t t-esc="cdoc.attachment_id.name"/></h3>
                                                <p style="color: #666; font-size: 14px;">Veuillez consulter la pièce jointe PDF ou document correspondante dans les annexes numériques du contrat.</p>
                                                <p style="color: #999; font-size: 12px; margin-top: 20px;"><em>Ce document ne peut pas être imprimé directement dans cette liasse.</em></p>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div style="border: 2px dashed #dc3545; padding: 40px; text-align: center; font-family: sans-serif; margin-top: 50px; background-color: #fff3f3;">
                                            <h3 style="color: #dc3545; margin-bottom: 15px;">Document absent</h3>
                                            <p style="color: #666; font-size: 14px;">Ce document requis n'a pas été fourni ou intégré au contrat lors de sa génération.</p>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
