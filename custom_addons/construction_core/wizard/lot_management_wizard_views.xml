<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Lot Management Wizard Form View - Production Grade           -->
    <!-- ============================================================ -->
    
    <record id="lot_management_wizard_form" model="ir.ui.view">
        <field name="name">construction.lot.management.wizard.form</field>
        <field name="model">construction.lot.management.wizard</field>
        <field name="arch" type="xml">
            <form string="Gestion du Lot">
                <sheet>
                    <!-- Header: Lot Reference -->
                    <div class="oe_title">
                        <h2>
                            <field name="lot_id" readonly="1" options="{'no_open': True}"/>
                        </h2>
                        <span class="text-muted">
                            Chantier: <field name="chantier_id" readonly="1" class="oe_inline" options="{'no_open': True}"/>
                        </span>
                    </div>
                    
                    <separator/>
                    
                    <!-- Mode Selector (Key UX Controller) -->
                    <group>
                        <group>
                            <field name="execution_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                    
                    <!-- US-COR-001: Alert Zone Above Tabs -->
                    <field name="is_subcontractor_already_assigned" invisible="1"/>
                    <field name="subcontractor_warning" widget="html" nolabel="1" 
                           invisible="not subcontractor_warning" colspan="2"/>
                    
                    <notebook>
                        <!-- ============================================== -->
                        <!-- TAB 1: VUE D'ENSEMBLE                          -->
                        <!-- ============================================== -->
                        <page string="Vue d'Ensemble" name="overview">
                            <group>
                                <!-- External Mode: Subcontractor Assignment -->
                                <group string="Sous-Traitant" invisible="execution_type != 'external'">
                                    <field name="subcontractor_id"
                                           placeholder="Sélectionner un sous-traitant..."
                                           options="{'no_create': True}"/>
                                    <div class="text-muted small" style="padding-left:8px"
                                         invisible="not is_subcontractor_already_assigned">
                                        <i class="fa fa-pencil me-1"/>
                                        Vous pouvez modifier ce sous-traitant directement.
                                    </div>
                                </group>
                                
                                <!-- Internal Mode: Responsible User -->
                                <group string="Équipe Interne" invisible="execution_type != 'internal'">
                                    <field name="internal_user_id" 
                                           placeholder="Sélectionner un responsable..."
                                           options="{'no_create': True}"/>
                                </group>
                                
                                <!-- Planning Section -->
                                <group string="Planning">
                                    <label for="date_start"/>
                                    <div class="o_row">
                                        <field name="date_start" class="oe_inline"/>
                                        <span class="mx-2">→</span>
                                        <field name="date_end" class="oe_inline"/>
                                    </div>
                                </group>
                            </group>
                            
                            <separator string="Synthèse Financière"/>
                            
                            <!-- Financial KPIs (Read-Only) -->
                            <group>
                                <group string="Revenus &amp; Coûts">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="lot_sale_price" readonly="1" widget="monetary"
                                           string="Prix de Vente HT"/>
                                    <field name="lot_cost" readonly="1" widget="monetary"
                                           string="Coût Prévu"/>
                                </group>
                                <group string="Marge">
                                    <field name="lot_margin" readonly="1" widget="monetary"
                                           decoration-success="lot_margin &gt; 0"
                                           decoration-danger="lot_margin &lt; 0"/>
                                    <field name="lot_margin_percent" readonly="1"
                                           decoration-success="lot_margin_percent &gt; 0"
                                           decoration-danger="lot_margin_percent &lt; 0"
                                           string="Marge (%)"/>
                                </group>
                            </group>
                            
                            <!-- Info Banner -->
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle me-2"/>
                                <strong>Prix:</strong> Montant du devis validé.
                                <strong class="ms-3">Coût:</strong> Calculé depuis les coûts produits.
                                <strong class="ms-3">Marge:</strong> Prix - Coût.
                            </div>
                        </page>
                        
                        <!-- ============================================== -->
                        <!-- TAB 2: DOCUMENTS                               -->
                        <!-- ============================================== -->
                        <page string="Documents" name="documents">
                            <!-- Technical Documents -->
                            <group string="Documents Techniques">
                                <group>
                                    <field name="cctp_file" widget="binary" filename="cctp_file_filename"/>
                                    <field name="cctp_file_filename" invisible="1"/>
                                </group>
                                <group>
                                    <field name="project_planning_file" widget="binary" filename="project_planning_filename"/>
                                    <field name="project_planning_filename" invisible="1"/>
                                </group>
                            </group>
                            
                            <group invisible="execution_type != 'external'">
                                <group>
                                    <field name="subcontractor_planning_file" widget="binary" filename="subcontractor_planning_filename"/>
                                    <field name="subcontractor_planning_filename" invisible="1"/>
                                </group>
                            </group>
                            
                            <group string="Autres Documents">
                                <field name="other_files" widget="many2many_binary" nolabel="1" colspan="2"/>
                            </group>
                            
                            <separator/>
                            
                            <!-- Purchase Order Section (External Only) -->
                            <group string="Bon de Commande" invisible="execution_type != 'external'">
                                <group>
                                    <button name="action_generate_po" 
                                            string="Générer le Bon de Commande"
                                            type="object" 
                                            class="btn-primary"
                                            icon="fa-shopping-cart"
                                            invisible="purchase_order_id"
                                            confirm="Générer un bon de commande pour ce lot ?"/>
                                    <field name="purchase_order_id" readonly="1" 
                                           invisible="not purchase_order_id"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                            
                            <separator invisible="execution_type != 'external'"/>
                            
                            <!-- Contract Section (External Only) -->
                            <group string="Contrat de Sous-Traitance" invisible="execution_type != 'external'">
                                <!-- Prerequisites Panel -->
                                <div class="alert alert-secondary mb-3" role="alert" style="font-size: 13px;">
                                    <strong>Prérequis :</strong><br/>
                                    <field name="prerequisites_html" readonly="1" widget="html" nolabel="1"/>
                                </div>
                                
                                <group>
                                    <field name="can_generate_contract" invisible="1"/>
                                    <button name="action_generate_contract" 
                                            string="Déléguer la Génération du Contrat"
                                            type="object" 
                                            class="btn-success"
                                            icon="fa-file-text-o"
                                            invisible="contract_id or not can_generate_contract"/>
                                    <button string="Prérequis non remplis" 
                                            class="btn-secondary"
                                            disabled="1"
                                            invisible="contract_id or can_generate_contract"/>
                                    <field name="contract_id" readonly="1" 
                                           invisible="not contract_id"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- ============================================== -->
                        <!-- TAB 3: NOTES                                   -->
                        <!-- ============================================== -->
                        <page string="Notes" name="notes">
                            <field name="notes" widget="html" nolabel="1" colspan="2"
                                   placeholder="Notes et commentaires structurés concernant le lot..."/>
                        </page>
                        
                        <!-- ============================================== -->
                        <!-- TAB 4: AVANCEMENT                              -->
                        <!-- ============================================== -->
                        <page string="Avancement" name="progress">
                            <!-- US-COR-005: Over-billing Alert -->
                            <field name="is_over_billed" invisible="1"/>
                            <div class="alert alert-danger mb-3" role="alert" invisible="not is_over_billed">
                                <i class="fa fa-exclamation-circle me-2"/>
                                <strong>ALERTE SURFACTURATION:</strong> L'avancement dépasse 100%. 
                                Veuillez vérifier la facturation de ce lot.
                            </div>
                            
                            <div class="alert alert-warning mb-3" role="alert">
                                <i class="fa fa-exclamation-triangle me-2"/>
                                <strong>Important:</strong> Le pourcentage d'avancement est indexé sur la valeur facturable. 
                                50% signifie que 50% du prix de vente a été réalisé.
                            </div>
                            
                            <group>
                                <group string="Progression">
                                    <field name="progress_percentage" widget="progressbar"/>
                                </group>
                            </group>
                            
                            <group>
                                <group string="Valeurs Calculées">
                                    <field name="completed_value" readonly="1" widget="monetary"
                                           decoration-success="1"/>
                                    <field name="remaining_value" readonly="1" widget="monetary"
                                           decoration-info="1"/>
                                </group>
                                <group string="Référence">
                                    <field name="lot_sale_price" readonly="1" widget="monetary" string="Prix Total"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <footer>
                    <button string="Enregistrer" name="action_save" type="object" class="btn-primary" icon="fa-save"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- Action to Open Wizard                                        -->
    <!-- ============================================================ -->
    
    <record id="action_lot_management_wizard" model="ir.actions.act_window">
        <field name="name">Gérer le Lot</field>
        <field name="res_model">construction.lot.management.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="construction_core.model_construction_lot"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
