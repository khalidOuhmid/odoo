<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_force_stage_wizard_form" model="ir.ui.view">
        <field name="name">construction.force.stage.wizard.form</field>
        <field name="model">construction.force.stage.wizard</field>
        <field name="arch" type="xml">
            <form string="Forcer le changement d'étape">
                <group>
                    <field name="chantier_id"/>
                    <field name="target_stage_id"/>
                    <field name="reason" placeholder="Pourquoi forcer ce changement ?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Forcer" type="object" class="btn-warning"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
