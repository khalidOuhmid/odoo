<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron Job: Guarantee Reminder (US-COR-006) -->
        <record id="ir_cron_guarantee_reminder" model="ir.cron">
            <field name="name">Construction: Rappels Garantie Automatiques</field>
            <field name="model_id" ref="construction_core.model_construction_chantier"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_guarantee_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
    </data>
</odoo>
