<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_construction_chantier_search" model="ir.ui.view">
        <field name="name">construction.chantier.search</field>
        <field name="model">construction.chantier</field>
        <field name="arch" type="xml">
            <search string="Project Search">
                <field name="name"/>
                <field name="reference"/>
                <field name="client_id"/>
                <field name="user_id"/>
                <filter string="My Projects" name="my_projects" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Open Projects" name="open_projects" domain="[('stage_id.is_closed', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Customer" name="group_by_client" context="{'group_by': 'client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_construction_chantier_form" model="ir.ui.view">
        <field name="name">construction.chantier.form</field>
        <field name="model">construction.chantier</field>
        <field name="arch" type="xml">
            <form string="Chantier">
                <header>
                    <button name="action_force_stage_wizard" string="Forcer l'Étape" type="object" groups="construction_core.group_construction_manager" class="btn-warning"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart Buttons will be added here by extensions -->
                    </div>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="reference" class="oe_inline" readonly="1"/> - 
                            <field name="name" class="oe_inline" placeholder="Project Name (e.g., Villa Sunshine)"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="client_id" widget="res_partner_many2one" context="{'show_address': 1}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <label for="date_start" string="Period"/>
                            <div class="o_row">
                                <field name="date_start" widget="daterange" options="{'related_end_date': 'date_end'}"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>
                                <field name="date_end" widget="daterange" options="{'related_start_date': 'date_start'}"/>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <!-- FinOps Summary Banner -->
                    <div class="alert alert-info d-flex align-items-center" role="alert" 
                         style="background-color: #f8f9fa; border-left: 5px solid #005c96;">
                        <div style="flex: 1; padding: 0 10px; border-right: 1px solid #dee2e6;">
                            <small class="text-muted text-uppercase">Budget Initial</small><br/>
                            <field name="budget_amount" widget="monetary" class="fw-bold h5 mb-0"/>
                        </div>
                        <div style="flex: 1; padding: 0 10px; border-right: 1px solid #dee2e6;">
                            <small class="text-muted text-uppercase">Committed</small><br/>
                            <field name="committed_amount" widget="monetary" class="fw-bold h5 mb-0 text-primary"/>
                        </div>
                        <div style="flex: 1; padding: 0 10px; border-right: 1px solid #dee2e6;">
                            <small class="text-muted text-uppercase">Realized</small><br/>
                            <field name="realized_amount" widget="monetary" class="fw-bold h5 mb-0"/>
                        </div>
                        <div style="flex: 1; padding: 0 10px;">
                            <small class="text-muted text-uppercase">Gross Margin</small><br/>
                            <span class="d-flex align-items-baseline">
                                <field name="gross_margin" widget="monetary" class="fw-bold h5 mb-0"/>
                                <span class="ms-2 badge bg-success round-pill">
                                    <field name="margin_rate" widget="float" digits="[12,1]"/>%
                                </span>
                            </span>
                        </div>
                    </div>

                    <notebook>
                        <page string="Work Packages" name="lots">
                            <field name="lot_ids" mode="list,kanban">
                                <list editable="bottom">
                                    <field name="code" width="80px"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'"/>
                                    <field name="budget_amount" sum="Total Budget"/>
                                    <field name="committed_amount" sum="Total Committed"/>
                                    <field name="realized_amount" sum="Total Realized"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Financial Control" name="finops">
                            <group>
                                <group string="Key Indicators">
                                    <field name="budget_variance" decoration-danger="budget_variance &lt; 0"/>
                                </group>
                                <group string="Configuration">
                                    <field name="currency_id"/>
                                </group>
                            </group>
                            <!-- Placeholder for advanced graphs -->
                        </page>
                        
                        <page string="Stakeholders" name="stakeholders">
                            <!-- Placeholder for Subcontractors / Business Providers -->
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_construction_chantier_kanban" model="ir.ui.view">
        <field name="name">construction.chantier.kanban.professional</field>
        <field name="model">construction.chantier</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    class="o_kanban_small_column o_kanban_project_tasks"
                    quick_create="false"
                    on_create="quick_create"
                    sample="1">
                <field name="id"/>
                <field name="color"/>
                <field name="name"/>
                <field name="reference"/>
                <field name="client_id"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <field name="margin_rate"/>
                <field name="currency_id"/>
                <field name="days_remaining"/>
                <field name="date_end_contract"/>
                <field name="priority"/>
                <field name="user_id"/>
                <field name="budget_amount"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_global_click oe_semantic_html_override o_kanban_card_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="reference"/> - <field name="name"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="client_id"/>
                                    </small>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">Modifier</a>
                                        <a role="menuitem" type="delete" class="dropdown-item">Supprimer</a>
                                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="o_kanban_record_body mt-2">
                                <!-- Dates & Risks -->
                                <div class="row mb-2">
                                    <div class="col-8">
                                        <span class="text-muted"><i class="fa fa-clock-o" title="Échéance"/> <field name="date_end_contract"/></span>
                                        <t t-if="record.days_remaining.raw_value &lt; 0">
                                             <span class="badge text-bg-danger ms-1">Retard</span>
                                        </t>
                                        <t t-elif="record.days_remaining.raw_value &lt; 7">
                                            <span class="badge text-bg-warning ms-1">J-<field name="days_remaining"/></span>
                                        </t>
                                    </div>
                                    <div class="col-4 text-end">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>

                                <!-- Financial Progress -->
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted small">Budget</span>
                                    <span class="fw-bold"><field name="budget_amount" widget="monetary"/></span>
                                </div>
                                
                                <t t-if="record.margin_rate.raw_value">
                                    <div class="progress" style="height: 6px;" title="Taux de Marge">
                                        <div t-attf-class="progress-bar #{record.margin_rate.raw_value &lt; 15 ? 'bg-danger' : 'bg-success'}" 
                                             role="progressbar" 
                                             t-att-style="'width: ' + Math.min(Math.max(record.margin_rate.raw_value, 0), 100) + '%'" 
                                             aria-valuenow="record.margin_rate.raw_value" aria-valuemin="0" aria-valuemax="100"/>
                                    </div>
                                     <div class="d-flex justify-content-end mt-1">
                                        <small t-attf-class="#{record.margin_rate.raw_value &lt; 15 ? 'text-danger' : 'text-success'} fw-bold">
                                            Marge: <field name="margin_rate" widget="float" digits="[0,1]"/>%
                                        </small>
                                    </div>
                                </t>
                            </div>

                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                     <field name="priority" widget="priority"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_construction_chantier" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">construction.chantier</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_construction_chantier_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first construction project
            </p>
            <p>
                Manage your construction sites with financial and technical precision.
            </p>
        </field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_construction_root" 
              name="Construction" 
              web_icon="construction_core,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_construction_sub_chantier"
              name="Projects"
              parent="menu_construction_root"
              action="action_construction_chantier"
              sequence="10"/>
</odoo>
