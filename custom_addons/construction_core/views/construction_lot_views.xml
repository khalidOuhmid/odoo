<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_construction_lot_tree" model="ir.ui.view">
        <field name="name">construction.lot.tree</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <list string="Lots">
                <field name="chantier_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="subcontractor_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="budget_amount" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_construction_lot" model="ir.actions.act_window">
        <field name="name">Lots / Travaux</field>
        <field name="res_model">construction.lot</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_chantier': 1}</field>
    </record>
    
    <!-- SEARCH VIEW -->
     <record id="view_construction_lot_search" model="ir.ui.view">
        <field name="name">construction.lot.search</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <search string="Search Lots">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="subcontractor_id"/>
                <group expand="0" string="Group By">
                    <filter string="Chantier" name="group_by_chantier" domain="[]" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Sous-Traitant" name="group_by_subcontractor" domain="[]" context="{'group_by': 'subcontractor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_action_lot"
              name="Lots"
              parent="menu_construction_configuration"
              action="action_construction_lot"
              sequence="20"/>
</odoo>
