<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LOT CATEGORY -->
    <record id="view_construction_lot_category_tree" model="ir.ui.view">
        <field name="name">construction.lot.category.tree</field>
        <field name="model">construction.lot.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="urssaf_code"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_construction_lot_category" model="ir.actions.act_window">
        <field name="name">Catégories de Lots</field>
        <field name="res_model">construction.lot.category</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- LOT FORM VIEW - Cockpit Style (SAP/ONAYA Inspired) -->
    <record id="view_construction_lot_form" model="ir.ui.view">
        <field name="name">construction.lot.form</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <form string="Lot de Chantier">
                <header>
                    <!-- Execution Type Badge -->
                    <field name="execution_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="is_finished" widget="boolean_toggle" nolabel="1"/>
                    <span class="badge bg-success ms-2" invisible="is_finished == False">✓ Terminé</span>
                </header>
                <sheet>
                    <!-- Smart Button Box -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="execution_type == 'internal'">
                            <field name="cost_total" widget="statinfo" string="Coût Achats"/>
                        </button>
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    
                    <!-- Ribbon for finished lots -->
                    <widget name="web_ribbon" title="Terminé" bg_color="text-bg-success" 
                            invisible="is_finished == False"/>
                    
                    <!-- Title Section -->
                    <div class="oe_title">
                        <label for="category_id" string="Type de Lot"/>
                        <h1>
                            <field name="category_id" placeholder="Sélectionnez une catégorie (ex: Électricité)" 
                                   options="{'no_create': True, 'no_open': True}"/>
                        </h1>
                        <div class="o_row">
                            <field name="name" invisible="1"/> <!-- Hidden but keeps value -->
                            <span class="badge bg-secondary me-2">
                                <field name="code" placeholder="01" nolabel="1" class="oe_inline"/>
                            </span>
                        </div>
                    </div>
                    
                    <notebook>
                        <!-- TAB 1: OVERVIEW (📊) -->
                        <page string="📊 Vue d'ensemble" name="overview">
                            <group>
                                <!-- Execution Details -->
                                <group string="👷 Exécution" invisible="execution_type == 'internal'">
                                    <field name="subcontractor_id" 
                                           placeholder="Sélectionner un sous-traitant..."
                                           options="{'no_create': True}"/>
                                    <field name="subcontractor_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"
                                           invisible="1"/>
                                    
                                    <!-- Subcontractor Compliance: defined via view inheritance in construction_subcontractor -->
                                </group>
                                <group string="👷 Équipe Interne" invisible="execution_type == 'external'">
                                    <field name="internal_team_user_ids" widget="many2many_tags"
                                           placeholder="Affecter des utilisateurs BLG..."/>
                                </group>
                                
                                <!-- Planning -->
                                <group string="📅 Planning">
                                    <label for="date_start_planned"/>
                                    <div class="o_row">
                                        <field name="date_start_planned" class="oe_inline"/>
                                        <span class="mx-2">→</span>
                                        <field name="date_end_planned" class="oe_inline"/>
                                    </div>
                                    <field name="completion_percentage" widget="progressbar"/>
                                </group>
                            </group>
                            
                            <!-- Financials Section (Read-only Computed) -->
                            <group string="💰 Synthèse Financière">
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="revenue_total" readonly="1" 
                                           widget="monetary"
                                           options="{'currency': 'currency_id'}"/>
                                    <field name="cost_total" readonly="1"
                                           widget="monetary"
                                           options="{'currency': 'currency_id'}"/>
                                </group>
                                <group>
                                    <field name="margin_eur" readonly="1"
                                           widget="monetary"
                                           decoration-success="margin_eur > 0"
                                           decoration-danger="margin_eur &lt; 0"/>
                                    <field name="margin_percent" readonly="1"
                                           widget="percentage"
                                           decoration-success="margin_percent > 20"
                                           decoration-warning="margin_percent > 0 and margin_percent &lt;= 20"
                                           decoration-danger="margin_percent &lt;= 0"/>
                                </group>
                            </group>
                            
                            <!-- Info Box -->
                            <div class="alert alert-info" role="alert" 
                                 invisible="execution_type == 'internal'">
                                <i class="fa fa-info-circle me-2"/>
                                <strong>Coût:</strong> Somme des bons de commande confirmés.
                                <strong class="ms-3">Revenu:</strong> Prix facturé au client (devis).
                            </div>
                        </page>
                        
                        <!-- TAB 2: DOCUMENTS (📂) -->
                        <page string="📂 Documents" name="documents">
                            <group string="Documents Contractuels">
                                <field name="document_cctp" widget="binary" filename="document_cctp_filename"/>
                                <field name="document_planning_chantier" widget="binary" filename="document_planning_chantier_filename"/>
                                <field name="document_planning_sous_traitant" widget="binary" filename="document_planning_sous_traitant_filename"/>
                            </group>
                            <group string="Autres Documents">
                                <field name="document_ids" widget="many2many_binary" 
                                       nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        
                        <!-- TAB 3: NOTES (📝) -->
                        <page string="📝 Notes" name="notes">
                            <group>
                                <field name="description" nolabel="1" colspan="2"
                                       placeholder="Notes et informations complémentaires sur ce lot..."/>
                            </group>
                            <group>
                                <group>
                                    <field name="sequence"/>
                                    <field name="color" widget="color_picker"/>
                                </group>
                                <group>
                                    <field name="price" widget="monetary" string="Prix Lot"/>
                                    <field name="weighted_value" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <!-- LOT LIST VIEW - Enhanced -->
    <record id="view_construction_lot_tree" model="ir.ui.view">
        <field name="name">construction.lot.tree</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <list string="Lots" editable="bottom" 
                  decoration-success="is_finished == True"
                  decoration-muted="is_finished == True">
                <field name="sequence" widget="handle"/>
                <field name="code" string="N°"/>
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="chantier_id"/>
                <field name="price" widget="monetary" sum="Total"/>
                <field name="subcontractor_ids" widget="many2many_tags" 
                       options="{'color_field': 'color'}"/>
                <field name="is_finished" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- LOT KANBAN VIEW -->
    <record id="view_construction_lot_kanban" model="ir.ui.view">
        <field name="name">construction.lot.kanban</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="price"/>
                <field name="is_finished"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{record.is_finished.raw_value ? 'o_kanban_record_muted' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <span class="badge bg-primary me-2"><field name="code"/></span>
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_subtitle text-muted">
                                    <field name="category_id"/>
                                </div>
                                <div class="mt-2">
                                    <span class="fw-bold"><field name="price" widget="monetary"/></span>
                                    <span t-if="record.is_finished.raw_value" class="badge bg-success float-end">
                                        ✓ Terminé
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_construction_lot" model="ir.actions.act_window">
        <field name="name">Lots</field>
        <field name="res_model">construction.lot</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>
