<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LOT CATEGORY -->
    <record id="view_construction_lot_category_tree" model="ir.ui.view">
        <field name="name">construction.lot.category.tree</field>
        <field name="model">construction.lot.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="urssaf_code"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_construction_lot_category" model="ir.actions.act_window">
        <field name="name">Catégories de Lots</field>
        <field name="res_model">construction.lot.category</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- LOT FORM VIEW - Cockpit Style (New Standard) -->
    <record id="view_construction_lot_form" model="ir.ui.view">
        <field name="name">construction.lot.form</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <form string="Lot de Chantier">
                <header>
                    <field name="execution_type" widget="statusbar" options="{'clickable': '1'}"/>
                    <field name="is_finished" widget="boolean_toggle"/>
                    <span class="badge bg-success ms-2" invisible="is_finished == False">✓ Terminé</span>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                         <!-- Stats buttons if needed -->
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="category_id" placeholder="Choisir une catégorie de lot" options="{'no_create': True}"/>
                        </h1>
                        <h3 class="text-muted">
                            <field name="code" readonly="1"/> — <field name="name" readonly="1"/>
                        </h3>
                    </div>

                    <group>
                        <group>
                            <field name="chantier_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB 1: OVERVIEW -->
                        <page string="Vue d'Ensemble" name="overview">
                            <group>
                                <!-- External Mode -->
                                <group string="Sous-Traitant" invisible="execution_type != 'external'">
                                    <field name="subcontractor_id" 
                                           placeholder="Sélectionner un sous-traitant..."
                                           options="{'no_create': True}"/>
                                </group>
                                
                                <!-- Internal Mode -->
                                <group string="Équipe Interne" invisible="execution_type != 'internal'">
                                    <field name="internal_team_user_ids" widget="many2many_tags_avatar"/>
                                </group>
                                
                                <!-- Planning -->
                                <group string="Planning">
                                    <label for="date_start_planned" string="Période"/>
                                    <div class="o_row">
                                        <field name="date_start_planned" class="oe_inline"/>
                                        <span class="mx-2">→</span>
                                        <field name="date_end_planned" class="oe_inline"/>
                                    </div>
                                </group>
                            </group>
                            
                            <separator string="Synthèse Financière"/>
                            <group>
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="price" string="Prix de Vente (Devis)" widget="monetary"/>
                                    <field name="planned_cost" string="Coût Prévu (Produits)" widget="monetary"/>
                                </group>
                                <group>
                                    <field name="planned_margin" widget="monetary"
                                           decoration-success="planned_margin > 0"
                                           decoration-danger="planned_margin &lt; 0"/>
                                </group>
                            </group>
                            
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle me-2"/>
                                <strong>Prix:</strong> Montant du devis validé.
                                <strong class="ms-3">Coût Prévu:</strong> Calculé depuis les produits.
                                <strong class="ms-3">Marge:</strong> Prix - Coût Prévu.
                            </div>
                        </page>
                        
                        <!-- TAB 2: DOCUMENTS & ACTIONS -->
                        <page string="Documents et Actions" name="documents">
                            <group string="Documents Techniques">
                                <group>
                                    <field name="document_cctp" widget="binary" filename="document_cctp_filename"/>
                                    <field name="document_cctp_filename" invisible="1"/>
                                </group>
                                <group>
                                    <field name="document_planning_chantier" widget="binary" filename="document_planning_chantier_filename"/>
                                    <field name="document_planning_chantier_filename" invisible="1"/>
                                </group>
                            </group>
                            
                            <group invisible="execution_type != 'external'">
                                <group>
                                    <field name="document_planning_sous_traitant" widget="binary" filename="document_planning_sous_traitant_filename"/>
                                    <field name="document_planning_sous_traitant_filename" invisible="1"/>
                                </group>
                            </group>
                            
                            <separator/>
                            
                            <!-- ACTIONS PANEL (External Only) -->
                            <group string="Bon de Commande" invisible="execution_type != 'external'">
                                <group>
                                    <button name="action_generate_po_safe"
                                            string="Générer le Bon de Commande"
                                            type="object"
                                            class="btn-primary"
                                            icon="fa-shopping-cart"
                                            invisible="purchase_order_id"
                                            confirm="Générer un bon de commande pour ce lot ?"/>
                                    <field name="purchase_order_id" readonly="1"
                                           invisible="not purchase_order_id"
                                           widget="many2one_button"/>
                                    <field name="po_state" invisible="not purchase_order_id" readonly="1"
                                           widget="badge"
                                           decoration-info="po_state == 'draft'"
                                           decoration-warning="po_state == 'sent'"
                                           decoration-success="po_state in ('purchase', 'done')"/>
                                    <field name="po_amount_total" invisible="not purchase_order_id" readonly="1"
                                           widget="monetary"/>
                                </group>
                            </group>

                            <separator/>

                            <!-- TASK-014: Additional Document Creation (always visible) -->
                            <group string="Créer des documents supplémentaires">
                                <div class="alert alert-light mb-2" role="alert" style="font-size: 12px;">
                                    <i class="fa fa-plus-circle me-1"/>
                                    Créer des devis, BC ou contrats additionnels en cours de chantier.
                                </div>
                                <group>
                                    <button name="action_create_additional_quote" 
                                            string="Nouveau Devis"
                                            type="object" 
                                            class="btn-outline-primary me-2"
                                            icon="fa-file-text"/>
                                    <button name="action_create_additional_po" 
                                            string="Nouveau BC"
                                            type="object" 
                                            class="btn-outline-warning me-2"
                                            icon="fa-shopping-cart"
                                            invisible="execution_type != 'external'"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- TAB 3: NOTES -->
                        <page string="Notes" name="notes">
                            <field name="description" placeholder="Notes et commentaires..." widget="html"/>
                        </page>
                        
                        <!-- TAB 4: AVANCEMENT -->
                        <page string="Avancement" name="progress">
                             <div class="alert alert-warning mb-3" role="alert">
                                <i class="fa fa-exclamation-triangle me-2"/>
                                <strong>Important:</strong> Le pourcentage affecte la valeur réalisée.
                            </div>
                            <group>
                                <group>
                                    <field name="is_finished" invisible="1"/>
                                    <field name="completion_percentage" widget="lot_progress"
                                           nolabel="1"/>
                                </group>
                                <group>
                                    <button name="action_mark_complete"
                                            string="Terminer (100%)"
                                            type="object"
                                            class="btn-success"
                                            icon="fa-check"
                                            invisible="is_finished"/>
                                </group>
                            </group>
                            <group>
                                <group string="Valeurs">
                                    <field name="weighted_value" readonly="1" string="Valeur Réalisée"/>
                                    <field name="remaining_value" readonly="1"/>
                                </group>
                                <group string="Référence">
                                    <field name="price" readonly="1" string="Prix Total"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>



    <!-- LOT LIST VIEW - Enhanced -->
    <record id="view_construction_lot_tree" model="ir.ui.view">
        <field name="name">construction.lot.tree</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <list string="Lots" editable="bottom" 
                  decoration-success="is_finished == True"
                  decoration-muted="is_finished == True">
                <field name="sequence" widget="handle"/>
                <field name="category_id" string="Catégorie" options="{'no_create': True}"/>
                <field name="code" string="Code" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="chantier_id"/>
                <field name="price" widget="monetary" sum="Total"/>
                <field name="subcontractor_ids" widget="many2many_tags" 
                       options="{'color_field': 'color'}"/>
                <field name="is_finished" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- LOT KANBAN VIEW -->
    <record id="view_construction_lot_kanban" model="ir.ui.view">
        <field name="name">construction.lot.kanban</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="price"/>
                <field name="is_finished"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{record.is_finished.raw_value ? 'o_kanban_record_muted' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <span class="badge bg-primary me-2"><field name="code"/></span>
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_subtitle text-muted">
                                    <field name="category_id"/>
                                </div>
                                <div class="mt-2">
                                    <span class="fw-bold"><field name="price" widget="monetary"/></span>
                                    <span t-if="record.is_finished.raw_value" class="badge bg-success float-end">
                                        ✓ Terminé
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_construction_lot" model="ir.actions.act_window">
        <field name="name">Lots</field>
        <field name="res_model">construction.lot</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>
