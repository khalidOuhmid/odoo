<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ========================================= -->
        <!-- SECURITY GROUPS - Role-Based Access      -->
        <!-- ========================================= -->

        <!-- 1. DIRECTEUR - All Rights -->
        <record id="group_construction_director" model="res.groups">
            <field name="name">Construction / Directeur</field>
            <field name="category_id" ref="base.module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Directeurs: Accès complet + Forcer les étapes</field>
        </record>

        <!-- 2. ADMIN - Same as Director -->
        <record id="group_construction_admin" model="res.groups">
            <field name="name">Construction / Administrateur</field>
            <field name="category_id" ref="base.module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('group_construction_director'))]"/>
            <field name="comment">Administrateurs: Mêmes droits que Directeur</field>
        </record>

        <!-- 3. PILOTE CHANTIER - All except Force Stage -->
        <record id="group_construction_manager" model="res.groups">
            <field name="name">Construction / Pilote Chantier</field>
            <field name="category_id" ref="base.module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Pilotes: Gestion complète sans forcer les étapes</field>
        </record>

        <!-- 4. COMPTABILITÉ - Finance Access Only -->
        <record id="group_construction_accountant" model="res.groups">
            <field name="name">Construction / Comptabilité</field>
            <field name="category_id" ref="base.module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Compta: Accès finances, factures, contrats sous-traitance</field>
        </record>

    </data>
</odoo>
