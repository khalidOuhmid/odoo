                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Assurance -->
                        <div class="col-lg-6 col-md-12 mb-4">
                            <div class="card shadow-sm h-100 o_document_card">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <span class="card-title fw-bold mb-0 d-flex align-items-center">
