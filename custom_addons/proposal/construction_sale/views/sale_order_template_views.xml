<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_template_view_form_construction" model="ir.ui.view">
        <field name="name">sale.order.template.form.construction</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_template_line_ids']/list/field[@name='name']" position="after">
                <field name="construction_lot_name" optional="show"/>
                <field name="dimension_length" optional="hide"/>
                <field name="dimension_width" optional="hide"/>
                <field name="is_dimensional" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
