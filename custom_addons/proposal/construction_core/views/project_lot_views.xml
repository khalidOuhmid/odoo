<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_construction_lot_search" model="ir.ui.view">
        <field name="name">construction.lot.search</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <search string="Recherche Lot">
                <field name="name"/>
                <field name="code"/>
                <field name="chantier_id"/>
                <filter string="Non démarrés" name="draft_lots" domain="[('state', 'in', ['draft', 'defined'])]"/>
                <filter string="En cours" name="open_lots" domain="[('state', '=', 'in_progress')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Chantier" name="group_by_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Statut" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_construction_lot_form" model="ir.ui.view">
        <field name="name">construction.lot.form</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <form string="Lot de Travaux">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" class="oe_inline" placeholder="Code"/> - 
                            <field name="name" class="oe_inline" placeholder="Intitulé du lot"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chantier_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <label for="budget_amount" string="Budget Alloué"/>
                            <div class="o_row">
                                <field name="budget_amount" widget="monetary"/>
                            </div>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Suivi Financier" name="finance">
                             <group col="4">
                                <field name="committed_amount" widget="monetary"/>
                                <field name="realized_amount" widget="monetary"/>
                                <field name="gross_margin" widget="monetary"/>
                                <field name="margin_rate" widget="percentage"/>
                             </group>
                        </page>
                        <page string="Notes" name="notes">
                            <!-- Use Odoo 18 placeholder for html field or standard text -->
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_construction_lot_list" model="ir.ui.view">
        <field name="name">construction.lot.list</field>
        <field name="model">construction.lot</field>
        <field name="arch" type="xml">
            <list string="Lots de Travaux" decoration-success="state == 'done'" decoration-muted="state == 'draft'">
                <field name="code"/>
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="budget_amount" sum="Total Budget" widget="monetary"/>
                <field name="committed_amount" sum="Total Engagé" widget="monetary"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>
