<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- CONSTRUCTION CATEGORY -->
        <record model="ir.module.category" id="module_category_construction">
            <field name="name">Construction</field>
            <field name="description">Gestion des Chantiers et BTP</field>
            <field name="sequence">10</field>
        </record>

        <!-- GROUP: PILOTE / USER -->
        <record id="group_construction_user" model="res.groups">
            <field name="name">Pilote de Chantier</field>
            <field name="category_id" ref="module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Peut gérer les chantiers, lots, devis et planning. Ne peut PAS forcer les états.</field>
        </record>

        <!-- GROUP: DIRECTEUR / MANAGER -->
        <record id="group_construction_manager" model="res.groups">
            <field name="name">Directeur / Admin</field>
            <field name="category_id" ref="module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
            <field name="comment">Accès complet, peut forcer les changements d'états.</field>
        </record>
        
        <!-- GROUP: AUDITEUR / COMPTABLE (Non-Hierarchical usually, or separate category) -->
        <!-- User asked for Accountant to see panels but not send invoices. 
             Ideally linked to standard Accounting groups? 
             Let's create a specific group for "Construction Finance View" -->
        <record id="group_construction_auditor" model="res.groups">
            <field name="name">Comptable BTP</field>
            <field name="category_id" ref="module_category_construction"/>
            <field name="comment">Accès au suivi financier et factures. Pas de modification technique chantier.</field>
        </record>

    </data>
</odoo>
