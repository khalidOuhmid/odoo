<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ACTION -->
    <record id="action_construction_visit" model="ir.actions.act_window">
        <field name="name">Visites de Chantier</field>
        <field name="res_model">construction.visit</field>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Planifiez votre première visite !
            </p>
        </field>
    </record>

    <!-- MENUS -->
    <!-- Assuming menu_construction_root exists in construction_core -->
    <menuitem id="menu_construction_visit_root" 
              name="Visites" 
              parent="construction_core.menu_construction_root"
              sequence="30"/>

    <menuitem id="menu_construction_visit_action"
              name="Toutes les visites"
              parent="menu_construction_visit_root"
              action="action_construction_visit"
              sequence="10"/>

</odoo>
