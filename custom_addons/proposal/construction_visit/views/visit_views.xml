<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH -->
    <record id="view_construction_visit_search" model="ir.ui.view">
        <field name="name">construction.visit.search</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <search string="Recherche Visites">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="user_ids"/>
                <filter string="Mes Visites" name="my_visits" domain="[('user_ids', 'in', uid)]"/>
                <filter string="Aujourd'hui" name="today" domain="[('date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <group expand="0" string="Group By">
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'visit_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- KANBAN (Mobile First) -->
    <record id="view_construction_visit_kanban" model="ir.ui.view">
        <field name="name">construction.visit.kanban</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="date"/>
                <field name="visit_type"/>
                <field name="state"/>
                <field name="user_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="chantier_id"/>
                                    </small>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">Modifier</a>
                                        <a role="menuitem" type="delete" class="dropdown-item">Supprimer</a>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-clock-o me-1" title="Date"/>
                                    <field name="date" widget="datetime"/>
                                </div>
                                <div class="mt-1">
                                    <span t-attf-class="badge #{record.visit_type.raw_value == 'final' ? 'bg-danger' : 'bg-info'}">
                                        <field name="visit_type"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_construction_visit_form" model="ir.ui.view">
        <field name="name">construction.visit.form</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <form string="Visite de Chantier">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="Démarrer" type="object" class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_complete" string="Terminer" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state in ['completed', 'cancelled']"/>
                    <button name="action_reset_draft" string="Remettre en brouillon" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Titre de la visite"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chantier_id"/>
                            <field name="visit_type"/>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="duration" widget="float_time"/>
                            <field name="partner_ids" widget="many2many_tags" placeholder="Clients ou Sous-traitants présents"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Observations" name="notes">
                            <field name="notes" placeholder="Prendre des notes ici..."/>
                        </page>
                        <page string="Compte-rendu" name="report">
                            <field name="report" placeholder="Synthèse pour le rapport PDF..."/>
                        </page>
                    </notebook>
                </sheet>
                <!-- NEW CHATTER SYNTAX -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- CALENDAR -->
    <record id="view_construction_visit_calendar" model="ir.ui.view">
        <field name="name">construction.visit.calendar</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <calendar string="Visites" date_start="date" color="state" mode="month" quick_create="0">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="state" filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_construction_visit_list" model="ir.ui.view">
        <field name="name">construction.visit.list</field>
        <field name="model">construction.visit</field>
        <field name="arch" type="xml">
            <list string="Visites" decoration-info="state == 'planned'" decoration-muted="state == 'completed'">
                <field name="date"/>
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="visit_type"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-warning="state == 'in_progress'"/>
            </list>
        </field>
    </record>
</odoo>
