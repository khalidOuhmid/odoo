<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ACTION TO OPEN CONTRACTS FROM PARTNER -->
    <record id="action_construction_contract_partner" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">construction.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_id', '=', active_id)]</field>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>

    <!-- PARTNER VIEW EXTENSION -->
    <record id="view_partner_form_subcontractor" model="ir.ui.view">
        <field name="name">res.partner.form.subcontractor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                 <button class="oe_stat_button" type="action" 
                        name="%(construction_subcontractor.action_construction_contract_partner)d" 
                        icon="fa-pencil-square-o"
                        invisible="not is_subcontractor">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Contracts</span>
                    </div>
                </button>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Subcontractor" name="subcontractor_tab" invisible="not is_subcontractor">
                    <group>
                        <group string="Status">
                            <field name="is_subcontractor"/>
                            <field name="compliance_state" widget="badge" 
                                   decoration-success="compliance_state == 'compliant'"
                                   decoration-warning="compliance_state == 'incomplete'"
                                   decoration-danger="compliance_state == 'expired'"/>
                        </group>
                    </group>
                    
                    <separator string="Compliance Documents"/>
                    <field name="compliance_document_ids" context="{'default_document_type': 'other'}">
                        <list editable="bottom" decoration-danger="state == 'expired'">
                            <field name="document_type"/>
                            <field name="name"/>
                            <field name="expiry_date"/>
                            <field name="state" widget="badge" decoration-success="state == 'valid'"/>
                            <field name="file_data" filename="filename" widget="binary_min"/>
                            <field name="filename" column_invisible="1"/>
                            <button name="action_validate_manually" type="object" icon="fa-check" title="Validate" invisible="state == 'valid'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
