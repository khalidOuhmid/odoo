<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- =============== CYCLES DE FACTURATION =============== -->

        <!-- Cycle Little Worker : 30% 60% 90% 100% -->
        <record id="invoice_type_little_worker" model="construction.invoice.type">
            <field name="name">Little Worker</field>
            <field name="code">LITTLE_WORKER</field>
            <!-- <field name="description">Cycle de facturation pour les petits chantiers : 30%, 60%, 90%, 100%</field> -->
            <field name="sequence">10</field>
        </record>

        <record id="invoice_type_little_worker_line_30" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_little_worker"/>
            <field name="name">1ère facture - Démarrage</field>
            <field name="sequence">10</field>
            <field name="trigger_percentage">30</field>
            <field name="bill_percentage">30</field>
            <field name="is_advance">False</field>
            <!-- <field name="notes">Facture émise à 30% d'avancement des travaux</field> -->
        </record>

        <record id="invoice_type_little_worker_line_60" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_little_worker"/>
            <field name="name">2ème facture - Mi-parcours</field>
            <field name="sequence">20</field>
            <field name="trigger_percentage">60</field>
            <field name="bill_percentage">30</field>
            <field name="is_advance">False</field>
        </record>

        <record id="invoice_type_little_worker_line_90" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_little_worker"/>
            <field name="name">3ème facture - Quasi-finition</field>
            <field name="sequence">30</field>
            <field name="trigger_percentage">90</field>
            <field name="bill_percentage">30</field>
            <field name="is_advance">False</field>
        </record>

        <record id="invoice_type_little_worker_line_100" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_little_worker"/>
            <field name="name">Facture finale - Livraison</field>
            <field name="sequence">40</field>
            <field name="trigger_percentage">100</field>
            <field name="bill_percentage">10</field>
            <field name="is_advance">False</field>
        </record>

        <!-- Cycle Coloc : 40% signature, 60% 80% 90% 100% -->
        <record id="invoice_type_coloc" model="construction.invoice.type">
            <field name="name">Coloc</field>
            <field name="code">COLOC</field>
            <field name="sequence">20</field>
        </record>

        <record id="invoice_type_coloc_line_signature" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_coloc"/>
            <field name="name">Acompte de signature</field>
            <field name="sequence">10</field>
            <field name="trigger_percentage">0</field>
            <field name="bill_percentage">40</field>
            <field name="is_advance">True</field>
        </record>

        <record id="invoice_type_coloc_line_60" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_coloc"/>
            <field name="name">1ère facture d'avancement</field>
            <field name="sequence">20</field>
            <field name="trigger_percentage">60</field>
            <field name="bill_percentage">20</field>
            <field name="is_advance">False</field>
        </record>

        <record id="invoice_type_coloc_line_80" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_coloc"/>
            <field name="name">2ème facture d'avancement</field>
            <field name="sequence">30</field>
            <field name="trigger_percentage">80</field>
            <field name="bill_percentage">20</field>
            <field name="is_advance">False</field>
        </record>

        <record id="invoice_type_coloc_line_90" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_coloc"/>
            <field name="name">3ème facture d'avancement</field>
            <field name="sequence">40</field>
            <field name="trigger_percentage">90</field>
            <field name="bill_percentage">10</field>
            <field name="is_advance">False</field>
        </record>

        <record id="invoice_type_coloc_line_100" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_coloc"/>
            <field name="name">Facture finale</field>
            <field name="sequence">50</field>
            <field name="trigger_percentage">100</field>
            <field name="bill_percentage">10</field>
            <field name="is_advance">False</field>
        </record>

        <!-- Cycle Classique : 30% signature, 60%, 90% 100% -->
        <record id="invoice_type_classique" model="construction.invoice.type">
            <field name="name">Classique (Standard)</field>
            <field name="code">CLASSIQUE</field>
            <field name="sequence">30</field>
        </record>

        <record id="invoice_type_classique_line_signature" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_classique"/>
            <field name="name">Acompte de signature</field>
            <field name="sequence">10</field>
            <field name="trigger_percentage">0</field>
            <field name="bill_percentage">30</field>
            <field name="is_advance">True</field>
        </record>

        <record id="invoice_type_classique_line_60" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_classique"/>
            <field name="name">1ère facture d'avancement</field>
            <field name="sequence">20</field>
            <field name="trigger_percentage">60</field>
            <field name="bill_percentage">30</field>
            <field name="is_advance">False</field>
        </record>

        <record id="invoice_type_classique_line_90" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_classique"/>
            <field name="name">2ème facture d'avancement</field>
            <field name="sequence">30</field>
            <field name="trigger_percentage">90</field>
            <field name="bill_percentage">30</field>
            <field name="is_advance">False</field>
        </record>

        <record id="invoice_type_classique_line_100" model="construction.invoice.type.line">
            <field name="type_id" ref="invoice_type_classique"/>
            <field name="name">Facture finale</field>
            <field name="sequence">40</field>
            <field name="trigger_percentage">100</field>
            <field name="bill_percentage">10</field>
            <field name="is_advance">False</field>
        </record>

    </data>
</odoo>
