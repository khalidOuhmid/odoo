<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_documents" model="ir.module.category">
            <field name="name">Documents Sous-traitants</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_conductrice_travaux" model="res.groups">
            <field name="name">Conductrice Travaux</field>
            <field name="category_id" ref="module_category_documents"/>
        </record>

        <record id="group_directeur_general" model="res.groups">
            <field name="name">Directeur Général</field>
            <field name="category_id" ref="module_category_documents"/>
            <field name="implied_ids" eval="[(4, ref('group_conductrice_travaux'))]"/>
        </record>

        <!-- Règles de sécurité pour les documents -->
        <record id="document_access_rule" model="ir.rule">
            <field name="name">Access to Sous-traitant Documents</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('is_subcontractor', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_conductrice_travaux'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
