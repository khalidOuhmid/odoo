<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW SCHEDULE -->
    <record id="view_construction_invoice_schedule_list" model="ir.ui.view">
        <field name="name">construction.invoice.schedule.list</field>
        <field name="model">construction.invoice.schedule</field>
        <field name="arch" type="xml">
            <list string="Billing Schedule" decoration-muted="state == 'invoiced'" decoration-bf="state == 'ready'">
                <field name="chantier_id"/>
                <field name="name"/>
                <field name="trigger_percentage" widget="progressbar"/>
                <field name="amount_to_bill"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'invoiced'" decoration-danger="state == 'ready'"/>
                <button name="action_create_invoice" type="object" string="Create Invoice" icon="fa-file-text-o" invisible="state != 'ready'"/>
            </list>
        </field>
    </record>
    
    <!-- SEARCH VIEW -->
    <record id="view_construction_invoice_schedule_search" model="ir.ui.view">
        <field name="name">construction.invoice.schedule.search</field>
        <field name="model">construction.invoice.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="chantier_id"/>
                <field name="state"/>
                <filter string="Ready to Bill" name="ready" domain="[('state', '=', 'ready')]"/>
                <group expand="0" string="Group By">
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_invoice_schedule" model="ir.actions.act_window">
        <field name="name">Billing Schedules</field>
        <field name="res_model">construction.invoice.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_ready': 1}</field>
    </record>

    <menuitem id="menu_construction_billing"
              name="Billing"
              parent="construction_core.menu_construction_root"
              sequence="30"/>

    <menuitem id="menu_invoice_schedule"
              name="Schedules to Bill"
              parent="menu_construction_billing"
              action="action_invoice_schedule"
              sequence="10"/>
</odoo>
