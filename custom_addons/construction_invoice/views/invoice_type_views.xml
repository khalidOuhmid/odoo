<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice Type List -->
    <record id="view_invoice_type_list" model="ir.ui.view">
        <field name="name">construction.invoice_type.list</field>
        <field name="model">construction.invoice_type</field>
        <field name="arch" type="xml">
            <list string="Cycles de facturation">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="line_count"/>
                <field name="total_percentage" widget="progressbar"/>
            </list>
        </field>
    </record>

    <!-- Invoice Type Form -->
    <record id="view_invoice_type_form" model="ir.ui.view">
        <field name="name">construction.invoice_type.form</field>
        <field name="model">construction.invoice_type</field>
        <field name="arch" type="xml">
            <form string="Cycle de facturation">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="total_percentage" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description du cycle..."/>
                    
                    <notebook>
                        <page string="Étapes de facturation" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="trigger_percentage"/>
                                    <field name="percentage"/>
                                    <field name="is_advance_payment"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_invoice_type" model="ir.actions.act_window">
        <field name="name">Cycles de facturation</field>
        <field name="res_model">construction.invoice_type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
