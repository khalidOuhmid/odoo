<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Default 30/30/40 billing cycle template -->
    <record id="billing_template_30_30_40" model="construction.billing.cycle.template">
        <field name="name">Modèle standard 30/30/40</field>
        <field name="sequence">10</field>
    </record>

    <record id="billing_template_step_1" model="construction.billing.step.template">
        <field name="template_id" ref="billing_template_30_30_40"/>
        <field name="name">Acompte à la signature</field>
        <field name="percentage">30.0</field>
        <field name="sequence">10</field>
    </record>

    <record id="billing_template_step_2" model="construction.billing.step.template">
        <field name="template_id" ref="billing_template_30_30_40"/>
        <field name="name">Avancement mi-chantier</field>
        <field name="percentage">30.0</field>
        <field name="sequence">20</field>
    </record>

    <record id="billing_template_step_3" model="construction.billing.step.template">
        <field name="template_id" ref="billing_template_30_30_40"/>
        <field name="name">Solde à la réception</field>
        <field name="percentage">40.0</field>
        <field name="sequence">30</field>
    </record>

</odoo>
