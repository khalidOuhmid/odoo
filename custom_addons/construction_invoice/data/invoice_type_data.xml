<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Standard Billing Cycle: 30/30/40 -->
        <record id="invoice_type_30_30_40" model="construction.invoice_type">
            <field name="name">Standard 30/30/40</field>
            <field name="code">30-30-40</field>
            <field name="description">Acompte 30%, 30% à mi-travaux, solde 40% à réception</field>
            <field name="sequence">10</field>
        </record>
        
        <record id="invoice_type_line_30_sign" model="construction.invoice_type.line">
            <field name="invoice_type_id" ref="invoice_type_30_30_40"/>
            <field name="name">Acompte signature</field>
            <field name="sequence">10</field>
            <field name="trigger_percentage">0</field>
            <field name="percentage">30</field>
            <field name="is_advance_payment">True</field>
        </record>
        
        <record id="invoice_type_line_30_mid" model="construction.invoice_type.line">
            <field name="invoice_type_id" ref="invoice_type_30_30_40"/>
            <field name="name">Situation 50%</field>
            <field name="sequence">20</field>
            <field name="trigger_percentage">50</field>
            <field name="percentage">30</field>
        </record>
        
        <record id="invoice_type_line_40_final" model="construction.invoice_type.line">
            <field name="invoice_type_id" ref="invoice_type_30_30_40"/>
            <field name="name">Solde réception</field>
            <field name="sequence">30</field>
            <field name="trigger_percentage">100</field>
            <field name="percentage">40</field>
        </record>
        
        <!-- Progress Billing: 25 quartiles -->
        <record id="invoice_type_quartiles" model="construction.invoice_type">
            <field name="name">Quartiles 25%</field>
            <field name="code">QUART</field>
            <field name="description">Facturation par tranches de 25%</field>
            <field name="sequence">20</field>
        </record>
        
        <record id="invoice_type_line_q1" model="construction.invoice_type.line">
            <field name="invoice_type_id" ref="invoice_type_quartiles"/>
            <field name="name">Situation 25%</field>
            <field name="sequence">10</field>
            <field name="trigger_percentage">25</field>
            <field name="percentage">25</field>
        </record>
        
        <record id="invoice_type_line_q2" model="construction.invoice_type.line">
            <field name="invoice_type_id" ref="invoice_type_quartiles"/>
            <field name="name">Situation 50%</field>
            <field name="sequence">20</field>
            <field name="trigger_percentage">50</field>
            <field name="percentage">25</field>
        </record>
        
        <record id="invoice_type_line_q3" model="construction.invoice_type.line">
            <field name="invoice_type_id" ref="invoice_type_quartiles"/>
            <field name="name">Situation 75%</field>
            <field name="sequence">30</field>
            <field name="trigger_percentage">75</field>
            <field name="percentage">25</field>
        </record>
        
        <record id="invoice_type_line_q4" model="construction.invoice_type.line">
            <field name="invoice_type_id" ref="invoice_type_quartiles"/>
            <field name="name">Solde final</field>
            <field name="sequence">40</field>
            <field name="trigger_percentage">100</field>
            <field name="percentage">25</field>
        </record>

    </data>
</odoo>
