<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_schedule_wizard_form" model="ir.ui.view">
        <field name="name">construction.invoice.schedule.wizard.form</field>
        <field name="model">construction.invoice.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer Planning Facturation">
                <group>
                    <field name="chantier_id" invisible="1"/>
                    <field name="invoice_type_id"/>
                </group>
                <group string="Base de Calcul (Optionnel)">
                     <field name="quote_id" domain="[('chantier_id', '=', chantier_id), ('state', 'in', ['sale', 'done'])]"/>
                     <field name="lot_ids" widget="many2many_tags" domain="[('chantier_id', '=', chantier_id)]"/>
                     <field name="margin_percentage"/>
                     <div class="text-muted" colspan="2">
                        Si aucun devis n'est sélectionné, le calcul se basera sur le coût total estimé du chantier.
                     </div>
                </group>
                <footer>
                    <button name="action_generate_schedule" string="Générer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_invoice_schedule_wizard" model="ir.actions.act_window">
        <field name="name">Générer Planning</field>
        <field name="res_model">construction.invoice.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
