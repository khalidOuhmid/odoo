<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_progress_billing_tree" model="ir.ui.view">
        <field name="name">construction.progress.billing.tree</field>
        <field name="model">construction.progress.billing</field>
        <field name="arch" type="xml">
            <list string="Situations de Travaux" decoration-info="state=='draft'" decoration-muted="state=='cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="chantier_id"/>
                <field name="partner_id"/>
                <field name="current_progress" widget="progressbar"/>
                <field name="amount_this_bill"/>
                <field name="net_to_pay"/>
                <field name="state" widget="badge" decoration-success="state=='invoiced'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_progress_billing_form" model="ir.ui.view">
        <field name="name">construction.progress.billing.form</field>
        <field name="model">construction.progress.billing</field>
        <field name="arch" type="xml">
            <form string="Situation de Travaux">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_invoice" string="Créer Facture" type="object" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="chantier_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="invoice_id" invisible="not invoice_id"/>
                        </group>
                    </group>
                    <group string="Calcul de la Situation">
                        <group>
                             <field name="total_market_amount"/>
                             <field name="previous_progress"/>
                             <field name="current_progress"/>
                        </group>
                        <group>
                             <field name="amount_cumulative"/>
                             <field name="amount_previous"/>
                             <field name="amount_this_bill" class="oe_subtotal_footer_separator"/>
                             <field name="apply_retention"/>
                             <field name="retention_amount" invisible="not apply_retention"/>
                             <field name="net_to_pay" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_construction_progress_billing" model="ir.actions.act_window">
        <field name="name">Situations de Travaux</field>
        <field name="res_model">construction.progress.billing</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_progress_billing"
              name="Situations Client"
              parent="menu_finance_root"
              action="action_construction_progress_billing"
              sequence="10"/>
</odoo>
