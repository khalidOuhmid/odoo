<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_invoice_schedule_tree" model="ir.ui.view">
        <field name="name">construction.invoice.schedule.tree</field>
        <field name="model">construction.invoice.schedule</field>
        <field name="arch" type="xml">
            <list string="Echéancier" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="chantier_id" invisible="context.get('default_chantier_id')"/>
                <field name="name"/>
                <field name="percentage"/>
                <field name="amount_to_invoice"/>
                <field name="date_planned"/>
                <field name="state" widget="badge"/>
                <field name="invoice_id" widget="many2one_clickable"/>
            </list>
        </field>
    </record>

    <record id="action_construction_invoice_schedule" model="ir.actions.act_window">
        <field name="name">Echéanciers</field>
        <field name="res_model">construction.invoice.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_invoice_schedule"
              name="Echéanciers"
              parent="menu_finance_root"
              action="action_construction_invoice_schedule"
              sequence="30"/>
</odoo>
