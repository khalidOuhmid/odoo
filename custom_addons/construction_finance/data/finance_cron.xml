<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron : Détection quotidienne des alertes financières -->
        <record id="ir_cron_finance_alert_detection" model="ir.cron">
            <field name="name">Finance : Détection des alertes chantiers</field>
            <field name="model_id" ref="model_construction_finance_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_detect_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">100</field>
        </record>

        <!-- Valeurs par défaut des seuils d'alerte -->
        <record id="finance_param_margin_threshold" model="ir.config_parameter">
            <field name="key">finance.alert.margin_threshold</field>
            <field name="value">15.0</field>
        </record>
        <record id="finance_param_late_invoice_days" model="ir.config_parameter">
            <field name="key">finance.alert.late_invoice_days</field>
            <field name="value">60</field>
        </record>
        <record id="finance_param_no_invoice_days" model="ir.config_parameter">
            <field name="key">finance.alert.no_invoice_days</field>
            <field name="value">30</field>
        </record>
        <record id="finance_param_budget_overrun" model="ir.config_parameter">
            <field name="key">finance.alert.budget_overrun_pct</field>
            <field name="value">10.0</field>
        </record>
        <record id="finance_param_dependency_threshold" model="ir.config_parameter">
            <field name="key">finance.alert.dependency_threshold</field>
            <field name="value">40.0</field>
        </record>

    </data>
</odoo>
