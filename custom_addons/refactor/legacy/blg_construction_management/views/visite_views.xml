<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire pour les visites -->
    <record id="view_blg_visite_form" model="ir.ui.view">
        <field name="name">blg.visite.form</field>
        <field name="model">blg.visite</field>
        <field name="arch" type="xml">
            <form string="Visite technique">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" 
                            class="btn-primary" invisible="state not in ['draft', 'planned']"/>
                    <button name="action_start" string="Commencer" type="object" 
                            class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_complete" string="Terminer" type="object" 
                            class="btn-info" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Annuler" type="object" 
                            class="btn-secondary" invisible="state in ['completed', 'cancelled']"/>
                    <button name="action_reset_to_planned" string="Remettre en planification" type="object" 
                            class="btn-warning" invisible="state not in ['cancelled', 'completed']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Objet de la visite"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="chantier_id" required="1"/>
                            <field name="date" required="1"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="visit_type"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description de la visite..."/>
                        </page>
                        <page string="Rapport">
                            <field name="report" placeholder="Rapport de visite..."/>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes et observations..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue liste pour les visites -->
    <record id="view_blg_visite_tree" model="ir.ui.view">
        <field name="name">blg.visite.tree</field>
        <field name="model">blg.visite</field>
        <field name="arch" type="xml">
            <list string="Visites" decoration-info="state == 'draft'" 
                  decoration-warning="state == 'planned'" 
                  decoration-success="state == 'completed'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="date"/>
                <field name="visit_type"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Vue calendrier pour les visites -->
    <record id="view_blg_visite_calendar" model="ir.ui.view">
        <field name="name">blg.visite.calendar</field>
        <field name="model">blg.visite</field>
        <field name="arch" type="xml">
            <calendar string="Planning des visites" date_start="date" color="chantier_id" mode="month">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="state"/>
                <field name="user_ids"/>
            </calendar>
        </field>
    </record>

    <!-- Vue recherche pour les visites -->
    <record id="view_blg_visite_search" model="ir.ui.view">
        <field name="name">blg.visite.search</field>
        <field name="model">blg.visite</field>
        <field name="arch" type="xml">
            <search string="Rechercher visites">
                <field name="name"/>
                <field name="chantier_id"/>
                <field name="user_ids"/>
                <separator/>
                <filter string="Mes visites" name="my_visits" domain="[('user_ids', 'in', uid)]"/>
                <filter string="Aujourd'hui" name="today" domain="[('date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="Cette semaine" name="this_week" domain="[('date', '>=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Brouillons" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Planifiées" name="planned" domain="[('state', '=', 'planned')]"/>
                <filter string="Confirmées" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="En cours" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Terminées" name="completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Chantier" name="group_by_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Statut" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'visit_type'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action pour les visites -->
    <record id="action_blg_visite" model="ir.actions.act_window">
        <field name="name">Visites techniques</field>
        <field name="res_model">blg.visite</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_blg_visite_search"/>
        <field name="context">{
            'search_default_my_visits': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Programmer une nouvelle visite technique
            </p>
            <p>
                Planifiez et suivez vos visites techniques sur les chantiers.
            </p>
        </field>
    </record>
</odoo>
