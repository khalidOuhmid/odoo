<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_devis_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page">
                <div class="oe_structure"/>

                <h2>
                    <span t-field="doc.name"/>
                </h2>

                <div class="row mt-4 mb-4">
                    <div class="col-6">
                        <strong>Client:</strong>
                        <p t-field="doc.partner_id"/>
                        <t t-if="doc.blg_chantier_id">
                            <strong>Projet:</strong>
                            <p t-field="doc.blg_chantier_id.name"/>
                            <strong>Adresse du chantier:</strong>
                            <p t-field="doc.blg_chantier_id.address"/>
                        </t>
                    </div>
                    <div class="col-6">
                        <strong>Date:</strong>
                        <p t-field="doc.date_order"/>
                        <strong>Référence:</strong>
                        <p t-field="doc.name"/>
                        <strong>Validité:</strong>
                        <p t-field="doc.validity_date"/>
                    </div>
                </div>

                <!-- Section des lots de travaux -->
                <t t-if="doc.blg_chantier_id">
                    <h3>Lots de travaux concernés</h3>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Sous-traitant</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.blg_chantier_id.get_lots_with_sent_quotes()" t-as="lot">
                                <td><span t-field="lot.lot_type_id.name"/></td>
                                <td><span t-field="lot.subcontractor_id.name"/></td>
                                <td><span t-field="lot.notes"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <!-- Lignes du devis -->
                <table class="table table-sm o_main_table mt-4">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Quantité</th>
                            <th class="text-end">Prix unitaire</th>
                            <th class="text-end">Sous-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line" t-as="line">
                            <tr>
                                <td><span t-field="line.name"/></td>
                                <td class="text-end">
                                    <span t-field="line.product_uom_qty"/>
                                    <span t-field="line.product_uom"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-4">
                        <table class="table table-sm">
                            <tr class="border-black">
                                <td><strong>Total HT</strong></td>
                                <td class="text-end">
                                    <span t-field="doc.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>TVA</td>
                                <td class="text-end">
                                    <span t-field="doc.amount_tax" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                            <tr class="border-black o_total">
                                <td><strong>Total TTC</strong></td>
                                <td class="text-end">
                                    <span t-field="doc.amount_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_devis">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="blg_construction_management.report_devis_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_devis" model="ir.actions.report">
        <field name="name">Devis Chantier</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">blg_construction_management.report_devis</field>
        <field name="report_file">blg_construction_management.report_devis</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
