<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_construction" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.construction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="chantier_id"/>
                <field name="lot_id" invisible="not chantier_id"/>
            </field>
            <xpath expr="//div[@class='oe_title']" position="before">
                <div class="alert alert-info" invisible="not sale_order_id" role="alert">
                    <i class="fa fa-link"/> Lié au Devis : <field name="sale_order_id" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
