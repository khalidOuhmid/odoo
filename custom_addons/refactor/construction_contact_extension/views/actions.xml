<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Actions pour les wizards -->
        <!-- Note: action_bulk_operations_wizard est définie dans bulk_operations_wizard_views.xml -->
        <!-- Note: action_portal_link_wizard est définie dans portal_link_wizard_views.xml -->

        <!-- Actions spécialisées pour les documents -->
        <record id="action_documents_to_validate" model="ir.actions.act_window">
            <field name="name">Documents à Valider</field>
            <field name="res_model">partner.document</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'to_check')]</field>
            <field name="context">{'search_default_to_check': 1}</field>
            <field name="groups_id" eval="[(4, ref('group_document_validator'))]"/>
        </record>

        <record id="action_expired_documents" model="ir.actions.act_window">
            <field name="name">Documents Expirés</field>
            <field name="res_model">partner.document</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'expired')]</field>
            <field name="context">{'search_default_expired': 1}</field>
        </record>

        <record id="action_expiring_documents" model="ir.actions.act_window">
            <field name="name">Documents Expirant Bientôt</field>
            <field name="res_model">partner.document</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'expiring')]</field>
            <field name="context">{'search_default_expiring': 1}</field>
        </record>


        <!-- Actions pour les services -->
        <record id="action_partner_notification_service" model="ir.actions.act_window">
            <field name="name">Service de Notifications</field>
            <field name="res_model">partner.notification.service</field>
            <field name="view_mode">list,form</field>
            <field name="groups_id" eval="[(4, ref('group_subcontractor_manager'))]"/>
        </record>

        <!-- Actions d'administration -->
        <record id="action_archive_management" model="ir.actions.act_window">
            <field name="name">Gestion des Archives</field>
            <field name="res_model">document.archive</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_can_be_restored': 1}</field>
            <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="action_subcontractor_audit_logs" model="ir.actions.act_window">
            <field name="name">Logs d'Audit</field>
            <field name="res_model">mail.message</field>
            <field name="view_mode">list</field>
            <field name="domain">[('model', 'in', ['partner.document', 'document.archive'])]</field>
            <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="action_subcontractor_maintenance" model="ir.actions.act_window">
            <field name="name">Maintenance</field>
            <field name="res_model">ir.cron</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('model_id.model', 'in', ['partner.document', 'document.archive', 'res.partner'])]</field>
            <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Actions serveur pour les opérations automatiques -->
        <record id="action_server_send_expiry_reminder" model="ir.actions.server">
            <field name="name">Envoyer Rappel Expiration</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="binding_model_id" ref="model_partner_document"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    if record.is_expiring_soon:
                        record.send_expiry_notification()
            </field>
            <field name="groups_id" eval="[(4, ref('group_subcontractor_manager'))]"/>
        </record>

        <record id="action_server_validate_documents" model="ir.actions.server">
            <field name="name">Valider Documents</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="binding_model_id" ref="model_partner_document"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    if record.state == 'to_check':
                        record.action_validate()
            </field>
            <field name="groups_id" eval="[(4, ref('group_document_validator'))]"/>
        </record>

        <record id="action_server_generate_portal_links" model="ir.actions.server">
            <field name="name">Générer Liens Portail</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    if record.is_subcontractor:
                        record.generate_upload_token()
                        record.send_portal_link_notification()
            </field>
            <field name="groups_id" eval="[(4, ref('group_subcontractor_manager'))]"/>
        </record>

        <!-- Actions de rapports -->
        <!-- Note: action_partner_document_report est définie dans partner_document_reports.xml -->
        <!-- Note: action_statistics_report est définie dans statistics_reports.xml -->
        <!-- Note: action_portal_instructions_report est définie dans portal_instructions_report.xml -->

        <!-- Actions de fenêtre pour les configurations -->
        <record id="action_subcontractor_config_settings" model="ir.actions.act_window">
            <field name="name">Configuration Sous-traitants</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module': 'construction_contact_extension'}</field>
            <field name="groups_id" eval="[(4, ref('group_subcontractor_manager'))]"/>
        </record>

        <!-- Actions URL pour les liens externes -->
        <record id="action_portal_help_external" model="ir.actions.act_url">
            <field name="name">Aide Portail</field>
            <field name="url">https://docs.blggroupe.com/portal-upload</field>
            <field name="target">new</field>
        </record>

        <!-- Actions multi-étapes -->
        <record id="action_multi_document_validation" model="ir.actions.act_window_close">
            <field name="name">Validation Multiple</field>
        </record>

        <!-- Actions planifiées (Cron actions) -->
        <record id="action_cron_document_health_check" model="ir.actions.server">
            <field name="name">Vérification Santé Documents</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_health_check()</field>
        </record>

        <record id="action_cron_cleanup_expired_tokens" model="ir.actions.server">
            <field name="name">Nettoyage Tokens Expirés</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_expired_tokens()</field>
        </record>

        <!-- Actions de notification -->
        <record id="action_notify_document_expiry" model="ir.actions.server">
            <field name="name">Notifier Expiration Document</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="binding_model_id" ref="model_partner_document"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">
                if record.is_expiring_soon:
                    record.send_expiry_notification()
                    action = {'type': 'ir.actions.client', 'tag': 'display_notification', 'params': {'message': 'Notification envoyée', 'type': 'success'}}
            </field>
        </record>

        <!-- Actions client-side -->
        <record id="action_client_notification_center" model="ir.actions.client">
            <field name="name">Centre de Notifications</field>
            <field name="tag">notification_center</field>
            <field name="context">{'default_model': 'partner.document'}</field>
        </record>

        <record id="action_client_document_dashboard" model="ir.actions.client">
            <field name="name">Tableau de Bord Documents</field>
            <field name="tag">document_dashboard</field>
            <field name="context">{'dashboard_type': 'documents'}</field>
        </record>

        <!-- Actions de génération de rapports personnalisés -->
        <record id="action_generate_custom_report" model="ir.actions.server">
            <field name="name">Générer Rapport Personnalisé</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
report_wizard = env['partner.document.stats.wizard'].create({
    'partner_id': record.id if len(records) == 1 else False
})
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'partner.document.stats.wizard',
    'res_id': report_wizard.id,
    'view_mode': 'form',
    'target': 'new'
}
            </field>
            <field name="groups_id" eval="[(4, ref('group_subcontractor_manager'))]"/>
        </record>

    </data>
</odoo>
