<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vue formulaire pour l'assistant lien portail -->
        <record id="portal_link_wizard_form_view" model="ir.ui.view">
            <field name="name">portal.link.wizard.form</field>
            <field name="model">portal.link.wizard</field>
            <field name="arch" type="xml">
                <form string="Lien Portail d'Upload">
                    <header>
                        <button name="action_regenerate_token" string="Régénérer Token"
                                type="object" class="btn-secondary"
                                data-confirm="Êtes-vous sûr de vouloir régénérer le token ? L'ancien lien ne fonctionnera plus."/>
                        <button name="action_extend_validity" string="Étendre Validité"
                                type="object" class="btn-secondary"/>
                        <button name="action_revoke_token" string="Révoquer Token"
                                type="object" class="btn-danger"
                                data-confirm="Êtes-vous sûr de vouloir révoquer ce token ?"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="partner_id" readonly="1"/>
                            </h1>
                            <h2>
                                Lien Portail d'Upload de Documents
                            </h2>
                        </div>

                        <!-- Informations partenaire -->
                        <group>
                            <group string="Informations Partenaire">
                                <field name="partner_email" readonly="1"/>
                                <field name="partner_phone" readonly="1"/>
                                <field name="document_completion_rate" readonly="1" widget="progressbar"/>
                                <field name="can_send_email" readonly="1"/>
                                <field name="can_send_sms" readonly="1"/>
                            </group>

                            <group string="Configuration Token">
                                <field name="validity_days"/>
                                <field name="regenerate_if_exists"/>
                                <field name="include_instructions"/>
                                <field name="token_status" readonly="1"
                                       decoration-success="token_status == 'valid'"
                                       decoration-warning="token_status == 'expiring'"
                                       decoration-danger="token_status == 'expired'"/>
                                <field name="days_until_expiry" readonly="1"
                                       invisible="token_status == 'none'"/>
                            </group>
                        </group>

                        <!-- URL et QR Code -->
                        <group string="Lien d'Accès">
                            <field name="portal_url" readonly="1" widget="url"/>
                            <field name="short_url" readonly="1" widget="url"
                                   invisible="not short_url"/>
                            <field name="token_expiry" readonly="1"/>
                        </group>

                        <!-- QR Code -->
                        <group string="QR Code" invisible="not qr_code">
                            <field name="qr_code" widget="image" nolabel="1"/>
                        </group>

                        <!-- Documents manquants -->
                        <group string="Documents Manquants" invisible="not missing_documents">
                            <field name="missing_documents" readonly="1" nolabel="1" widget="text"/>
                        </group>

                        <!-- Actions d'envoi -->
                        <group string="Actions d'Envoi">
                            <div class="row">
                                <div class="col-md-6">
                                    <button name="action_send_by_email" string="📧 Envoyer par Email"
                                            type="object" class="btn-primary oe_highlight"
                                            invisible="not can_send_email"/>
                                    <button name="action_send_by_sms" string="📱 Envoyer par SMS"
                                            type="object" class="btn-info"
                                            invisible="not can_send_sms"/>
                                </div>
                                <div class="col-md-6">
                                    <button name="action_copy_url" string="📋 Copier Lien"
                                            type="object" class="btn-secondary"/>
                                    <button name="action_print_instructions" string="🖨️ Imprimer Instructions"
                                            type="object" class="btn-secondary"/>
                                </div>
                            </div>
                        </group>

                        <!-- Actions de test -->
                        <group string="Test et Prévisualisation">
                            <div class="row">
                                <div class="col-md-6">
                                    <button name="action_preview_portal" string="👁️ Prévisualiser Portail"
                                            type="object" class="btn-secondary"/>
                                    <button name="action_test_upload" string="🧪 Test d'Upload"
                                            type="object" class="btn-secondary"/>
                                </div>
                            </div>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action pour l'assistant -->
        <record id="portal_link_wizard_action" model="ir.actions.act_window">
            <field name="name">Générer Lien Portail</field>
            <field name="res_model">portal.link.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
