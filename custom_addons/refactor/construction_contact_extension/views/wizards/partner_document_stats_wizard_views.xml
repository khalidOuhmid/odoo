<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vue formulaire pour les statistiques documentaires -->
        <record id="partner_document_stats_wizard_form_view" model="ir.ui.view">
            <field name="name">partner.document.stats.wizard.form</field>
            <field name="model">partner.document.stats.wizard</field>
            <field name="arch" type="xml">
                <form string="Statistiques Documentaires">
                    <header>
                        <button name="action_generate_report" string="📊 Générer Rapport PDF"
                                type="object" class="btn-primary"/>
                        <button name="action_export_data" string="📤 Exporter Excel"
                                type="object" class="btn-secondary"/>
                        <button name="action_send_reminder" string="📧 Envoyer Rappel"
                                type="object" class="btn-warning"
                                invisible="alerts_count == 0"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="partner_id" readonly="1"/>
                            </h1>
                            <h2>
                                Statistiques Documentaires Détaillées
                            </h2>
                        </div>

                        <!-- Scores principaux -->
                        <group>
                            <group string="Scores Globaux">
                                <field name="health_score" readonly="1" widget="progressbar"
                                       options="{'style': 'width: 200px'}"
                                       decoration-success="health_score >= 80"
                                       decoration-warning="health_score >= 50 and health_score &lt; 80"
                                       decoration-danger="health_score &lt; 50"/>
                                <field name="completion_rate" readonly="1" widget="progressbar"
                                       options="{'style': 'width: 200px'}"/>
                                <field name="reliability_score" readonly="1" widget="progressbar"
                                       options="{'style': 'width: 200px'}"/>
                            </group>
                        </group>

                        <!-- Statistiques détaillées -->
                        <notebook>
                            <page string="Vue d'Ensemble" name="overview">
                                <group>
                                    <group string="Répartition des Documents">
                                        <field name="total_documents" readonly="1"/>
                                        <field name="valid_documents" readonly="1"
                                               decoration-success="valid_documents > 0"/>
                                        <field name="expired_documents" readonly="1"
                                               decoration-danger="expired_documents > 0"/>
                                        <field name="expiring_documents" readonly="1"
                                               decoration-warning="expiring_documents > 0"/>
                                        <field name="rejected_documents" readonly="1"
                                               decoration-danger="rejected_documents > 0"/>
                                        <field name="missing_documents" readonly="1"
                                               decoration-warning="missing_documents > 0"/>
                                        <field name="to_check_documents" readonly="1"
                                               decoration-info="to_check_documents > 0"/>
                                    </group>

                                    <group string="Actions Rapides">
                                        <button name="action_view_documents" string="Voir Tous les Documents"
                                                type="object" class="btn-link"/>
                                        <button name="action_view_expired_documents" string="Voir Documents Expirés"
                                                type="object" class="btn-link"
                                                invisible="expired_documents == 0"/>
                                        <button name="action_view_expiring_documents" string="Voir Documents Expirant"
                                                type="object" class="btn-link"
                                                invisible="expiring_documents == 0"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Analyse Temporelle" name="temporal">
                                <group>
                                    <group string="Historique des Uploads">
                                        <field name="first_upload_date" readonly="1"/>
                                        <field name="last_upload_date" readonly="1"/>
                                        <field name="uploads_last_30_days" readonly="1"/>
                                        <field name="uploads_last_90_days" readonly="1"/>
                                        <field name="average_processing_days" readonly="1" widget="float"/>
                                    </group>

                                    <group string="Prochaines Échéances">
                                        <field name="next_expiry_date" readonly="1"
                                               decoration-danger="next_expiry_date and next_expiry_date &lt;= context_today() + datetime.timedelta(days=30)"/>
                                        <field name="next_expiry_document" readonly="1"/>
                                        <field name="expiry_within_30_days" readonly="1"
                                               decoration-warning="expiry_within_30_days > 0"/>
                                        <field name="expiry_within_60_days" readonly="1"/>
                                        <field name="expiry_within_90_days" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Analyse par Type" name="by_type">
                                <group>
                                    <group string="Complétude">
                                        <field name="mandatory_docs_complete" readonly="1"
                                               decoration-success="mandatory_docs_complete == True"
                                               decoration-danger="mandatory_docs_complete == False"/>
                                        <field name="optional_docs_uploaded" readonly="1"/>
                                    </group>
                                </group>

                                <group string="Répartition par Type de Document">
                                    <field name="document_type_stats" readonly="1" nolabel="1" widget="text"/>
                                </group>
                            </page>

                            <page string="Alertes et Recommandations" name="alerts">
                                <group>
                                    <group string="Alertes Actives">
                                        <field name="alerts_count" readonly="1"
                                               decoration-danger="alerts_count > 0"/>
                                    </group>
                                </group>

                                <div class="row" invisible="alerts_count == 0">
                                    <div class="col-md-12">
                                        <div class="alert alert-warning">
                                            <h4>⚠️ Alertes</h4>
                                            <field name="alerts_text" readonly="1" nolabel="1" widget="html"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="alert alert-info">
                                            <h4>💡 Recommandations</h4>
                                            <field name="recommendations_text" readonly="1" nolabel="1" widget="html"/>
                                        </div>
                                    </div>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action pour les statistiques -->
        <record id="partner_document_stats_wizard_action" model="ir.actions.act_window">
            <field name="name">Statistiques Documentaires</field>
            <field name="res_model">partner.document.stats.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
