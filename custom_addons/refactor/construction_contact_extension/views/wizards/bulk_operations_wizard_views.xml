<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vue formulaire pour les opérations en lot -->
        <record id="bulk_operations_wizard_form_view" model="ir.ui.view">
            <field name="name">subcontractor.bulk.wizard.form</field>
            <field name="model">subcontractor.bulk.wizard</field>
            <field name="arch" type="xml">
                <form string="Opérations en Lot">
                    <header>
                        <button name="action_confirm_operation" string="Confirmer l'Opération"
                                type="object" class="btn-primary oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="action_execute_operation" string="Exécuter"
                                type="object" class="btn-success"
                                invisible="state != 'confirm'"
                                data-confirm="Êtes-vous sûr de vouloir exécuter cette opération ?"/>
                        <button name="action_export_results" string="Exporter Résultats"
                                type="object" class="btn-secondary"
                                invisible="state != 'done'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,processing,done"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                Opérations en Lot sur les Sous-traitants
                            </h1>
                        </div>

                        <!-- Étape 1: Sélection -->
                        <group invisible="state not in ['draft', 'confirm']">
                            <group string="Sélection des Partenaires">
                                <field name="selection_criteria" widget="radio"/>
                                <field name="partner_count" readonly="1"/>
                                <field name="estimated_duration" readonly="1"/>
                            </group>

                            <group string="Filtres Avancés"
                                   invisible="selection_criteria not in ['low_health_score', 'inactive', 'by_speciality']">
                                <field name="health_score_min"
                                       invisible="selection_criteria != 'low_health_score'"/>
                                <field name="days_inactive"
                                       invisible="selection_criteria != 'inactive'"/>
                                <field name="speciality_filter_ids" widget="many2many_tags"
                                       invisible="selection_criteria != 'by_speciality'"/>
                            </group>
                        </group>

                        <group string="Partenaires Sélectionnés"
                               invisible="state not in ['draft', 'confirm']">
                            <field name="partner_ids" nolabel="1" widget="many2many"
                                   options="{'no_create': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="document_completion_rate" widget="progressbar"/>
                                    <field name="document_health_score" widget="progressbar"/>
                                </list>
                            </field>
                            <div class="oe_button_box">
                                <button name="action_preview_selection" string="Prévisualiser"
                                        type="object" class="btn-secondary"/>
                                <button name="action_clear_selection" string="Vider Sélection"
                                        type="object" class="btn-link"/>
                            </div>
                        </group>

                        <!-- Étape 2: Configuration de l'opération -->
                        <group string="Configuration de l'Opération"
                               invisible="state not in ['draft', 'confirm']">
                            <field name="operation" widget="radio" options="{'horizontal': true}"/>
                        </group>

                        <!-- Paramètres spécifiques selon l'opération -->
                        <group string="Paramètres"
                               invisible="state not in ['draft', 'confirm']">

                            <!-- Paramètres notifications -->
                            <group invisible="operation != 'update_notifications'">
                                <field name="notification_preference" required="operation == 'update_notifications'"/>
                            </group>

                            <!-- Paramètres tokens -->
                            <group invisible="operation != 'generate_tokens'">
                                <field name="token_validity_days"/>
                                <field name="force_regenerate"/>
                            </group>

                            <!-- Paramètres documents -->
                            <group invisible="operation != 'validate_documents'">
                                <field name="document_type_ids" widget="many2many_tags"
                                       required="operation == 'validate_documents'"/>
                                <field name="validation_status" required="operation == 'validate_documents'"/>
                                <field name="validation_notes"/>
                            </group>

                            <!-- Paramètres spécialités -->
                            <group invisible="operation != 'update_speciality'">
                                <field name="new_speciality_ids" widget="many2many_tags"
                                       required="operation == 'update_speciality'"/>
                                <field name="speciality_mode"/>
                            </group>
                        </group>

                        <!-- Étape 3: Progression et résultats -->
                        <group string="Progression"
                               invisible="state not in ['processing', 'done']">
                            <field name="progress_percent" widget="progressbar"/>
                            <field name="success_count" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                        </group>

                        <!-- Journal des résultats -->
                        <group string="Journal des Résultats"
                               invisible="not result_log">
                            <field name="result_log" nolabel="1" widget="html" readonly="1"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action pour les opérations en lot -->
        <record id="bulk_operations_wizard_action" model="ir.actions.act_window">
            <field name="name">Opérations en Lot</field>
            <field name="res_model">subcontractor.bulk.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
