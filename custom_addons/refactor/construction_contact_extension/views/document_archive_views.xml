<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Search view for document archives -->
    <record id="view_document_archive_search" model="ir.ui.view">
        <field name="name">document.archive.search</field>
        <field name="model">document.archive</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name"/>
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="archived_filename"/>
                <field name="archived_date"/>
                <field name="archived_by"/>
                <field name="archive_reason"/>

                <!-- Filtres par type de document -->
                <filter string="Carte d'identité" name="identity_card"
                        domain="[('document_type_id.code', '=', 'identity_card')]"/>
                <filter string="URSSAF" name="urssaf"
                        domain="[('document_type_id.code', '=', 'urssaf')]"/>
                <filter string="KBIS" name="kbis"
                        domain="[('document_type_id.code', '=', 'kbis')]"/>
                <filter string="Assurance" name="insurance"
                        domain="[('document_type_id.code', '=', 'insurance')]"/>
                <filter string="RIB" name="rib"
                        domain="[('document_type_id.code', '=', 'rib')]"/>

                <!-- Filtres par raison d'archivage -->
                <separator/>
                <filter string="Remplacé" name="replaced"
                        domain="[('archive_reason', '=', 'replaced')]"/>
                <filter string="Expiré" name="expired_reason"
                        domain="[('archive_reason', '=', 'expired')]"/>
                <filter string="Rejeté" name="rejected_reason"
                        domain="[('archive_reason', '=', 'rejected')]"/>
                <filter string="Supprimé" name="deleted"
                        domain="[('archive_reason', '=', 'deleted')]"/>

                <!-- Filtres par date -->
                <separator/>
                <filter string="Aujourd'hui" name="today"
                        domain="[('archived_date', '>=', context_today())]"/>
                <filter string="Cette semaine" name="this_week"
                        domain="[('archived_date', '>=', (context_today() - datetime.timedelta(days=7)))]"/>
                <filter string="Ce mois" name="this_month"
                        domain="[('archived_date', '>=', (context_today() - datetime.timedelta(days=30)))]"/>

                <!-- Filtres avancés -->
                <separator/>
                <filter string="Peut être restauré" name="restorable"
                        domain="[('can_be_restored', '=', True)]"/>

                <!-- Groupes -->
                <group expand="0" string="Group By">
                    <filter string="Partenaire" name="group_by_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Type de document" name="group_by_type"
                            context="{'group_by': 'document_type_id'}"/>
                    <filter string="Raison d'archivage" name="group_by_reason"
                            context="{'group_by': 'archive_reason'}"/>
                    <filter string="Date d'archivage" name="group_by_date"
                            context="{'group_by': 'archived_date:month'}"/>
                    <filter string="Archivé par" name="group_by_user"
                            context="{'group_by': 'archived_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List view for document archives -->
    <record id="view_document_archive_list" model="ir.ui.view">
        <field name="name">document.archive.list</field>
        <field name="model">document.archive</field>
        <field name="arch" type="xml">
            <list string="Archives de Documents" create="false">
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="archived_filename"/>
                <field name="archive_reason" widget="badge"
                       decoration-info="archive_reason == 'replaced'"
                       decoration-warning="archive_reason == 'expired'"
                       decoration-danger="archive_reason == 'rejected'"
                       decoration-muted="archive_reason == 'deleted'"/>
                <field name="archived_date"/>
                <field name="days_since_archived" string="Âge (jours)"/>
                <field name="file_size_human" string="Taille"/>
                <field name="archived_by"/>
                <field name="can_be_restored" widget="boolean"/>

                <!-- Actions -->
                <button name="action_download" type="object"
                        string="Télécharger"
                        class="btn btn-sm btn-outline-primary"
                        icon="fa-download"/>
                <button name="action_restore" type="object"
                        string="Restaurer"
                        class="btn btn-sm btn-outline-success"
                        icon="fa-undo"
                        invisible="not can_be_restored"/>
                <button name="action_permanent_delete" type="object"
                        string="Supprimer définitivement"
                        class="btn btn-sm btn-outline-danger"
                        icon="fa-trash"
                        groups="base.group_system"
                />
            </list>
        </field>
    </record>

    <!-- Form view for document archives -->
    <record id="view_document_archive_form" model="ir.ui.view">
        <field name="name">document.archive.form</field>
        <field name="model">document.archive</field>
        <field name="arch" type="xml">
            <form string="Archive de Document" create="false" delete="false">
                <header>
                    <button name="action_download" string="Télécharger"
                            type="object" class="btn-primary"
                            icon="fa-download"/>
                    <button name="action_restore" string="Restaurer"
                            type="object" class="btn-success"
                            icon="fa-undo"
                            invisible="not can_be_restored"/>
                    <button name="action_view_replacement" string="Voir Document Actuel"
                            type="object" class="btn-secondary"
                            icon="fa-eye"/>
                    <button name="action_permanent_delete" string="Supprimer Définitivement"
                            type="object" class="btn-danger"
                            icon="fa-trash"
                            groups="base.group_system"
                            data-confirm="Cette action est irréversible !"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informations Générales">
                            <field name="partner_id" readonly="1"/>
                            <field name="document_type_id" readonly="1"/>
                            <field name="archived_filename" readonly="1"/>
                            <field name="file_size_human" readonly="1"/>
                            <field name="file_hash" readonly="1" groups="base.group_system"/>
                        </group>

                        <group string="Informations d'Archivage">
                            <field name="archive_reason" readonly="1"/>
                            <field name="archived_date" readonly="1"/>
                            <field name="days_since_archived" readonly="1"/>
                            <field name="archived_by" readonly="1"/>
                            <field name="can_be_restored" readonly="1"/>
                        </group>
                    </group>

                    <group string="Données Originales">
                        <group>
                            <field name="original_upload_date" readonly="1"/>
                            <field name="original_expiry_date" readonly="1"/>
                            <field name="original_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="original_validated_by" readonly="1"/>
                            <field name="original_validation_date" readonly="1"/>
                        </group>
                    </group>

                    <group string="Notes d'Archivage" invisible="not archive_notes">
                        <field name="archive_notes" readonly="1" nolabel="1"/>
                    </group>

                    <!-- Aperçu du fichier si disponible -->
                    <group string="Fichier Archivé">
                        <field name="archived_content"
                               filename="archived_filename"
                               widget="binary"
                               readonly="1"/>
                    </group>
                </sheet>

                <!-- Chatter pour l'historique -->
               <chatter></chatter>
            </form>
        </field>
    </record>

    <!-- Action principale -->
    <record id="action_document_archive" model="ir.actions.act_window">
        <field name="name">Archives de Documents</field>
        <field name="res_model">document.archive</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune archive de document trouvée
            </p>
            <p>
                Les documents archivés apparaissent ici lorsqu'ils sont remplacés, expirés ou supprimés.
            </p>
        </field>
    </record>

</odoo>
