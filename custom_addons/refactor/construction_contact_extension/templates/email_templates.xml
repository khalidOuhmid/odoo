<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Template CSS commun pour les emails -->
        <template id="email_layout_construction" name="Construction Email Layout">
            <div style="margin: 0; padding: 0; font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; background: linear-gradient(135deg, #f8fafc 0%, #e3f0ff 100%); min-height: 100vh;">
                <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
                    <div style="background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.12);">
                        <t t-raw="0"/>
                    </div>
                </div>
            </div>
        </template>

        <!-- Header pour les emails BLG -->
        <template id="email_header_blg" name="BLG Email Header">
            <div t-att-style="'background: linear-gradient(135deg, ' + (header_color or '#1e40af') + ' 0%, ' + (header_color_end or '#3b82f6') + ' 100%); padding: 40px 30px; text-align: center; color: white;'">
                <div style="margin-bottom: 20px;">
                    <img src="/construction_contact_extension/static/img/logo-white.png"
                         alt="BLG Groupe"
                         style="height: 50px;"
                         onerror="this.onerror=null; this.src='/web/static/img/logo.png'; this.style.filter='brightness(0) invert(1)';"/>
                </div>
                <h1 t-att-style="'margin: 0; font-size: 28px; font-weight: 700; margin-bottom: 10px; color: ' + (title_color or 'white') + ';'">
                    <t t-esc="title or 'BLG Groupe'"/>
                </h1>
                <t t-if="subtitle">
                    <p style="margin: 0; font-size: 16px; opacity: 0.9;">
                        <t t-esc="subtitle"/>
                    </p>
                </t>
            </div>
        </template>

        <!-- Footer pour les emails BLG -->
        <template id="email_footer_blg" name="BLG Email Footer">
            <div style="background: #1f2937; color: white; padding: 25px 30px; text-align: center;">
                <div style="margin-bottom: 15px;">
                    <img src="/construction_contact_extension/static/img/logo-white.png"
                         alt="BLG Groupe"
                         style="height: 35px; filter: brightness(0) invert(1);"
                         onerror="this.src='/web/static/img/logo.png'"/>
                </div>
                <p style="margin: 0; font-size: 14px; opacity: 0.9; margin-bottom: 10px;">
                    <t t-esc="company_name or 'BLG Groupe'"/> - Votre partenaire de confiance dans le BTP
                </p>
                <p style="margin: 0; font-size: 13px; opacity: 0.7;">
                    🌐 <t t-esc="website or 'www.blggroupe.com'"/> |
                    📧 <t t-esc="email or 'contact@blggroupe.com'"/> |
                    📞 <t t-esc="phone or '01 23 45 67 89'"/>
                </p>
                <t t-if="address">
                    <p style="margin: 10px 0 0 0; font-size: 12px; opacity: 0.6;">
                        📍 <t t-esc="address"/>
                    </p>
                </t>
                <p style="margin: 15px 0 0 0; font-size: 11px; opacity: 0.5; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 15px;">
                    Cet email a été envoyé automatiquement. Pour vous désabonner ou modifier vos préférences,
                    <a href="#" style="color: #60a5fa;">cliquez ici</a>.
                </p>
            </div>
        </template>

        <!-- Template pour les alertes dans les emails -->
        <template id="email_alert_box" name="Email Alert Box">
            <div t-att-style="'background: ' + (bg_color or '#fef2f2') + '; border-left: 4px solid ' + (border_color or '#dc2626') + '; padding: 20px; margin: 25px 0; border-radius: 0 8px 8px 0;'">
                <h3 t-att-style="'color: ' + (text_color or '#b91c1c') + '; margin: 0 0 15px 0; font-size: 18px; display: flex; align-items: center;'">
                    <t t-if="icon">
                        <span style="margin-right: 10px; font-size: 20px;"><t t-esc="icon"/></span>
                    </t>
                    <t t-esc="title or 'Alerte'"/>
                </h3>
                <div t-att-style="'color: #374151; font-size: 15px; line-height: 1.5;'">
                    <t t-raw="0"/>
                </div>
            </div>
        </template>

        <!-- Template pour les informations dans les emails -->
        <template id="email_info_box" name="Email Info Box">
            <div t-att-style="'background: ' + (bg_color or '#eff6ff') + '; border: 1px solid ' + (border_color or '#bae6fd') + '; border-radius: 8px; padding: 20px; margin: 25px 0;'">
                <t t-if="title">
                    <h4 t-att-style="'color: ' + (title_color or '#0369a1') + '; margin: 0 0 15px 0; font-size: 16px; display: flex; align-items: center;'">
                        <t t-if="icon">
                            <span style="margin-right: 8px;"><t t-esc="icon"/></span>
                        </t>
                        <t t-esc="title"/>
                    </h4>
                </t>
                <div style="color: #374151; font-size: 14px; line-height: 1.5;">
                    <t t-raw="0"/>
                </div>
            </div>
        </template>

        <!-- Template pour les boutons dans les emails -->
        <template id="email_button" name="Email Button">
            <div style="text-align: center; margin: 30px 0;">
                <a t-att-href="url or '#'"
                   t-att-style="'display: inline-block; background: linear-gradient(135deg, ' + (bg_color or '#1e40af') + ' 0%, ' + (bg_color_end or '#1e3a8a') + ' 100%); color: white; text-decoration: none; padding: 15px 30px; border-radius: 8px; font-weight: 600; font-size: 16px; box-shadow: 0 4px 14px rgba(30, 64, 175, 0.25); transition: transform 0.2s ease;'"
                   onmouseover="this.style.transform='translateY(-2px)'"
                   onmouseout="this.style.transform='translateY(0)'">
                    <t t-if="icon">
                        <span style="margin-right: 8px;"><t t-esc="icon"/></span>
                    </t>
                    <t t-esc="text or 'Cliquez ici'"/>
                </a>
            </div>
        </template>

        <!-- Template pour les listes dans les emails -->
        <template id="email_document_list" name="Email Document List">
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin: 20px 0;">
                <t t-if="title">
                    <h4 style="color: #374151; margin: 0 0 15px 0; font-size: 16px; font-weight: 600;">
                        <t t-esc="title"/>
                    </h4>
                </t>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <t t-foreach="documents" t-as="doc">
                        <div style="background: white; padding: 15px; border-radius: 6px; border-left: 3px solid #1e40af;">
                            <div style="display: flex; justify-content: between; align-items: center;">
                                <div style="flex: 1;">
                                    <p style="margin: 0; font-weight: 600; color: #374151; font-size: 15px;">
                                        <t t-esc="doc.get('name', 'Document')"/>
                                    </p>
                                    <t t-if="doc.get('description')">
                                        <p style="margin: 5px 0 0 0; color: #6b7280; font-size: 13px;">
                                            <t t-esc="doc['description']"/>
                                        </p>
                                    </t>
                                </div>
                                <div style="text-align: right;">
                                    <t t-if="doc.get('status')">
                                        <span t-att-class="'badge badge-' + doc.get('status_class', 'secondary')"
                                              t-att-style="'padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: 500; background: ' + doc.get('status_bg', '#6b7280') + '; color: white;'">
                                            <t t-esc="doc['status']"/>
                                        </span>
                                    </t>
                                    <t t-if="doc.get('expiry_date')">
                                        <p style="margin: 5px 0 0 0; font-size: 12px; color: #9ca3af;">
                                            Expire le <t t-esc="doc['expiry_date']"/>
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </template>

        <!-- Template pour les statistiques dans les emails -->
        <template id="email_stats_grid" name="Email Stats Grid">
            <div style="background: #f8fafc; border-radius: 12px; padding: 25px; margin: 25px 0;">
                <t t-if="title">
                    <h3 style="color: #374151; margin: 0 0 20px 0; font-size: 18px; text-align: center;">
                        <t t-esc="title"/>
                    </h3>
                </t>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 15px;">
                    <t t-foreach="stats" t-as="stat">
                        <div style="background: white; padding: 20px; border-radius: 8px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                            <div t-att-style="'font-size: 28px; font-weight: 700; margin-bottom: 8px; color: ' + stat.get('color', '#1e40af') + ';'">
                                <t t-esc="stat.get('value', '0')"/>
                                <t t-if="stat.get('unit')">
                                    <span style="font-size: 18px; font-weight: 500;">
                                        <t t-esc="stat['unit']"/>
                                    </span>
                                </t>
                            </div>
                            <div style="font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">
                                <t t-esc="stat.get('label', 'Statistique')"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </template>

        <!-- Template pour les progressions dans les emails -->
        <template id="email_progress_bar" name="Email Progress Bar">
            <div style="margin: 20px 0;">
                <div style="display: flex; justify-content: between; align-items: center; margin-bottom: 8px;">
                    <span style="font-size: 14px; font-weight: 600; color: #374151;">
                        <t t-esc="label or 'Progression'"/>
                    </span>
                    <span style="font-size: 14px; font-weight: 600; color: #1e40af;">
                        <t t-esc="percentage or 0"/>%
                    </span>
                </div>
                <div style="background: #e5e7eb; height: 8px; border-radius: 4px; overflow: hidden;">
                    <div t-att-style="'background: linear-gradient(90deg, ' + (color or '#1e40af') + ', ' + (color_end or '#3b82f6') + '); height: 100%; width: ' + str(percentage or 0) + '%; transition: width 0.3s ease; border-radius: 4px;'">
                    </div>
                </div>
            </div>
        </template>

        <!-- Template pour les QR codes dans les emails -->
        <template id="email_qr_code" name="Email QR Code">
            <div style="text-align: center; margin: 25px 0;">
                <div style="background: white; padding: 20px; border-radius: 12px; display: inline-block; box-shadow: 0 4px 20px rgba(0,0,0,0.1);">
                    <t t-if="title">
                        <h4 style="margin: 0 0 15px 0; color: #374151; font-size: 16px;">
                            <t t-esc="title"/>
                        </h4>
                    </t>
                    <img t-att-src="qr_code_url"
                         alt="QR Code"
                         style="width: 150px; height: 150px; border: 2px solid #e5e7eb; border-radius: 8px;"/>
                    <t t-if="subtitle">
                        <p style="margin: 15px 0 0 0; color: #6b7280; font-size: 13px;">
                            <t t-esc="subtitle"/>
                        </p>
                    </t>
                </div>
            </div>
        </template>

        <!-- Template pour les notifications urgentes -->
        <template id="email_urgent_notification" name="Email Urgent Notification">
            <div style="background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border: 2px solid #fecaca; border-radius: 12px; padding: 25px; margin: 25px 0; position: relative; overflow: hidden;">
                <!-- Animation pulse -->
                <div style="position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(239, 68, 68, 0.1) 0%, transparent 70%); animation: pulse 2s infinite;"></div>

                <div style="position: relative; z-index: 1;">
                    <div style="text-align: center; margin-bottom: 20px;">
                        <div style="background: #dc2626; color: white; width: 60px; height: 60px; border-radius: 50%; margin: 0 auto 15px; display: flex; align-items: center; justify-content: center; font-size: 24px; animation: shake 0.5s infinite;">
                            🚨
                        </div>
                        <h2 style="color: #b91c1c; margin: 0; font-size: 22px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                            <t t-esc="title or 'URGENT'"/>
                        </h2>
                    </div>

                    <div style="background: rgba(255,255,255,0.8); padding: 20px; border-radius: 8px; text-align: center;">
                        <t t-raw="0"/>
                    </div>
                </div>

                <style>
                    @keyframes pulse {
                        0% { transform: scale(1); opacity: 0.1; }
                        50% { transform: scale(1.1); opacity: 0.2; }
                        100% { transform: scale(1); opacity: 0.1; }
                    }
                    @keyframes shake {
                        0%, 100% { transform: translateX(0); }
                        25% { transform: translateX(-5px); }
                        75% { transform: translateX(5px); }
                    }
                </style>
            </div>
        </template>

    </data>
</odoo>
