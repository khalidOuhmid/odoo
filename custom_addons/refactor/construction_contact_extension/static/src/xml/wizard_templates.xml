<?xml version="1.0" encoding="utf-8"?>
<templates>

    <!-- Template pour la prévisualisation d'image -->
    <t t-name="construction_contact_extension.ImagePreviewDialog">
        <div class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-image"></i>
                            Aperçu du fichier
                        </h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body text-center">
                        <div class="image-preview-container">
                            <img t-att-src="props.imageUrl"
                                 t-att-alt="props.fileName"
                                 class="img-fluid rounded shadow"
                                 style="max-height: 70vh;" />
                        </div>
                        <div class="image-info mt-3">
                            <h6 t-esc="props.fileName"></h6>
                            <div class="image-controls">
                                <button class="btn btn-outline-secondary btn-sm" onclick="this.previousElementSibling.previousElementSibling.style.transform = 'scale(' + (parseFloat(this.previousElementSibling.previousElementSibling.style.transform.replace(/[^\d.]/g, '') || '1') * 1.2) + ')'">
                                    <i class="fa fa-search-plus"></i> Zoom +
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="this.previousElementSibling.previousElementSibling.previousElementSibling.style.transform = 'scale(' + (parseFloat(this.previousElementSibling.previousElementSibling.previousElementSibling.style.transform.replace(/[^\d.]/g, '') || '1') / 1.2) + ')'">
                                    <i class="fa fa-search-minus"></i> Zoom -
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="this.previousElementSibling.previousElementSibling.previousElementSibling.previousElementSibling.style.transform = 'scale(1)'">
                                    <i class="fa fa-refresh"></i> Reset
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">
                            <i class="fa fa-times"></i> Fermer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Template pour la prévisualisation d'email -->
    <t t-name="construction_contact_extension.EmailPreviewDialog">
        <div class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-xl" role="document">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="fa fa-envelope"></i>
                            Aperçu de l'email
                        </h5>
                        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Fermer">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body p-0">
                        <div class="email-preview-container">
                            <!-- En-tête email -->
                            <div class="email-header bg-light border-bottom p-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>À :</strong> <span t-esc="props.partner"></span>
                                    </div>
                                    <div class="col-md-6 text-right">
                                        <strong>De :</strong> BLG Groupe
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <strong>Objet :</strong> <span t-esc="props.subject"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Corps de l'email -->
                            <div class="email-body p-4" style="background: #f8f9fa; min-height: 400px;">
                                <div class="email-content bg-white rounded shadow-sm p-4">
                                    <t t-raw="props.body"></t>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
                            <i class="fa fa-times"></i> Fermer l'aperçu
                        </button>
                        <button type="button" class="btn btn-primary">
                            <i class="fa fa-paper-plane"></i> Envoyer maintenant
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Template pour le wizard de rejet de document -->
    <t t-name="construction_contact_extension.DocumentRejectionWizard">
        <div class="document-rejection-wizard">
            <div class="wizard-header">
                <h4><i class="fa fa-times-circle text-danger"></i> Rejet de Document</h4>
                <p>Indiquez la raison du rejet pour permettre au partenaire de corriger son document.</p>
            </div>

            <div class="wizard-body">
                <div class="form-group">
                    <label class="form-label-modern">Raison du rejet *</label>
                    <select class="form-control-modern" t-model="state.rejectionReason" required="required">
                        <option value="">-- Sélectionner une raison --</option>
                        <option value="quality">Qualité insuffisante (illisible, flou)</option>
                        <option value="incomplete">Document incomplet</option>
                        <option value="expired">Document expiré</option>
                        <option value="wrong_type">Mauvais type de document</option>
                        <option value="invalid_format">Format de fichier invalide</option>
                        <option value="missing_info">Informations manquantes</option>
                        <option value="not_authentic">Document non authentique</option>
                        <option value="other">Autre (préciser)</option>
                    </select>
                </div>

                <div class="form-group" t-if="state.rejectionReason === 'other'">
                    <label class="form-label-modern">Préciser la raison</label>
                    <input type="text"
                           class="form-control-modern"
                           t-model="state.customReason"
                           placeholder="Veuillez préciser la raison du rejet" />
                </div>

                <div class="form-group">
                    <label class="form-label-modern">Commentaire détaillé</label>
                    <textarea class="form-control-modern"
                              rows="4"
                              t-model="state.detailedComment"
                              placeholder="Expliquez en détail ce qui doit être corrigé..."></textarea>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox"
                               class="form-check-input"
                               id="sendNotification"
                               t-model="state.sendNotification" />
                        <label class="form-check-label" for="sendNotification">
                            Envoyer une notification par email au partenaire
                        </label>
                    </div>
                </div>

                <div class="form-group" t-if="state.sendNotification">
                    <label class="form-label-modern">Template d'email</label>
                    <select class="form-control-modern" t-model="state.emailTemplate">
                        <option value="standard">Template standard</option>
                        <option value="detailed">Template détaillé</option>
                        <option value="urgent">Template urgent</option>
                    </select>
                </div>

                <!-- Aperçu du message -->
                <div class="rejection-preview" t-if="state.rejectionReason">
                    <h6>Aperçu du message envoyé :</h6>
                    <div class="preview-content bg-light p-3 rounded">
                        <p><strong>Raison :</strong> <span t-esc="getRejectionReasonText()"></span></p>
                        <p t-if="state.detailedComment"><strong>Commentaire :</strong> <span t-esc="state.detailedComment"></span></p>
                        <p class="text-muted"><small>Le partenaire recevra ces informations pour corriger son document.</small></p>
                    </div>
                </div>
            </div>

            <div class="wizard-footer">
                <button type="button" class="btn btn-secondary" onclick="this.closeWizard()">
                    <i class="fa fa-times"></i> Annuler
                </button>
                <button type="button"
                        class="btn btn-danger"
                        onclick="this.confirmRejection()"
                        t-att-disabled="!state.rejectionReason">
                    <i class="fa fa-times-circle"></i> Confirmer le rejet
                </button>
            </div>
        </div>
    </t>

    <!-- Template pour le wizard de restauration d'archive -->
    <t t-name="construction_contact_extension.DocumentRestoreWizard">
        <div class="document-restore-wizard">
            <div class="wizard-header">
                <h4><i class="fa fa-undo text-success"></i> Restaurer un Document Archivé</h4>
                <p>Restauration d'un document depuis les archives vers l'état actif.</p>
            </div>

            <div class="wizard-body">
                <!-- Informations du document à restaurer -->
                <div class="document-info-card">
                    <h6>Document à restaurer</h6>
                    <div class="card bg-light">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Type :</strong> <span t-esc="props.documentType"></span></p>
                                    <p><strong>Partenaire :</strong> <span t-esc="props.partnerName"></span></p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Archivé le :</strong> <span t-esc="props.archiveDate"></span></p>
                                    <p><strong>Raison :</strong> <span t-esc="props.archiveReason"></span></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Options de restauration -->
                <div class="form-group">
                    <label class="form-label-modern">Action après restauration</label>
                    <div class="form-check">
                        <input type="radio"
                               class="form-check-input"
                               id="restoreAsValid"
                               name="restoreAction"
                               value="valid"
                               t-model="state.restoreAction" />
                        <label class="form-check-label" for="restoreAsValid">
                            Restaurer comme document valide
                        </label>
                    </div>
                    <div class="form-check">
                        <input type="radio"
                               class="form-check-input"
                               id="restoreForReview"
                               name="restoreAction"
                               value="to_check"
                               t-model="state.restoreAction" />
                        <label class="form-check-label" for="restoreForReview">
                            Restaurer pour révision (à vérifier)
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label-modern">Nouvelle date d'expiration</label>
                    <input type="date"
                           class="form-control-modern"
                           t-model="state.newExpiryDate"
                           t-att-min="getCurrentDate()" />
                    <small class="form-text text-muted">
                        Laissez vide pour conserver la date d'expiration originale
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label-modern">Commentaire de restauration</label>
                    <textarea class="form-control-modern"
                              rows="3"
                              t-model="state.restoreComment"
                              placeholder="Raison de la restauration, contexte..."></textarea>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox"
                               class="form-check-input"
                               id="notifyPartner"
                               t-model="state.notifyPartner" />
                        <label class="form-check-label" for="notifyPartner">
                            Notifier le partenaire de la restauration
                        </label>
                    </div>
                </div>

                <!-- Avertissement -->
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle"></i>
                    <strong>Attention :</strong> La restauration remplacera le document actuel s'il existe.
                    Cette action est définitive et sera enregistrée dans l'historique.
                </div>
            </div>

            <div class="wizard-footer">
                <button type="button" class="btn btn-secondary" onclick="this.closeWizard()">
                    <i class="fa fa-times"></i> Annuler
                </button>
                <button type="button"
                        class="btn btn-success"
                        onclick="this.confirmRestore()"
                        t-att-disabled="!state.restoreAction">
                    <i class="fa fa-undo"></i> Confirmer la restauration
                </button>
            </div>
        </div>
    </t>

    <!-- Template pour le wizard de statistiques -->
    <t t-name="construction_contact_extension.StatisticsWizard">
        <div class="statistics-wizard">
            <div class="wizard-header">
                <h4><i class="fa fa-bar-chart"></i> Générateur de Rapport Statistiques</h4>
                <p>Générez des rapports personnalisés selon vos critères.</p>
            </div>

            <div class="wizard-body">
                <!-- Sélection de la période -->
                <div class="form-group">
                    <label class="form-label-modern">Période d'analyse</label>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Date de début</label>
                            <input type="date"
                                   class="form-control-modern"
                                   t-model="state.startDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date de fin</label>
                            <input type="date"
                                   class="form-control-modern"
                                   t-model="state.endDate" />
                        </div>
                    </div>
                    <div class="period-shortcuts mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="this.setLastWeek()">
                            7 derniers jours
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="this.setLastMonth()">
                            30 derniers jours
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="this.setLastQuarter()">
                            3 derniers mois
                        </button>
                    </div>
                </div>

                <!-- Filtres -->
                <div class="form-group">
                    <label class="form-label-modern">Partenaires à inclure</label>
                    <select class="form-control-modern" multiple="multiple" t-model="state.selectedPartners">
                        <option t-foreach="state.availablePartners" t-as="partner"
                                t-key="partner.id"
                                t-att-value="partner.id"
                                t-esc="partner.name"></option>
                    </select>
                    <small class="form-text text-muted">
                        Laissez vide pour inclure tous les partenaires
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label-modern">Spécialités</label>
                    <select class="form-control-modern" multiple="multiple" t-model="state.selectedSpecialities">
                        <option t-foreach="state.availableSpecialities" t-as="speciality"
                                t-key="speciality.id"
                                t-att-value="speciality.id"
                                t-esc="speciality.name"></option>
                    </select>
                </div>

                <!-- Métriques à inclure -->
                <div class="form-group">
                    <label class="form-label-modern">Métriques à inclure</label>
                    <div class="metrics-grid">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="includeCompletion" t-model="state.includeCompletion" />
                            <label class="form-check-label" for="includeCompletion">Taux de complétude</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="includeHealthScore" t-model="state.includeHealthScore" />
                            <label class="form-check-label" for="includeHealthScore">Scores de santé</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="includeUploadTrends" t-model="state.includeUploadTrends" />
                            <label class="form-check-label" for="includeUploadTrends">Tendances d'upload</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="includeValidationTimes" t-model="state.includeValidationTimes" />
                            <label class="form-check-label" for="includeValidationTimes">Temps de validation</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="includeExpirations" t-model="state.includeExpirations" />
                            <label class="form-check-label" for="includeExpirations">Expirations</label>
                        </div>

                    </div>
                </div>

                <!-- Format de sortie -->
                <div class="form-group">
                    <label class="form-label-modern">Format de sortie</label>
                    <div class="form-check">
                        <input type="radio" class="form-check-input" id="formatPdf" name="outputFormat" value="pdf" t-model="state.outputFormat" />
                        <label class="form-check-label" for="formatPdf">PDF (Rapport détaillé)</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" class="form-check-input" id="formatExcel" name="outputFormat" value="excel" t-model="state.outputFormat" />
                        <label class="form-check-label" for="formatExcel">Excel (Données brutes)</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" class="form-check-input" id="formatBoth" name="outputFormat" value="both" t-model="state.outputFormat" />
                        <label class="form-check-label" for="formatBoth">Les deux formats</label>
                    </div>
                </div>

                <!-- Options avancées -->
                <div class="advanced-options">
                    <h6>Options avancées</h6>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="includeCharts" t-model="state.includeCharts" />
                        <label class="form-check-label" for="includeCharts">Inclure les graphiques</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="includeRecommendations" t-model="state.includeRecommendations" />
                        <label class="form-check-label" for="includeRecommendations">Inclure les recommandations</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="anonymizeData" t-model="state.anonymizeData" />
                        <label class="form-check-label" for="anonymizeData">Anonymiser les données sensibles</label>
                    </div>
                </div>

                <!-- Aperçu de la sélection -->
                <div class="selection-preview" t-if="hasValidSelection()">
                    <h6>Aperçu de la sélection</h6>
                    <div class="preview-stats">
                        <span class="badge badge-primary">
                            <t t-esc="getSelectedPartnersCount()"/> partenaire(s)
                        </span>
                        <span class="badge badge-info">
                            <t t-esc="getSelectedSpecialitiesCount()"/> spécialité(s)
                        </span>
                        <span class="badge badge-success">
                            <t t-esc="getSelectedMetricsCount()"/> métrique(s)
                        </span>
                    </div>
                </div>
            </div>

            <div class="wizard-footer">
                <button type="button" class="btn btn-secondary" onclick="this.closeWizard()">
                    <i class="fa fa-times"></i> Annuler
                </button>
                <button type="button"
                        class="btn btn-primary"
                        onclick="this.generateReport()"
                        t-att-disabled="!canGenerateReport()">
                    <i class="fa fa-file-text"></i> Générer le rapport
                </button>
            </div>
        </div>
    </t>

</templates>
