<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vue liste des types de documents -->
        <record id="view_document_type_list" model="ir.ui.view">
            <field name="name">document.type.list</field>
            <field name="model">document.type</field>
            <field name="arch" type="xml">
                <list string="Types de Documents" create="true" delete="true">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="is_mandatory" widget="boolean"/>
                    <field name="has_expiry" widget="boolean"/>
                    <field name="validity_period_months"/>
                    <field name="allowed_file_types"/>
                    <field name="max_file_size_mb" widget="float"/>
                    <field name="active" widget="boolean"/>

                    <!-- Actions -->
                    <button name="action_duplicate" type="object"
                            string="Dupliquer"
                            class="btn btn-sm btn-outline-secondary"
                            icon="fa-copy"/>
                    <button name="action_toggle_active" type="object"
                            string="Activer/Désactiver"
                            class="btn btn-sm btn-outline-warning"
                            icon="fa-power-off"/>
                </list>
            </field>
        </record>

        <!-- Vue formulaire des types de documents -->
        <record id="view_document_type_form" model="ir.ui.view">
            <field name="name">document.type.form</field>
            <field name="model">document.type</field>
            <field name="arch" type="xml">
                <form string="Type de Document">
                    <header>
                        <button name="action_create_default_documents" string="Créer Documents par Défaut"
                                type="object" class="btn-primary"
                                invisible="not is_mandatory"
                                groups="construction_contact_extension.group_subcontractor_manager"/>
                        <button name="action_validate_all_pending" string="Valider Tous en Attente"
                                type="object" class="btn-success"
                                groups="construction_contact_extension.group_document_validator"/>
                        <field name="active" widget="boolean_button"
                               options="{'terminology': 'active'}"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="ex: Carte d'identité"/>
                            </h1>
                            <h2>
                                <field name="code" required="1" placeholder="ex: identity_card"/>
                            </h2>
                        </div>

                        <group>
                            <group string="Informations Générales">
                                <field name="sequence"/>
                                <field name="description" widget="text"/>
                                <field name="category"/>
                                <field name="is_mandatory"/>
                                <field name="is_system" readonly="1" groups="base.group_system"/>
                            </group>

                            <group string="Gestion de l'Expiration">
                                <field name="has_expiry"/>
                                <field name="validity_period_months"
                                       required="has_expiry"
                                       invisible="not has_expiry"/>
                                <field name="expiry_warning_days"
                                       invisible="not has_expiry"/>
                                <field name="require_expiry_date"
                                       invisible="not has_expiry"/>
                                <field name="auto_calculate_expiry"
                                       invisible="not has_expiry"/>
                            </group>
                        </group>

                        <group>
                            <group string="Contraintes de Fichier">
                                <field name="allowed_file_types"
                                       placeholder=".pdf,.jpg,.jpeg,.png"/>
                                <field name="max_file_size_mb" widget="float"/>
                                <field name="require_digital_signature"/>
                                <field name="allow_multiple_files"/>
                            </group>

                            <group string="Spécialités Concernées">
                                <field name="required_for_specialities"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <field name="optional_for_specialities"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Instructions d'Upload" name="upload_instructions">
                                <field name="upload_instructions" widget="html"
                                       placeholder="Instructions détaillées pour l'utilisateur lors de l'upload..."/>
                            </page>

                            <page string="Checklist de Validation" name="validation_checklist">
                                <field name="validation_checklist" widget="html"
                                       placeholder="Points de contrôle pour la validation du document..."/>
                            </page>

                            <page string="Configuration Avancée" name="advanced_config">
                                <group>
                                    <group string="Validation Automatique">
                                        <field name="auto_validation_enabled"/>
                                        <field name="validation_rules"
                                               widget="text"
                                               invisible="not auto_validation_enabled"/>
                                        <field name="require_manual_review"
                                               invisible="not auto_validation_enabled"/>
                                    </group>

                                    <group string="Notifications">
                                        <field name="send_upload_confirmation"/>
                                        <field name="send_validation_notification"/>
                                        <field name="send_expiry_reminders"
                                               invisible="not has_expiry"/>
                                        <field name="reminder_template_id"
                                               invisible="not send_expiry_reminders"/>
                                    </group>
                                </group>

                                <group string="Intégrations Externes">
                                    <field name="external_validation_api"/>
                                    <field name="api_endpoint"
                                           invisible="not external_validation_api"/>
                                    <field name="api_key" password="True"
                                           invisible="not external_validation_api"/>
                                </group>
                            </page>

                            <page string="Statistiques" name="statistics">
                                <group>
                                    <group string="Utilisation">
                                        <field name="document_count" readonly="1"/>
                                        <field name="valid_document_count" readonly="1"/>
                                        <field name="pending_document_count" readonly="1"/>
                                        <field name="rejected_document_count" readonly="1"/>
                                    </group>

                                    <group string="Métriques">
                                        <field name="average_validation_time" readonly="1" widget="float"/>
                                        <field name="rejection_rate" readonly="1" widget="progressbar"/>
                                        <field name="compliance_rate" readonly="1" widget="progressbar"/>
                                    </group>
                                </group>

                                <div class="mt-3">
                                    <button name="action_view_documents" string="Voir Tous les Documents"
                                            type="object" class="btn btn-outline-primary"/>
                                    <button name="action_generate_statistics_report" string="Générer Rapport"
                                            type="object" class="btn btn-outline-secondary"/>
                                </div>
                            </page>
                        </notebook>
                    </sheet>

                    <!-- Chatter -->
                   <chatter>

                   </chatter>
                </form>
            </field>
        </record>

        <!-- Vue recherche -->
        <record id="view_document_type_search" model="ir.ui.view">
            <field name="name">document.type.search</field>
            <field name="model">document.type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="category"/>

                    <!-- Filtres -->
                    <filter string="Obligatoires" name="mandatory"
                            domain="[('is_mandatory', '=', True)]"/>
                    <filter string="Optionnels" name="optional"
                            domain="[('is_mandatory', '=', False)]"/>
                    <filter string="Avec Expiration" name="with_expiry"
                            domain="[('has_expiry', '=', True)]"/>
                    <filter string="Sans Expiration" name="without_expiry"
                            domain="[('has_expiry', '=', False)]"/>

                    <separator/>
                    <filter string="Actifs" name="active"
                            domain="[('active', '=', True)]"/>
                    <filter string="Inactifs" name="inactive"
                            domain="[('active', '=', False)]"/>

                    <!-- Filtres par catégorie -->
                    <separator/>
                    <filter string="Identité" name="identity"
                            domain="[('category', '=', 'identity')]"/>
                    <filter string="Légal" name="legal"
                            domain="[('category', '=', 'legal')]"/>
                    <filter string="Financier" name="financial"
                            domain="[('category', '=', 'financial')]"/>
                    <filter string="Assurance" name="insurance"
                            domain="[('category', '=', 'insurance')]"/>
                    <filter string="Technique" name="technical"
                            domain="[('category', '=', 'technical')]"/>

                    <!-- Groupes -->
                    <group expand="0" string="Group By">
                        <filter string="Catégorie" name="group_by_category"
                                context="{'group_by': 'category'}"/>
                        <filter string="Obligatoire" name="group_by_mandatory"
                                context="{'group_by': 'is_mandatory'}"/>
                        <filter string="Expiration" name="group_by_expiry"
                                context="{'group_by': 'has_expiry'}"/>
                        <filter string="Statut" name="group_by_active"
                                context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Vue kanban -->
        <record id="view_document_type_kanban" model="ir.ui.view">
            <field name="name">document.type.kanban</field>
            <field name="model">document.type</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="is_mandatory"/>
                    <field name="has_expiry"/>
                    <field name="document_count"/>
                    <field name="active"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="code"/>
                                        </small>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <div class="o_kanban_record_subtitle">
                                            <t t-if="record.is_mandatory.raw_value">
                                                <span class="badge badge-success">Obligatoire</span>
                                            </t>
                                            <t t-if="record.has_expiry.raw_value">
                                                <span class="badge badge-warning">Expire</span>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-6">
                                            <button class="btn btn-primary btn-sm" type="object" name="action_view_documents">
                                                <i class="fa fa-files-o"/> <field name="document_count"/> docs
                                            </button>
                                        </div>
                                        <div class="col-6 text-right">
                                            <t t-if="!record.active.raw_value">
                                                <span class="badge badge-secondary">Inactif</span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action principale -->
        <record id="action_document_type" model="ir.actions.act_window">
            <field name="name">Types de Documents</field>
            <field name="res_model">document.type</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer votre premier type de document
                </p>
                <p>
                    Les types de documents définissent les exigences pour chaque document requis des sous-traitants.
                </p>
            </field>
        </record>

    </data>
</odoo>
