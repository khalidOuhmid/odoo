<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Cron pour vérifier les documents expirés -->
        <record id="cron_check_expired_documents" model="ir.cron">
            <field name="name">Vérification Documents Expirés</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_documents()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">5</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
        </record>

        <!-- Cron pour envoyer les notifications d'expiration -->
        <record id="cron_send_expiry_notifications" model="ir.cron">
            <field name="name">Notifications Expiration Documents</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_expiry_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=9)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">6</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
        </record>



        <!-- Cron pour nettoyer les tokens expirés -->
        <record id="cron_cleanup_expired_tokens" model="ir.cron">
            <field name="name">Nettoyage Tokens Expirés</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_expired_tokens()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">8</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>

        </record>

        <!-- Cron pour archiver automatiquement les anciens documents -->
        <record id="cron_auto_archive_old_documents" model="ir.cron">
            <field name="name">Archivage Automatique Documents Anciens</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_archive_old_documents()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=7, hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">9</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>

        </record>

        <!-- Cron pour calculer les scores de santé -->
        <record id="cron_calculate_health_scores" model="ir.cron">
            <field name="name">Calcul Scores Santé Partenaires</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_calculate_health_scores()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>

        </record>

        <!-- Cron pour envoyer les rappels hebdomadaires -->
        <record id="cron_weekly_reminders" model="ir.cron">
            <field name="name">Rappels Hebdomadaires Documents</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_weekly_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=9, minute=0) + timedelta(days=(6-DateTime.now().weekday()))).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">11</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>

        </record>

        <!-- Cron pour supprimer définitivement les anciennes archives -->
        <record id="cron_permanent_delete_old_archives" model="ir.cron">
            <field name="name">Suppression Définitive Anciennes Archives</field>
            <field name="model_id" ref="model_document_archive"/>
            <field name="state">code</field>
            <field name="code">model._cron_permanent_delete_old_archives()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=3, minute=0) + timedelta(days=32)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">12</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>

        </record>

        <!-- Cron pour générer les statistiques mensuelles -->
        <record id="cron_generate_monthly_stats" model="ir.cron">
            <field name="name">Génération Statistiques Mensuelles</field>
            <field name="model_id" ref="model_partner_notification_service"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_statistics()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=6, minute=0) + timedelta(days=32)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">13</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
        </record>

        <!-- Cron pour vérifier l'intégrité des fichiers -->
        <record id="cron_check_file_integrity" model="ir.cron">
            <field name="name">Vérification Intégrité Fichiers</field>
            <field name="model_id" ref="model_partner_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_file_integrity()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=7, hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">14</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
        </record>

        <!-- Cron pour optimiser la base de données -->
        <record id="cron_optimize_database" model="ir.cron">
            <field name="name">Optimisation Base de Données Documents</field>
            <field name="model_id" ref="model_document_archive"/>
            <field name="state">code</field>
            <field name="code">model._cron_optimize_database()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=15, hour=2, minute=0) + timedelta(days=32)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">15</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
