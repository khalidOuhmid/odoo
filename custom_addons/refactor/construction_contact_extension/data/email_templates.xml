<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Template pour demande de documents manquants -->
        <record id="email_template_partner_document_request" model="mail.template">
            <field name="name">Demande Documents Sous-traitant</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">📋 Documents administratifs requis - ${object.name}</field>
            <field name="email_from">${object.company_id.email or 'noreply@blggroupe.com'}</field>
            <field name="email_to">${object.email}</field>
            <field name="partner_to">${object.id}</field>
            <field name="body_html"><![CDATA[
                <div style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #f8fafc 0%, #e3f0ff 100%); min-height: 100vh;">
                    <div style="max-width: 600px; margin: 0 auto; padding: 20px;">

                        <!-- Header -->
                        <div style="background: white; border-radius: 12px 12px 0 0; padding: 30px; text-align: center; border-bottom: 3px solid #1e40af;">
                            <img src="/web/static/img/logo.png" alt="BLG Groupe" style="height: 50px; margin-bottom: 20px;">
                            <h1 style="color: #1e40af; margin: 0; font-size: 24px; font-weight: 700;">
                                Documents Administratifs Requis
                            </h1>
                        </div>

                        <!-- Content -->
                        <div style="background: white; padding: 30px; margin: 0;">
                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 20px;">
                                Bonjour <strong>${object.name}</strong>,
                            </p>

                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 25px;">
                                Dans le cadre de notre collaboration, nous avons besoin que vous nous transmettiez
                                certains documents administratifs obligatoires pour la constitution de votre dossier.
                            </p>

                            <!-- Documents manquants -->
                            <div style="background: #fef2f2; border-left: 4px solid #dc2626; padding: 20px; margin: 25px 0; border-radius: 0 8px 8px 0;">
                                <h3 style="color: #b91c1c; margin: 0 0 15px 0; font-size: 18px;">
                                    📋 Documents manquants :
                                </h3>
                                <ul style="margin: 0; padding-left: 20px; color: #374151;">
                                    <li style="margin-bottom: 8px; font-size: 15px;">Carte d'identité</li>
                                    <li style="margin-bottom: 8px; font-size: 15px;">Certificat URSSAF</li>
                                    <li style="margin-bottom: 8px; font-size: 15px;">Extrait KBIS</li>
                                    <li style="margin-bottom: 8px; font-size: 15px;">Certificat d'assurance</li>
                                    <li style="margin-bottom: 8px; font-size: 15px;">RIB</li>
                                </ul>
                            </div>

                            <!-- Call to Action -->
                            <div style="text-align: center; margin: 30px 0;">
                                <a href="${ctx.get('upload_link', '#')}"
                                   style="display: inline-block; background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%); color: white; text-decoration: none; padding: 15px 30px; border-radius: 8px; font-weight: 600; font-size: 16px; box-shadow: 0 4px 14px rgba(30, 64, 175, 0.25);">
                                    🔗 Téléverser mes documents
                                </a>
                            </div>

                            <!-- Instructions -->
                            <div style="background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 20px; margin: 25px 0;">
                                <h4 style="color: #0369a1; margin: 0 0 15px 0; font-size: 16px;">
                                    ℹ️ Instructions importantes :
                                </h4>
                                <ul style="margin: 0; padding-left: 20px; color: #374151; font-size: 14px;">
                                    <li style="margin-bottom: 8px;">Formats acceptés : PDF, JPG, PNG</li>
                                    <li style="margin-bottom: 8px;">Taille maximum : 10 MB par fichier</li>
                                    <li style="margin-bottom: 8px;">Vérifiez que tous les documents soient lisibles</li>
                                    <li style="margin-bottom: 8px;">Les documents doivent être en cours de validité</li>
                                </ul>
                            </div>

                            <!-- Délai -->
                            <div style="background: #fefce8; border: 1px solid #fde047; border-radius: 8px; padding: 15px; margin: 20px 0; text-align: center;">
                                <p style="margin: 0; color: #a16207; font-size: 14px;">
                                    ⏰ Ce lien est valide pendant 7 jours
                                </p>
                            </div>

                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-top: 25px;">
                                Si vous rencontrez des difficultés ou avez des questions, n'hésitez pas à nous contacter.
                            </p>

                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 0;">
                                Cordialement,<br/>
                                <strong>L'équipe BLG Groupe</strong>
                            </p>
                        </div>

                        <!-- Footer -->
                        <div style="background: #f8fafc; border-radius: 0 0 12px 12px; padding: 20px; text-align: center; border-top: 1px solid #e5e7eb;">
                            <p style="margin: 0; color: #6b7280; font-size: 12px;">
                                📧 ${object.company_id.email or 'contact@blggroupe.com'} |
                                📞 ${object.company_id.phone or '01 23 45 67 89'} |
                                🌐 ${object.company_id.website or 'www.blggroupe.com'}
                            </p>
                            <p style="margin: 10px 0 0 0; color: #9ca3af; font-size: 11px;">
                                Cet email a été envoyé automatiquement, merci de ne pas y répondre directement.
                            </p>
                        </div>
                    </div>
                </div>
            ]]></field>
            <field name="auto_delete">False</field>
            <field name="lang">fr_FR</field>
        </record>

        <!-- Template pour rejet de document -->
        <record id="email_template_document_rejection" model="mail.template">
            <field name="name">Rejet Document Sous-traitant</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">❌ Document rejeté - ${ctx.get('document_type', 'Document')} - ${object.name}</field>
            <field name="email_from">${object.company_id.email or 'noreply@blggroupe.com'}</field>
            <field name="email_to">${object.email}</field>
            <field name="partner_to">${object.id}</field>
            <field name="body_html"><![CDATA[
                <div style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #f8fafc 0%, #e3f0ff 100%); min-height: 100vh;">
                    <div style="max-width: 600px; margin: 0 auto; padding: 20px;">

                        <!-- Header -->
                        <div style="background: white; border-radius: 12px 12px 0 0; padding: 30px; text-align: center; border-bottom: 3px solid #dc2626;">
                            <img src="/web/static/img/logo.png" alt="BLG Groupe" style="height: 50px; margin-bottom: 20px;">
                            <h1 style="color: #dc2626; margin: 0; font-size: 24px; font-weight: 700;">
                                Document Rejeté
                            </h1>
                        </div>

                        <!-- Content -->
                        <div style="background: white; padding: 30px; margin: 0;">
                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 20px;">
                                Bonjour <strong>${object.name}</strong>,
                            </p>

                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 25px;">
                                Nous avons examiné le document <strong>${ctx.get('document_type', 'Document')}</strong>
                                que vous avez téléversé, mais malheureusement nous ne pouvons pas l'accepter en l'état.
                            </p>

                            <!-- Raison du rejet -->
                            <div style="background: #fef2f2; border-left: 4px solid #dc2626; padding: 20px; margin: 25px 0; border-radius: 0 8px 8px 0;">
                                <h3 style="color: #b91c1c; margin: 0 0 10px 0; font-size: 18px;">
                                    Raison du rejet :
                                </h3>
                                <p style="margin: 0; color: #374151; font-size: 15px; font-weight: 600;">
                                    ${ctx.get('rejection_reason', 'Non spécifiée')}
                                </p>
                                % if ctx.get('rejection_details'):
                                <p style="margin: 15px 0 0 0; color: #374151; font-size: 14px; line-height: 1.5;">
                                    ${ctx.get('rejection_details')}
                                </p>
                                % endif
                            </div>

                            <!-- Actions requises -->
                            % if ctx.get('required_actions'):
                            <div style="background: #eff6ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 20px; margin: 25px 0;">
                                <h4 style="color: #0369a1; margin: 0 0 15px 0; font-size: 16px;">
                                    🔧 Actions à effectuer :
                                </h4>
                                <div style="color: #374151; font-size: 14px; line-height: 1.5;">
                                    ${ctx.get('required_actions')}
                                </div>
                            </div>
                            % endif

                            <!-- Nouvelle soumission -->
                            <div style="text-align: center; margin: 30px 0;">
                                % if ctx.get('upload_link'):
                                <a href="${ctx.get('upload_link')}"
                                   style="display: inline-block; background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: white; text-decoration: none; padding: 15px 30px; border-radius: 8px; font-weight: 600; font-size: 16px; box-shadow: 0 4px 14px rgba(22, 163, 74, 0.25);">
                                    🔄 Soumettre un nouveau document
                                </a>
                                % endif
                            </div>

                            <!-- Compteur de rejets -->
                            % if ctx.get('rejection_count', 0) > 1:
                            <div style="background: #fefce8; border: 1px solid #fde047; border-radius: 8px; padding: 15px; margin: 20px 0; text-align: center;">
                                <p style="margin: 0; color: #a16207; font-size: 14px;">
                                    ⚠️ Ceci est le <strong>${ctx.get('rejection_count', 1)}ème rejet</strong> pour ce type de document.
                                    Merci de porter une attention particulière aux instructions.
                                </p>
                            </div>
                            % endif

                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-top: 25px;">
                                Si vous avez des questions sur les exigences ou rencontrez des difficultés,
                                n'hésitez pas à nous contacter.
                            </p>

                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 0;">
                                Cordialement,<br/>
                                <strong>L'équipe BLG Groupe</strong>
                            </p>
                        </div>

                        <!-- Footer -->
                        <div style="background: #f8fafc; border-radius: 0 0 12px 12px; padding: 20px; text-align: center; border-top: 1px solid #e5e7eb;">
                            <p style="margin: 0; color: #6b7280; font-size: 12px;">
                                📧 ${object.company_id.email or 'contact@blggroupe.com'} |
                                📞 ${object.company_id.phone or '01 23 45 67 89'} |
                                🌐 ${object.company_id.website or 'www.blggroupe.com'}
                            </p>
                        </div>
                    </div>
                </div>
            ]]></field>
            <field name="auto_delete">False</field>
            <field name="lang">fr_FR</field>
        </record>

        <!-- Template pour expiration de documents -->
        <record id="email_template_document_expiry" model="mail.template">
            <field name="name">Expiration Document Sous-traitant</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">⏰ Document expirant bientôt - ${ctx.get('document_type', 'Document')} - ${object.name}</field>
            <field name="email_from">${object.company_id.email or 'noreply@blggroupe.com'}</field>
            <field name="email_to">${object.email}</field>
            <field name="partner_to">${object.id}</field>
            <field name="body_html"><![CDATA[
                <div style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #f8fafc 0%, #e3f0ff 100%); min-height: 100vh;">
                    <div style="max-width: 600px; margin: 0 auto; padding: 20px;">

                        <!-- Header -->
                        <div style="background: white; border-radius: 12px 12px 0 0; padding: 30px; text-align: center; border-bottom: 3px solid #eab308;">
                            <img src="/web/static/img/logo.png" alt="BLG Groupe" style="height: 50px; margin-bottom: 20px;">
                            <h1 style="color: #a16207; margin: 0; font-size: 24px; font-weight: 700;">
                                Document Expirant Bientôt
                            </h1>
                        </div>

                        <!-- Content -->
                        <div style="background: white; padding: 30px; margin: 0;">
                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 20px;">
                                Bonjour <strong>${object.name}</strong>,
                            </p>

                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 25px;">
                                Nous souhaitons vous informer que votre document
                                <strong>${ctx.get('document_type', 'Document')}</strong>
                                expire bientôt et nécessite un renouvellement.
                            </p>

                            <!-- Détails expiration -->
                            <div style="background: #fefce8; border-left: 4px solid #eab308; padding: 20px; margin: 25px 0; border-radius: 0 8px 8px 0;">
                                <h3 style="color: #a16207; margin: 0 0 15px 0; font-size: 18px;">
                                    📅 Informations d'expiration :
                                </h3>
                                <ul style="margin: 0; padding-left: 20px; color: #374151;">
                                    <li style="margin-bottom: 8px; font-size: 15px;">
                                        <strong>Document :</strong> ${ctx.get('document_type', 'Non spécifié')}
                                    </li>
                                    <li style="margin-bottom: 8px; font-size: 15px;">
                                        <strong>Date d'expiration :</strong> ${ctx.get('expiry_date', 'Non spécifiée')}
                                    </li>
                                    <li style="margin-bottom: 8px; font-size: 15px;">
                                        <strong>Jours restants :</strong>
                                        <span style="color: ${ctx.get('urgency_level') == 'high' and '#dc2626' or '#a16207'}; font-weight: 600;">
                                            ${ctx.get('days_until_expiry', 'N/A')} jour(s)
                                        </span>
                                    </li>
                                </ul>
                            </div>

                            <!-- Urgence -->
                            % if ctx.get('urgency_level') == 'high':
                            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 15px; margin: 20px 0; text-align: center;">
                                <p style="margin: 0; color: #b91c1c; font-size: 16px; font-weight: 600;">
                                    🚨 URGENT : Ce document expire dans moins de 7 jours !
                                </p>
                            </div>
                            % endif

                            <!-- Action -->
                            <div style="text-align: center; margin: 30px 0;">
                                <a href="#"
                                   style="display: inline-block; background: linear-gradient(135deg, #eab308 0%, #d97706 100%); color: white; text-decoration: none; padding: 15px 30px; border-radius: 8px; font-weight: 600; font-size: 16px; box-shadow: 0 4px 14px rgba(234, 179, 8, 0.25);">
                                    📄 Renouveler le document
                                </a>
                            </div>

                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-top: 25px;">
                                Pour maintenir la validité de votre dossier et éviter toute interruption
                                de notre collaboration, merci de nous transmettre le document renouvelé
                                dès que possible.
                            </p>

                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 0;">
                                Cordialement,<br/>
                                <strong>L'équipe BLG Groupe</strong>
                            </p>
                        </div>

                        <!-- Footer -->
                        <div style="background: #f8fafc; border-radius: 0 0 12px 12px; padding: 20px; text-align: center; border-top: 1px solid #e5e7eb;">
                            <p style="margin: 0; color: #6b7280; font-size: 12px;">
                                📧 ${object.company_id.email or 'contact@blggroupe.com'} |
                                📞 ${object.company_id.phone or '01 23 45 67 89'} |
                                🌐 ${object.company_id.website or 'www.blggroupe.com'}
                            </p>
                        </div>
                    </div>
                </div>
            ]]></field>
            <field name="auto_delete">False</field>
            <field name="lang">fr_FR</field>
        </record>

    </data>
</odoo>
