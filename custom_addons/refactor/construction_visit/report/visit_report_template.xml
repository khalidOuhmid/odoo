<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_visit_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Rapport de Visite : <span t-field="doc.name"/></h2>
                <div class="row mt-4">
                    <div class="col-6">
                        <strong>Chantier:</strong> <span t-field="doc.chantier_id.name"/><br/>
                        <strong>Date:</strong> <span t-field="doc.date"/>
                    </div>
                     <div class="col-6">
                        <strong>Conduit par:</strong> <span t-field="doc.user_id.name"/><br/>
                        <strong>Participants:</strong> <span t-foreach="doc.attendee_ids" t-as="p"><span t-esc="p.name"/>, </span>
                    </div>
                </div>
                
                <div class="mt-4">
                    <h3>Observations</h3>
                    <div t-field="doc.observations"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_visit">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="construction_visit.report_visit_document"/>
            </t>
        </t>
    </template>
</odoo>
