<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_dgd_form" model="ir.ui.view">
        <field name="name">construction.dgd.form</field>
        <field name="model">construction.dgd</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Valider" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                         <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="chantier_id"/>
                        <field name="partner_id"/>
                        <field name="date"/>
                    </group>
                    <group string="Calcul du Solde">
                        <field name="total_works_amount"/>
                        <field name="total_paid_advances"/>
                        <field name="penalties_amount"/>
                        <field name="prorata_account"/>
                        <field name="final_balance" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_construction_dgd" model="ir.actions.act_window">
        <field name="name">DGD (Décomptes)</field>
        <field name="res_model">construction.dgd</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dgd"
              name="DGD"
              parent="menu_finance_root"
              action="action_construction_dgd"
              sequence="20"/>
</odoo>
