<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SAP/Pro Style Layout -->
    <template id="external_layout_construction_pro">
        <div class="header">
            <div class="row">
                <div class="col-6">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px;" alt="Logo"/>
                </div>
                <div class="col-6 text-end">
                    <h5 t-field="company.name" class="text-uppercase fw-bold text-primary"/>
                    <div class="small text-muted">
                        <span t-field="company.street"/><br/>
                        <span t-field="company.zip"/> <span t-field="company.city"/>
                    </div>
                </div>
            </div>
            <div class="row mt-2" style="border-top: 3px solid #E95420;"> <!-- Grenot Orange -->
                <div class="col-12"></div>
            </div>
        </div>

        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <t t-call="web.address_layout"/>
            <t t-raw="0"/>
        </div>

        <div class="footer o_standard_footer">
            <div class="row mt-4 mb-2" style="border-top: 1px solid #333;">
                <div class="col-4">
                    <span class="fw-bold" style="color: #002B5C;">BLG Construct</span> <!-- BLG Navy -->
                </div>
                <div class="col-4 text-center text-muted small">
                    SIRET: <span t-field="company.vat"/>
                </div>
                <div class="col-4 text-end small">
                    Page <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </template>
    
    <!-- Report Action: Contract -->
    <record id="action_report_contract" model="ir.actions.report">
        <field name="name">Contrat de Sous-Traitance</field>
        <field name="model">construction.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construction_contract.report_contract_document</field>
        <field name="report_file">construction_contract.report_contract_document</field>
        <field name="binding_model_id" ref="model_construction_contract"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Report Template: Contract -->
    <template id="report_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="construction_contract.external_layout_construction_pro">
                    <div class="page font-size-14">
                        <div class="row mb-5 mt-4">
                            <div class="col-12 text-center">
                                <h2 class="text-uppercase fw-bold" style="letter-spacing: 2px;">Contrat de Sous-Traitance</h2>
                                <h4 class="text-muted"><span t-field="doc.name"/></h4>
                            </div>
                        </div>

                        <!-- Info Table -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div class="card p-3 border-0 bg-light">
                                    <strong class="text-primary text-uppercase">Entreprise (Donneur d'ordre)</strong>
                                    <div t-field="doc.chantier_id.partner_id" class="mt-2"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="card p-3 border-0 bg-light">
                                    <strong class="text-warning text-uppercase" style="color: #E95420 !important;">Sous-Traitant</strong>
                                    <div t-field="doc.partner_id" class="mt-2"/>
                                </div>
                            </div>
                        </div>

                        <!-- Content Mockup -->
                        <div class="row">
                            <div class="col-12">
                                <p><strong>Objet du Marché :</strong> Travaux de <span t-field="doc.lot_id.name"/></p>
                                <p><strong>Chantier :</strong> <span t-field="doc.chantier_id.name"/></p>
                                <p><strong>Montant HT :</strong> <span t-field="doc.amount_ht" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' class="fw-bold"/></p>
                                
                                <div class="alert alert-secondary mt-4">
                                    Le présent contrat est régi par les conditions générales ci-annexées...
                                </div>
                            </div>
                        </div>

                        <!-- Signatures -->
                         <div class="row mt-5" style="page-break-inside: avoid;">
                            <div class="col-6">
                                <p class="fw-bold mb-5">Pour l'Entreprise :</p>
                                <div style="border-bottom: 1px dotted #000; height: 50px;"></div>
                            </div>
                             <div class="col-6">
                                <p class="fw-bold mb-5">Pour le Sous-Traitant :</p>
                                <div t-if="doc.date_signature">
                                    Signé le <span t-field="doc.date_signature"/>
                                    <!-- Only show "Signed" stamp if electronically signed -->
                                    <div t-if="doc.state in ['signed']" style="color: green; border: 2px solid green; display: inline-block; padding: 5px; transform: rotate(-10deg); margin-top: -30px;">
                                        SIGNÉ NUMÉRIQUEMENT
                                    </div>
                                </div>
                                <div t-else="" style="border-bottom: 1px dotted #000; height: 50px;"></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
