<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_contract_signature" model="mail.template">
            <field name="name">Contrat Sous-traitance - Demande de Signature</field>
            <field name="model_id" ref="model_construction_contract"/>
            <field name="subject">Signature de votre contrat de sous-traitance {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Bonjour <t t-out="object.partner_id.name or ''">Cher Partenaire</t>,<br/><br/>
                        Veuillez trouver ci-joint votre contrat de sous-traitance <strong><t t-out="object.name or ''">REF</t></strong>
                        pour le chantier <strong><t t-out="object.chantier_id.name or ''">Chantier</t></strong>.
                        <br/><br/>
                        Merci de bien vouloir le signer électroniquement en cliquant sur le lien ci-dessous :
                        <br/><br/>
                        <div style="text-align: center; margin: 16px 0px;">
                            <a t-att-href="object.portal_url"
                                style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                Signer le Contrat
                            </a>
                        </div>
                        <br/>
                        Lien direct (si le bouton ne fonctionne pas) : <br/>
                        <t t-out="object.portal_url or ''">http://...</t>
                        <br/><br/>
                        Cordialement,
                        <br/>
                        <t t-out="object.company_id.name or ''">Votre Entreprise</t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
