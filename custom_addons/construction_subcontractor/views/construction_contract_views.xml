<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- Héritage de la vue liste construction_contract             -->
    <!-- Ajout de la colonne lot_names après subcontractor_id       -->
    <!-- ========================================================== -->
    <record id="view_construction_contract_tree_sub" model="ir.ui.view">
        <field name="name">construction.contract.tree.subcontractor</field>
        <field name="model">construction.contract</field>
        <field name="inherit_id" ref="construction_contract.view_construction_contract_tree"/>
        <field name="arch" type="xml">
            <field name="subcontractor_id" position="after">
                <field name="lot_names" string="Lots" optional="show"/>
                <field name="amount_total" string="Montant lots" widget="monetary" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- Action (réutilise les vues de construction_contract)       -->
    <!-- ========================================================== -->
    <record id="action_construction_contract" model="ir.actions.act_window">
        <field name="name">Contrats</field>
        <field name="res_model">construction.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_subcontractor': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun contrat de sous-traitance trouvé.
            </p>
        </field>
    </record>

</odoo>
