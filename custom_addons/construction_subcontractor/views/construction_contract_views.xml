<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CONTRACT SEARCH -->
    <record id="view_construction_contract_search" model="ir.ui.view">
        <field name="name">construction.contract.search</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <search string="Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="chantier_id"/>
                <filter string="Active" name="active_contracts" domain="[('state', 'in', ['signed', 'sent'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Subcontractor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Project" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- CONTRACT LIST -->
    <record id="view_construction_contract_list" model="ir.ui.view">
        <field name="name">construction.contract.list</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts" decoration-muted="state == 'cancel'" decoration-success="state == 'signed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="chantier_id"/>
                <field name="lot_ids" widget="many2many_tags"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount_tax_excluded" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- CONTRACT FORM -->
    <record id="view_construction_contract_form" model="ir.ui.view">
        <field name="name">construction.contract.form</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_sign" string="Sign Contract" type="object" class="oe_highlight" invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,signed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="chantier_id"/>
                            <field name="lot_ids" widget="many2many_tags" domain="[('chantier_id', '=', chantier_id)]" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="date_signed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Financial Terms" name="financial">
                            <group>
                                <field name="amount_tax_excluded"/>
                                <field name="amount_tax"/>
                                <field name="amount_total"/>
                                <field name="retention_guarantee_rate"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Documents" name="docs">
                            <!-- Placeholder for contract generated PDFs -->
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_construction_contract" model="ir.actions.act_window">
        <field name="name">Subcontractor Contracts</field>
        <field name="res_model">construction.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new contract
            </p>
        </field>
    </record>

    <record id="action_compliance_docs" model="ir.actions.act_window">
        <field name="name">Compliance Documents</field>
        <field name="res_model">construction.compliance.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENUS -->
     <menuitem id="menu_construction_subcontractor_root"
              name="Subcontractors"
              parent="construction_core.menu_construction_root"
              sequence="20"/>

    <menuitem id="menu_construction_contracts"
              name="Contracts"
              parent="menu_construction_subcontractor_root"
              action="action_construction_contract"
              sequence="10"/>

    <menuitem id="menu_construction_compliance"
              name="All Documents"
              parent="menu_construction_subcontractor_root"
              action="action_compliance_docs"
              sequence="20"/>
</odoo>
