<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_lot_form_subcontractor_inherit" model="ir.ui.view">
        <field name="name">construction.lot.form.subcontractor.inherit</field>
        <field name="model">construction.lot</field>
        <field name="inherit_id" ref="construction_core.view_construction_lot_form"/>
        <field name="arch" type="xml">
            <!-- Replace subcontractor_id with readonly version + Button + Compliance Display -->
            <xpath expr="//field[@name='subcontractor_id']" position="replace">
                <label for="subcontractor_id"/>
                <div class="o_row">
                    <field name="subcontractor_id" readonly="1" force_save="1"/>
                    <button name="%(construction_subcontractor.action_subcontractor_assignment_wizard)d" 
                            type="action" 
                            string="Assigner" 
                            icon="fa-user-plus"
                            class="btn-primary"
                            context="{'default_lot_id': id}"
                            invisible="execution_type == 'internal'"/>
                </div>
                
                <!-- Subcontractor Compliance Status -->
                <label for="subcontractor_compliance_state" 
                       invisible="not subcontractor_id"
                       string="Conformité"/>
                <div class="o_row" invisible="not subcontractor_id">
                    <!-- FIX: Use document_status with strict R/O/G logic -->
                    <field name="document_status" widget="badge"
                           decoration-success="document_status == 'success'"
                           decoration-warning="document_status == 'warning'"
                           decoration-danger="document_status == 'danger'"/>
                    
                    <field name="subcontractor_compliance_state" invisible="1"/> <!-- Hide old one -->
                    <field name="subcontractor_alert_level" widget="badge"
                           decoration-success="subcontractor_alert_level == 'green'"
                           decoration-warning="subcontractor_alert_level == 'yellow'"
                           decoration-danger="subcontractor_alert_level == 'red'"
                           invisible="not subcontractor_alert_level"/>
                </div>
                
                <!-- Document Expiry Warning -->
                <div colspan="2" class="alert alert-warning mb-0 mt-2" role="alert"
                     invisible="not subcontractor_doc_warning">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <strong>Alerte Documents :</strong>
                    <field name="subcontractor_doc_warning" widget="html" nolabel="1" class="mt-2"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

