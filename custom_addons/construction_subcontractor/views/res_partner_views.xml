<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========== RES.PARTNER TREE VIEW ========== -->
    <record id="view_partner_subcontractor_tree" model="ir.ui.view">
        <field name="name">res.partner.subcontractor.tree</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Sous-traitants" decoration-danger="compliance_state == 'expired'" decoration-warning="compliance_state == 'incomplete'">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="subcontractor_type"/>
                <field name="compliance_state" widget="badge" decoration-success="compliance_state == 'compliant'" decoration-danger="compliance_state == 'expired'" decoration-warning="compliance_state == 'incomplete'"/>
                <field name="contract_count"/>
            </list>
        </field>
    </record>

    <!-- ========== RES.PARTNER FORM VIEW EXTENSION ========== -->
    <record id="view_partner_subcontractor_form" model="ir.ui.view">
        <field name="name">res.partner.subcontractor.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add subcontractor checkbox after company type -->
            <field name="company_type" position="after">
                <field name="is_subcontractor"/>
                <field name="subcontractor_type" invisible="not is_subcontractor"/>
            </field>
            
            <!-- Add compliance badge in header -->
            <div name="button_box" position="inside">
                <button name="action_view_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not is_subcontractor">
                    <field name="contract_count" widget="statinfo" string="Contrats"/>
                </button>
                <button name="action_view_archives" type="object" class="oe_stat_button" icon="fa-archive" invisible="not is_subcontractor or archive_count == 0">
                    <field name="archive_count" widget="statinfo" string="Archives"/>
                </button>
                <button name="action_manual_cron_trigger" type="object" class="oe_stat_button" icon="fa-bell-o" 
                        invisible="not is_subcontractor"
                        groups="base.group_system"
                        title="Vérifier expirations et envoyer rappels (Manuel)">
                    <span class="o_stat_text">Rappels</span>
                </button>
            </div>
            
            <!-- Add Subcontractor tab -->
            <page name="internal_notes" position="before">
                <page string="Sous-traitant" name="subcontractor_page" invisible="not is_subcontractor or subcontractor_type == 'internal'">
                    <group>
                        <group string="Qualification">
                            <field name="specialty_lot_category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="lot_ids" widget="many2many_tags" readonly="1" string="Lots Assignés (Chantiers)"/>
                        </group>
                        <group string="Conformité &amp; Portail">
                            <field name="compliance_state" widget="badge" readonly="1"/>
                            <field name="alert_level" widget="badge" decoration-success="alert_level == 'green'" decoration-warning="alert_level == 'yellow'" decoration-danger="alert_level == 'red'"/>
                            <field name="reminder_count" readonly="1" string="Nb Rappels"/>
                            
                            <label for="upload_url" string="Lien Portail"/>
                            <div class="o_row">
                                <field name="upload_url" widget="CopyClipboardChar" readonly="1"/>
                                <button name="action_generate_upload_link" icon="fa-refresh" type="object" class="btn-link" title="Générer nouveau lien"/>
                                <button name="action_send_upload_request" icon="fa-envelope" type="object" class="btn-link" title="Envoyer par email"/>
                                <button name="action_send_upload_sms" icon="fa-mobile" type="object" class="btn-link" title="Envoyer par SMS"/>
                            </div>
                            
                            <label for="action_validate_all_documents" string="Actions"/>
                            <div>
                                <button name="action_validate_all_documents" 
                                        type="object" 
                                        string="✅ Tout Valider" 
                                        class="btn btn-outline-success btn-sm"
                                        confirm="Voulez-vous valider tous les documents présents ?"
                                        title="Valider tous les documents 'À vérifier'"/>
                            </div>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Documents Requis" name="documents">
                            <group>
                                <group string="Identité &amp; Juridique">
                                    <field name="company_registry" string="SIRET" placeholder="123 456 789 00012"/>
                                    <field name="doc_kbis" filename="doc_kbis_filename"/>
                                    <field name="doc_kbis_filename" invisible="1"/>
                                    <field name="doc_kbis_expiry"/>
                                    <div class="o_row">
                                        <field name="doc_kbis_status" widget="badge"/>
                                        <button name="action_open_validation_wizard" 
                                                type="object" 
                                                string="Verifier"
                                                icon="fa-check-circle"
                                                class="btn btn-primary btn-sm ms-2"
                                                title="Vérifier ce document"
                                                invisible="doc_kbis_status != 'to_check'"
                                                context="{'default_doc_type': 'kbis'}"/>
                                        <button name="action_request_document" 
                                                type="object" 
                                                string="Redemander"
                                                icon="fa-refresh"
                                                class="btn btn-warning btn-sm ms-2"
                                                title="Redemander ce document"
                                                confirm="Voulez-vous vraiment redemander ce document ? Le document actuel sera archive."
                                                invisible="doc_kbis_status not in ['valid', 'expired', 'expiring']"
                                                context="{'doc_type': 'kbis'}"/>
                                    </div>
                                    
                                    <separator/>
                                    
                                    <field name="doc_cni" filename="doc_cni_filename"/>
                                    <field name="doc_cni_filename" invisible="1"/>
                                    <field name="doc_cni_expiry"/>
                                    <div class="o_row">
                                        <field name="doc_cni_status" widget="badge"/>
                                        <button name="action_open_validation_wizard" 
                                                type="object" 
                                                string="Verifier"
                                                icon="fa-check-circle"
                                                class="btn btn-primary btn-sm ms-2"
                                                title="Vérifier ce document"
                                                invisible="doc_cni_status != 'to_check'"
                                                context="{'default_doc_type': 'cni'}"/>
                                        <button name="action_request_document" 
                                                type="object" 
                                                string="Redemander"
                                                icon="fa-refresh"
                                                class="btn btn-warning btn-sm ms-2"
                                                title="Redemander ce document"
                                                confirm="Voulez-vous vraiment redemander ce document ? Le document actuel sera archive."
                                                invisible="doc_cni_status not in ['valid', 'expired', 'expiring']"
                                                context="{'doc_type': 'cni'}"/>
                                    </div>
                                </group>
                                <group string="Assurances &amp; Fiscal">
                                    <field name="doc_insurance_dec" filename="doc_insurance_dec_filename"/>
                                    <field name="doc_insurance_dec_filename" invisible="1"/>
                                    <field name="doc_insurance_dec_expiry"/>
                                    <div class="o_row">
                                        <field name="doc_insurance_dec_status" widget="badge"/>
                                        <button name="action_open_validation_wizard" 
                                                type="object" 
                                                string="Verifier"
                                                icon="fa-check-circle"
                                                class="btn btn-primary btn-sm ms-2"
                                                title="Vérifier ce document"
                                                invisible="doc_insurance_dec_status != 'to_check'"
                                                context="{'default_doc_type': 'insurance_dec'}"/>
                                        <button name="action_request_document" 
                                                type="object" 
                                                string="Redemander"
                                                icon="fa-refresh"
                                                class="btn btn-warning btn-sm ms-2"
                                                title="Redemander ce document"
                                                confirm="Voulez-vous vraiment redemander ce document ? Le document actuel sera archive."
                                                invisible="doc_insurance_dec_status not in ['valid', 'expired', 'expiring']"
                                                context="{'doc_type': 'insurance_dec'}"/>
                                    </div>
                                    
                                    <separator/>
                                    
                                    <field name="doc_urssaf" filename="doc_urssaf_filename"/>
                                    <field name="doc_urssaf_filename" invisible="1"/>
                                    <field name="doc_urssaf_expiry"/>
                                    <div class="o_row">
                                        <field name="doc_urssaf_status" widget="badge"/>
                                        <button name="action_open_validation_wizard" 
                                                type="object" 
                                                string="Verifier"
                                                icon="fa-check-circle"
                                                class="btn btn-primary btn-sm ms-2"
                                                title="Vérifier ce document"
                                                invisible="doc_urssaf_status != 'to_check'"
                                                context="{'default_doc_type': 'urssaf'}"/>
                                        <button name="action_request_document" 
                                                type="object" 
                                                string="Redemander"
                                                icon="fa-refresh"
                                                class="btn btn-warning btn-sm ms-2"
                                                title="Redemander ce document"
                                                confirm="Voulez-vous vraiment redemander ce document ? Le document actuel sera archive."
                                                invisible="doc_urssaf_status not in ['valid', 'expired', 'expiring']"
                                                context="{'doc_type': 'urssaf'}"/>
                                    </div>
                                </group>
                            </group>
                            <group>
                                <group string="Bancaire (Optionnel)">
                                    <field name="doc_rib" filename="doc_rib_filename"/>
                                    <field name="doc_rib_filename" invisible="1"/>
                                    <div class="o_row">
                                        <field name="doc_rib_status" widget="badge"/>
                                        <button name="action_open_validation_wizard" 
                                                type="object" 
                                                string="Vérifier"
                                                icon="fa-check-circle"
                                                class="btn btn-primary btn-sm ms-2"
                                                title="Vérifier ce document"
                                                invisible="doc_rib_status != 'to_check'"
                                                context="{'default_doc_type': 'rib'}"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Archives Tab -->
                        <page string="📁 Archives" name="archives">
                            <field name="archive_ids" readonly="1">
                                <list string="Documents Archivés" decoration-info="reason == 'requested'" decoration-muted="reason == 'deleted'">
                                    <field name="document_type_display" string="Type"/>
                                    <field name="filename"/>
                                    <field name="expiry_date"/>
                                    <field name="archived_date"/>
                                    <field name="reason" widget="badge"/>
                                    <field name="replaced_by_filename" optional="show"/>
                                    <field name="was_validated" widget="boolean"/>
                                    <field name="validated_by_name" optional="hide"/>
                                    <field name="replaced_by_user_id" string="Archivé par"/>
                                    <button name="action_download" type="object" icon="fa-download" title="Télécharger"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </page>
        </field>
    </record>

    <!-- ========== SEARCH VIEW ========== -->
    <record id="view_partner_subcontractor_search" model="ir.ui.view">
        <field name="name">res.partner.subcontractor.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Sous-traitants">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <separator/>
                <filter string="Conformes" name="compliant" domain="[('compliance_state', '=', 'compliant')]"/>
                <filter string="Incomplets" name="incomplete" domain="[('compliance_state', '=', 'incomplete')]"/>
                <filter string="Documents expirés" name="expired" domain="[('compliance_state', '=', 'expired')]"/>
                <separator/>
                <filter string="Externes" name="external" domain="[('subcontractor_type', '=', 'external')]"/>
                <filter string="Internes" name="internal" domain="[('subcontractor_type', '=', 'internal')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="État conformité" name="group_compliance" context="{'group_by': 'compliance_state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'subcontractor_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========== ACTION ========== -->
    <record id="action_subcontractor_list" model="ir.actions.act_window">
        <field name="name">Sous-traitants</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_subcontractor', '=', True)]</field>
        <field name="context">{'default_is_subcontractor': True}</field>
        <field name="search_view_id" ref="view_partner_subcontractor_search"/>
    </record>

</odoo>
