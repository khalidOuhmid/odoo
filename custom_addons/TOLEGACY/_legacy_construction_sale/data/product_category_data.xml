<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Catégorie principale Construction -->
        <record id="product_category_construction" model="product.category">
            <field name="name">Construction</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>
        
        <!-- Sous-catégories par corps de métier -->
        <record id="product_category_demolition" model="product.category">
            <field name="name">Démolition</field>
            <field name="parent_id" ref="product_category_construction"/>
        </record>
        
        <record id="product_category_masonry" model="product.category">
            <field name="name">Maçonnerie</field>
            <field name="parent_id" ref="product_category_construction"/>
        </record>
        
        <record id="product_category_plumbing" model="product.category">
            <field name="name">Plomberie CVC</field>
            <field name="parent_id" ref="product_category_construction"/>
        </record>
        
        <record id="product_category_electrical" model="product.category">
            <field name="name">Électricité</field>
            <field name="parent_id" ref="product_category_construction"/>
        </record>
        
        <record id="product_category_joinery_ext" model="product.category">
            <field name="name">Menuiserie extérieure</field>
            <field name="parent_id" ref="product_category_construction"/>
        </record>
        
        <record id="product_category_joinery_int" model="product.category">
            <field name="name">Menuiserie intérieure</field>
            <field name="parent_id" ref="product_category_construction"/>
        </record>
        
        <record id="product_category_painting" model="product.category">
            <field name="name">Peinture &amp; finition</field>
            <field name="parent_id" ref="product_category_construction"/>
        </record>
        
        <record id="product_category_flooring" model="product.category">
            <field name="name">Sol souple et parquet</field>
            <field name="parent_id" ref="product_category_construction"/>
        </record>
        
        <record id="product_category_tiling" model="product.category">
            <field name="name">Carrelage &amp; faïence</field>
            <field name="parent_id" ref="product_category_construction"/>
        </record>
        
    </data>
</odoo> 