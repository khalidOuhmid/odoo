<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_template_user" model="res.groups">
        <field name="name">Templates: User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Can view and use document templates</field>
    </record>

    <record id="group_template_manager" model="res.groups">
        <field name="name">Templates: Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_template_user'))]"/>
        <field name="comment">Can create, edit and manage document templates</field>
    </record>

    <!-- Record Rules -->
    <record id="rule_template_company" model="ir.rule">
        <field name="name">Document Template: Company Rule</field>
        <field name="model_id" ref="model_construction_document_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_signature_zone_company" model="ir.rule">
        <field name="name">Signature Zone: Company Rule</field>
        <field name="model_id" ref="model_construction_signature_zone"/>
        <field name="domain_force">['|', ('template_id.company_id', '=', False), ('template_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_template_version_company" model="ir.rule">
        <field name="name">Template Version: Company Rule</field>
        <field name="model_id" ref="model_construction_template_version"/>
        <field name="domain_force">['|', ('template_id.company_id', '=', False), ('template_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
