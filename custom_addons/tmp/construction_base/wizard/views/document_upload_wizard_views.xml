<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vue formulaire pour l'assistant de téléchargement de documents -->
        <record id="view_document_upload_wizard_form" model="ir.ui.view">
            <field name="name">construction.document.upload.wizard.form</field>
            <field name="model">construction.document.upload.wizard</field>
            <field name="arch" type="xml">
                <form string="Ajouter un document">
                    <sheet>
                        <group>
                            <group>
                                <field name="chantier_id" readonly="1"/>
                                <field name="name" placeholder="Ex: Devis électricité..."/>
                                <field name="document_type"/>
                            </group>
                            <group>
                                <field name="partner_id" placeholder="Partenaire associé (optionnel)"/>
                                <field name="expiry_date"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="file_data" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        
                        <group>
                            <field name="description" placeholder="Description du document (optionnel)"/>
                        </group>
                    </sheet>
                    
                    <footer>
                        <button name="action_upload_document" 
                                string="Ajouter le document" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="Annuler" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action pour ouvrir l'assistant -->
        <record id="action_document_upload_wizard" model="ir.actions.act_window">
            <field name="name">Ajouter un document</field>
            <field name="res_model">construction.document.upload.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_chantier_id': active_id}</field>
        </record>

    </data>
</odoo>
