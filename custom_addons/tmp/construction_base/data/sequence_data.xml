<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Séquence pour les références de chantiers -->
        <record id="seq_construction_chantier" model="ir.sequence">
            <field name="name">Construction Chantier</field>
            <field name="code">construction.chantier</field>
            <field name="prefix">CH/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo> 