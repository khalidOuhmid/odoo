<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template pour l'envoi automatique des factures -->
        <record id="email_template_invoice_ready" model="mail.template">
            <field name="name">Facture prête - Envoi automatique</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Facture ${object.name} - ${object.partner_id.name}</field>
            <field name="email_from">${user.email}</field>
            <field name="email_to">${object.partner_id.email}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #20B2AA; color: white; padding: 20px; text-align: center;">
        <h1 style="margin: 0;">Facture</h1>
        <p style="margin: 5px 0;"><t t-out="user.company_id.name"/></p>
    </div>

    <div style="padding: 20px;">
        <p>Bonjour <strong><t t-out="object.partner_id.name"/></strong>,</p>

        <p>Veuillez trouver ci-joint votre facture <strong><t t-out="object.name"/></strong>.</p>

        <div style="background: #f8f9fa; padding: 15px; margin: 20px 0; border-radius: 5px;">
            <h3 style="color: #20B2AA; margin-top: 0;">Détails de la facture</h3>
            <p><strong>Référence :</strong> <t t-out="object.name"/></p>
            <p><strong>Date :</strong> <t t-out="object.invoice_date"/></p>
            <p><strong>Échéance :</strong> <t t-out="object.invoice_due_date"/></p>
            <p><strong>Montant HT :</strong> <t t-out="'{:,.2f}'.format(object.amount_untaxed_signed)"/> €</p>
            <p><strong>Montant TTC :</strong> <t t-out="'{:,.2f}'.format(object.amount_total_signed)"/> €</p>
            <p><strong>Origine :</strong> <t t-out="object.invoice_origin"/></p>
        </div>

        <div style="background: #fff3cd; padding: 15px; margin: 20px 0; border-radius: 5px;">
            <p style="margin: 0;"><strong>Informations de paiement :</strong></p>
            <ul style="margin: 10px 0;">
                <li>IBAN : <t t-out="user.company_id.partner_id.bank_ids[0].acc_number if user.company_id.partner_id.bank_ids else 'Non défini'"/></li>
                <li>BIC : <t t-out="user.company_id.partner_id.bank_ids[0].bank_bic if user.company_id.partner_id.bank_ids else 'Non défini'"/></li>
                <li>Référence : <t t-out="object.name"/></li>
            </ul>
        </div>

        <p><small><strong>Note :</strong> Cette facture a été générée automatiquement selon le planning de facturation du chantier.</small></p>

        <hr style="margin: 30px 0; border: none; border-top: 1px solid #eee;"/>

        <p>Pour toute question concernant cette facture, contactez-nous :<br/>
        📧 <t t-out="user.email"/><br/>
        📞 <t t-out="user.company_id.phone"/></p>

        <p>Cordialement,<br/>
        <strong><t t-out="user.company_id.name"/></strong></p>
    </div>
</div>
            </field>
        </record>

    </data>
</odoo>
