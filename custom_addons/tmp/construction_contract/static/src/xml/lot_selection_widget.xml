<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Main LotSelectionWidget Template -->
    <t t-name="construction_contract.LotSelectionWidget">
        <div class="o_lot_selection_widget">
            <!-- Loading State -->
            <div t-if="state.loading" class="o_lot_selection_loading text-center p-4">
                <i class="fa fa-spinner fa-spin fa-2x text-primary"/>
                <p class="mt-2 text-muted">Chargement des lots...</p>
            </div>

            <!-- No Chantier Selected -->
            <div t-elif="!state.chantierId" class="o_lot_selection_empty alert alert-info">
                <i class="fa fa-info-circle me-2"/>
                Veuillez d'abord sélectionner un chantier pour voir les lots disponibles.
            </div>

            <!-- No Lots Available -->
            <div t-elif="state.lots.length === 0" class="o_lot_selection_empty alert alert-warning">
                <i class="fa fa-exclamation-triangle me-2"/>
                Aucun lot disponible pour ce chantier.
            </div>

            <!-- Widget Content -->
            <div t-else="" class="o_lot_selection_content">
                <!-- Header with Search and Actions -->
                <div class="o_lot_selection_header mb-3">
                    <div class="row align-items-center g-2">
                        <!-- Search Input -->
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="fa fa-search text-muted"/>
                                </span>
                                <input type="text" 
                                       class="form-control" 
                                       placeholder="Rechercher un lot..."
                                       t-att-value="state.searchTerm"
                                       t-on-input="onSearchInput"
                                       t-att-disabled="props.readonly"/>
                                <button t-if="state.searchTerm" 
                                        class="btn btn-outline-secondary" 
                                        type="button"
                                        t-on-click="clearSearch">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </div>

                        <!-- View Mode Toggle -->
                        <div class="col-md-3">
                            <div class="btn-group w-100" role="group">
                                <button type="button" 
                                        t-attf-class="btn btn-sm {{ state.viewMode === 'checkbox' ? 'btn-primary' : 'btn-outline-primary' }}"
                                        t-on-click="() => this.switchViewMode('checkbox')"
                                        title="Mode liste">
                                    <i class="fa fa-list"/>
                                </button>
                                <button type="button" 
                                        t-attf-class="btn btn-sm {{ state.viewMode === 'dual-list' ? 'btn-primary' : 'btn-outline-primary' }}"
                                        t-on-click="() => this.switchViewMode('dual-list')"
                                        title="Mode double liste">
                                    <i class="fa fa-columns"/>
                                </button>
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <div class="col-md-3 text-end" t-if="!props.readonly">
                            <div class="btn-group">
                                <button type="button" 
                                        class="btn btn-sm btn-outline-success"
                                        t-on-click="selectAll"
                                        title="Tout sélectionner">
                                    <i class="fa fa-check-square-o me-1"/>Tout
                                </button>
                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger"
                                        t-on-click="deselectAll"
                                        title="Tout désélectionner">
                                    <i class="fa fa-square-o me-1"/>Aucun
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Selection Summary -->
                <div class="o_lot_selection_summary alert alert-light mb-3 py-2">
                    <i class="fa fa-info-circle me-2 text-primary"/>
                    <span t-esc="selectionSummary"/>
                </div>

                <!-- Checkbox Mode -->
                <div t-if="state.viewMode === 'checkbox'" class="o_lot_selection_checkbox_mode">
                    <t t-foreach="getFilteredCategories()" t-as="category" t-key="category.name">
                        <div class="o_lot_category card mb-2">
                            <!-- Category Header -->
                            <div class="card-header o_lot_category_header d-flex align-items-center py-2"
                                 t-on-click="() => this.toggleCategory(category.name)"
                                 style="cursor: pointer;">
                                <i t-attf-class="fa {{ isCategoryExpanded(category.name) ? 'fa-chevron-down' : 'fa-chevron-right' }} me-2"/>
                                <span class="fw-bold flex-grow-1" t-esc="category.name"/>
                                <span class="badge bg-secondary me-2">
                                    <t t-esc="getSelectedCountInCategory(category.name)"/>/<t t-esc="category.lots.length"/>
                                </span>
                                <div class="btn-group btn-group-sm" t-if="!props.readonly" t-on-click.stop="">
                                    <button type="button" 
                                            class="btn btn-outline-success btn-sm py-0"
                                            t-on-click="() => this.selectCategory(category.name)"
                                            title="Sélectionner la catégorie">
                                        <i class="fa fa-check"/>
                                    </button>
                                    <button type="button" 
                                            class="btn btn-outline-danger btn-sm py-0"
                                            t-on-click="() => this.deselectCategory(category.name)"
                                            title="Désélectionner la catégorie">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </div>

                            <!-- Category Content -->
                            <div t-if="isCategoryExpanded(category.name)" class="card-body p-0">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 40px;"></th>
                                            <th>Lot</th>
                                            <th class="text-end" style="width: 120px;">Montant</th>
                                            <th class="text-center d-none d-md-table-cell" style="width: 100px;">Début</th>
                                            <th class="text-center d-none d-md-table-cell" style="width: 100px;">Fin</th>
                                            <th class="text-center" style="width: 100px;">Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="category.lots" t-as="lot" t-key="lot.id">
                                            <tr t-attf-class="{{ isSelected(lot.id) ? 'table-primary' : '' }}"
                                                t-on-click="() => this.toggleLot(lot.id)"
                                                style="cursor: pointer;">
                                                <td class="text-center">
                                                    <input type="checkbox" 
                                                           class="form-check-input o_lot_checkbox"
                                                           t-att-checked="isSelected(lot.id)"
                                                           t-att-disabled="props.readonly"
                                                           t-on-click.stop="() => this.toggleLot(lot.id)"/>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-light text-dark me-2" t-esc="lot.code"/>
                                                        <span t-esc="lot.name"/>
                                                    </div>
                                                </td>
                                                <td class="text-end fw-bold">
                                                    <span t-esc="formatPrice(lot.price)"/>
                                                </td>
                                                <td class="text-center text-muted d-none d-md-table-cell">
                                                    <small t-esc="formatDate(lot.lot_date_start)"/>
                                                </td>
                                                <td class="text-center text-muted d-none d-md-table-cell">
                                                    <small t-esc="formatDate(lot.lot_date_end)"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-attf-class="badge bg-{{ lot.statusColor }}" 
                                                          t-esc="lot.statusLabel"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>

                    <!-- No Results -->
                    <div t-if="getFilteredCategories().length === 0 and state.searchTerm" 
                         class="alert alert-info text-center">
                        <i class="fa fa-search me-2"/>
                        Aucun lot ne correspond à votre recherche.
                    </div>
                </div>

                <!-- Dual-List Mode -->
                <div t-if="state.viewMode === 'dual-list'" class="o_lot_selection_dual_list_mode">
                    <div class="row">
                        <!-- Available Lots Panel -->
                        <div class="col-md-5">
                            <div class="card h-100">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold">
                                        <i class="fa fa-list me-2"/>Lots disponibles
                                    </span>
                                    <span class="badge bg-secondary" t-esc="getAvailableLots().length"/>
                                </div>
                                <div class="card-body p-0 o_lot_dual_list_panel" style="max-height: 400px; overflow-y: auto;">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="getAvailableLots()" t-as="lot" t-key="lot.id">
                                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2"
                                                 t-on-click="() => this.moveToSelected(lot.id)"
                                                 t-att-class="{ 'disabled': props.readonly }"
                                                 style="cursor: pointer;">
                                                <div>
                                                    <span class="badge bg-light text-dark me-2" t-esc="lot.code"/>
                                                    <span t-esc="lot.name"/>
                                                    <br/>
                                                    <small class="text-muted" t-esc="formatPrice(lot.price)"/>
                                                </div>
                                                <i class="fa fa-chevron-right text-muted"/>
                                            </div>
                                        </t>
                                        <div t-if="getAvailableLots().length === 0" 
                                             class="list-group-item text-center text-muted py-4">
                                            <i class="fa fa-check-circle fa-2x mb-2 d-block text-success"/>
                                            Tous les lots sont sélectionnés
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Transfer Buttons -->
                        <div class="col-md-2 d-flex flex-column justify-content-center align-items-center py-3">
                            <button type="button" 
                                    class="btn btn-primary mb-2"
                                    t-on-click="moveAllToSelected"
                                    t-att-disabled="props.readonly or getAvailableLots().length === 0"
                                    title="Tout sélectionner">
                                <i class="fa fa-angle-double-right"/>
                            </button>
                            <button type="button" 
                                    class="btn btn-outline-secondary"
                                    t-on-click="moveAllToAvailable"
                                    t-att-disabled="props.readonly or getSelectedLots().length === 0"
                                    title="Tout désélectionner">
                                <i class="fa fa-angle-double-left"/>
                            </button>
                        </div>

                        <!-- Selected Lots Panel -->
                        <div class="col-md-5">
                            <div class="card h-100 border-primary">
                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold">
                                        <i class="fa fa-check-square me-2"/>Lots sélectionnés
                                    </span>
                                    <span class="badge bg-light text-primary" t-esc="getSelectedLots().length"/>
                                </div>
                                <div class="card-body p-0 o_lot_dual_list_panel" style="max-height: 400px; overflow-y: auto;">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="getSelectedLots()" t-as="lot" t-key="lot.id">
                                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2"
                                                 t-on-click="() => this.moveToAvailable(lot.id)"
                                                 t-att-class="{ 'disabled': props.readonly }"
                                                 style="cursor: pointer;">
                                                <i class="fa fa-chevron-left text-muted"/>
                                                <div class="text-end">
                                                    <span t-esc="lot.name"/>
                                                    <span class="badge bg-light text-dark ms-2" t-esc="lot.code"/>
                                                    <br/>
                                                    <small class="text-muted" t-esc="formatPrice(lot.price)"/>
                                                </div>
                                            </div>
                                        </t>
                                        <div t-if="getSelectedLots().length === 0" 
                                             class="list-group-item text-center text-muted py-4">
                                            <i class="fa fa-arrow-left fa-2x mb-2 d-block"/>
                                            Cliquez sur un lot pour le sélectionner
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
