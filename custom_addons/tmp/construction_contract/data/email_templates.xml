<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ========================================================== -->
        <!-- EMAIL: Contract Invitation                                 -->
        <!-- ========================================================== -->

        <record id="mail_template_contract_invitation" model="mail.template">
            <field name="name">Contract: Invitation to Sign</field>
            <field name="model_id" ref="model_construction_contract"/>
            <field name="subject">Contract to Sign - ${object.chantier_id.name}</field>
            <field name="email_from">${(object.company_id.email or user.email)|safe}</field>
            <field name="email_to">${object.subcontractor_id.email|safe}</field>
            <field name="body_html" type="html">
<div style="font-family: 'Arial', sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background-color: #0056b3; padding: 20px; text-align: center;">
        <h1 style="color: white; margin: 0;">New Contract to Sign</h1>
    </div>

    <div style="padding: 30px; background-color: #f9f9f9;">
        <p style="font-size: 16px;">Hello <strong>${object.subcontractor_id.name}</strong>,</p>

        <p>We are pleased to send you a new subcontractor contract for the following construction site:</p>

        <div style="background-color: white; padding: 20px; border-left: 4px solid #0056b3; margin: 20px 0;">
            <h3 style="margin-top: 0; color: #0056b3;">Contract Details</h3>
            <table style="width: 100%; border-collapse: collapse;">
                <tr>
                    <td style="padding: 8px 0; font-weight: bold; width: 40%;">Contract Reference:</td>
                    <td style="padding: 8px 0;">${object.name}</td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; font-weight: bold;">Construction Site:</td>
                    <td style="padding: 8px 0;">${object.chantier_id.name}</td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; font-weight: bold;">Client:</td>
                    <td style="padding: 8px 0;">${object.chantier_id.client.name}</td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; font-weight: bold;">Total Amount:</td>
                    <td style="padding: 8px 0; color: #0056b3; font-weight: bold; font-size: 18px;">
                        ${'{:,.2f}'.format(object.total_amount_ttc)} ${object.currency_id.symbol}
                    </td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; font-weight: bold;">Work Period:</td>
                    <td style="padding: 8px 0;">
                        ${format_date(object.start_date)} - ${format_date(object.end_date)}
                    </td>
                </tr>
            </table>
        </div>

        <p style="font-size: 16px; margin: 30px 0;">
            <strong>Please review and sign this contract before ${format_date(object.token_expiry_date)}.</strong>
        </p>

        <div style="text-align: center; margin: 30px 0;">
            <a href="${object.portal_url or '#'}"
               style="display: inline-block; padding: 15px 40px; background-color: #28a745; color: white; text-decoration: none; border-radius: 5px; font-size: 18px; font-weight: bold;">
                📄 Review and Sign Contract
            </a>
        </div>

        <div style="background-color: #fff3cd; border: 1px solid #ffc107; padding: 15px; border-radius: 5px; margin: 20px 0;">
            <p style="margin: 0; color: #856404;">
                ⚠️ <strong>Important:</strong> You will need to validate each page of the contract before being able to sign it. This ensures you have read the entire document.
            </p>
        </div>

        <p style="font-size: 14px; color: #666; margin-top: 30px;">
            If you have any questions, please contact us.<br/>
            Best regards,<br/>
            <strong>${user.name}</strong>
        </p>
    </div>

    <div style="background-color: #333; color: white; padding: 15px; text-align: center; font-size: 12px;">
        <p style="margin: 0;">This is an automated message. Please do not reply to this email.</p>
        % if object.company_id.name:
        <p style="margin: 5px 0 0 0;">${object.company_id.name}</p>
        % endif
    </div>
</div>
            </field>
        </record>

        <!-- ========================================================== -->
        <!-- EMAIL: Reminder (Generic)                                  -->
        <!-- ========================================================== -->

        <record id="mail_template_contract_reminder" model="mail.template">
            <field name="name">Contract: Signature Reminder</field>
            <field name="model_id" ref="model_construction_contract"/>
            <field name="subject">Rappel: Contrat ${object.name} en attente de signature</field>
            <field name="email_from">${(object.company_id.email or user.email)|safe}</field>
            <field name="email_to">${object.subcontractor_id.email|safe}</field>
            <field name="body_html" type="html">
<div style="font-family: 'Arial', sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background-color: #ffc107; padding: 20px; text-align: center;">
        <h1 style="color: #333; margin: 0;">⏰ Rappel de signature de contrat</h1>
    </div>

    <div style="padding: 30px; background-color: #f9f9f9;">
        <p style="font-size: 16px;">Bonjour <strong>${object.subcontractor_id.name}</strong>,</p>

        <p>Nous vous rappelons que le contrat suivant est toujours en attente de votre signature :</p>

        <div style="background-color: white; padding: 20px; border-left: 4px solid #ffc107; margin: 20px 0;">
            <table style="width: 100%; border-collapse: collapse;">
                <tr>
                    <td style="padding: 8px 0; font-weight: bold; width: 40%;">Référence contrat :</td>
                    <td style="padding: 8px 0;">${object.name}</td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; font-weight: bold;">Chantier :</td>
                    <td style="padding: 8px 0;">${object.chantier_id.name}</td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; font-weight: bold;">Date d'expiration :</td>
                    <td style="padding: 8px 0; color: #dc3545; font-weight: bold;">
                        ${format_date(object.token_expiry_date)}
                    </td>
                </tr>
            </table>
        </div>

        <div style="text-align: center; margin: 30px 0;">
            <a href="${ctx.get('portal_url', object.portal_url or '#')}"
               style="display: inline-block; padding: 15px 40px; background-color: #28a745; color: white; text-decoration: none; border-radius: 5px; font-size: 18px; font-weight: bold;">
                📄 Signer maintenant
            </a>
        </div>

        <p style="font-size: 14px; color: #666; margin-top: 30px;">
            Cordialement,<br/>
            <strong>${user.name}</strong>
        </p>
    </div>

    <div style="background-color: #333; color: white; padding: 15px; text-align: center; font-size: 12px;">
        <p style="margin: 0;">Ceci est un rappel automatique.</p>
    </div>
</div>
            </field>
        </record>

        <!-- ========================================================== -->
        <!-- EMAIL: Reminder J+7 (First Reminder)                       -->
        <!-- ========================================================== -->

        <record id="mail_template_contract_reminder_j7" model="mail.template">
            <field name="name">Contract: Reminder J+7</field>
            <field name="model_id" ref="model_construction_contract"/>
            <field name="subject">Rappel J+7: Contrat ${object.name} en attente de signature</field>
            <field name="email_from">${(object.company_id.email or user.email)|safe}</field>
            <field name="email_to">${object.subcontractor_id.email|safe}</field>
            <field name="body_html" type="html">
<div style="font-family: 'Arial', sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background-color: #ffc107; padding: 20px; text-align: center;">
