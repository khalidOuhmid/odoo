<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ========================================================== -->
        <!-- CRON: Automatic Contract Reminders                         -->
        <!-- ========================================================== -->

        <record id="ir_cron_contract_reminders" model="ir.cron">
            <field name="name">Construction Contract: Send Automatic Reminders</field>
            <field name="model_id" ref="model_construction_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_automatic_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">5</field>
        </record>

    </data>
</odoo>
