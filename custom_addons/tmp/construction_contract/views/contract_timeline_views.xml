<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- CONTRACT FORM VIEW EXTENSION - Timeline & Audit            -->
    <!-- ========================================================== -->

    <record id="view_construction_contract_form_timeline" model="ir.ui.view">
        <field name="name">construction.contract.form.timeline</field>
        <field name="model">construction.contract</field>
        <field name="inherit_id" ref="view_construction_contract_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            
            <!-- Add smart buttons for activity and audit counts -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_activity_timeline" type="object"
                        class="oe_stat_button" icon="fa-history"
                        invisible="activity_count == 0">
                    <field name="activity_count" widget="statinfo"
                           string="Activités"/>
                </button>
                <button name="action_view_audit_trail" type="object"
                        class="oe_stat_button" icon="fa-shield"
                        invisible="audit_count == 0"
                        groups="group_construction_admin">
                    <field name="audit_count" widget="statinfo"
                           string="Audit"/>
                </button>
            </xpath>

            <!-- Add communication channel field in the notification group -->
            <xpath expr="//field[@name='email_sent']" position="before">
                <field name="communication_channel" 
                       string="Canal de communication"
                       readonly="state not in ('draft', 'generated')"
                       help="Canal préféré pour l'envoi du contrat"/>
            </xpath>

            <!-- Add document_template_id field after template_id -->
            <xpath expr="//field[@name='template_id']" position="after">
                <field name="document_template_id" 
                       string="Template unifié"
                       readonly="state != 'draft'"
                       options="{'no_create': True}"
                       invisible="1"
                       help="Template du module construction_templates (optionnel)"/>
            </xpath>

            <!-- Add Timeline tab in the notebook -->
            <xpath expr="//page[@name='technical']" position="before">
                <!-- Timeline Tab -->
                <page string="📊 Historique" name="timeline">
                    <div class="alert alert-info mb-3" role="alert">
                        <i class="fa fa-info-circle"/> 
                        <strong>Historique des activités :</strong> 
                        Consultez toutes les actions effectuées sur ce contrat.
                    </div>
                    
                    <!-- Timeline Widget -->
                    <field name="activity_log_ids" widget="contract_timeline" nolabel="1"/>
                    
                    <!-- Fallback list view if widget not available -->
                    <field name="activity_log_ids" nolabel="1" invisible="1">
                        <list create="0" delete="0" edit="0">
                            <field name="create_date" string="Date" widget="datetime"/>
                            <field name="activity_type" string="Type"/>
                            <field name="description" string="Description"/>
                            <field name="user_id" string="Utilisateur"/>
                            <field name="ip_address" string="IP"/>
                        </list>
                    </field>
                </page>

                <!-- Audit Trail Tab (Admin only) -->
                <page string="🔒 Audit" name="audit" groups="group_construction_admin">
                    <div class="alert alert-warning mb-3" role="alert">
                        <i class="fa fa-shield"/> 
                        <strong>Piste d'audit :</strong> 
                        Journal complet des modifications pour la conformité légale.
                    </div>
                    
                    <!-- Integrity verification button -->
                    <div class="mb-3" invisible="not pdf_document">
                        <button name="action_verify_integrity" type="object"
                                string="Vérifier l'intégrité du PDF"
                                class="btn-secondary"
                                icon="fa-check-circle"
                                help="Vérifier que le document PDF n'a pas été modifié"/>
                    </div>
                    
                    <!-- Audit Log List -->
                    <field name="audit_log_ids" nolabel="1">
                        <list create="0" delete="0" edit="0"
                              decoration-success="integrity_status == 'valid'"
                              decoration-danger="integrity_status == 'invalid'">
                            <field name="timestamp" string="Date/Heure" widget="datetime"/>
                            <field name="action" string="Action"/>
                            <field name="user_id" string="Utilisateur"/>
                            <field name="ip_address" string="Adresse IP"/>
                            <field name="user_agent" string="Navigateur" optional="hide"/>
                            <field name="integrity_status" string="Intégrité" widget="badge"
                                   decoration-success="integrity_status == 'valid'"
                                   decoration-danger="integrity_status == 'invalid'"
                                   decoration-muted="integrity_status == 'not_checked'"/>
                            <field name="hash_before" string="Hash avant" optional="hide"/>
                            <field name="hash_after" string="Hash après" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ========================================================== -->
    <!-- ACTIVITY TIMELINE - TREE VIEW                              -->
    <!-- ========================================================== -->

    <record id="view_contract_activity_tree" model="ir.ui.view">
        <field name="name">construction.contract.activity.tree</field>
        <field name="model">construction.contract.activity</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-success="activity_type == 'signed'"
                  decoration-warning="activity_type in ('sent', 'reminder')"
                  decoration-info="activity_type in ('created', 'generated')">
                <field name="create_date" string="Date" widget="datetime"/>
                <field name="activity_type" string="Type" widget="badge"/>
                <field name="description" string="Description"/>
                <field name="user_id" string="Utilisateur"/>
                <field name="ip_address" string="Adresse IP"/>
                <field name="contract_id" string="Contrat" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- ACTIVITY TIMELINE - FORM VIEW                              -->
    <!-- ========================================================== -->

    <record id="view_contract_activity_form" model="ir.ui.view">
        <field name="name">construction.contract.activity.form</field>
        <field name="model">construction.contract.activity</field>
        <field name="arch" type="xml">
            <form string="Activité du Contrat" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Informations">
                            <field name="contract_id" string="Contrat"/>
                            <field name="activity_type" string="Type"/>
                            <field name="description" string="Description"/>
                            <field name="create_date" string="Date"/>
                        </group>
                        <group string="Traçabilité">
                            <field name="user_id" string="Utilisateur"/>
                            <field name="ip_address" string="Adresse IP"/>
                            <field name="metadata" string="Métadonnées" widget="ace" 
                                   options="{'mode': 'json'}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- AUDIT LOG - TREE VIEW                                      -->
    <!-- ========================================================== -->

    <record id="view_contract_audit_tree" model="ir.ui.view">
        <field name="name">construction.contract.audit.tree</field>
        <field name="model">construction.contract.audit</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-success="integrity_status == 'valid'"
                  decoration-danger="integrity_status == 'invalid'">
                <field name="timestamp" string="Date/Heure" widget="datetime"/>
                <field name="contract_id" string="Contrat"/>
                <field name="action" string="Action" widget="badge"/>
                <field name="user_id" string="Utilisateur"/>
                <field name="ip_address" string="Adresse IP"/>
                <field name="integrity_status" string="Intégrité" widget="badge"
                       decoration-success="integrity_status == 'valid'"
                       decoration-danger="integrity_status == 'invalid'"
                       decoration-muted="integrity_status == 'not_checked'"/>
            </list>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- AUDIT LOG - FORM VIEW                                      -->
    <!-- ========================================================== -->

    <record id="view_contract_audit_form" model="ir.ui.view">
        <field name="name">construction.contract.audit.form</field>
        <field name="model">construction.contract.audit</field>
        <field name="arch" type="xml">
            <form string="Entrée d'Audit" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Action">
                            <field name="contract_id" string="Contrat"/>
                            <field name="action" string="Action"/>
                            <field name="timestamp" string="Date/Heure"/>
                        </group>
                        <group string="Utilisateur">
                            <field name="user_id" string="Utilisateur"/>
                            <field name="ip_address" string="Adresse IP"/>
                            <field name="user_agent" string="Navigateur"/>
                        </group>
                    </group>
                    <group string="Valeurs">
                        <group>
                            <field name="old_value" string="Ancienne valeur" widget="ace" 
                                   options="{'mode': 'json'}"/>
                        </group>
                        <group>
                            <field name="new_value" string="Nouvelle valeur" widget="ace" 
                                   options="{'mode': 'json'}"/>
                        </group>
                    </group>
                    <group string="Intégrité du Document">
                        <group>
                            <field name="integrity_verified" string="Vérifié"/>
                            <field name="integrity_status" string="Statut"/>
                        </group>
                        <group>
                            <field name="hash_before" string="Hash avant"/>
                            <field name="hash_after" string="Hash après"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- ACTIONS                                                    -->
    <!-- ========================================================== -->

    <record id="action_contract_activity" model="ir.actions.act_window">
        <field name="name">Activités des Contrats</field>
        <field name="res_model">construction.contract.activity</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune activité enregistrée
            </p>
            <p>
                Les activités sont automatiquement enregistrées lors des actions sur les contrats.
            </p>
        </field>
    </record>

    <record id="action_contract_audit" model="ir.actions.act_window">
        <field name="name">Piste d'Audit</field>
        <field name="res_model">construction.contract.audit</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="groups_id" eval="[(4, ref('group_construction_admin'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune entrée d'audit
            </p>
            <p>
                Les entrées d'audit sont automatiquement créées pour la conformité légale.
            </p>
        </field>
    </record>

</odoo>
