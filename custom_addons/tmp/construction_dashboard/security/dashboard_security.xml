<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BTPVision Role-Based Security Groups -->

    <!-- Category for BTPVision groups -->
    <record id="module_category_btpvision" model="ir.module.category">
        <field name="name">BTPVision</field>
        <field name="description">Gestion des chantiers BTPVision</field>
        <field name="sequence">10</field>
    </record>

    <!-- Gestionnaire de Chantier -->
    <record id="group_btpvision_gestionnaire" model="res.groups">
        <field name="name">Gestionnaire de Chantier</field>
        <field name="category_id" ref="module_category_btpvision"/>
        <field name="implied_ids" eval="[(4, ref('construction_base.group_construction_user'))]"/>
        <field name="comment">
            Gestion opérationnelle des chantiers assignés.
            Accès: chantiers assignés, contrats, planning, alertes temps réel.
        </field>
    </record>

    <!-- Responsable Administratif -->
    <record id="group_btpvision_administratif" model="res.groups">
        <field name="name">Responsable Administratif</field>
        <field name="category_id" ref="module_category_btpvision"/>
        <field name="implied_ids" eval="[(4, ref('construction_contract.group_contract_manager'))]"/>
        <field name="comment">
            Gestion administrative et documentaire.
            Accès: templates, conformité sous-traitants, contrats en attente.
        </field>
    </record>

    <!-- Directeur de Travaux -->
    <record id="group_btpvision_directeur" model="res.groups">
        <field name="name">Directeur de Travaux</field>
        <field name="category_id" ref="module_category_btpvision"/>
        <field name="implied_ids" eval="[
            (4, ref('group_btpvision_gestionnaire')),
            (4, ref('group_btpvision_administratif'))
        ]"/>
        <field name="comment">
            Supervision multi-chantiers avec vision analytique.
            Accès: tous les chantiers, rentabilité, ressources, planning global.
        </field>
    </record>

    <!-- Dashboard Access Groups -->
    <record id="group_dashboard_user" model="res.groups">
        <field name="name">Dashboard: User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Can view dashboards</field>
    </record>

    <record id="group_dashboard_manager" model="res.groups">
        <field name="name">Dashboard: Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
        <field name="comment">Can configure dashboards and widgets</field>
    </record>

    <!-- Record Rules -->
    <record id="rule_dashboard_company" model="ir.rule">
        <field name="name">Dashboard: Company Rule</field>
        <field name="model_id" ref="model_construction_dashboard"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Gestionnaire: voir uniquement ses chantiers -->
    <record id="rule_gestionnaire_chantiers" model="ir.rule">
        <field name="name">Gestionnaire: Own Sites Only</field>
        <field name="model_id" ref="construction_base.model_construction_chantier"/>
        <field name="domain_force">[('user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_btpvision_gestionnaire'))]"/>
    </record>

    <!-- Administratif: tous les contrats de sa company -->
    <record id="rule_administratif_contracts" model="ir.rule">
        <field name="name">Administratif: Company Contracts</field>
        <field name="model_id" ref="construction_contract.model_construction_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_btpvision_administratif'))]"/>
    </record>

    <!-- Directeur: tous les chantiers de sa company -->
    <record id="rule_directeur_chantiers" model="ir.rule">
        <field name="name">Directeur: Company Sites</field>
        <field name="model_id" ref="construction_base.model_construction_chantier"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_btpvision_directeur'))]"/>
    </record>
</odoo>
