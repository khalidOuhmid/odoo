<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="construction_dashboard.Dashboard">
        <div class="o_construction_dashboard">
            <div t-if="state.loading" class="dashboard-loading text-center p-5">
                <i class="fa fa-spinner fa-spin fa-3x text-blg-terre-cuite"/>
                <p class="mt-3">Chargement du dashboard...</p>
            </div>
            
            <div t-elif="!state.dashboard" class="dashboard-empty">
                <div class="text-center p-5">
                    <i class="fa fa-tachometer fa-4x text-muted mb-3"/>
                    <h3>Aucun dashboard configuré</h3>
                    <p class="text-muted">Contactez votre administrateur pour configurer votre dashboard.</p>
                </div>
            </div>
            
            <div t-else="" class="dashboard-container">
                <div class="dashboard-header d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm">
                    <h2 class="mb-0">
                        <i class="fa fa-tachometer-alt text-blg-terre-cuite me-2"/>
                        <t t-esc="state.dashboard.name"/>
                    </h2>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="loadDashboard">
                        <i class="fa fa-refresh"/> Actualiser
                    </button>
                </div>
                
                <div class="dashboard-grid">
                    <t t-foreach="state.widgets" t-as="widget" t-key="widget.id">
                        <div class="dashboard-widget" t-att-style="getWidgetStyle(widget)">
                            <!-- KPI Widget -->
                            <t t-if="widget.type === 'kpi'">
                                <KPICard widget="widget" onRefresh.bind="refreshWidget"/>
                            </t>
                            
                            <!-- Alert Widget -->
                            <t t-if="widget.type === 'alert'">
                                <AlertPanel widget="widget" onRefresh.bind="refreshWidget"/>
                            </t>
                            
                            <!-- Quick Actions Widget -->
                            <t t-if="widget.type === 'quick_action'">
                                <QuickActions widget="widget"/>
                            </t>
                            
                            <!-- List Widget -->
                            <t t-if="widget.type === 'list'">
                                <div class="widget-list card h-100">
                                    <div class="card-header bg-blg-terre-cuite text-white">
                                        <i t-attf-class="fa {{widget.icon}} me-2"/>
                                        <span><t t-esc="widget.title"/></span>
                                    </div>
                                    <div class="card-body p-0">
                                        <div t-if="!widget.items || widget.items.length === 0" 
                                             class="text-center text-muted p-4">
                                            Aucun élément
                                        </div>
                                        <div t-else="" class="list-group list-group-flush">
                                            <t t-foreach="widget.items" t-as="item" t-key="item.id">
                                                <div class="list-group-item">
                                                    <t t-esc="item.name"/>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            
                            <!-- Chart Widget (placeholder for future implementation) -->
                            <t t-if="widget.type === 'chart'">
                                <div class="widget-chart card h-100">
                                    <div class="card-header bg-blg-terre-cuite text-white">
                                        <i t-attf-class="fa {{widget.icon}} me-2"/>
                                        <span><t t-esc="widget.title"/></span>
                                    </div>
                                    <div class="card-body text-center text-muted">
                                        <i class="fa fa-chart-bar fa-3x mb-2"/>
                                        <p>Graphique à implémenter</p>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
