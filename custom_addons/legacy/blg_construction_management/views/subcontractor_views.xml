<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire pour les sous-traitants -->
    <record id="view_construction_subcontractor_form" model="ir.ui.view">
        <field name="name">construction.subcontractor.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Sous-traitant">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'entreprise"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Informations générales">
                            <field name="is_company" invisible="1"/>
                            <field name="contact_type" invisible="1"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                        </group>
                        <group string="Spécialités">
                            <field name="lots" widget="many2many_tags"/>
                        </group>
                    </group>
                    
                    <group string="Adresse">
                        <field name="street" placeholder="Adresse"/>
                        <field name="street2"/>
                        <div class="address_format">
                            <field name="zip" placeholder="Code postal" class="o_address_zip"/>
                            <field name="city" placeholder="Ville" class="o_address_city"/>
                        </div>
                        <field name="country_id" placeholder="Pays" class="o_address_country"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_construction_subcontractor_tree" model="ir.ui.view">
        <field name="name">construction.subcontractor.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Sous-traitants">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="lots" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Action pour les sous-traitants -->
    <record id="action_construction_subcontractors" model="ir.actions.act_window">
        <field name="name">Sous-traitants</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contact_type', '=', 'sous_traitant')]</field>
        <field name="context">{'default_contact_type': 'sous_traitant', 'default_is_company': True}</field>
        <field name="view_id" ref="view_construction_subcontractor_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau sous-traitant
            </p>
            <p>
                Gérez votre réseau d'entreprises sous-traitantes et leurs spécialités.
            </p>
        </field>
    </record>
</odoo>
