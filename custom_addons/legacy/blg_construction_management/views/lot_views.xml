<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lot Type Views (Catégories de lots) -->
    <record id="view_blg_lot_type_form" model="ir.ui.view">
        <field name="name">blg.lot.type.form</field>
        <field name="model">blg.lot.type</field>
        <field name="arch" type="xml">
            <form string="Type de lot">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Nom du type de lot"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sous-catégories" name="subcategories">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lots associés" name="lots">
                            <field name="lot_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="sequence"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Produits recommandés" name="products">
                            <field name="product_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="default_code"/>
                                    <field name="list_price" widget="monetary"/>
                                    <field name="categ_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_blg_lot_type_tree" model="ir.ui.view">
        <field name="name">blg.lot.type.list</field>
        <field name="model">blg.lot.type</field>
        <field name="arch" type="xml">
            <list string="Types de lot" editable="bottom" multi_edit="1">
                <field name="complete_name"/>
                <field name="parent_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_blg_lot_type_search" model="ir.ui.view">
        <field name="name">blg.lot.type.search</field>
        <field name="model">blg.lot.type</field>
        <field name="arch" type="xml">
            <search string="Rechercher un type de lot">
                <field name="name"/>
                <field name="complete_name"/>
                <field name="parent_id"/>
                <separator/>
                <filter string="Actifs" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactifs" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Parent" name="parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_blg_lot_type" model="ir.actions.act_window">
        <field name="name">Types de lot</field>
        <field name="res_model">blg.lot.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_blg_lot_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier type de lot !
            </p>
        </field>
    </record>

    <record id="view_blg_contacts_extension_lot_form" model="ir.ui.view">
        <field name="name">blg.contacts.extension.lot.form</field>
        <field name="model">blg_contacts_extension.lot</field>
        <field name="arch" type="xml">
            <form string="Corps de métier">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Nom du corps de métier"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="type_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sous-traitants associés" name="subcontractors">
                            <field name="partner_ids" widget="many2many_tags" domain="[('contact_type', '=', 'sous_traitant')]"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_blg_contacts_extension_lot_tree" model="ir.ui.view">
        <field name="name">blg.contacts.extension.lot.list</field>
        <field name="model">blg_contacts_extension.lot</field>
        <field name="arch" type="xml">
            <list string="Corps de métier" editable="bottom" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="type_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_blg_contacts_extension_lot_search" model="ir.ui.view">
        <field name="name">blg.contacts.extension.lot.search</field>
        <field name="model">blg_contacts_extension.lot</field>
        <field name="arch" type="xml">
            <search string="Rechercher un corps de métier">
                <field name="name"/>
                <field name="code"/>
                <field name="type_id"/>
                <separator/>
                <filter string="Actifs" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactifs" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Avec sous-traitants" name="with_subcontractors" domain="[('partner_ids', '!=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type" name="type" context="{'group_by': 'type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_blg_contacts_extension_lot" model="ir.actions.act_window">
        <field name="name">Corps de métier</field>
        <field name="res_model">blg_contacts_extension.lot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_blg_contacts_extension_lot_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier corps de métier !
            </p>
        </field>
    </record>

    <record id="action_blg_chantier_lot" model="ir.actions.act_window">
        <field name="name">Lots de travaux</field>
        <field name="res_model">blg.chantier.lot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun lot de travaux défini
            </p>
            <p>
                Créez des lots de travaux en sélectionnant parmi les corps de métier disponibles.
            </p>
        </field>
    </record>
</odoo>
